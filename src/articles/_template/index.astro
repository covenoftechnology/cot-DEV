---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import './article.css';
import meta from './meta';

// Local images
import coverImg from './images/cover.svg';
import diagramImg from './images/diagram-architecture.svg';
import scoringImg from './images/feature-scoring.svg';
import timingImg from './images/feature-timing.svg';
import gridItem1 from './images/grid-item-1.svg';
import gridItem2 from './images/grid-item-2.svg';
import gridItem3 from './images/grid-item-3.svg';

// Reusable article components
import Callout from '../../components/article/Callout.astro';
import CodeBlock from '../../components/article/CodeBlock.astro';
---

<ArticleLayout meta={meta} wide={true}>
  <article class="article-template">

    <!-- Hero-specific content -->
    <p class="hero-lead">
      {meta.description}
    </p>

    <figure class="hero-cover">
      <img src={coverImg.src} alt="Article visual system showcase cover artwork" width="1200" height="560" loading="eager" />
      <figcaption>Figure — Architectural overview and pattern showcase for Coven of Technology editorial scrolls.</figcaption>
    </figure>

    <!-- Mobile Table of Contents (visible on <= 980px) -->
    <details class="mobile-toc">
      <summary class="mobile-toc-summary">
        <span>☰ ON THIS SCROLL</span>
        <span style="font-size: 11px; opacity: 0.7;">EXPLORE</span>
      </summary>
      <div class="mobile-toc-content">
        <ul class="toc-nav-list" id="mobile-toc-list">
          <!-- Populated dynamically by client-side script from .article-section[data-toc-title] -->
        </ul>
      </div>
    </details>

    <div class="editorial-layout">

      <!-- Main content column -->
      <div class="main-content">

        <!-- ============================================================== -->
        <!-- 01 · BASIC TYPOGRAPHY                                          -->
        <!-- ============================================================== -->
        <section id="basic-typography" class="article-section" data-toc-title="Basic Typography">
          <div class="section-kicker">01 · BASIC TYPOGRAPHY</div>
          <h2>H2 · FONT-FAMILY: METAMORPHOUS · SIZE: CLAMP(22PX, 5VW, 26PX) · WEIGHT: 600 · LH: 1.25 · COLOR: #ECE6DD</h2>

          <!-- BLOCK: Title + Text -->
          <div class="block-typography-title-text">
            <div class="section-kicker">KICKER · FONT-FAMILY: CONSOLAS · SIZE: 11PX · WEIGHT: 600 · COLOR: #B98FD8</div>
            <h3>H3 · FONT-FAMILY: METAMORPHOUS · SIZE: CLAMP(18PX, 4.5VW, 22PX) · WEIGHT: 600 · LH: 1.3 · COLOR: #ECE6DD</h3>
            <p>
              P · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 18PX · WEIGHT: 400 · LINE-HEIGHT: 1.75 · COLOR: #CDC3B6
            </p>
            <p>
              P · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 18PX · WEIGHT: 400 · LINE-HEIGHT: 1.75 · COLOR: #CDC3B6 — In technical editorial writing, clear typographic hierarchy ensures the initiate absorbs complex doctrines with precision and ease.
            </p>
          </div>
          <!-- END BLOCK: Title + Text -->

          <!-- BLOCK: Text + Title -->
          <div class="block-typography-text-title">
            <p class="text-intro">
              LEAD-IN / P · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 20PX · WEIGHT: 400 (ITALIC) · LINE-HEIGHT: 1.65 · COLOR: #CDC3B6
            </p>
            <h3 class="heading-subsequent">H3 · FONT-FAMILY: METAMORPHOUS · SIZE: CLAMP(20PX, 4VW, 24PX) · WEIGHT: 600 · COLOR: #ECE6DD</h3>
            <p>
              P · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 18PX · WEIGHT: 400 · LINE-HEIGHT: 1.75 · COLOR: #CDC3B6 — Following the transition, this body paragraph delivers the technical breakdown of the newly introduced mechanism.
            </p>
          </div>
          <!-- END BLOCK: Text + Title -->

          <!-- BLOCK: Solo Text -->
          <div class="block-solo-text">
            <p>
              P · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 18PX · WEIGHT: 400 · LINE-HEIGHT: 1.75 · COLOR: #CDC3B6 — Within this scroll, initiates can review <strong style="font-weight:700;color:#f3ecdf">STRONG · WEIGHT: 700 · COLOR: #F3ECDF</strong>, <em style="font-style:italic;color:#e8cf95">EM · STYLE: ITALIC · COLOR: #E8CF95</em>, and inline hyperlinks directing the scholar to <a href="/library">LINK · HELVETICA NEUE ROMAN · SIZE: 18PX · COLOR: #E8CF95 · UNDERLINE: 1PX SOLID · OFFSET: 3PX</a>.
            </p>
            <p>
              P · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 18PX · WEIGHT: 400 · LINE-HEIGHT: 1.75 · COLOR: #CDC3B6 — Every line adheres to strict baseline rhythms and carefully tuned contrast ratios, ensuring legibility against the dark cosmic canvas even during protracted midnight research sessions.
            </p>
          </div>
          <!-- END BLOCK: Solo Text -->
        </section>

        <!-- ============================================================== -->
        <!-- 02 · LISTS & STEPS                                             -->
        <!-- ============================================================== -->
        <section id="lists-and-steps" class="article-section" data-toc-title="Lists & Steps">
          <div class="section-kicker">02 · LISTS & STEPS</div>
          <h2>H2 · FONT-FAMILY: METAMORPHOUS · SIZE: CLAMP(22PX, 5VW, 26PX) · WEIGHT: 600 · LH: 1.25 · COLOR: #ECE6DD</h2>

          <!-- BLOCK: Bullet List -->
          <div class="block-bullet-list">
            <h3 class="list-title">LIST TITLE · FONT-FAMILY: METAMORPHOUS · SIZE: 16PX · WEIGHT: 600 · COLOR: #ECE6DD</h3>
            <ul class="bullets-list">
              <li>BODY LIST · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 16PX · WEIGHT: 400 · LINE-HEIGHT: 1.65 · COLOR: #CDC3B6</li>
              <li>BODY LIST · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 16PX · WEIGHT: 400 · LINE-HEIGHT: 1.65 · COLOR: #CDC3B6</li>
              <li>BODY LIST · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 16PX · WEIGHT: 400 · LINE-HEIGHT: 1.65 · COLOR: #CDC3B6</li>
            </ul>
          </div>
          <!-- END BLOCK: Bullet List -->

          <!-- BLOCK: Nested Bullets (Bullets + Sub-Bullets) -->
          <div class="block-nested-bullets">
            <h3 class="list-title">NESTED BULLETS · FONT-FAMILY: METAMORPHOUS · SIZE: 16PX · WEIGHT: 600 · COLOR: #ECE6DD</h3>
            <ul class="nested-bullets-list">
              <li class="nested-bullet-main">
                <span class="bullet-text">MAIN BULLET · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 16PX · WEIGHT: 400 · LH: 1.6 · COLOR: #CDC3B6</span>
                <ul class="sub-bullets-list">
                  <li class="sub-bullet-item">SUB-BULLET · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 15PX · WEIGHT: 400 · LH: 1.55 · COLOR: #B3A99D</li>
                  <li class="sub-bullet-item">SUB-BULLET · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 15PX · WEIGHT: 400 · LH: 1.55 · COLOR: #B3A99D</li>
                </ul>
              </li>
              <li class="nested-bullet-main">
                <span class="bullet-text">MAIN BULLET · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 16PX · WEIGHT: 400 · LH: 1.6 · COLOR: #CDC3B6</span>
                <ul class="sub-bullets-list">
                  <li class="sub-bullet-item">SUB-BULLET · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 15PX · WEIGHT: 400 · LH: 1.55 · COLOR: #B3A99D</li>
                </ul>
              </li>
            </ul>
          </div>
          <!-- END BLOCK: Nested Bullets -->

          <!-- BLOCK: Numbered Steps -->
          <div class="block-numbered-steps">
            <h3 class="list-title">STEPS · FONT-FAMILY: METAMORPHOUS · SIZE: 16PX · WEIGHT: 600 · COLOR: #ECE6DD</h3>
            <ol class="steps-list">
              <li class="step-item">
                <div class="step-badge">01</div>
                <div class="step-content">
                  <h4>STEP TITLE · FONT-FAMILY: METAMORPHOUS · SIZE: 16PX · WEIGHT: 600 · COLOR: #ECE6DD</h4>
                  <p>Step body content · font-family: Helvetica Neue Roman · size: 16px · weight: 400 · line-height: 1.6 · color: #cdc3b6.</p>
                </div>
              </li>
              <li class="step-item">
                <div class="step-badge">02</div>
                <div class="step-content">
                  <h4>STEP TITLE · FONT-FAMILY: METAMORPHOUS · SIZE: 16PX · WEIGHT: 600 · COLOR: #ECE6DD</h4>
                  <p>Step body content · font-family: Helvetica Neue Roman · size: 16px · weight: 400 · line-height: 1.6 · color: #cdc3b6.</p>
                </div>
              </li>
              <li class="step-item">
                <div class="step-badge">03</div>
                <div class="step-content">
                  <h4>STEP TITLE · FONT-FAMILY: METAMORPHOUS · SIZE: 16PX · WEIGHT: 600 · COLOR: #ECE6DD</h4>
                  <p>Step body content · font-family: Helvetica Neue Roman · size: 16px · weight: 400 · line-height: 1.6 · color: #cdc3b6.</p>
                </div>
              </li>
            </ol>
          </div>
          <!-- END BLOCK: Numbered Steps -->
        </section>

        <!-- ============================================================== -->
        <!-- 03 · COLUMN LAYOUTS                                            -->
        <!-- ============================================================== -->
        <section id="column-layouts" class="article-section" data-toc-title="Column Layouts">
          <div class="section-kicker">03 · COLUMN LAYOUTS</div>
          <h2>H2 · FONT-FAMILY: METAMORPHOUS · SIZE: CLAMP(22PX, 5VW, 26PX) · WEIGHT: 600 · LH: 1.25 · COLOR: #ECE6DD</h2>

          <!-- BLOCK: Text | Image -->
          <div class="layout-text-media">
            <div class="layout-copy">
              <h3>H3 · FONT-FAMILY: METAMORPHOUS · SIZE: CLAMP(18PX, 4.5VW, 22PX) · WEIGHT: 600 · COLOR: #ECE6DD</h3>
              <p>
                P · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 18PX · WEIGHT: 400 · LINE-HEIGHT: 1.75 · COLOR: #CDC3B6 — This example demonstrates a 50/50 desktop layout with copy on the left and supporting visual media on the right. On tablet and mobile viewports, the layout gracefully stacks.
              </p>
              <p>
                P · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 18PX · WEIGHT: 400 · LINE-HEIGHT: 1.75 · COLOR: #CDC3B6 — Subscribers are categorized into four distinct quadrants based on predicted open and click probabilities.
              </p>
            </div>
            <figure class="layout-media">
              <img src={scoringImg.src} alt="Quadrant Propensity Matrix demonstration" width="600" height="420" loading="lazy" />
              <figcaption>FIGCAPTION · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 13PX · WEIGHT: 400 (ITALIC) · COLOR: #8F857A</figcaption>
            </figure>
          </div>
          <!-- END BLOCK: Text | Image -->

          <!-- BLOCK: Image | Text -->
          <div class="layout-media-text">
            <figure class="layout-media">
              <img src={timingImg.src} alt="Temporal send time optimization distribution" width="600" height="420" loading="lazy" />
              <figcaption>FIGCAPTION · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 13PX · WEIGHT: 400 (ITALIC) · COLOR: #8F857A</figcaption>
            </figure>
            <div class="layout-copy">
              <h3>H3 · FONT-FAMILY: METAMORPHOUS · SIZE: CLAMP(18PX, 4.5VW, 22PX) · WEIGHT: 600 · COLOR: #ECE6DD</h3>
              <p>
                P · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 18PX · WEIGHT: 400 · LINE-HEIGHT: 1.75 · COLOR: #CDC3B6 — This pattern places media on the left and technical narrative on the right. Rather than resorting to direction inversions, semantic DOM ordering ensures accessibility.
              </p>
              <p>
                P · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 18PX · WEIGHT: 400 · LINE-HEIGHT: 1.75 · COLOR: #CDC3B6 — Send Time Optimization calculates individual response probability curves over a 168-hour weekly cycle.
              </p>
            </div>
          </div>
          <!-- END BLOCK: Image | Text -->

          <!-- BLOCK: Two Text Columns -->
          <div class="layout-2col">
            <div class="col-box">
              <h3>H3 · FONT-FAMILY: METAMORPHOUS · SIZE: CLAMP(18PX, 4.5VW, 22PX) · WEIGHT: 600 · COLOR: #ECE6DD</h3>
              <p>
                P · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 18PX · WEIGHT: 400 · LINE-HEIGHT: 1.75 · COLOR: #CDC3B6 — Demonstrating a balanced two-column text layout. Column A focuses on inbound engagement streams and telemetry ingestion.
              </p>
              <ul class="col-list">
                <li>• FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 15PX · WEIGHT: 400 · COLOR: #CDC3B6</li>
                <li>• FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 15PX · WEIGHT: 400 · COLOR: #CDC3B6</li>
              </ul>
            </div>
            <div class="col-box">
              <h3>H3 · FONT-FAMILY: METAMORPHOUS · SIZE: CLAMP(18PX, 4.5VW, 22PX) · WEIGHT: 600 · COLOR: #ECE6DD</h3>
              <p>
                P · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 18PX · WEIGHT: 400 · LINE-HEIGHT: 1.75 · COLOR: #CDC3B6 — Column B addresses outbound dispatch engines, delivery queue priority, and automatic throttle policies.
              </p>
              <ul class="col-list">
                <li>• FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 15PX · WEIGHT: 400 · COLOR: #CDC3B6</li>
                <li>• FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 15PX · WEIGHT: 400 · COLOR: #CDC3B6</li>
              </ul>
            </div>
          </div>
          <!-- END BLOCK: Two Text Columns -->

          <!-- BLOCK: Three Columns -->
          <div class="layout-3col">
            <div class="col-box">
              <div class="col-kicker">PILLAR · CONSOLAS · SIZE: 10PX · WEIGHT: 600 · COLOR: #B98FD8</div>
              <h3>H3 · METAMORPHOUS · 17PX · 600</h3>
              <p>P · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 15PX · WEIGHT: 400 · COLOR: #CDC3B6</p>
            </div>
            <div class="col-box">
              <div class="col-kicker">PILLAR · CONSOLAS · SIZE: 10PX · WEIGHT: 600 · COLOR: #B98FD8</div>
              <h3>H3 · METAMORPHOUS · 17PX · 600</h3>
              <p>P · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 15PX · WEIGHT: 400 · COLOR: #CDC3B6</p>
            </div>
            <div class="col-box">
              <div class="col-kicker">PILLAR · CONSOLAS · SIZE: 10PX · WEIGHT: 600 · COLOR: #B98FD8</div>
              <h3>H3 · METAMORPHOUS · 17PX · 600</h3>
              <p>P · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 15PX · WEIGHT: 400 · COLOR: #CDC3B6</p>
            </div>
          </div>
          <!-- END BLOCK: Three Columns -->
        </section>

        <!-- ============================================================== -->
        <!-- 04 · IMAGES & MEDIA                                            -->
        <!-- ============================================================== -->
        <section id="images-and-media" class="article-section" data-toc-title="Images & Media">
          <div class="section-kicker">04 · IMAGES & MEDIA</div>
          <h2>H2 · FONT-FAMILY: METAMORPHOUS · SIZE: CLAMP(22PX, 5VW, 26PX) · WEIGHT: 600 · LH: 1.25 · COLOR: #ECE6DD</h2>

          <!-- BLOCK: Single Image -->
          <figure class="figure-single">
            <img src={coverImg.src} alt="Standard single figure diagram" width="1000" height="480" loading="lazy" />
            <figcaption>FIGCAPTION · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 13PX · WEIGHT: 400 (ITALIC) · COLOR: #8F857A</figcaption>
          </figure>
          <!-- END BLOCK: Single Image -->

          <!-- BLOCK: Full Width Image -->
          <figure class="figure-full">
            <img src={diagramImg.src} alt="Full width architecture diagram" width="1200" height="600" loading="lazy" />
            <figcaption>FIGCAPTION · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 13PX · WEIGHT: 400 (ITALIC) · COLOR: #8F857A</figcaption>
          </figure>
          <!-- END BLOCK: Full Width Image -->

          <!-- BLOCK: Two Images Grid -->
          <div class="image-grid-2">
            <figure class="figure-item">
              <img src={gridItem1.src} alt="Artifact classification asset" width="600" height="380" loading="lazy" />
              <figcaption>FIGCAPTION · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 13PX · WEIGHT: 400 (ITALIC) · COLOR: #8F857A</figcaption>
            </figure>
            <figure class="figure-item">
              <img src={gridItem2.src} alt="Audience fatigue saturation curve" width="600" height="380" loading="lazy" />
              <figcaption>FIGCAPTION · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 13PX · WEIGHT: 400 (ITALIC) · COLOR: #8F857A</figcaption>
            </figure>
          </div>
          <!-- END BLOCK: Two Images Grid -->

          <!-- BLOCK: Three Images Grid -->
          <div class="image-grid-3">
            <figure class="figure-item">
              <img src={gridItem1.src} alt="Visual feature classification" width="600" height="380" loading="lazy" />
              <figcaption>FIGCAPTION · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 13PX · WEIGHT: 400 (ITALIC) · COLOR: #8F857A</figcaption>
            </figure>
            <figure class="figure-item">
              <img src={gridItem2.src} alt="Fatigue threshold analysis" width="600" height="380" loading="lazy" />
              <figcaption>FIGCAPTION · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 13PX · WEIGHT: 400 (ITALIC) · COLOR: #8F857A</figcaption>
            </figure>
            <figure class="figure-item">
              <img src={gridItem3.src} alt="NLP subject line prediction" width="600" height="380" loading="lazy" />
              <figcaption>FIGCAPTION · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 13PX · WEIGHT: 400 (ITALIC) · COLOR: #8F857A</figcaption>
            </figure>
          </div>
          <!-- END BLOCK: Three Images Grid -->

          <!-- BLOCK: Horizontal Gallery Scroll -->
          <div class="horizontal-scroll-wrap">
            <div class="horizontal-scroll" role="region" aria-label="Horizontal image gallery" tabindex="0">
              <figure class="gallery-card">
                <img src={gridItem1.src} alt="Gallery item 1 - Propensity Matrix" width="360" height="230" loading="lazy" />
                <figcaption>FIGCAPTION · HELVETICA NEUE ROMAN · 13PX · ITALIC</figcaption>
              </figure>
              <figure class="gallery-card">
                <img src={gridItem2.src} alt="Gallery item 2 - Saturation Curve" width="360" height="230" loading="lazy" />
                <figcaption>FIGCAPTION · HELVETICA NEUE ROMAN · 13PX · ITALIC</figcaption>
              </figure>
              <figure class="gallery-card">
                <img src={gridItem3.src} alt="Gallery item 3 - Frequency Model" width="360" height="230" loading="lazy" />
                <figcaption>FIGCAPTION · HELVETICA NEUE ROMAN · 13PX · ITALIC</figcaption>
              </figure>
              <figure class="gallery-card">
                <img src={coverImg.src} alt="Gallery item 4 - Holistic Pipeline" width="360" height="230" loading="lazy" />
                <figcaption>FIGCAPTION · HELVETICA NEUE ROMAN · 13PX · ITALIC</figcaption>
              </figure>
            </div>
            <div class="gallery-scroll-hint">✦ Scroll horizontally to inspect model artifacts</div>
          </div>
          <!-- END BLOCK: Horizontal Gallery Scroll -->
        </section>

        <!-- ============================================================== -->
        <!-- 05 · CARDS & COMPARISONS                                       -->
        <!-- ============================================================== -->
        <section id="cards-and-comparisons" class="article-section" data-toc-title="Cards & Comparisons">
          <div class="section-kicker">05 · CARDS & COMPARISONS</div>
          <h2>H2 · FONT-FAMILY: METAMORPHOUS · SIZE: CLAMP(22PX, 5VW, 26PX) · WEIGHT: 600 · LH: 1.25 · COLOR: #ECE6DD</h2>

          <!-- BLOCK: 2-Card Grid -->
          <div class="card-grid-2">
            <div class="pattern-card">
              <div class="pattern-card-icon">✧</div>
              <h3 class="pattern-card-title">CARD TITLE · FONT-FAMILY: METAMORPHOUS · SIZE: 17PX · WEIGHT: 600 · COLOR: #F3ECDF</h3>
              <p class="pattern-card-desc">CARD BODY · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 15PX · WEIGHT: 400 · LINE-HEIGHT: 1.6 · COLOR: #CDC3B6</p>
            </div>
            <div class="pattern-card">
              <div class="pattern-card-icon">◈</div>
              <h3 class="pattern-card-title">CARD TITLE · FONT-FAMILY: METAMORPHOUS · SIZE: 17PX · WEIGHT: 600 · COLOR: #F3ECDF</h3>
              <p class="pattern-card-desc">CARD BODY · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 15PX · WEIGHT: 400 · LINE-HEIGHT: 1.6 · COLOR: #CDC3B6</p>
            </div>
          </div>
          <!-- END BLOCK: 2-Card Grid -->

          <!-- BLOCK: 3-Card Grid -->
          <div class="card-grid-3">
            <div class="pattern-card">
              <div class="pattern-card-icon">✉</div>
              <h3 class="pattern-card-title">CARD TITLE · FONT-FAMILY: METAMORPHOUS · SIZE: 17PX · WEIGHT: 600 · COLOR: #F3ECDF</h3>
              <p class="pattern-card-desc">CARD BODY · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 15PX · WEIGHT: 400 · LINE-HEIGHT: 1.6 · COLOR: #CDC3B6</p>
            </div>
            <div class="pattern-card">
              <div class="pattern-card-icon">⚙</div>
              <h3 class="pattern-card-title">CARD TITLE · FONT-FAMILY: METAMORPHOUS · SIZE: 17PX · WEIGHT: 600 · COLOR: #F3ECDF</h3>
              <p class="pattern-card-desc">CARD BODY · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 15PX · WEIGHT: 400 · LINE-HEIGHT: 1.6 · COLOR: #CDC3B6</p>
            </div>
            <div class="pattern-card">
              <div class="pattern-card-icon">✦</div>
              <h3 class="pattern-card-title">CARD TITLE · FONT-FAMILY: METAMORPHOUS · SIZE: 17PX · WEIGHT: 600 · COLOR: #F3ECDF</h3>
              <p class="pattern-card-desc">CARD BODY · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 15PX · WEIGHT: 400 · LINE-HEIGHT: 1.6 · COLOR: #CDC3B6</p>
            </div>
          </div>
          <!-- END BLOCK: 3-Card Grid -->

          <!-- BLOCK: 50/50 Comparison -->
          <div class="comparison-split">
            <div class="comparison-column">
              <div class="comparison-col-header">
                <span class="comparison-col-icon">✉</span>
                <span>TITLE · FONT-FAMILY: METAMORPHOUS · SIZE: 15PX · WEIGHT: 600 · COLOR: #E8CF95</span>
              </div>
              <ul class="comparison-list">
                <li>• LIST ITEM · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 15PX · WEIGHT: 400 · COLOR: #CDC3B6</li>
                <li>• LIST ITEM · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 15PX · WEIGHT: 400 · COLOR: #CDC3B6</li>
                <li>• LIST ITEM · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 15PX · WEIGHT: 400 · COLOR: #CDC3B6</li>
              </ul>
            </div>
            <div class="comparison-column">
              <div class="comparison-col-header">
                <span class="comparison-col-icon">◈</span>
                <span>TITLE · FONT-FAMILY: METAMORPHOUS · SIZE: 15PX · WEIGHT: 600 · COLOR: #E8CF95</span>
              </div>
              <ul class="comparison-list">
                <li>• LIST ITEM · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 15PX · WEIGHT: 400 · COLOR: #CDC3B6</li>
                <li>• LIST ITEM · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 15PX · WEIGHT: 400 · COLOR: #CDC3B6</li>
                <li>• LIST ITEM · FONT-FAMILY: HELVETICA NEUE ROMAN · SIZE: 15PX · WEIGHT: 400 · COLOR: #CDC3B6</li>
              </ul>
            </div>
          </div>
          <!-- END BLOCK: 50/50 Comparison -->

          <!-- BLOCK: Stats & Metrics -->
          <div class="stats-grid">
            <div class="stat-card">
              <div class="stat-number">12</div>
              <div class="stat-label">Active Journeys</div>
              <div class="stat-sub">Multi-cloud orchestration</div>
