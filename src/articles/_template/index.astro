  <!-- Interactive Client-side Script: Automated Dynamic TOC, Spy & Reveal -->
  <script is:inline>
    (function () {
      function buildToc(container, sections) {
        if (!container) return;
        container.innerHTML = '';
        sections.forEach(function (sec, idx) {
          var id = sec.id;
          var title = sec.getAttribute('data-toc-title') || ('Section ' + (idx + 1));
          var numStr = String(idx + 1).padStart(2, '0');
          var li = document.createElement('li');
          var a = document.createElement('a');
          a.href = '#' + id;
          a.className = 'toc-link';
          a.setAttribute('data-toc-target', id);
          a.innerHTML = '<span class="toc-num">' + numStr + '</span><span>' + title + '</span>';
          li.appendChild(a);
          container.appendChild(li);
        });
      }

      var observerInstance = null;

      function setupToc() {
        var sections = Array.from(document.querySelectorAll('.article-section[data-toc-title]'));
        var desktopTocList = document.getElementById('desktop-toc-list');
        var mobileTocList = document.getElementById('mobile-toc-list');

        if (sections.length === 0) return;

        // Defensive validations
        var seenIds = new Set();
        sections.forEach(function (sec, idx) {
          var id = sec.id;
          var title = sec.getAttribute('data-toc-title');
          if (!id) {
            console.warn('[TOC Defensive Warning] Section at index ' + idx + ' is missing an id attribute. Title: "' + title + '"');
          } else if (seenIds.has(id)) {
            console.warn('[TOC Defensive Warning] Duplicate section id detected: "' + id + '"');
          } else {
            seenIds.add(id);
          }
        });

        // Build links for Desktop and Mobile from the exact same sections array
        if (desktopTocList) {
          buildToc(desktopTocList, sections);
        }
        if (mobileTocList) {
          buildToc(mobileTocList, sections);
        }

        // Defensive count check
        var desktopCount = desktopTocList ? desktopTocList.querySelectorAll('.toc-link').length : 0;
        var mobileCount = mobileTocList ? mobileTocList.querySelectorAll('.toc-link').length : 0;
        if (desktopCount !== sections.length || mobileCount !== sections.length) {
          console.warn('[TOC Defensive Warning] Count mismatch! Sections: ' + sections.length + ', Desktop: ' + desktopCount + ', Mobile: ' + mobileCount);
        }

        // Active Section Spy for Sidebar TOC
        var allTocLinks = document.querySelectorAll('.article-template .toc-link');

        function scrollLinkIntoTocView(link) {
          var container = link.closest('.toc-scroll-area');
          if (!container) return;
          var containerRect = container.getBoundingClientRect();
          var linkRect = link.getBoundingClientRect();

          if (linkRect.top < containerRect.top) {
            container.scrollTo({
              top: container.scrollTop + (linkRect.top - containerRect.top) - 10,
              behavior: 'smooth'
            });
          } else if (linkRect.bottom > containerRect.bottom) {
            container.scrollTo({
              top: container.scrollTop + (linkRect.bottom - containerRect.bottom) + 10,
              behavior: 'smooth'
            });
          }
        }

        if (observerInstance) {
          observerInstance.disconnect();
        }

        if ('IntersectionObserver' in window && sections.length > 0) {
          observerInstance = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                var activeId = entry.target.id;
                allTocLinks.forEach(function (link) {
                  if (link.getAttribute('data-toc-target') === activeId) {
                    link.classList.add('active');
                    scrollLinkIntoTocView(link);
                  } else {
                    link.classList.remove('active');
                  }
                });
              }
            });
          }, {
            rootMargin: '-10% 0px -70% 0px',
            threshold: 0
          });

          sections.forEach(function (s) {
            observerInstance.observe(s);
          });
        }
      }

      // Initial execution
      setupToc();

      // Ensure execution on DOM ready and window load
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupToc);
      }
      window.addEventListener('load', setupToc);

      // DOM watcher: if React / DC-runtime mounts or clears #desktop-toc-list, repopulate immediately!
      var checkInterval = setInterval(function () {
        var dt = document.getElementById('desktop-toc-list');
        var secs = document.querySelectorAll('.article-section[data-toc-title]');
        if (dt && secs.length > 0 && dt.children.length === 0) {
          setupToc();
        }
      }, 100);

      // Stop polling after 4 seconds once stable
      setTimeout(function () {
        clearInterval(checkInterval);
        setupToc();
      }, 4000);

      // Exercise Reveal Answer Buttons (delegated)
      document.addEventListener('click', function (e) {
        var btn = e.target.closest('.reveal-btn');
        if (!btn) return;
        var targetId = btn.getAttribute('data-target');
        if (!targetId) return;
        var ans = document.getElementById(targetId);
        if (!ans) return;

        var isExpanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', !isExpanded);
        if (!isExpanded) {
          ans.classList.add('visible');
          btn.querySelector('span').textContent = 'Hide Answer';
        } else {
          ans.classList.remove('visible');
          btn.querySelector('span').textContent = '✦ Reveal Answer';
        }
      });

      // Auto-close mobile TOC on link click (delegated)
      document.addEventListener('click', function (e) {
        var mobileLink = e.target.closest('.mobile-toc a');
        if (mobileLink) {
          var mobileToc = mobileLink.closest('.mobile-toc');
          if (mobileToc) mobileToc.removeAttribute('open');
        }
      });
    })();
  </script>
