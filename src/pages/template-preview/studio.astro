        }

        var tableClassList = AT ? AT.getTableClassList(tableStyle, 'studio-table-grid') : 'studio-table-grid';
        var wrapClassList = 'studio-table-builder coven-table-scroll coven-table-wrap--' + escapeHtml(tableStyle.preset);

        var html =
          '<div class="studio-form-group studio-table-v2-root" data-table-block-id="' + escapeHtml(block.id) + '">' +
            '<div class="table-builder-header-bar">' +
