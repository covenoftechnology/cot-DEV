        // Delegated click handler for Table V2 toolbar & style gallery actions
        root.addEventListener('click', function(e) {
          var actBtn = e.target.closest('[data-table-v2-act]');
          if (!actBtn) return;
          e.preventDefault();
          e.stopPropagation();

          var act = actBtn.getAttribute('data-table-v2-act');
          var val = actBtn.getAttribute('data-val');
          var sel = getSel();
          var cols = d.columns || [];
          var rows = d.rows || [];

          if (act === 'toggle-style-panel') {
            tableStylePanelOpenMap[block.id] = !tableStylePanelOpenMap[block.id];
            renderSections();
            return;
          }

          if (act === 'set-preset' && val) {
            var curSt = AT.resolveTableStyle(d.tableStyle);
            curSt.preset = val;
            if (val === 'banded-rows') curSt.bandedRows = true;
            if (val === 'banded-columns') curSt.bandedColumns = true;
            d.tableStyle = curSt;
            renderSections();
            triggerAutosave();
            return;
          }

          if (act === 'toggle-bg-menu') {
            var wrap = actBtn.closest('.table-style-dropdown-wrap');
            var menu = wrap ? wrap.querySelector('.table-style-popover') : null;
            if (menu) {
              var isOpen = menu.style.display === 'flex';
              root.querySelectorAll('.table-style-popover').forEach(function(m) { m.style.display = 'none'; });
              if (!isOpen) menu.style.display = 'flex';
            }
            return;
          }

          if (act === 'set-cell-bg') {
            applySemanticPropToSelection('background', val || 'default');
            return;
          }

          if (act === 'set-cell-align' && val) {
            applySemanticPropToSelection('align', val);
            return;
          }

          if (act === 'reset-cell-style') {
            resetSelectionStyles();
            return;
          }

          if (act === 'merge-cells' && sel) {
            var res = AT.mergeCells(d.mergeRegions, {
              section: sel.section === 'header' ? 'header' : 'body',
              rowStart: sel.rowStart,
              rowEnd: sel.rowEnd,
              columnStart: sel.colStart,
              columnEnd: sel.colEnd
            }, rows.length, cols.length);
            if (!res.ok) {
              showToast(res.reason || 'Cannot merge selection', 'warning');
              return;
            }
            d.mergeRegions = res.mergeRegions;
            tableEditorSelectionMap[block.id] = AT.createSingleCellSelection(sel.section === 'header' ? 'header' : 'body', sel.rowStart, sel.colStart, d.mergeRegions);
            renderSections();
            triggerAutosave();
            return;
          }

          if (act === 'unmerge-cells' && sel) {
            var uRes = AT.unmergeCells(d.mergeRegions, sel.rowStart, sel.colStart, sel.section === 'header' ? 'header' : 'body');
            if (uRes.ok) {
              if (uRes.mergeRegions.length > 0) d.mergeRegions = uRes.mergeRegions;
              else delete d.mergeRegions;
              tableEditorSelectionMap[block.id] = AT.createSingleCellSelection(sel.section === 'header' ? 'header' : 'body', sel.rowStart, sel.colStart, d.mergeRegions || []);
              renderSections();
              triggerAutosave();
            }
            return;
          }

          if (act === 'insert-row-above' && sel && sel.section === 'body') {
            AT.insertRow(d, sel.rowStart, function() { return uid('row'); });
            tableEditorSelectionMap[block.id] = AT.createRowSelection('body', sel.rowStart, cols.length);
            renderSections();
            triggerAutosave();
            return;
          }

          if (act === 'insert-row-below' && sel && sel.section === 'body') {
            AT.insertRow(d, sel.rowStart + 1, function() { return uid('row'); });
            tableEditorSelectionMap[block.id] = AT.createRowSelection('body', sel.rowStart + 1, cols.length);
            renderSections();
            triggerAutosave();
            return;
          }

          if (act === 'delete-selected-row' && sel && sel.section === 'body') {
            if (AT.deleteRow(d, sel.rowStart)) {
              var nextRowIdx = Math.min(sel.rowStart, (d.rows || []).length - 1);
              tableEditorSelectionMap[block.id] = AT.createRowSelection('body', Math.max(0, nextRowIdx), cols.length);
              renderSections();
              triggerAutosave();
            }
            return;
          }

          if (act === 'insert-col-left' && sel) {
            AT.insertColumn(d, sel.colStart, function() { return uid('col'); });
            tableEditorSelectionMap[block.id] = AT.createColumnSelection(sel.colStart, (d.rows || []).length);
            renderSections();
            triggerAutosave();
            return;
          }

          if (act === 'insert-col-right' && sel) {
            AT.insertColumn(d, sel.colStart + 1, function() { return uid('col'); });
            tableEditorSelectionMap[block.id] = AT.createColumnSelection(sel.colStart + 1, (d.rows || []).length);
            renderSections();
            triggerAutosave();
            return;
          }

          if (act === 'delete-selected-col' && sel) {
            if (AT.deleteColumn(d, sel.colStart)) {
              var nextColIdx = Math.min(sel.colStart, (d.columns || []).length - 1);
              tableEditorSelectionMap[block.id] = AT.createColumnSelection(Math.max(0, nextColIdx), (d.rows || []).length);
              renderSections();
              triggerAutosave();
