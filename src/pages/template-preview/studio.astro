      // ── Category Custom Combobox ─────────────────────────
      var availableCategories = (window.STUDIO_MERGED_CATEGORIES || [
        'Business Analysis',
        'Management',
        'Mentoring',
        'Salesforce'
      ]).slice();

      function initCategoryCombobox() {
        var combobox = document.getElementById('category-combobox');
        var trigger = document.getElementById('category-trigger');
        var dropdown = document.getElementById('category-dropdown');
        var searchInput = document.getElementById('category-search-input');
        var optionsList = document.getElementById('category-options-list');
        var createRow = document.getElementById('category-create-row');
        var hiddenInput = document.getElementById('meta-category');
        var triggerText = document.getElementById('category-trigger-text');
        if (!combobox || !trigger || !dropdown) return;

        var highlightedIdx = -1;
        var filteredList = [];

        function openDropdown() {
          dropdown.style.display = 'flex';
          trigger.classList.add('is-open');
          combobox.setAttribute('aria-expanded', 'true');
          searchInput.value = '';
          renderList('');
          setTimeout(function() { searchInput.focus(); }, 20);
        }

        function closeDropdown() {
          dropdown.style.display = 'none';
          trigger.classList.remove('is-open');
          combobox.setAttribute('aria-expanded', 'false');
          highlightedIdx = -1;
        }

        function selectCategory(cat) {
          currentDoc.meta.category = cat;
          hiddenInput.value = cat;
          triggerText.textContent = cat;
          closeDropdown();
          trigger.focus();
          triggerAutosave();
        }

        function renderList(query) {
          optionsList.innerHTML = '';
          createRow.style.display = 'none';
          createRow.innerHTML = '';
          highlightedIdx = -1;

          var q = (query || '').trim().toLowerCase();
          filteredList = availableCategories.filter(function(c) {
            return !q || c.toLowerCase().includes(q);
          });

          var currentCat = (currentDoc.meta.category || '').toLowerCase();
          var hasExactMatch = false;

          filteredList.forEach(function(cat, idx) {
            if (cat.toLowerCase() === q) hasExactMatch = true;
            var isSelected = cat.toLowerCase() === currentCat;
            var opt = document.createElement('div');
            opt.className = 'combobox-option' + (isSelected ? ' is-selected' : '');
            opt.setAttribute('role', 'option');
            opt.setAttribute('aria-selected', isSelected ? 'true' : 'false');
            opt.textContent = cat;

            opt.addEventListener('mousedown', function(e) {
              e.preventDefault();
              selectCategory(cat);
            });
            optionsList.appendChild(opt);
          });

          var rawTrimmed = (query || '').trim();
          if (rawTrimmed && !hasExactMatch) {
            createRow.style.display = 'flex';
            createRow.textContent = '+ Create "' + rawTrimmed + '"';
            createRow.onmousedown = function(e) {
              e.preventDefault();
              var exists = availableCategories.some(function(c) {
                return c.toLowerCase() === rawTrimmed.toLowerCase();
              });
              if (!exists) {
                availableCategories.push(rawTrimmed);
              }
              selectCategory(rawTrimmed);
            };
          } else if (!rawTrimmed) {
            createRow.style.display = 'flex';
            createRow.textContent = '+ Create new category';
            createRow.onmousedown = function(e) {
              e.preventDefault();
              searchInput.focus();
            };
          }

          updateHighlight();
        }

        function updateHighlight() {
          var opts = optionsList.querySelectorAll('.combobox-option');
          opts.forEach(function(el, i) {
            el.classList.toggle('is-highlighted', i === highlightedIdx);
            if (i === highlightedIdx) el.scrollIntoView({ block: 'nearest' });
          });
          var isCreateHighlighted = (highlightedIdx === filteredList.length && createRow.style.display !== 'none');
          createRow.classList.toggle('is-highlighted', isCreateHighlighted);
        }

        trigger.addEventListener('click', function(e) {
          e.stopPropagation();
          if (dropdown.style.display === 'flex') {
            closeDropdown();
          } else {
            openDropdown();
          }
        });

        trigger.addEventListener('keydown', function(e) {
          if (dropdown.style.display !== 'flex') {
            if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              openDropdown();
            }
          }
        });

        searchInput.addEventListener('input', function(e) {
          renderList(e.target.value);
        });

        searchInput.addEventListener('keydown', function(e) {
          var totalItems = filteredList.length + (createRow.style.display !== 'none' ? 1 : 0);

          if (e.key === 'ArrowDown') {
            e.preventDefault();
            if (totalItems > 0) {
              highlightedIdx = (highlightedIdx + 1) % totalItems;
              updateHighlight();
            }
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            if (totalItems > 0) {
              highlightedIdx = (highlightedIdx - 1 + totalItems) % totalItems;
              updateHighlight();
            }
          } else if (e.key === 'Enter') {
            e.preventDefault();
            if (highlightedIdx >= 0 && highlightedIdx < filteredList.length) {
              selectCategory(filteredList[highlightedIdx]);
            } else if (highlightedIdx === filteredList.length && createRow.style.display !== 'none') {
              var typedVal = searchInput.value.trim();
              if (typedVal) {
                var exists = availableCategories.some(function(c) { return c.toLowerCase() === typedVal.toLowerCase(); });
                if (!exists) availableCategories.push(typedVal);
                selectCategory(typedVal);
              }
            } else if (filteredList.length > 0) {
              selectCategory(filteredList[0]);
            } else {
              var manual = searchInput.value.trim();
              if (manual) {
                if (!availableCategories.some(function(c) { return c.toLowerCase() === manual.toLowerCase(); })) {
                  availableCategories.push(manual);
                }
                selectCategory(manual);
              }
            }
          } else if (e.key === 'Escape') {
            e.preventDefault();
            closeDropdown();
            trigger.focus();
          }
        });

        document.addEventListener('click', function(e) {
          if (!combobox.contains(e.target)) {
            closeDropdown();
          }
        });
      }

      // ── Difficulty Custom Dropdown ───────────────────────
      function initDifficultyDropdown() {
        var combobox = document.getElementById('difficulty-combobox');
        var trigger = document.getElementById('difficulty-trigger');
        var menu = document.getElementById('difficulty-options-menu');
        var optionsList = document.getElementById('difficulty-options-list');
        var hiddenInput = document.getElementById('meta-difficulty');
        var triggerText = document.getElementById('difficulty-trigger-text');
        if (!combobox || !trigger || !menu) return;

        var difficulties = window.STUDIO_CANONICAL_DIFFICULTIES || [
          'Lv. 1 - Incantation',
          'Lv. 2 - Scroll',
          'Lv. 3 - Ritual'
        ];
        var glyphs = window.STUDIO_DIFFICULTY_GLYPHS || {
          'Lv. 1 - Incantation': '✦',
          'Lv. 2 - Scroll': '◆',
          'Lv. 3 - Ritual': '✧'
        };

        var highlightedIdx = -1;

        function renderList() {
          optionsList.innerHTML = '';
          var currentDiff = currentDoc.meta.difficulty || 'Lv. 1 - Incantation';

          difficulties.forEach(function(diff, idx) {
            var isSelected = diff === currentDiff;
            var opt = document.createElement('div');
            opt.className = 'combobox-option' + (isSelected ? ' is-selected' : '');
            opt.setAttribute('role', 'option');
            opt.setAttribute('aria-selected', isSelected ? 'true' : 'false');
            opt.innerHTML = '<span class="combobox-option-icon">' + (glyphs[diff] || '✦') + '</span><span>' + escapeHtml(diff) + '</span>';

            opt.addEventListener('mousedown', function(e) {
              e.preventDefault();
              selectDifficulty(diff);
            });
            optionsList.appendChild(opt);
          });
        }

        function selectDifficulty(diff) {
          currentDoc.meta.difficulty = diff;
          hiddenInput.value = diff;
          triggerText.textContent = (glyphs[diff] || '✦') + ' ' + diff;
          closeMenu();
          trigger.focus();
          triggerAutosave();
        }

        function openMenu() {
          renderList();
          menu.style.display = 'flex';
          trigger.classList.add('is-open');
          combobox.setAttribute('aria-expanded', 'true');
          highlightedIdx = difficulties.indexOf(currentDoc.meta.difficulty || 'Lv. 1 - Incantation');
          updateHighlight();
        }

        function closeMenu() {
          menu.style.display = 'none';
          trigger.classList.remove('is-open');
          combobox.setAttribute('aria-expanded', 'false');
          highlightedIdx = -1;
        }

        function updateHighlight() {
          var opts = optionsList.querySelectorAll('.combobox-option');
          opts.forEach(function(el, i) {
            el.classList.toggle('is-highlighted', i === highlightedIdx);
            if (i === highlightedIdx) el.scrollIntoView({ block: 'nearest' });
          });
        }

        trigger.addEventListener('click', function(e) {
          e.stopPropagation();
          if (menu.style.display === 'flex') {
            closeMenu();
          } else {
            openMenu();
          }
        });

        trigger.addEventListener('keydown', function(e) {
          if (menu.style.display !== 'flex') {
            if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              openMenu();
            }
            return;
          }

          if (e.key === 'ArrowDown') {
            e.preventDefault();
            highlightedIdx = (highlightedIdx + 1) % difficulties.length;
            updateHighlight();
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            highlightedIdx = (highlightedIdx - 1 + difficulties.length) % difficulties.length;
            updateHighlight();
          } else if (e.key === 'Enter') {
            e.preventDefault();
            if (highlightedIdx >= 0 && highlightedIdx < difficulties.length) {
              selectDifficulty(difficulties[highlightedIdx]);
            }
          } else if (e.key === 'Escape') {
            e.preventDefault();
            closeMenu();
            trigger.focus();
          }
        });

        document.addEventListener('click', function(e) {
          if (!combobox.contains(e.target)) {
            closeMenu();
          }
        });
      }

      // ── Canonical Tags Combobox ──────────────────────────
      var availableTags = (window.STUDIO_MERGED_TAGS || []).slice();
      var canonicalTagsList = window.STUDIO_CANONICAL_TAGS || [];

      function getCanonicalTagCasing(raw) {
        var trimmed = raw.trim();
        var match = canonicalTagsList.find(function(c) {
          return c.toLowerCase() === trimmed.toLowerCase();
        });
        return match || trimmed;
      }

      function initTagsCombobox() {
        var wrap = document.getElementById('tags-combobox-wrap');
        var container = document.getElementById('tag-chips-container');
        var input = document.getElementById('tag-inline-input');
        var dropdown = document.getElementById('tags-dropdown-menu');
        var optionsList = document.getElementById('tags-options-list');
        var createRow = document.getElementById('tag-create-row');
        if (!wrap || !container || !input || !dropdown) return;

        var highlightedIdx = -1;
        var currentFilteredTags = [];

        function openDropdown() {
          dropdown.style.display = 'flex';
          wrap.setAttribute('aria-expanded', 'true');
          renderSuggestions(input.value);
        }

        function closeDropdown() {
          dropdown.style.display = 'none';
          wrap.setAttribute('aria-expanded', 'false');
          highlightedIdx = -1;
        }

        function addTag(raw) {
          if (!raw) return;
          var trimmed = raw.trim().replace(/^,|,$/g, '');
          if (!trimmed) return;

          var resolvedTag = getCanonicalTagCasing(trimmed);

          // Case-insensitive duplicate prevention
          var exists = (currentDoc.meta.tags || []).some(function(t) {
            return t.toLowerCase() === resolvedTag.toLowerCase();
          });

          if (!exists) {
            if (!currentDoc.meta.tags) currentDoc.meta.tags = [];
            currentDoc.meta.tags.push(resolvedTag);

            var inAvailable = availableTags.some(function(t) {
              return t.toLowerCase() === resolvedTag.toLowerCase();
            });
            if (!inAvailable) {
              availableTags.push(resolvedTag);
            }

            renderTagChips();
            triggerAutosave();
          }

          input.value = '';
          renderSuggestions('');
        }

        function removeTag(idx) {
          currentDoc.meta.tags.splice(idx, 1);
          renderTagChips();
          renderSuggestions(input.value);
          triggerAutosave();
        }

        function renderTagChips() {
          container.querySelectorAll('.tag-chip').forEach(function(c) { c.remove(); });

          (currentDoc.meta.tags || []).forEach(function(tag, idx) {
            var chip = document.createElement('span');
            chip.className = 'tag-chip';
            chip.innerHTML = '<span>' + escapeHtml(tag) + '</span><span class="tag-chip-remove" data-idx="' + idx + '" aria-label="Remove tag ' + escapeHtml(tag) + '">×</span>';

            chip.querySelector('.tag-chip-remove').addEventListener('click', function(e) {
              e.stopPropagation();
              removeTag(idx);
            });

            container.insertBefore(chip, input);
          });
        }

        function renderSuggestions(filterText) {
          optionsList.innerHTML = '';
          createRow.style.display = 'none';
          createRow.innerHTML = '';
          highlightedIdx = -1;

          var q = (filterText || '').trim().toLowerCase();
          currentFilteredTags = availableTags.filter(function(tag) {
            return !q || tag.toLowerCase().includes(q);
          });

          var selectedLower = (currentDoc.meta.tags || []).map(function(t) { return t.toLowerCase(); });
          var exactMatch = false;

          currentFilteredTags.forEach(function(tag, idx) {
            if (tag.toLowerCase() === q) exactMatch = true;
            var isSelected = selectedLower.includes(tag.toLowerCase());
            var opt = document.createElement('div');
            opt.className = 'combobox-option' + (isSelected ? ' is-selected' : '');
            opt.setAttribute('role', 'option');
            opt.setAttribute('aria-selected', isSelected ? 'true' : 'false');
            opt.textContent = tag;

            opt.addEventListener('mousedown', function(e) {
              e.preventDefault();
              if (isSelected) {
                var tIdx = currentDoc.meta.tags.findIndex(function(t) { return t.toLowerCase() === tag.toLowerCase(); });
                if (tIdx >= 0) removeTag(tIdx);
              } else {
                addTag(tag);
              }
            });
            optionsList.appendChild(opt);
          });

          var rawTrimmed = (filterText || '').trim();
          if (rawTrimmed && !exactMatch) {
            createRow.style.display = 'flex';
            createRow.textContent = '+ Create "' + rawTrimmed + '"';
            createRow.onmousedown = function(e) {
              e.preventDefault();
              addTag(rawTrimmed);
            };
          }

          updateHighlight();
        }

        function updateHighlight() {
          var allOptions = optionsList.querySelectorAll('.combobox-option');
          allOptions.forEach(function(el, i) {
            el.classList.toggle('is-highlighted', i === highlightedIdx);
            if (i === highlightedIdx) el.scrollIntoView({ block: 'nearest' });
          });
          var isCreateHighlighted = (highlightedIdx === currentFilteredTags.length && createRow.style.display !== 'none');
          createRow.classList.toggle('is-highlighted', isCreateHighlighted);
        }

        container.addEventListener('click', function() {
          input.focus();
        });

        input.addEventListener('focus', function() {
          openDropdown();
        });

        input.addEventListener('input', function() {
          openDropdown();
        });

        input.addEventListener('keydown', function(e) {
          var totalItems = currentFilteredTags.length + (createRow.style.display !== 'none' ? 1 : 0);

          if (e.key === 'ArrowDown') {
            e.preventDefault();
            if (dropdown.style.display !== 'flex') {
              openDropdown();
            } else if (totalItems > 0) {
              highlightedIdx = (highlightedIdx + 1) % totalItems;
              updateHighlight();
            }
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            if (totalItems > 0) {
              highlightedIdx = (highlightedIdx - 1 + totalItems) % totalItems;
              updateHighlight();
            }
          } else if (e.key === 'Enter' || e.key === ',') {
            e.preventDefault();
            if (highlightedIdx >= 0 && highlightedIdx < currentFilteredTags.length) {
              var chosen = currentFilteredTags[highlightedIdx];
              var isSelected = (currentDoc.meta.tags || []).some(function(t) { return t.toLowerCase() === chosen.toLowerCase(); });
              if (isSelected) {
                var tIdx = currentDoc.meta.tags.findIndex(function(t) { return t.toLowerCase() === chosen.toLowerCase(); });
                if (tIdx >= 0) removeTag(tIdx);
              } else {
                addTag(chosen);
              }
            } else if (highlightedIdx === currentFilteredTags.length && createRow.style.display !== 'none') {
              addTag(input.value.trim());
            } else if (input.value.trim()) {
              addTag(input.value.trim());
            }
          } else if (e.key === 'Backspace' && !input.value) {
            if (currentDoc.meta.tags && currentDoc.meta.tags.length > 0) {
              removeTag(currentDoc.meta.tags.length - 1);
            }
          } else if (e.key === 'Escape') {
            e.preventDefault();
            closeDropdown();
          }
        });

        input.addEventListener('paste', function(e) {
          e.preventDefault();
          var paste = (e.clipboardData || window.clipboardData).getData('text');
          if (paste) {
            var parts = paste.split(',').map(function(p) { return p.trim(); }).filter(Boolean);
            parts.forEach(function(p) { addTag(p); });
          }
        });

        document.addEventListener('click', function(e) {
          if (!wrap.contains(e.target)) {
            closeDropdown();
          }
        });

        window._renderTagChips = renderTagChips;
      }

      // Close rich text color menus, highlight menus, and link popovers on outside click
      document.addEventListener('click', function(e) {
        if (!e.target.closest('.rich-color-dropdown-wrap')) {
          document.querySelectorAll('.rich-color-menu').forEach(function(m) {
            m.style.display = 'none';
          });
        }
        if (!e.target.closest('.rich-highlight-dropdown-wrap')) {
          document.querySelectorAll('.rich-highlight-menu').forEach(function(m) {
            m.style.display = 'none';
          });
        }
        if (!e.target.closest('.rich-link-dropdown-wrap')) {
          document.querySelectorAll('.rich-link-popover').forEach(function(p) {
            p.style.display = 'none';
          });
        }
      });

      // ── Advanced Settings Accordion ─────────────────────
      document.getElementById('adv-settings-toggle').addEventListener('click', function() {
        document.getElementById('adv-settings-box').classList.toggle('open');
      });

      // Cover upload handler
      document.getElementById('btn-upload-cover').addEventListener('click', function() {
        document.getElementById('cover-file-upload').click();
      });

      document.getElementById('cover-file-upload').addEventListener('change', function(e) {
        var file = e.target.files[0];
        if (!file) return;
        var reader = new FileReader();
        reader.onload = function(evt) {
          fetch('/__article-studio/upload', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ filename: file.name, base64: evt.target.result })
          })
          .then(function(res) { return res.json(); })
          .then(function(data) {
            if (data.success && data.url) {
              document.getElementById('meta-cover').value = data.url;
              currentDoc.meta.cover = data.url;
              document.getElementById('cover-caption-group').style.display = 'flex';
              triggerAutosave();
              showToast('Cover image uploaded: ' + file.name, 'success');
            }
          });
        };
        reader.readAsDataURL(file);
      });

      document.getElementById('meta-cover').addEventListener('input', function(e) {
        var val = (e.target.value || '').trim();
        currentDoc.meta.cover = val;
        document.getElementById('cover-caption-group').style.display = val ? 'flex' : 'none';
        triggerAutosave();
      });

      // Settings generic listeners
      ['meta-desc', 'meta-author', 'meta-rank', 'meta-aether', 'meta-cover-caption', 'meta-featured', 'meta-wide'].forEach(function(id) {
        var el = document.getElementById(id);
        if (el) {
          el.addEventListener('change', function() {
            syncMetaStateFromInputs();
            triggerAutosave();
          });
        }
      });

      // ── Autosave & Persistence ──────────────────────────
      function saveDraft(quiet) {
        syncMetaStateFromInputs();
        setStatus('Saving…', 'saving');

        return fetch('/__article-studio/draft', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(currentDoc)
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.success) {
            setStatus('Saved', 'saved');
            isDirty = false;
            try {
              localStorage.setItem('covenArticleStudio:lastDraftId', currentDoc.studioId);
            } catch (e) {}
            if (!quiet) showToast('Draft saved successfully', 'success');
          } else {
            setStatus('Save failed', 'error');
            showToast(data.error || 'Failed to save draft', 'error');
          }
        })
        .catch(function(err) {
          setStatus('Save error', 'error');
          showToast('Save error: ' + err.message, 'error');
        });
      }

      function triggerAutosave() {
        isDirty = true;
        setStatus('Unsaved changes', '');

        if (autosaveTimer) clearTimeout(autosaveTimer);
        autosaveTimer = setTimeout(function() {
          saveDraft(true);
        }, 800);
      }

      function setStatus(text, type) {
        var indicator = document.getElementById('status-indicator');
        var dot = document.getElementById('status-dot');
        if (indicator) indicator.textContent = text;
        if (dot) {
          dot.className = 'status-dot' + (type ? ' ' + type : '');
        }
      }

      function showToast(msg, type) {
        var container = document.getElementById('toast-container');
        if (!container) return;

        var toast = document.createElement('div');
        toast.className = 'studio-toast' + (type ? ' ' + type : '');
        toast.innerHTML = '<span>✦</span><span>' + escapeHtml(msg) + '</span>';
        container.appendChild(toast);

        setTimeout(function() {
          toast.style.opacity = '0';
          toast.style.transform = 'translateY(10px)';
          setTimeout(function() { toast.remove(); }, 300);
        }, 3000);
      }

      // ── Delete Confirmation Modal ───────────────────────
      function confirmDelete(title, message, onConfirm) {
        var modal = document.getElementById('delete-confirm-modal');
        var titleEl = document.getElementById('delete-modal-title');
        var msgEl = document.getElementById('delete-modal-message');
        if (!modal) {
          if (confirm(message)) onConfirm();
          return;
        }

        if (titleEl) titleEl.textContent = title;
        if (msgEl) msgEl.textContent = message;
        pendingDeleteCallback = onConfirm;
        modal.style.display = 'flex';
      }

      document.getElementById('btn-cancel-delete').addEventListener('click', function() {
        document.getElementById('delete-confirm-modal').style.display = 'none';
        pendingDeleteCallback = null;
      });

      document.getElementById('btn-confirm-delete').addEventListener('click', function() {
        document.getElementById('delete-confirm-modal').style.display = 'none';
        if (typeof pendingDeleteCallback === 'function') {
          pendingDeleteCallback();
        }
        pendingDeleteCallback = null;
      });

      // ── New Article Draft ───────────────────────────────
      document.getElementById('btn-new').addEventListener('click', function() {
        if (isDirty) {
          confirmDelete(
            'START NEW ARTICLE?',
            'You have unsaved changes in the current scroll. Create a new blank draft?',
            function() {
              createNewArticle();
            }
          );
        } else {
          createNewArticle();
        }
      });

      function createNewArticle() {
        isExistingPublished = false;
        originalPublishedSlug = '';
        var warningEl = document.getElementById('slug-published-warning');
        if (warningEl) warningEl.style.display = 'none';

        currentDoc = {
          version: 1,
          studioId: uid('draft'),
          slug: '',
          meta: {
            title: '',
            description: '',
            author: 'Oracle of Orgs',
            category: 'Salesforce',
            difficulty: 'Lv. 1 - Incantation',
            tags: [],
            rank: 'Mechanic',
            readingTime: '1 min',
            aetherReward: 120,
            status: 'draft',
            featured: false,
            wide: true,
            cover: '',
            coverCaption: ''
          },
          sections: []
        };
        activeSectionId = null;
        renderSections();
        syncMetaInputsFromState();
        saveDraft(true);
        showToast('New article created', 'success');
      }

      // ── Drafts Modal ────────────────────────────────────
      var btnDraftsEl = document.getElementById('btn-drafts');
      if (btnDraftsEl) {
        btnDraftsEl.addEventListener('click', function() {
          loadDraftsList();
          document.getElementById('drafts-modal').style.display = 'flex';
        });
      }

      document.getElementById('btn-close-drafts').addEventListener('click', function() {
        closeInlineDelete();
        document.getElementById('drafts-modal').style.display = 'none';
      });

      function deleteDraft(studioId, title, triggerBtn) {
        showInlineDelete(
          triggerBtn,
          'Delete this draft?',
          null,
          function() {
            if (triggerBtn) triggerBtn.disabled = true;
            fetch('/__article-studio/drafts/' + studioId, { method: 'DELETE' })
              .then(function(res) {
                if (!res.ok) throw new Error('Delete failed');
                showToast('Draft deleted');
                loadDraftsList();
              })
              .catch(function(err) {
                if (triggerBtn) triggerBtn.disabled = false;
                showToast('Failed to delete draft', 'error');
              });
          }
        );
      }

      function loadDraftsList() {
        var listContainer = document.getElementById('drafts-list');
        listContainer.innerHTML = '<div style="color:var(--studio-text-muted);font-size:12px">Loading drafts…</div>';

        fetch('/__article-studio/drafts')
          .then(function(res) { return res.json(); })
          .then(function(data) {
            var drafts = data.drafts || [];
            if (drafts.length === 0) {
              listContainer.innerHTML = '<div style="color:var(--studio-text-muted);font-size:13px;padding:12px 0">No saved drafts found.</div>';
              return;
            }

            listContainer.innerHTML = '';
            drafts.forEach(function(d) {
              var card = document.createElement('div');
              card.style.cssText = 'background:rgba(21,18,28,0.8);border:1px solid var(--studio-border);border-radius:6px;padding:12px 14px;display:flex;justify-content:space-between;align-items:center;gap:12px';

              var dateStr = new Date(d.updatedAt).toLocaleString();
              card.innerHTML =
                '<div>' +
                  '<div style="font-family:var(--font-display);font-size:13px;color:var(--studio-gold-bright);margin-bottom:3px">' + escapeHtml(d.title || 'Untitled Scroll') + '</div>' +
                  '<div style="font-family:var(--font-mono);font-size:10px;color:var(--studio-purple)">' + escapeHtml(d.category) + ' · ' + escapeHtml(d.status).toUpperCase() + ' · ' + dateStr + '</div>' +
                '</div>' +
                '<div style="display:flex;gap:6px">' +
                  '<button type="button" class="studio-btn studio-btn--sm btn-open-draft" data-id="' + d.studioId + '">Open</button>' +
                  '<button type="button" class="studio-btn studio-btn--sm studio-btn--danger btn-del-draft" data-id="' + d.studioId + '">✕</button>' +
                '</div>';

              card.querySelector('.btn-open-draft').addEventListener('click', function() {
                openDraft(d.studioId);
                document.getElementById('drafts-modal').style.display = 'none';
              });

              card.querySelector('.btn-del-draft').addEventListener('click', function(e) {
                e.stopPropagation();
                deleteDraft(d.studioId, d.title, e.currentTarget);
              });

              listContainer.appendChild(card);
            });
          });
      }

      function openDraft(studioId) {
        closeInlineDelete();
        try {
          localStorage.setItem('covenArticleStudio:lastDraftId', studioId);
        } catch (e) {}
        fetch('/__article-studio/drafts/' + studioId)
          .then(function(res) { return res.json(); })
          .then(function(doc) {
            normalizeDocument(doc);
            currentDoc = doc;
            activeSectionId = doc.sections.length > 0 ? doc.sections[0].id : null;
            renderSections();
            syncMetaInputsFromState();
            setStatus('Draft restored', 'saved');
            showToast('Draft opened: ' + (doc.meta.title || 'Untitled'));
          });
      }

      // ── Duplicate Article ───────────────────────────────
      document.getElementById('btn-duplicate-article').addEventListener('click', function() {
        var copyDoc = JSON.parse(JSON.stringify(currentDoc));
        copyDoc.studioId = uid('draft');
        var rawBase = (copyDoc.slug || 'untitled').replace(/-copy(-\d+)?$/i, '');
        copyDoc.slug = normalizeSlugClient(rawBase + '-copy', false);
        copyDoc.meta.title = (copyDoc.meta.title || 'Untitled Scroll') + ' (Copy)';
        copyDoc.meta.status = 'draft';

        normalizeDocument(copyDoc);
        currentDoc = copyDoc;
        isExistingPublished = false;
        originalPublishedSlug = '';
        activeSectionId = currentDoc.sections.length > 0 ? currentDoc.sections[0].id : null;
        renderSections();
        syncMetaInputsFromState();
        saveDraft(false);
        showToast('Article duplicated as new draft', 'success');
      });

      // ── Save Draft Button ───────────────────────────────
      document.getElementById('btn-save-draft').addEventListener('click', function() {
        saveDraft(false);
      });

      // ── Single-Tab Reusable Live Preview ────────────────
      document.getElementById('btn-preview').addEventListener('click', function() {
        syncMetaStateFromInputs();
        showToast('Preparing preview…', 'saving');

        fetch('/__article-studio/preview', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(currentDoc)
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.success) {
            window.open('/template-preview/article', 'coven-article-preview');
            showToast('Preview updated in tab', 'success');
          } else {
            showToast(data.error || 'Preview failed', 'error');
          }
        })
        .catch(function(err) {
          showToast('Preview error: ' + err.message, 'error');
        });
      });

      // ── Publish Action ──────────────────────────────────
      document.getElementById('btn-publish').addEventListener('click', function() {
        syncMetaStateFromInputs();

        // Validation
        if (currentDoc.meta.status !== 'published') {
          showToast('Set status to Published before publishing scroll', 'warning');
          return;
        }
        if (!currentDoc.meta.title || !currentDoc.meta.title.trim()) {
          showToast('Title is required to publish', 'error');
          document.getElementById('meta-title').focus();
          return;
        }

        var rawSlug = (currentDoc.slug || '').trim();
        if (!rawSlug) {
          showToast('Choose a URL slug before publishing this scroll.', 'error');
          document.getElementById('meta-slug').focus();
          return;
        }
        var finalSlug = normalizeSlugClient(rawSlug, false);
        if (!isValidSlugClient(finalSlug)) {
          showToast('Invalid slug. Must be lowercase alphanumeric characters and single hyphens.', 'error');
          document.getElementById('meta-slug').focus();
          return;
        }
        currentDoc.slug = finalSlug;

        // Collision validation against published articles
        var publishedArticles = window.STUDIO_PUBLISHED_ARTICLES || [];
        var matchSlug = publishedArticles.find(function(a) { return a.slug === finalSlug; });
        if (matchSlug) {
          if (matchSlug.studioId && matchSlug.studioId !== currentDoc.studioId) {
            showToast('This article URL is already in use.', 'error');
            return;
          }
        }

        if (!currentDoc.meta.category || !currentDoc.meta.category.trim()) {
          showToast('Choose an article category before publishing this scroll.', 'error');
          return;
        }
        if (!currentDoc.meta.difficulty) {
          showToast('Choose an article difficulty before publishing this scroll.', 'error');
          return;
        }
        if (currentDoc.sections.length === 0) {
          showToast('Add at least one section before publishing', 'error');
          return;
        }

        // Validate image alt texts and table minimums
        var errors = [];
        function validateBlockRecursive(blk, sIdx) {
          if (!blk || !blk.data) return;
          var d = blk.data;
          if ((d.src || d.imageSrc) && !d.alt) {
            errors.push('Section ' + (sIdx + 1) + ' (' + blk.type + '): Alt text is required for image.');
          }
          if (blk.type === 'technical-table') {
            if (!d.columns || d.columns.length === 0) {
              errors.push('Section ' + (sIdx + 1) + ' (technical-table): At least 1 column is required.');
            }
          }
          if (Array.isArray(d.blocks)) {
            d.blocks.forEach(function(cb) { validateBlockRecursive(cb, sIdx); });
          }
          if (Array.isArray(d.columns)) {
            d.columns.forEach(function(col) {
              if (Array.isArray(col.blocks)) {
                col.blocks.forEach(function(cb) { validateBlockRecursive(cb, sIdx); });
              }
            });
          }
        }
        currentDoc.sections.forEach(function(sec, sIdx) {
          (sec.blocks || []).forEach(function(blk) {
            validateBlockRecursive(blk, sIdx);
          });
        });

        if (errors.length > 0) {
          showToast(errors[0], 'error');
          return;
        }

        showToast('Publishing scroll to archives…', 'saving');
        fetch('/__article-studio/publish', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(currentDoc)
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.success) {
            isDirty = false;
            isExistingPublished = true;
            originalPublishedSlug = data.slug;
            setStatus('Published', 'saved');
            showToast('✦ Scroll published successfully: ' + data.slug, 'success');
            setTimeout(function() {
              window.open(data.articleUrl || ('/article/' + data.slug), 'coven-published-article');
            }, 1000);
          } else {
            showToast('Publish failed: ' + (data.error || 'Server error'), 'error');
          }
        })
        .catch(function(err) {
          showToast('Publish error: ' + err.message, 'error');
        });
      });

      // ── Initial Boot ────────────────────────────────────
      initLibrary();
      initCategoryCombobox();
      initDifficultyDropdown();
      initTagsCombobox();
      initCustomColorPicker();

      // Restore draft from URL query, lastDraftId, or create new
      var urlParams = new URLSearchParams(window.location.search);
      var paramDraftId = urlParams.get('draft');
      var paramNew = urlParams.get('new');

      if (paramDraftId) {
        openDraft(paramDraftId);
      } else if (paramNew === '1') {
        createNewArticle();
      } else {
        var lastDraftId = null;
        try {
          lastDraftId = localStorage.getItem('covenArticleStudio:lastDraftId');
        } catch (e) {}

        if (lastDraftId) {
          fetch('/__article-studio/drafts/' + lastDraftId)
            .then(function(res) {
              if (res.ok) return res.json();
              throw new Error('Not found');
            })
            .then(function(doc) {
              normalizeDocument(doc);
              currentDoc = doc;
              activeSectionId = doc.sections.length > 0 ? doc.sections[0].id : null;
              renderSections();
              syncMetaInputsFromState();
              setStatus('Draft restored', 'saved');
            })
            .catch(function() {
              createNewArticle();
            });
        } else {
          createNewArticle();
        }
      }

      // Expose state globally for browser QA automation
      window.currentDoc = currentDoc;
      window.resolveBlockLocation = resolveBlockLocation;
      window.renderSections = renderSections;
      window.renderMetadata = syncMetaInputsFromState;
      window.calculateReadingTime = calculateReadingTime;
      window.saveDraft = saveDraft;
      window.sanitizeRichText = sanitizeRichText;
      window.applyColorClass = applyColorClass;
      window.applyBgClass = applyBgClass;
      window.getSavedColors = getSavedColors;
      window.saveColorToPalette = saveColorToPalette;
      window.removeColorFromPalette = removeColorFromPalette;
      window.closeAllPopovers = closeAllPopovers;
      window.openCustomColorPicker = openCustomColorPicker;
      window.normalizeHex = normalizeHex;

    })();
  </script>

</body>
</html>
