              '<button type="button" class="studio-btn studio-btn--sm table-style-toggle-btn' + (isStylePanelOpen ? ' is-active' : '') + '" data-table-v2-act="toggle-style-panel">✦ Table Style: ' + escapeHtml(activePresetObj.name) + ' ' + (isStylePanelOpen ? '▴' : '▾') + '</button>' +
            '</div>' +
