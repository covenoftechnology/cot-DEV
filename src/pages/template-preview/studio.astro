                '<div style="display:flex;gap:6px">' +
                  '<button type="button" class="studio-btn studio-btn--sm" data-act="trigger-upload" data-img-prop="' + propPrefix + '">Replace</button>' +
                  '<button type="button" class="studio-btn studio-btn--sm studio-btn--danger" data-act="remove-image" data-img-prop="' + propPrefix + '">Remove</button>' +
                '</div>' +
              '</div>' +
              '<div class="studio-form-group">' +
                '<label class="studio-label">Alt Text *</label>' +
                '<input type="text" class="studio-input" data-img-subfield="alt" data-img-prop="' + propPrefix + '" value="' + escapeHtml(alt) + '" placeholder="Required descriptive text for accessibility" />' +
              '</div>' +
              (showCaption ? (
                captionAttr ?
                  renderRichTextFieldHtml('Caption (Optional)', captionAttr, caption, 'Figure · Diagram explanation...') :
                  ('<div class="studio-form-group">' +
                    '<label class="studio-label">Caption (Optional)</label>' +
                    '<input type="text" class="studio-input" data-img-subfield="caption" data-img-prop="' + propPrefix + '" value="' + escapeHtml(caption) + '" placeholder="Figure · Diagram explanation..." />' +
                  '</div>')
              ) : '') +
            '</div>' +
          '</div>'
        );
      }

      // ── Block Library Initialization ────────────────────
      function initLibrary() {
        var container = document.getElementById('palette-categories-container');
        if (!container) return;
        container.innerHTML = '';

        var firstCategory = true;

        window.STUDIO_CATEGORIES.forEach(function(cat) {
          var accordion = document.createElement('div');
          accordion.className = 'category-accordion' + (firstCategory ? ' open' : '');
          firstCategory = false;
          accordion.setAttribute('data-category', cat);

          var header = document.createElement('button');
          header.type = 'button';
          header.className = 'category-accordion-header';

          var matchingBlocks = Object.values(window.STUDIO_REGISTRY).filter(function(b) {
            return b.category === cat && isInsertablePaletteBlock(b);
          });

          header.innerHTML =
            '<div class="category-accordion-title">' +
              '<span class="category-arrow">▸</span>' +
              '<span>' + escapeHtml(cat) + '</span>' +
            '</div>' +
            '<span class="category-items-count">' + matchingBlocks.length + '</span>';

          header.addEventListener('click', function() {
            accordion.classList.toggle('open');
          });

          var body = document.createElement('div');
          body.className = 'category-accordion-body';

          matchingBlocks.forEach(function(blk) {
            var card = document.createElement('div');
            card.className = 'library-block-card';
            card.setAttribute('draggable', 'true');
            card.setAttribute('data-block-type', blk.type);
            card.setAttribute('data-keywords', (blk.label + ' ' + blk.description + ' ' + blk.category).toLowerCase());

            var glyph = BLOCK_GLYPHS[blk.type] || '✦';

            card.innerHTML =
              '<div class="lib-card-handle" title="Drag to insert into section">⋮⋮</div>' +
              '<div class="lib-card-glyph">' + glyph + '</div>' +
              '<div class="lib-card-content">' +
                '<div class="lib-card-title">' + escapeHtml(blk.label) + '</div>' +
                '<div class="lib-card-desc">' + escapeHtml(blk.description) + '</div>' +
              '</div>' +
              '<button type="button" class="studio-btn studio-btn--insert" data-block-type="' + blk.type + '" title="Insert into active section">+ Insert</button>';

            card.querySelector('.studio-btn--insert').addEventListener('click', function(e) {
              e.stopPropagation();
              addBlockToActiveSection(blk.type);
            });

            card.addEventListener('click', function() {
              addBlockToActiveSection(blk.type);
            });

            card.addEventListener('dragstart', function(e) {
              draggedBlockData = { source: 'library', type: blk.type };
              e.dataTransfer.setData('text/plain', JSON.stringify(draggedBlockData));
              e.dataTransfer.effectAllowed = 'copy';
              startDragAutoScroll();
            });

            card.addEventListener('dragend', function() {
              draggedBlockData = null;
              stopDragAutoScroll();
            });

            body.appendChild(card);
          });

          accordion.appendChild(header);
          accordion.appendChild(body);
          container.appendChild(accordion);
        });
      }

      // Search Filter & Clear Control
      var librarySearchInput = document.getElementById('library-search-input');
      var librarySearchClearBtn = document.getElementById('library-search-clear');

      function updateLibrarySearchClearBtn() {
        if (!librarySearchClearBtn || !librarySearchInput) return;
        librarySearchClearBtn.style.display = librarySearchInput.value ? 'flex' : 'none';
      }

      function clearLibrarySearch() {
        if (!librarySearchInput) return;
        librarySearchInput.value = '';
        updateLibrarySearchClearBtn();
        librarySearchInput.dispatchEvent(new Event('input', { bubbles: true }));
        librarySearchInput.focus();
      }

      if (librarySearchClearBtn) {
        librarySearchClearBtn.addEventListener('click', function(e) {
          e.preventDefault();
          clearLibrarySearch();
        });
      }

      if (librarySearchInput) {
        librarySearchInput.addEventListener('keydown', function(e) {
          if (e.key === 'Escape' && librarySearchInput.value) {
            e.preventDefault();
            e.stopPropagation();
            clearLibrarySearch();
          }
        });

        librarySearchInput.addEventListener('input', function(e) {
          updateLibrarySearchClearBtn();
          var query = (e.target.value || '').trim().toLowerCase();
          var accordions = document.querySelectorAll('.category-accordion');

          accordions.forEach(function(acc) {
            var cards = acc.querySelectorAll('.library-block-card');
            var hasMatch = false;

            cards.forEach(function(c) {
              var kw = c.getAttribute('data-keywords') || '';
              if (!query || kw.includes(query)) {
                c.style.display = 'flex';
                hasMatch = true;
              } else {
                c.style.display = 'none';
              }
            });

            if (query) {
              if (hasMatch) {
                acc.style.display = 'block';
                acc.classList.add('open');
              } else {
                acc.style.display = 'none';
              }
            } else {
              acc.style.display = 'block';
            }
          });
        });
      }

      // ── Sections Management ─────────────────────────────
      function addSection(title) {
        var secId = uid('sec');
        var secTitle = title || ('Section ' + (currentDoc.sections.length + 1));
        var newSec = {
          id: secId,
          title: secTitle,
          kicker: '',
          heading: '',
          blocks: []
        };
        currentDoc.sections.push(newSec);
        activeSectionId = secId;
        renderSections();
        triggerAutosave();
        showToast('Section added: ' + secTitle);
      }

      function duplicateSection(secId) {
        var idx = currentDoc.sections.findIndex(function(s) { return s.id === secId; });
        if (idx === -1) return;
        var original = currentDoc.sections[idx];
        var copy = JSON.parse(JSON.stringify(original));
        copy.id = uid('sec');
        copy.title = copy.title + ' — Copy';
        copy.blocks.forEach(function(b) {
          b.id = uid('blk');
          regenerateBlockNestedIds(b);
        });
        currentDoc.sections.splice(idx + 1, 0, copy);
        activeSectionId = copy.id;
        renderSections();
        triggerAutosave();
        showToast('Section duplicated');
      }

      // ── Inline Delete Confirmation (Section & Block) ────
      var activeInlineDelete = null;

      function closeInlineDelete() {
        if (!activeInlineDelete) return null;
        var prevTrigger = activeInlineDelete.triggerBtn;
        if (activeInlineDelete.popoverEl && activeInlineDelete.popoverEl.parentNode) {
          activeInlineDelete.popoverEl.parentNode.removeChild(activeInlineDelete.popoverEl);
        }
        activeInlineDelete = null;
        return prevTrigger;
      }

      function positionInlineConfirmation(triggerBtn, popoverEl) {
        if (!triggerBtn || !popoverEl) return;
        var rect = triggerBtn.getBoundingClientRect();
        var popoverWidth = popoverEl.offsetWidth || 230;
        var popoverHeight = popoverEl.offsetHeight || 68;

        // Position horizontally: align right edge of popover with right edge of triggerBtn
        var left = rect.right - popoverWidth;
        if (left < 10) {
          left = Math.max(10, rect.left);
        }
        if (left + popoverWidth > window.innerWidth - 10) {
          left = Math.max(10, window.innerWidth - popoverWidth - 10);
        }

        // Position vertically: default directly below with 6px gap
        var top = rect.bottom + 6;
        var scrollParent = triggerBtn.closest ? triggerBtn.closest('#drafts-list') : null;
        var maxBottom = window.innerHeight - 10;
        if (scrollParent) {
          var pRect = scrollParent.getBoundingClientRect();
          maxBottom = Math.min(maxBottom, pRect.bottom + 20);
        }
        if (top + popoverHeight > maxBottom) {
          // Flip above button if not enough room below
          top = Math.max(10, rect.top - popoverHeight - 6);
        }

        popoverEl.style.left = Math.round(left) + 'px';
        popoverEl.style.top = Math.round(top) + 'px';
      }

      function handleInlineDeleteScrollOrResize() {
        if (activeInlineDelete && activeInlineDelete.triggerBtn && activeInlineDelete.popoverEl) {
          if (!document.body.contains(activeInlineDelete.triggerBtn)) {
            closeInlineDelete();
            return;
          }
          var rect = activeInlineDelete.triggerBtn.getBoundingClientRect();
          if (rect.bottom < 0 || rect.top > window.innerHeight) {
            closeInlineDelete();
            return;
          }
          var scrollParent = activeInlineDelete.triggerBtn.closest ? activeInlineDelete.triggerBtn.closest('#drafts-list') : null;
          if (scrollParent) {
            var pRect = scrollParent.getBoundingClientRect();
            if (rect.bottom < pRect.top || rect.top > pRect.bottom) {
              closeInlineDelete();
              return;
            }
          }
          positionInlineConfirmation(activeInlineDelete.triggerBtn, activeInlineDelete.popoverEl);
        }
      }

      function showInlineDelete(triggerBtn, title, subtitle, onConfirm) {
        // Toggle: clicking same trigger again closes it
        if (activeInlineDelete && activeInlineDelete.triggerBtn === triggerBtn) {
          closeInlineDelete();
          return;
        }

        closeInlineDelete();

        if (!triggerBtn) {
          if (confirm(title)) onConfirm();
          return;
        }

        var popover = document.createElement('div');
        popover.className = 'delete-confirm-inline';
        popover.setAttribute('role', 'dialog');
        popover.setAttribute('aria-modal', 'false');
        popover.setAttribute('aria-label', title);

        var content = document.createElement('div');
        content.className = 'delete-confirm-inline__content';

        var titleEl = document.createElement('div');
        titleEl.className = 'delete-confirm-inline__title';
        titleEl.textContent = title;
        content.appendChild(titleEl);

        if (subtitle) {
          var subtitleEl = document.createElement('div');
          subtitleEl.className = 'delete-confirm-inline__subtitle';
          subtitleEl.textContent = subtitle;
          content.appendChild(subtitleEl);
        }

        var actions = document.createElement('div');
        actions.className = 'delete-confirm-inline__actions';

        var cancelBtn = document.createElement('button');
        cancelBtn.type = 'button';
        cancelBtn.className = 'studio-btn studio-btn--sm delete-confirm-cancel';
        cancelBtn.textContent = 'Cancel';
        cancelBtn.setAttribute('aria-label', 'Cancel deletion');

        var deleteBtn = document.createElement('button');
        deleteBtn.type = 'button';
        deleteBtn.className = 'studio-btn studio-btn--sm studio-btn--danger delete-confirm-proceed';
        deleteBtn.textContent = 'Delete';
        deleteBtn.setAttribute('aria-label', 'Confirm deletion');

        actions.appendChild(cancelBtn);
        actions.appendChild(deleteBtn);
        content.appendChild(actions);
        popover.appendChild(content);

        var studioRoot = document.querySelector('.coven-studio') || document.body;
        studioRoot.appendChild(popover);

        activeInlineDelete = {
          triggerBtn: triggerBtn,
          popoverEl: popover,
          onConfirm: onConfirm
        };

        positionInlineConfirmation(triggerBtn, popover);

        cancelBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          var prev = closeInlineDelete();
          if (prev) prev.focus();
        });

        deleteBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          closeInlineDelete();
          if (typeof onConfirm === 'function') {
            onConfirm();
          }
        });

        setTimeout(function() {
          cancelBtn.focus();
        }, 10);
      }

      // ── Drag Auto-Scroll Coordinator ───────────────────────────
      var dragAutoScrollState = {
        isDragging: false,
        clientX: 0,
        clientY: 0,
        activeFlexCanvas: null,
        rafId: null
      };

      function startDragAutoScroll() {
        dragAutoScrollState.isDragging = true;
        if (!dragAutoScrollState.rafId) {
          dragAutoScrollState.rafId = requestAnimationFrame(dragAutoScrollLoop);
        }
      }

      function stopDragAutoScroll() {
        dragAutoScrollState.isDragging = false;
        dragAutoScrollState.activeFlexCanvas = null;
        if (dragAutoScrollState.rafId) {
          cancelAnimationFrame(dragAutoScrollState.rafId);
          dragAutoScrollState.rafId = null;
        }
        document.querySelectorAll('.drag-target-above, .drag-target-below, .drag-target-forbidden, .drag-over').forEach(function(el) {
          el.classList.remove('drag-target-above', 'drag-target-below', 'drag-target-forbidden', 'drag-over');
        });
      }

      function updateDragTargetUnderPointer(x, y) {
        if (!x || !y) return;
        var el = document.elementFromPoint(x, y);
        if (!el) return;

        // Check if inside a Callout Composable Content panel
        var calloutPanel = el.closest('.studio-callout-blocks-panel');
        if (calloutPanel) {
          document.querySelectorAll('.studio-callout-blocks-panel.drag-over').forEach(function(p) {
            if (p !== calloutPanel) p.classList.remove('drag-over');
          });
          calloutPanel.classList.add('drag-over');
          document.querySelectorAll('.block-editor-card.drag-target-above, .block-editor-card.drag-target-below').forEach(function(c) {
            if (!calloutPanel.contains(c)) {
              c.classList.remove('drag-target-above', 'drag-target-below');
            }
          });
          var cBlocks = calloutPanel.querySelector('.studio-callout-blocks');
          if (!cBlocks) return;
          var cChildCards = Array.from(cBlocks.querySelectorAll(':scope > .block-editor-card'));
          if (cChildCards.length === 0) {
            var cEmptyDz = cBlocks.querySelector('.studio-callout-empty-dropzone');
            if (cEmptyDz) cEmptyDz.classList.add('drag-over');
          } else {
            for (var ci = 0; ci < cChildCards.length; ci++) {
              var cr = cChildCards[ci].getBoundingClientRect();
              var cmid = cr.top + cr.height / 2;
              cChildCards[ci].classList.remove('drag-target-above', 'drag-target-below');
              if (y < cmid) {
                cChildCards[ci].classList.add('drag-target-above');
                break;
              } else if (ci === cChildCards.length - 1) {
                cChildCards[ci].classList.add('drag-target-below');
              }
            }
          }
          return;
        }

        document.querySelectorAll('.studio-callout-blocks-panel.drag-over').forEach(function(p) {
          p.classList.remove('drag-over');
        });

        // Check if inside a Flexible Layout column
        var flexCol = el.closest('.studio-flex-col-panel');
        if (flexCol) {
          document.querySelectorAll('.studio-flex-col-panel.drag-over').forEach(function(p) {
            if (p !== flexCol) p.classList.remove('drag-over');
          });
          flexCol.classList.add('drag-over');
          document.querySelectorAll('.block-editor-card.drag-target-above, .block-editor-card.drag-target-below').forEach(function(c) {
            if (!flexCol.contains(c)) {
              c.classList.remove('drag-target-above', 'drag-target-below');
            }
          });
          var colBlocks = flexCol.querySelector('.studio-flex-col-blocks');
          if (!colBlocks) return;
          var childCards = Array.from(colBlocks.querySelectorAll(':scope > .block-editor-card'));
          if (childCards.length === 0) {
            var emptyDz = colBlocks.querySelector('.studio-flex-empty-dropzone');
            if (emptyDz) emptyDz.classList.add('drag-over');
          } else {
            for (var i = 0; i < childCards.length; i++) {
              var r = childCards[i].getBoundingClientRect();
              var mid = r.top + r.height / 2;
              childCards[i].classList.remove('drag-target-above', 'drag-target-below');
              if (y < mid) {
                childCards[i].classList.add('drag-target-above');
                break;
              } else if (i === childCards.length - 1) {
                childCards[i].classList.add('drag-target-below');
              }
            }
          }
          return;
        }

        document.querySelectorAll('.studio-flex-col-panel.drag-over').forEach(function(p) {
          p.classList.remove('drag-over');
        });

        // Section root level card
        var card = el.closest('.block-editor-card');
        if (card && !card.classList.contains('is-flex-child') && !card.classList.contains('is-callout-child')) {
          var rect = card.getBoundingClientRect();
          var midY = rect.top + rect.height / 2;
          document.querySelectorAll('.drag-target-above, .drag-target-below').forEach(function(c) {
            if (c !== card) c.classList.remove('drag-target-above', 'drag-target-below');
          });
          if (y < midY) {
            card.classList.add('drag-target-above');
            card.classList.remove('drag-target-below');
          } else {
            card.classList.add('drag-target-below');
            card.classList.remove('drag-target-above');
          }
        }
      }

      function dragAutoScrollLoop() {
        if (!dragAutoScrollState.isDragging) {
          dragAutoScrollState.rafId = null;
          return;
        }

        var centerPane = document.querySelector('.studio-center-pane');
        var didScroll = false;

        // 1. Vertical Auto-Scroll on .studio-center-pane
        if (centerPane && dragAutoScrollState.clientY > 0) {
          var paneRect = centerPane.getBoundingClientRect();
          var cx = dragAutoScrollState.clientX;
          var cy = dragAutoScrollState.clientY;

          if (cx >= paneRect.left && cx <= paneRect.right) {
            var topEdge = paneRect.top;
            var bottomEdge = paneRect.bottom;
            var edgeZone = 80;

            if (cy >= topEdge && cy <= topEdge + edgeZone) {
              var ratio = 1 - ((cy - topEdge) / edgeZone);
              var speed = Math.ceil(3 + ratio * 20);
              if (centerPane.scrollTop > 0) {
                centerPane.scrollTop = Math.max(0, centerPane.scrollTop - speed);
                didScroll = true;
              }
            } else if (cy >= bottomEdge - edgeZone && cy <= bottomEdge) {
              var ratio = 1 - ((bottomEdge - cy) / edgeZone);
              var speed = Math.ceil(3 + ratio * 20);
              var maxScroll = centerPane.scrollHeight - centerPane.clientHeight;
              if (centerPane.scrollTop < maxScroll) {
                centerPane.scrollTop = Math.min(maxScroll, centerPane.scrollTop + speed);
                didScroll = true;
              }
            }
          }
        }

        // 2. Local Horizontal Auto-Scroll on active Flexible Layout canvas
        var flexCanvas = dragAutoScrollState.activeFlexCanvas;
        if (flexCanvas && flexCanvas.isConnected) {
          var cRect = flexCanvas.getBoundingClientRect();
          var fx = dragAutoScrollState.clientX;
          var fy = dragAutoScrollState.clientY;

          if (fy >= cRect.top && fy <= cRect.bottom) {
            var hZone = 80;
            if (fx >= cRect.left && fx <= cRect.left + hZone) {
              var ratio = 1 - ((fx - cRect.left) / hZone);
              var hSpeed = Math.ceil(3 + ratio * 18);
              if (flexCanvas.scrollLeft > 0) {
                flexCanvas.scrollLeft = Math.max(0, flexCanvas.scrollLeft - hSpeed);
                didScroll = true;
              }
            } else if (fx >= cRect.right - hZone && fx <= cRect.right) {
              var ratio = 1 - ((cRect.right - fx) / hZone);
              var hSpeed = Math.ceil(3 + ratio * 18);
              var maxH = flexCanvas.scrollWidth - flexCanvas.clientWidth;
              if (flexCanvas.scrollLeft < maxH) {
                flexCanvas.scrollLeft = Math.min(maxH, flexCanvas.scrollLeft + hSpeed);
                didScroll = true;
              }
            }
          }
        }

        if (didScroll) {
          updateDragTargetUnderPointer(dragAutoScrollState.clientX, dragAutoScrollState.clientY);
        }

        dragAutoScrollState.rafId = requestAnimationFrame(dragAutoScrollLoop);
      }

      window.addEventListener('dragover', function(e) {
        if (!dragAutoScrollState.isDragging && !draggedBlockData) return;
        dragAutoScrollState.clientX = e.clientX;
        dragAutoScrollState.clientY = e.clientY;
        dragAutoScrollState.activeFlexCanvas = e.target ? e.target.closest('.studio-flex-canvas-wrap') : null;
        if (!dragAutoScrollState.isDragging && draggedBlockData) {
          startDragAutoScroll();
        }
      }, { passive: true });

      window.addEventListener('dragend', stopDragAutoScroll);
      window.addEventListener('drop', stopDragAutoScroll);

      window.addEventListener('resize', function() {
        handleInlineDeleteScrollOrResize();
        closeAllPopovers();
      }, { passive: true });
      window.addEventListener('scroll', function() {
        handleInlineDeleteScrollOrResize();
        closeAllPopovers();
      }, { capture: true, passive: true });

      document.addEventListener('mousedown', function(e) {
        if (activeInlineDelete) {
          if (!activeInlineDelete.popoverEl || !activeInlineDelete.popoverEl.contains(e.target)) {
            if (!activeInlineDelete.triggerBtn || !activeInlineDelete.triggerBtn.contains(e.target)) {
              closeInlineDelete();
            }
          }
        }

        var openPop = document.querySelector('.rich-color-menu[style*="display: flex"], .rich-color-menu[style*="display: block"], .rich-highlight-menu[style*="display: flex"], .rich-highlight-menu[style*="display: block"], .rich-link-popover[style*="display: flex"], .coven-custom-color-popover[style*="display: block"], .coven-custom-color-popover[style*="display: flex"], .nested-marker-dropdown[style*="display: flex"], .nested-marker-dropdown[style*="display: block"]');
        if (openPop && !openPop.contains(e.target)) {
          var isTrigger = e.target.closest('.rich-btn-color, .rich-btn-highlight, .rich-btn-link, .nested-marker-trigger, .callout-accent-custom-btn');
          if (!isTrigger) {
            closeAllPopovers();
          }
        }
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          closeAllPopovers();
          if (activeInlineDelete) {
            e.stopPropagation();
            e.stopImmediatePropagation();
            var prev = closeInlineDelete();
            if (prev) prev.focus();
          }
        }
      }, true);

      function deleteSection(secId, triggerBtn) {
        var sec = currentDoc.sections.find(function(s) { return s.id === secId; });
        if (!sec) return;

        var subtitle = sec.blocks.length === 1 ? 'Contains 1 block.' : ('Contains ' + sec.blocks.length + ' block(s).');

        showInlineDelete(
          triggerBtn,
          'Delete section?',
          subtitle,
          function() {
            currentDoc.sections = currentDoc.sections.filter(function(s) { return s.id !== secId; });
            if (activeSectionId === secId) {
              activeSectionId = currentDoc.sections.length > 0 ? currentDoc.sections[0].id : null;
            }
            renderSections();
            triggerAutosave();
            showToast('Section deleted');
          }
        );
      }

      function moveSection(secId, direction) {
        var idx = currentDoc.sections.findIndex(function(s) { return s.id === secId; });
        if (idx === -1) return;
        var targetIdx = idx + direction;
        if (targetIdx < 0 || targetIdx >= currentDoc.sections.length) return;
        var temp = currentDoc.sections[idx];
        currentDoc.sections[idx] = currentDoc.sections[targetIdx];
        currentDoc.sections[targetIdx] = temp;
        renderSections();
        triggerAutosave();
      }

      // ── Blocks Management ───────────────────────────────
      function addBlockToActiveSection(type, secId) {
        if (currentDoc.sections.length === 0) {
          addSection('Primary Section');
        }
        var targetSecId = secId || activeSectionId || (currentDoc.sections[0] ? currentDoc.sections[0].id : null);
        var sec = currentDoc.sections.find(function(s) { return s.id === targetSecId; }) || currentDoc.sections[0];
        if (!sec) return;

        var def = window.STUDIO_REGISTRY[type];
        if (!def) return;

        var newBlock = {
          id: uid('blk'),
          type: type,
          data: JSON.parse(JSON.stringify(def.defaultData))
        };
        if (type === 'flex-layout') {
          newBlock.data.columns = [
            { id: uid('fcol'), blocks: [] },
            { id: uid('fcol'), blocks: [] }
          ];
        }
        if (type === 'callout') {
          newBlock.data.blocks = [
            {
              id: uid('blk'),
              type: 'solo-text',
              data: { paragraphs: [''] }
            }
          ];
        }
        sec.blocks.push(newBlock);
        normalizeDocument(currentDoc);
        currentDoc = normalizeDocument(currentDoc);
        activeSectionId = sec.id;
        renderSections();
        triggerAutosave();
        showToast('Inserted: ' + def.label);
      }

      function regenerateBlockNestedIds(block) {
        if (!block || !block.data) return;
        var d = block.data;
        if (block.type === 'nested-bullets' && Array.isArray(d.items)) {
          d.items.forEach(function(l1) {
            l1.id = uid('main');
            if (Array.isArray(l1.children)) {
              l1.children.forEach(function(l2) {
                l2.id = uid('sub');
                if (Array.isArray(l2.children)) {
                  l2.children.forEach(function(l3) { l3.id = uid('fl3'); });
                }
              });
            }
          });
        } else if (block.type === 'numbered-steps' && Array.isArray(d.steps)) {
          d.steps.forEach(function(s) { s.id = uid('step'); });
        } else if (block.type === 'bullet-list' && Array.isArray(d.items)) {
          d.items.forEach(function(it) { it.id = uid('item'); });
        } else if (block.type === 'gallery-scroll' && Array.isArray(d.cards)) {
          d.cards.forEach(function(c) { c.id = uid('gcard'); });
        } else if (block.type === 'faq' && Array.isArray(d.items)) {
          d.items.forEach(function(it) { it.id = uid('faq'); });
        } else if (block.type === 'technical-table' && Array.isArray(d.rows)) {
          d.rows.forEach(function(r) { r.id = uid('row'); });
        } else if (block.type === 'related-docs' && Array.isArray(d.items)) {
          d.items.forEach(function(rd) { rd.id = uid('rd'); });
        } else if (block.type === 'key-takeaways' && Array.isArray(d.items)) {
          d.items.forEach(function(it) { it.id = uid('kt'); });
        } else if (block.type === 'callout' && Array.isArray(d.blocks)) {
          d.blocks.forEach(function(cb) {
            cb.id = uid('blk');
            regenerateBlockNestedIds(cb);
          });
        } else if (block.type === 'flex-layout' && Array.isArray(d.columns)) {
          d.columns.forEach(function(col) {
            col.id = uid('fcol');
            if (Array.isArray(col.blocks)) {
              col.blocks.forEach(function(cb) {
                cb.id = uid('blk');
                regenerateBlockNestedIds(cb);
              });
            }
          });
        }
      }

      function resolveBlockLocation(blockId) {
        if (!blockId || !currentDoc || !Array.isArray(currentDoc.sections)) return null;
        for (var s = 0; s < currentDoc.sections.length; s++) {
          var sec = currentDoc.sections[s];
          if (!Array.isArray(sec.blocks)) continue;
          for (var b = 0; b < sec.blocks.length; b++) {
            var blk = sec.blocks[b];
            if (blk.id === blockId) {
              return {
                block: blk,
                section: sec,
                parentType: 'section',
                parentBlockId: null,
                columnId: null
              };
            }
            if (blk.type === 'callout' && blk.data && Array.isArray(blk.data.blocks)) {
              var calloutBlocks = blk.data.blocks;
              for (var cb = 0; cb < calloutBlocks.length; cb++) {
                if (calloutBlocks[cb].id === blockId) {
                  return {
                    block: calloutBlocks[cb],
                    section: sec,
                    parentType: 'callout',
                    parentBlockId: blk.id,
                    columnId: null
                  };
                }
              }
            }
            if (blk.type === 'flex-layout' && blk.data && Array.isArray(blk.data.columns)) {
              var cols = blk.data.columns;
              for (var c = 0; c < cols.length; c++) {
                var cBlocks = cols[c].blocks || [];
                for (var cb = 0; cb < cBlocks.length; cb++) {
                  if (cBlocks[cb].id === blockId) {
                    return {
                      block: cBlocks[cb],
                      section: sec,
                      parentType: 'flex-col',
                      parentBlockId: blk.id,
                      columnId: cols[c].id
                    };
                  }
                  if (cBlocks[cb].type === 'callout' && cBlocks[cb].data && Array.isArray(cBlocks[cb].data.blocks)) {
                    var cChildren = cBlocks[cb].data.blocks;
                    for (var ck = 0; ck < cChildren.length; ck++) {
                      if (cChildren[ck].id === blockId) {
                        return {
                          block: cChildren[ck],
                          section: sec,
                          parentType: 'callout',
                          parentBlockId: cBlocks[cb].id,
                          columnId: null
                        };
                      }
                    }
                  }
                }
              }
            }
          }
        }
        return null;
      }

      function findBlockById(blockId) {
        var loc = resolveBlockLocation(blockId);
        return loc ? loc.block : null;
      }

      function isDraggingFlexLayout() {
        if (!draggedBlockData) return false;
        if (draggedBlockData.source === 'library') {
          return draggedBlockData.type === 'flex-layout';
        }
        if (draggedBlockData.source === 'block') {
          if (draggedBlockData.type) {
            return draggedBlockData.type === 'flex-layout';
          }
          if (draggedBlockData.blockType) {
            return draggedBlockData.blockType === 'flex-layout';
          }
          var b = findBlockById(draggedBlockData.blockId);
          return b && b.type === 'flex-layout';
        }
        return false;
      }

      function isDraggingForbiddenInCallout() {
        if (!draggedBlockData) return false;
        var type = draggedBlockData.type || draggedBlockData.blockType;
        if (!type && draggedBlockData.blockId) {
          var b = findBlockById(draggedBlockData.blockId);
          type = b ? b.type : '';
        }
        return !canNestInCallout(type);
      }

      function duplicateBlock(secId, blockId) {
        var sec = currentDoc.sections.find(function(s) { return s.id === secId; });
        if (!sec) return;
        var bIdx = sec.blocks.findIndex(function(b) { return b.id === blockId; });
        if (bIdx === -1) return;
        var original = sec.blocks[bIdx];
        var copy = JSON.parse(JSON.stringify(original));
        copy.id = uid('blk');
        if (copy.type === 'flex-layout' && copy.data && Array.isArray(copy.data.columns)) {
          copy.data.columns = copy.data.columns.map(function(c) {
            return {
              id: uid('fcol'),
              blocks: (c.blocks || []).map(function(child) {
                var childCopy = JSON.parse(JSON.stringify(child));
                childCopy.id = uid('blk');
                regenerateBlockNestedIds(childCopy);
                return childCopy;
              })
            };
          });
        } else if (copy.type === 'callout' && copy.data && Array.isArray(copy.data.blocks)) {
          copy.data.blocks = copy.data.blocks.map(function(child) {
            var childCopy = JSON.parse(JSON.stringify(child));
            childCopy.id = uid('blk');
            regenerateBlockNestedIds(childCopy);
            return childCopy;
          });
        } else {
          regenerateBlockNestedIds(copy);
        }
        sec.blocks.splice(bIdx + 1, 0, copy);
        activeSectionId = secId;
        renderSections();
        triggerAutosave();
        showToast('Block duplicated');
      }

      function deleteBlock(secId, blockId, triggerBtn) {
        var sec = currentDoc.sections.find(function(s) { return s.id === secId; });
        if (!sec) return;
        var b = sec.blocks.find(function(blk) { return blk.id === blockId; });
        if (!b) return;

        var title = 'Delete block?';
        var subtitle = null;
        if (b.type === 'flex-layout' && b.data && Array.isArray(b.data.columns)) {
          var totalChildBlocks = 0;
          b.data.columns.forEach(function(col) {
            totalChildBlocks += (col.blocks || []).length;
          });
          if (totalChildBlocks > 0) {
            title = 'Delete Flexible Layout?';
            subtitle = 'Contains ' + totalChildBlocks + ' block' + (totalChildBlocks !== 1 ? 's' : '') + '.';
          }
        } else if (b.type === 'callout' && b.data && Array.isArray(b.data.blocks)) {
          var totalChildBlocks = b.data.blocks.length;
          if (totalChildBlocks > 0) {
            title = 'Delete Callout Advisory?';
            subtitle = 'Contains ' + totalChildBlocks + ' block' + (totalChildBlocks !== 1 ? 's' : '') + '.';
          }
        }

        showInlineDelete(
          triggerBtn,
          title,
          subtitle,
          function() {
            sec.blocks = sec.blocks.filter(function(blk) { return blk.id !== blockId; });
            renderSections();
            triggerAutosave();
            showToast('Block removed');
          }
        );
      }

      function moveFlexChild(secId, flexBlockId, colId, childBlockId, direction) {
        var sec = currentDoc.sections.find(function(s) { return s.id === secId; });
        if (!sec) return;
        var flexBlock = sec.blocks.find(function(b) { return b.id === flexBlockId; });
        if (!flexBlock || !flexBlock.data) return;
        var col = (flexBlock.data.columns || []).find(function(c) { return c.id === colId; });
        if (!col || !Array.isArray(col.blocks)) return;
        var idx = col.blocks.findIndex(function(b) { return b.id === childBlockId; });
        if (idx === -1) return;
        var targetIdx = idx + direction;
        if (targetIdx < 0 || targetIdx >= col.blocks.length) return;
        var temp = col.blocks[idx];
        col.blocks[idx] = col.blocks[targetIdx];
        col.blocks[targetIdx] = temp;
        renderSections();
        triggerAutosave();
      }

      function duplicateFlexChild(secId, flexBlockId, colId, childBlockId) {
        var sec = currentDoc.sections.find(function(s) { return s.id === secId; });
        if (!sec) return;
        var flexBlock = sec.blocks.find(function(b) { return b.id === flexBlockId; });
        if (!flexBlock || !flexBlock.data) return;
        var col = (flexBlock.data.columns || []).find(function(c) { return c.id === colId; });
        if (!col || !Array.isArray(col.blocks)) return;
        var idx = col.blocks.findIndex(function(b) { return b.id === childBlockId; });
        if (idx === -1) return;
        var original = col.blocks[idx];
        var copy = JSON.parse(JSON.stringify(original));
        copy.id = uid('blk');
        regenerateBlockNestedIds(copy);
        col.blocks.splice(idx + 1, 0, copy);
        renderSections();
        triggerAutosave();
        showToast('Block duplicated');
      }

      function deleteFlexChild(secId, flexBlockId, colId, childBlockId, triggerBtn) {
        var sec = currentDoc.sections.find(function(s) { return s.id === secId; });
        if (!sec) return;
        var flexBlock = sec.blocks.find(function(b) { return b.id === flexBlockId; });
        if (!flexBlock || !flexBlock.data) return;
        var col = (flexBlock.data.columns || []).find(function(c) { return c.id === colId; });
        if (!col || !Array.isArray(col.blocks)) return;

        showInlineDelete(
          triggerBtn,
          'Delete block?',
          null,
          function() {
            col.blocks = col.blocks.filter(function(b) { return b.id !== childBlockId; });
            renderSections();
            triggerAutosave();
            showToast('Block removed');
          }
        );
      }

      function moveCalloutChild(secId, calloutBlockId, childBlockId, direction) {
        var loc = resolveBlockLocation(calloutBlockId);
        var calloutBlock = loc ? loc.block : null;
        if (!calloutBlock || !calloutBlock.data) return;
        var blocks = calloutBlock.data.blocks;
        if (!Array.isArray(blocks)) return;
        var idx = blocks.findIndex(function(b) { return b.id === childBlockId; });
        if (idx === -1) return;
        var targetIdx = idx + direction;
        if (targetIdx < 0 || targetIdx >= blocks.length) return;
        var temp = blocks[idx];
        blocks[idx] = blocks[targetIdx];
        blocks[targetIdx] = temp;
        renderSections();
        triggerAutosave();
      }

      function duplicateCalloutChild(secId, calloutBlockId, childBlockId) {
        var loc = resolveBlockLocation(calloutBlockId);
        var calloutBlock = loc ? loc.block : null;
        if (!calloutBlock || !calloutBlock.data) return;
        var blocks = calloutBlock.data.blocks;
        if (!Array.isArray(blocks)) return;
        var idx = blocks.findIndex(function(b) { return b.id === childBlockId; });
        if (idx === -1) return;
        var original = blocks[idx];
        var copy = JSON.parse(JSON.stringify(original));
        copy.id = uid('blk');
        regenerateBlockNestedIds(copy);
        blocks.splice(idx + 1, 0, copy);
        renderSections();
        triggerAutosave();
        showToast('Block duplicated');
      }

      function deleteCalloutChild(secId, calloutBlockId, childBlockId, triggerBtn) {
        var loc = resolveBlockLocation(calloutBlockId);
        var calloutBlock = loc ? loc.block : null;
        if (!calloutBlock || !calloutBlock.data) return;
        var blocks = calloutBlock.data.blocks;
        if (!Array.isArray(blocks)) return;

        showInlineDelete(
          triggerBtn,
          'Delete block?',
          null,
          function() {
            calloutBlock.data.blocks = blocks.filter(function(b) { return b.id !== childBlockId; });
            renderSections();
            triggerAutosave();
            showToast('Block removed');
          }
        );
      }

      function moveBlock(secId, blockId, direction) {
        var sec = currentDoc.sections.find(function(s) { return s.id === secId; });
        if (!sec) return;
        var idx = sec.blocks.findIndex(function(b) { return b.id === blockId; });
        if (idx === -1) return;
        var targetIdx = idx + direction;
        if (targetIdx < 0 || targetIdx >= sec.blocks.length) return;
        var temp = sec.blocks[idx];
        sec.blocks[idx] = sec.blocks[targetIdx];
        sec.blocks[targetIdx] = temp;
        renderSections();
        triggerAutosave();
      }

      function moveBlockToSection(sourceSecId, blockId, targetSecId, insertIndex) {
        var srcSec = currentDoc.sections.find(function(s) { return s.id === sourceSecId; });
        var dstSec = currentDoc.sections.find(function(s) { return s.id === targetSecId; });
        if (!srcSec || !dstSec) return;

        var bIdx = srcSec.blocks.findIndex(function(b) { return b.id === blockId; });
        if (bIdx === -1) return;

        var [block] = srcSec.blocks.splice(bIdx, 1);
        if (insertIndex !== undefined && insertIndex >= 0) {
          dstSec.blocks.splice(insertIndex, 0, block);
        } else {
          dstSec.blocks.push(block);
        }

        activeSectionId = dstSec.id;
        renderSections();
        triggerAutosave();
        showToast('Block moved');
      }

