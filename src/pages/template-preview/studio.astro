                    if (!s.id) s.id = uid('step');
                    if (s.markerStyle) s.markerStyle = String(s.markerStyle).trim();
                    if (s.markerValue !== undefined && s.markerValue !== null) {
                      var cleanVal = window.sanitizeMarkerValue ? window.sanitizeMarkerValue(s.markerValue) : String(s.markerValue).trim();
                      if (cleanVal) s.markerValue = cleanVal;
                      else delete s.markerValue;
                    }
                    if (window.resolveListMarker) {
                      s.badge = window.resolveListMarker({
