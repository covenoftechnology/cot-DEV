        } else if (propPrefix === 'src') {
          dataObj.src = url;
        } else if (propPrefix === 'img1') {
          dataObj.img1Src = url;
        } else if (propPrefix === 'img2') {
          dataObj.img2Src = url;
        } else if (propPrefix === 'img3') {
          dataObj.img3Src = url;
        } else if (propPrefix.startsWith('gcard_')) {
          var cardId = propPrefix.replace('gcard_', '');
          var card = (dataObj.cards || []).find(function(c) { return c.id === cardId; });
          if (card) card.src = url;
        }
      }

      // ── Safe Section Activation (No DOM destruction) ─────
      function setActiveSection(secId) {
        if (activeSectionId === secId) return;
        activeSectionId = secId;
        var cards = document.querySelectorAll('.section-card');
        for (var i = 0; i < cards.length; i++) {
          var c = cards[i];
          var isCardActive = c.getAttribute('data-sec-id') === secId;
          c.classList.toggle('active-section', isCardActive);
          var leftHeader = c.querySelector('.section-header-left');
          if (leftHeader) {
            var existingBadge = leftHeader.querySelector('.section-toc-badge');
            if (isCardActive && !existingBadge) {
              var badge = document.createElement('span');
              badge.className = 'section-toc-badge';
              badge.textContent = 'TOC ACTIVE';
              leftHeader.appendChild(badge);
            } else if (!isCardActive && existingBadge) {
              existingBadge.remove();
            }
          }
        }
      }

      // ── CANONICAL GRID COMPOSER V2 ENGINE (4-Column Authoring) ────────
      var MAX_GRID_ROWS = 200;
      var MIN_GRID_ROWS = 3;
      window.MAX_GRID_ROWS = MAX_GRID_ROWS;
      window.MIN_GRID_ROWS = MIN_GRID_ROWS;

      var secGridHistories = {}; // secId -> { past: [], future: [] }
      var secActiveSlotIds = {}; // secId -> itemId | null
      var secGridInteractions = {}; // secId -> interaction state
      var activePlacement = null; // { blockType: string, widthSpan: number, explicitWidth: boolean, label: string }
      var activeMove = null; // { secId: string, itemId: string, item: object }
      var activeDuplicate = null; // { secId: string, sourceItemId: string, sourceItem: object, sourceBlock: object, columnSpan: number, rowSpan: number, verticalAlign: string, label: string }
      window.activePlacement = activePlacement;
      window.activeMove = activeMove;
      window.activeDuplicate = activeDuplicate;

      function clampVal(val, min, max) {
        return Math.min(Math.max(val, min), max);
      }

      function getItemLabel(item) {
        if (!item) return 'Block';
        var blk = item.block;
        if (blk && blk.type && window.STUDIO_REGISTRY && window.STUDIO_REGISTRY[blk.type]) {
          return window.STUDIO_REGISTRY[blk.type].label;
        }
        return (blk && blk.type) ? blk.type : 'Block';
      }
      window.getItemLabel = getItemLabel;

      function hasVisualGridSection(sec) {
        if (typeof window.hasVisualGrid === 'function') {
          return window.hasVisualGrid(sec);
        }
        return false;
      }
      window.hasVisualGridSection = hasVisualGridSection;

      function rectsOverlapCoords(r1, r2) {
        var r1ColStart = r1.columnStart || 1;
        var r1ColSpan = r1.columnSpan || 1;
        var r1ColEnd = r1ColStart + r1ColSpan;

        var r1RowStart = r1.rowStart || 1;
        var r1RowSpan = r1.rowSpan || 1;
        var r1RowEnd = r1RowStart + r1RowSpan;

        var r2ColStart = r2.columnStart || 1;
        var r2ColSpan = r2.columnSpan || 1;
        var r2ColEnd = r2ColStart + r2ColSpan;

        var r2RowStart = r2.rowStart || 1;
        var r2RowSpan = r2.rowSpan || 1;
        var r2RowEnd = r2RowStart + r2RowSpan;

        var colOverlap = Math.max(r1ColStart, r2ColStart) < Math.min(r1ColEnd, r2ColEnd);
        var rowOverlap = Math.max(r1RowStart, r2RowStart) < Math.min(r1RowEnd, r2RowEnd);
        return colOverlap && rowOverlap;
      }

      function checkSlotCollisionState(items, excludeId, rect) {
        if (!Array.isArray(items)) return false;
        for (var i = 0; i < items.length; i++) {
          var it = items[i];
          if (it.id === excludeId) continue;
          if (rectsOverlapCoords(it, rect)) return true;
        }
        return false;
      }
      window.checkSlotCollisionState = checkSlotCollisionState;

      function getSpanPercentageLabel(colSpan) {
        var s = clampVal(colSpan, 1, 4);
        switch (s) {
          case 1: return '25%';
          case 2: return '50%';
          case 3: return '75%';
          case 4: return '100%';
          default: return (s * 25) + '%';
        }
      }
      window.getSpanPercentageLabel = getSpanPercentageLabel;

      function resolvePlacementTarget(items, targetCol, targetRow, requestedSpan, explicitWidth, excludeItemId) {
        var col = clampVal(targetCol, 1, 4);
        var row = clampVal(targetRow, 1, MAX_GRID_ROWS);
        var reqSpan = clampVal(requestedSpan || 4, 1, 4);

        var contiguousFree = 0;
        for (var c = col; c <= 4; c++) {
          var singleCell = {
            columnStart: c,
            columnSpan: 1,
            rowStart: row,
            rowSpan: 1
          };
          if (checkSlotCollisionState(items, excludeItemId, singleCell)) {
            break;
          }
          contiguousFree++;
        }

        if (contiguousFree === 0) {
          return {
            valid: false,
            columnStart: col,
            columnSpan: reqSpan,
            rowStart: row,
            rowSpan: 1,
            contiguousFree: 0,
            autoFitApplied: false,
            reason: 'Space Occupied'
          };
        }

        if (explicitWidth) {
          if (contiguousFree >= reqSpan) {
            return {
              valid: true,
              columnStart: col,
              columnSpan: reqSpan,
              rowStart: row,
              rowSpan: 1,
              contiguousFree: contiguousFree,
              autoFitApplied: false
            };
          } else {
            return {
              valid: false,
              columnStart: col,
              columnSpan: reqSpan,
              rowStart: row,
              rowSpan: 1,
              contiguousFree: contiguousFree,
              autoFitApplied: false,
              reason: 'Needs ' + getSpanPercentageLabel(reqSpan) + ' · only ' + getSpanPercentageLabel(contiguousFree) + ' available'
            };
          }
        }

        if (contiguousFree >= reqSpan) {
          return {
            valid: true,
            columnStart: col,
            columnSpan: reqSpan,
            rowStart: row,
            rowSpan: 1,
            contiguousFree: contiguousFree,
            autoFitApplied: false
          };
        } else {
          return {
            valid: true,
            columnStart: col,
            columnSpan: contiguousFree,
            rowStart: row,
            rowSpan: 1,
            contiguousFree: contiguousFree,
            autoFitApplied: true,
            reason: getSpanPercentageLabel(contiguousFree) + ' · Auto-fit'
          };
        }
      }
      window.resolvePlacementTarget = resolvePlacementTarget;

      // ── ADDITIVE BLOCK REORDERING HELPERS (SWAP & INSERT-BETWEEN) ──
      function cloneGridItemsShallow(items) {
        if (!Array.isArray(items)) return [];
        return items.map(function(it) {
          return {
            id: it.id,
            columnStart: it.columnStart || 1,
            columnSpan: it.columnSpan || 1,
            rowStart: it.rowStart || 1,
            rowSpan: it.rowSpan || 1,
            verticalAlign: (it.verticalAlign === 'center' || it.verticalAlign === 'end') ? it.verticalAlign : 'start',
            block: it.block
          };
        });
      }

      function validateReorderCandidate(originalItems, candidateItems, options) {
        if (!Array.isArray(originalItems) || !Array.isArray(candidateItems)) {
          return { valid: false, isNoOp: false, reason: 'Invalid items list' };
        }
        var allowNewItemId = (options && options.allowNewItemId) ? options.allowNewItemId : null;
        var expectedLen = allowNewItemId ? (originalItems.length + 1) : originalItems.length;
        if (candidateItems.length !== expectedLen) {
          return { valid: false, isNoOp: false, reason: 'Item count mismatch' };
        }

        var origMap = {};
        for (var i = 0; i < originalItems.length; i++) {
          origMap[originalItems[i].id] = originalItems[i];
        }

        var seenIds = {};
        var isNoOp = true;

        for (var j = 0; j < candidateItems.length; j++) {
          var cand = candidateItems[j];
          if (!cand || typeof cand.id !== 'string' || seenIds[cand.id]) {
            return { valid: false, isNoOp: false, reason: 'Duplicate or invalid item ID' };
          }
          seenIds[cand.id] = true;

          var colStart = cand.columnStart;
          var colSpan = cand.columnSpan;
          var rowStart = cand.rowStart;
          var rowSpan = cand.rowSpan || 1;

          if (!Number.isInteger(colStart) || colStart < 1 || colStart > 4 ||
              !Number.isInteger(colSpan) || colSpan < 1 || colSpan > 4 ||
              (colStart + colSpan - 1) > 4) {
            return { valid: false, isNoOp: false, reason: 'Exceeds 4-column grid bounds' };
          }

          if (!Number.isInteger(rowStart) || rowStart < 1 || rowStart > MAX_GRID_ROWS ||
              !Number.isInteger(rowSpan) || rowSpan < 1 || rowSpan > MAX_GRID_ROWS ||
              (rowStart + rowSpan - 1) > MAX_GRID_ROWS) {
            return { valid: false, isNoOp: false, reason: 'Exceeds MAX_GRID_ROWS (' + MAX_GRID_ROWS + ')' };
          }

          if (allowNewItemId && cand.id === allowNewItemId) {
            isNoOp = false;
            continue;
          }

          var orig = origMap[cand.id];
          if (!orig) {
            return { valid: false, isNoOp: false, reason: 'Unknown item ID' };
          }

          if (!cand.block || !orig.block || cand.block.id !== orig.block.id || cand.block.type !== orig.block.type) {
            return { valid: false, isNoOp: false, reason: 'Block identity mismatch' };
          }

          var origRowSpan = orig.rowSpan || 1;
          if (colSpan !== orig.columnSpan || rowSpan !== origRowSpan) {
            return { valid: false, isNoOp: false, reason: 'Block span footprint must be preserved' };
          }

          if (colStart !== orig.columnStart || rowStart !== orig.rowStart) {
            isNoOp = false;
          }
        }

        for (var a = 0; a < candidateItems.length; a++) {
          for (var b = a + 1; b < candidateItems.length; b++) {
            if (rectsOverlapCoords(candidateItems[a], candidateItems[b])) {
              return {
                valid: false,
                isNoOp: false,
                reason: 'Space occupied — collides with ' + getItemLabel(candidateItems[b])
              };
            }
          }
        }

        return { valid: true, isNoOp: isNoOp };
      }
      window.validateReorderCandidate = validateReorderCandidate;

      function computeSwapCandidate(items, sourceId, targetId) {
        var candidateItems = cloneGridItemsShallow(items);
        var candA = candidateItems.find(function(it) { return it.id === sourceId; });
        var candB = candidateItems.find(function(it) { return it.id === targetId; });

        if (!candA || !candB) {
          return {
            valid: false,
            isNoOp: false,
            action: 'swap',
            mode: 'move-existing',
            sourceId: sourceId,
            targetId: targetId,
            layoutItems: candidateItems,
            reason: 'Target block not found'
          };
        }

        if (sourceId === targetId) {
          return {
            valid: true,
            isNoOp: true,
            action: 'swap',
            mode: 'move-existing',
            sourceId: sourceId,
            targetId: targetId,
            layoutItems: candidateItems
          };
        }

        var sCol = candA.columnStart;
        var sSpan = candA.columnSpan || 1;
        var sRow = candA.rowStart;
        var sRowSpan = candA.rowSpan || 1;

        var tCol = candB.columnStart;
        var tSpan = candB.columnSpan || 1;
        var tRow = candB.rowStart;
        var tRowSpan = candB.rowSpan || 1;

        var newACol = tCol;
        var newARow = tRow;
        var newBCol = sCol;
        var newBRow = sRow;

        if (sRow === tRow && sRowSpan === tRowSpan) {
          if (sSpan !== tSpan) {
            if (sCol < tCol && (sCol + sSpan) === tCol) {
              newBCol = sCol;
              newACol = sCol + tSpan;
            } else if (tCol < sCol && (tCol + tSpan) === sCol) {
              newACol = tCol;
              newBCol = tCol + sSpan;
            }
          }
        } else {
          var colsOverlap = Math.max(sCol, tCol) < Math.min(sCol + sSpan, tCol + tSpan);
          if (colsOverlap && sRowSpan !== tRowSpan) {
            if (sRow < tRow && (sRow + sRowSpan) === tRow) {
              newBRow = sRow;
              newARow = sRow + tRowSpan;
            } else if (tRow < sRow && (tRow + tRowSpan) === sRow) {
              newARow = tRow;
              newBRow = tRow + sRowSpan;
            }
          }
          if (newACol + sSpan - 1 > 4) {
            newACol = clampVal(newACol, 1, 4 - sSpan + 1);
          }
          if (newBCol + tSpan - 1 > 4) {
            newBCol = clampVal(newBCol, 1, 4 - tSpan + 1);
          }
        }

        candA.columnStart = newACol;
        candA.rowStart = newARow;
        candB.columnStart = newBCol;
        candB.rowStart = newBRow;

        var check = validateReorderCandidate(items, candidateItems);
        return {
          valid: check.valid,
          isNoOp: check.isNoOp,
          action: 'swap',
          mode: 'move-existing',
          sourceId: sourceId,
          targetId: targetId,
          layoutItems: candidateItems,
          reason: check.reason
        };
      }
      window.computeSwapCandidate = computeSwapCandidate;

      function computeInsertionCandidate(items, sourceOrOptions, targetId, axis, position) {
        var candidateItems = cloneGridItemsShallow(items);
        var isNewInsertion = typeof sourceOrOptions === 'object' && sourceOrOptions !== null;
        var mode = isNewInsertion ? (sourceOrOptions.mode || 'library-new') : 'move-existing';
        var newSpec = isNewInsertion ? sourceOrOptions.newItem : null;
        var sourceId = isNewInsertion ? ((newSpec && newSpec.id) || '__new_candidate__') : sourceOrOptions;

        var candTarget = candidateItems.find(function(it) { return it.id === targetId; });
        var candSource = null;

        if (isNewInsertion && newSpec && candTarget) {
          candSource = {
            id: sourceId,
            columnStart: 1,
            columnSpan: clampVal(newSpec.columnSpan || 1, 1, 4),
            rowStart: candTarget.rowStart || 1,
            rowSpan: clampVal(newSpec.rowSpan || 1, 1, MAX_GRID_ROWS),
            verticalAlign: (newSpec.verticalAlign === 'center' || newSpec.verticalAlign === 'end') ? newSpec.verticalAlign : 'start',
            block: newSpec.block || {
              id: '__new_blk__',
              type: newSpec.blockType || 'solo-text',
              data: {}
            }
          };
          candidateItems.push(candSource);
        } else if (!isNewInsertion) {
          candSource = candidateItems.find(function(it) { return it.id === sourceId; });
        }

        if (!candSource || !candTarget) {
          return {
            valid: false,
            isNoOp: false,
            action: 'insert',
            mode: mode,
            axis: axis,
            position: position,
            sourceId: sourceId,
            targetId: targetId,
            layoutItems: candidateItems,
            reason: 'Target block not found'
          };
        }

        if (!isNewInsertion && sourceId === targetId) {
          return {
            valid: true,
            isNoOp: true,
            action: 'insert',
            mode: mode,
            axis: axis,
            position: position,
            sourceId: sourceId,
            targetId: targetId,
            layoutItems: candidateItems
          };
        }

        if (axis === 'horizontal') {
          var sSpan = candSource.columnSpan || 1;
          var tSpan = candTarget.columnSpan || 1;
          if (sSpan + tSpan > 4) {
            return {
              valid: false,
              isNoOp: false,
              action: 'insert',
              mode: mode,
              axis: axis,
              position: position,
              sourceId: sourceId,
              targetId: targetId,
              layoutItems: candidateItems,
              reason: 'Combined block widths exceed 100% (4 columns)'
            };
          }

          var targetRow = candTarget.rowStart;

          if (!isNewInsertion && candSource.rowStart === targetRow) {
            var rowItems = candidateItems
              .filter(function(it) { return it.rowStart === targetRow; })
              .sort(function(a, b) { return a.columnStart - b.columnStart; });

            var withoutSource = rowItems.filter(function(it) { return it.id !== sourceId; });
            var tIdx = withoutSource.findIndex(function(it) { return it.id === targetId; });
            if (tIdx === -1) {
              return {
                valid: false,
                isNoOp: false,
                action: 'insert',
                mode: mode,
                axis: axis,
                position: position,
                sourceId: sourceId,
                targetId: targetId,
                layoutItems: candidateItems,
                reason: 'Target block not in horizontal sequence'
              };
            }

            var insIdx = position === 'before' ? tIdx : (tIdx + 1);
            var reordered = withoutSource.slice();
            reordered.splice(insIdx, 0, candSource);

            var sameOrder = true;
            var iMin = -1;
            var iMax = -1;
            for (var i = 0; i < rowItems.length; i++) {
              if (rowItems[i].id !== reordered[i].id) {
                sameOrder = false;
                if (iMin === -1) iMin = i;
                iMax = i;
              }
            }

            if (sameOrder) {
              return {
                valid: true,
                isNoOp: true,
                action: 'insert',
                mode: mode,
                axis: axis,
                position: position,
                sourceId: sourceId,
                targetId: targetId,
                layoutItems: candidateItems
              };
            }

            var curCol = rowItems[iMin].columnStart;
            for (var k = iMin; k <= iMax; k++) {
              reordered[k].columnStart = curCol;
              curCol += (reordered[k].columnSpan || 1);
            }
          } else {
            var otherRowItems = candidateItems
