        function closeDropdown() {
          dropdown.style.display = 'none';
          wrap.setAttribute('aria-expanded', 'false');
          highlightedIdx = -1;
        }

        function addTag(raw) {
          if (!raw) return;
          var trimmed = raw.trim().replace(/^,|,$/g, '');
          if (!trimmed) return;

          var resolvedTag = getCanonicalTagCasing(trimmed);

          // Case-insensitive duplicate prevention
          var exists = (currentDoc.meta.tags || []).some(function(t) {
            return t.toLowerCase() === resolvedTag.toLowerCase();
          });

          if (!exists) {
            if (!currentDoc.meta.tags) currentDoc.meta.tags = [];
            currentDoc.meta.tags.push(resolvedTag);

            var inAvailable = availableTags.some(function(t) {
              return t.toLowerCase() === resolvedTag.toLowerCase();
            });
            if (!inAvailable) {
              availableTags.push(resolvedTag);
            }

            renderTagChips();
            triggerAutosave();
          }

          input.value = '';
          renderSuggestions('');
        }

        function removeTag(idx) {
          currentDoc.meta.tags.splice(idx, 1);
          renderTagChips();
          renderSuggestions(input.value);
          triggerAutosave();
        }

        function renderTagChips() {
          container.querySelectorAll('.tag-chip').forEach(function(c) { c.remove(); });

          (currentDoc.meta.tags || []).forEach(function(tag, idx) {
            var chip = document.createElement('span');
            chip.className = 'tag-chip';
            chip.innerHTML = '<span>' + escapeHtml(tag) + '</span><span class="tag-chip-remove" data-idx="' + idx + '" aria-label="Remove tag ' + escapeHtml(tag) + '">×</span>';

            chip.querySelector('.tag-chip-remove').addEventListener('click', function(e) {
              e.stopPropagation();
              removeTag(idx);
            });

            container.insertBefore(chip, input);
          });
        }

        function renderSuggestions(filterText) {
          optionsList.innerHTML = '';
          createRow.style.display = 'none';
          createRow.innerHTML = '';
          highlightedIdx = -1;

          var q = (filterText || '').trim().toLowerCase();
          currentFilteredTags = availableTags.filter(function(tag) {
            return !q || tag.toLowerCase().includes(q);
          });

          var selectedLower = (currentDoc.meta.tags || []).map(function(t) { return t.toLowerCase(); });
          var exactMatch = false;

          currentFilteredTags.forEach(function(tag, idx) {
            if (tag.toLowerCase() === q) exactMatch = true;
            var isSelected = selectedLower.includes(tag.toLowerCase());
            var opt = document.createElement('div');
            opt.className = 'combobox-option' + (isSelected ? ' is-selected' : '');
            opt.setAttribute('role', 'option');
            opt.setAttribute('aria-selected', isSelected ? 'true' : 'false');
            opt.textContent = tag;

            opt.addEventListener('mousedown', function(e) {
              e.preventDefault();
              if (isSelected) {
                var tIdx = currentDoc.meta.tags.findIndex(function(t) { return t.toLowerCase() === tag.toLowerCase(); });
                if (tIdx >= 0) removeTag(tIdx);
              } else {
                addTag(tag);
              }
            });
            optionsList.appendChild(opt);
          });

          var rawTrimmed = (filterText || '').trim();
          if (rawTrimmed && !exactMatch) {
            createRow.style.display = 'flex';
            createRow.textContent = '+ Create "' + rawTrimmed + '"';
            createRow.onmousedown = function(e) {
              e.preventDefault();
              addTag(rawTrimmed);
            };
          }

          updateHighlight();
        }

        function updateHighlight() {
          var allOptions = optionsList.querySelectorAll('.combobox-option');
          allOptions.forEach(function(el, i) {
            el.classList.toggle('is-highlighted', i === highlightedIdx);
            if (i === highlightedIdx) el.scrollIntoView({ block: 'nearest' });
          });
          var isCreateHighlighted = (highlightedIdx === currentFilteredTags.length && createRow.style.display !== 'none');
          createRow.classList.toggle('is-highlighted', isCreateHighlighted);
        }

        container.addEventListener('click', function() {
          input.focus();
        });

        input.addEventListener('focus', function() {
          openDropdown();
        });

        input.addEventListener('input', function() {
          openDropdown();
        });

        input.addEventListener('keydown', function(e) {
          var totalItems = currentFilteredTags.length + (createRow.style.display !== 'none' ? 1 : 0);

          if (e.key === 'ArrowDown') {
            e.preventDefault();
            if (dropdown.style.display !== 'flex') {
              openDropdown();
            } else if (totalItems > 0) {
              highlightedIdx = (highlightedIdx + 1) % totalItems;
              updateHighlight();
            }
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            if (totalItems > 0) {
              highlightedIdx = (highlightedIdx - 1 + totalItems) % totalItems;
              updateHighlight();
            }
          } else if (e.key === 'Enter' || e.key === ',') {
            e.preventDefault();
            if (highlightedIdx >= 0 && highlightedIdx < currentFilteredTags.length) {
              var chosen = currentFilteredTags[highlightedIdx];
              var isSelected = (currentDoc.meta.tags || []).some(function(t) { return t.toLowerCase() === chosen.toLowerCase(); });
              if (isSelected) {
                var tIdx = currentDoc.meta.tags.findIndex(function(t) { return t.toLowerCase() === chosen.toLowerCase(); });
                if (tIdx >= 0) removeTag(tIdx);
              } else {
                addTag(chosen);
              }
            } else if (highlightedIdx === currentFilteredTags.length && createRow.style.display !== 'none') {
              addTag(input.value.trim());
            } else if (input.value.trim()) {
              addTag(input.value.trim());
            }
          } else if (e.key === 'Backspace' && !input.value) {
            if (currentDoc.meta.tags && currentDoc.meta.tags.length > 0) {
              removeTag(currentDoc.meta.tags.length - 1);
            }
          } else if (e.key === 'Escape') {
            e.preventDefault();
            closeDropdown();
          }
        });

        input.addEventListener('paste', function(e) {
          e.preventDefault();
          var paste = (e.clipboardData || window.clipboardData).getData('text');
          if (paste) {
            var parts = paste.split(',').map(function(p) { return p.trim(); }).filter(Boolean);
            parts.forEach(function(p) { addTag(p); });
          }
        });

        document.addEventListener('click', function(e) {
          if (!wrap.contains(e.target)) {
            closeDropdown();
          }
        });

        window._renderTagChips = renderTagChips;
      }

      // Close rich text color menus, highlight menus, and link popovers on outside click
      document.addEventListener('click', function(e) {
        if (!e.target || !e.target.closest || !e.target.closest('.rich-color-dropdown-wrap, .rich-color-menu')) {
          document.querySelectorAll('.rich-color-menu').forEach(function(m) {
            if (m.style.display !== 'none') {
              m.style.display = 'none';
              restoreFromOverlayRoot(m);
            }
          });
        }
        if (!e.target || !e.target.closest || !e.target.closest('.rich-highlight-dropdown-wrap, .rich-highlight-menu')) {
          document.querySelectorAll('.rich-highlight-menu').forEach(function(m) {
            if (m.style.display !== 'none') {
              m.style.display = 'none';
              restoreFromOverlayRoot(m);
            }
          });
        }
        if (!e.target || !e.target.closest || !e.target.closest('.rich-link-dropdown-wrap, .rich-link-popover')) {
          document.querySelectorAll('.rich-link-popover').forEach(function(p) {
            if (p.style.display !== 'none') {
              p.style.display = 'none';
              p.style.position = '';
              p.style.zIndex = '';
              p.style.top = '';
              p.style.left = '';
              p.style.visibility = '';
              p.classList.remove('is-flipped-above');
              restoreFromOverlayRoot(p);
            }
          });
        }
      });

      // ── Advanced Settings Accordion ─────────────────────
      document.getElementById('adv-settings-toggle').addEventListener('click', function() {
        document.getElementById('adv-settings-box').classList.toggle('open');
      });

      // ── Cover Image UI and Management ───────────────────
      function syncCoverVisibilityToggleUi(isChecked) {
        var enabled = isChecked !== false;
        var showToggle = document.getElementById('meta-show-cover');
        var toggleRow = document.getElementById('cover-visibility-toggle-row');
        var stateText = document.getElementById('meta-show-cover-state');

        if (showToggle) {
          showToggle.checked = enabled;
          showToggle.setAttribute('aria-checked', enabled ? 'true' : 'false');
        }
        if (toggleRow) {
          toggleRow.classList.toggle('is-on', enabled);
          toggleRow.classList.toggle('is-off', !enabled);
          toggleRow.setAttribute('data-state', enabled ? 'on' : 'off');
        }
        if (stateText) {
          stateText.textContent = enabled ? 'ON' : 'OFF';
        }
      }
      window.syncCoverVisibilityToggleUi = syncCoverVisibilityToggleUi;

      function updateCoverUiState(src) {
        var emptyState = document.getElementById('cover-empty-state');
        var filledState = document.getElementById('cover-filled-state');
        var previewImg = document.getElementById('cover-preview-img');
        var altGroup = document.getElementById('cover-alt-group');
        var toggleWrap = document.getElementById('cover-display-toggle-wrap');

        var currentShowCover = (currentDoc && currentDoc.meta) ? (currentDoc.meta.showCoverImageOnArticle !== false) : true;
        syncCoverVisibilityToggleUi(currentShowCover);

        if (src) {
          if (previewImg) previewImg.src = src;
          if (emptyState) emptyState.style.display = 'none';
          if (filledState) filledState.style.display = 'flex';
          if (altGroup) altGroup.style.display = 'flex';
          if (toggleWrap) toggleWrap.style.display = 'flex';
        } else {
          if (previewImg) {
            previewImg.removeAttribute('src');
          }
          if (emptyState) emptyState.style.display = 'flex';
          if (filledState) filledState.style.display = 'none';
          if (altGroup) altGroup.style.display = 'none';
          if (toggleWrap) toggleWrap.style.display = 'none';
        }
      }
      window.updateCoverUiState = updateCoverUiState;

      var btnSelectCover = document.getElementById('btn-select-cover');
      var btnReplaceCover = document.getElementById('btn-replace-cover');
      var btnRemoveCover = document.getElementById('btn-remove-cover');
      var coverFileInput = document.getElementById('cover-file-upload');
      var coverAltInput = document.getElementById('meta-cover-alt');
      var coverShowToggle = document.getElementById('meta-show-cover');
      var coverUploadZone = document.getElementById('cover-upload-zone');

      function openCoverFileChooser() {
        if (coverFileInput) coverFileInput.click();
      }

      if (btnSelectCover) btnSelectCover.addEventListener('click', openCoverFileChooser);
      if (btnReplaceCover) btnReplaceCover.addEventListener('click', openCoverFileChooser);

      function handleCoverFile(file) {
        if (!file) return;
        var ext = '.' + file.name.split('.').pop().toLowerCase();
        var allowed = ['.png', '.jpg', '.jpeg', '.webp', '.gif'];
        if (!allowed.includes(ext)) {
          showToast('Only .png, .jpg, .jpeg, .webp, and .gif images are supported.', 'error');
          return;
        }

        var reader = new FileReader();
        reader.onload = function(evt) {
          fetch('/__article-studio/upload', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ filename: file.name, base64: evt.target.result })
          })
          .then(function(res) { return res.json(); })
          .then(function(data) {
            if (data.success && data.url) {
              currentDoc.meta.coverImageSrc = data.url;
              delete currentDoc.meta.cover;
              updateCoverUiState(data.url);
              triggerAutosave();
              showToast('Cover image updated: ' + file.name, 'success');
            } else {
              showToast(data.error || 'Failed to upload cover image.', 'error');
            }
          })
          .catch(function() {
            showToast('Failed to upload image.', 'error');
          });
        };
        reader.readAsDataURL(file);
      }

      if (coverFileInput) {
        coverFileInput.addEventListener('change', function(e) {
          var file = e.target.files && e.target.files[0];
          handleCoverFile(file);
        });
      }

      if (coverUploadZone) {
        coverUploadZone.addEventListener('dragover', function(e) {
          e.preventDefault();
          coverUploadZone.classList.add('dragover');
        });
        coverUploadZone.addEventListener('dragleave', function() {
          coverUploadZone.classList.remove('dragover');
        });
        coverUploadZone.addEventListener('drop', function(e) {
          e.preventDefault();
          coverUploadZone.classList.remove('dragover');
          if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]) {
            handleCoverFile(e.dataTransfer.files[0]);
          }
        });
      }

      if (btnRemoveCover) {
        btnRemoveCover.addEventListener('click', function() {
          currentDoc.meta.coverImageSrc = '';
          currentDoc.meta.coverImageAlt = '';
          delete currentDoc.meta.cover;
          delete currentDoc.meta.coverCaption;
          if (coverFileInput) coverFileInput.value = '';
          if (coverAltInput) coverAltInput.value = '';
          updateCoverUiState('');
          triggerAutosave();
          showToast('Cover image removed', 'info');
        });
      }

      if (coverAltInput) {
        coverAltInput.addEventListener('input', function(e) {
          var val = (e.target.value || '').trim();
          currentDoc.meta.coverImageAlt = val;
          delete currentDoc.meta.coverCaption;
          triggerAutosave();
        });
      }

      if (coverShowToggle) {
        coverShowToggle.addEventListener('change', function(e) {
          var nextVal = Boolean(e.target.checked);
          currentDoc.meta.showCoverImageOnArticle = nextVal;
          syncCoverVisibilityToggleUi(nextVal);
          triggerAutosave();
        });
        coverShowToggle.addEventListener('keydown', function(e) {
          if (e.key === 'Enter' || e.key === ' ' || e.key === 'Spacebar' || e.code === 'Space') {
            e.preventDefault();
            coverShowToggle.checked = !coverShowToggle.checked;
            coverShowToggle.dispatchEvent(new Event('change', { bubbles: true }));
          }
        });
      }

      // Settings generic listeners
      ['meta-desc', 'meta-author', 'meta-rank', 'meta-aether', 'meta-featured', 'meta-wide'].forEach(function(id) {
        var el = document.getElementById(id);
        if (el) {
          el.addEventListener('change', function() {
            syncMetaStateFromInputs();
            triggerAutosave();
          });
        }
      });

      function sanitizeDocumentGridContract(doc) {
        if (!doc || !Array.isArray(doc.sections)) return;
        doc.sections.forEach(function(sec) {
          if (sec.visualGrid && typeof sec.visualGrid === 'object') {
            if (!isAmbiguousSectionClient(sec)) {
              sec.blocks = [];
            }
            delete sec.visualGrid.showCoordinates;
            delete sec.visualGrid.minRowHeight;
            if (Array.isArray(sec.visualGrid.layoutItems)) {
              sec.visualGrid.layoutItems.forEach(function(it) {
                if (it && typeof it === 'object') {
                  delete it.columnEnd;
                  delete it.rowEnd;
                  delete it.label;
                }
              });
            }
          }
        });
      }

      // ── Autosave & Persistence ──────────────────────────
      function saveDraft(quiet) {
        syncMetaStateFromInputs();

        if (!hasPersistedDraft) {
          if (!isFirstSaveEligibleClient(currentDoc)) {
            if (!quiet) {
              showToast('Add title, valid slug, and meaningful content before saving', 'warning');
            }
            updateSaveEligibilityUi();
            return Promise.resolve();
          }
        }

        setStatus('Saving…', 'saving');
        sanitizeDocumentGridContract(currentDoc);

        var docToSave = JSON.parse(JSON.stringify(currentDoc));
        var savingStudioId = docToSave.studioId;

        return fetch('/__article-studio/draft', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(docToSave)
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          // Stale async response protection: verify response still belongs to current active document
          if (!currentDoc || currentDoc.studioId !== savingStudioId) {
            return;
          }

          if (data.success) {
            hasPersistedDraft = true;
            if (data.studioId && currentDoc.studioId !== data.studioId) {
              currentDoc.studioId = data.studioId;
            }
            updateSaveEligibilityUi();
            setStatus('Saved', 'saved');
            isDirty = false;
            try {
              localStorage.setItem('covenArticleStudio:lastDraftId', currentDoc.studioId);
            } catch (e) {}

            // Synchronize browser URL to active persisted draft ID
            var targetUrl = '/template-preview/studio?draft=' + encodeURIComponent(currentDoc.studioId);
            if (window.location.search !== '?draft=' + encodeURIComponent(currentDoc.studioId)) {
              history.replaceState(null, '', targetUrl);
            }

            if (!quiet) showToast('Draft saved successfully', 'success');
          } else {
            setStatus('Save failed', 'error');
            showToast(data.error || 'Failed to save draft', 'error');
          }
        })
        .catch(function(err) {
          if (!currentDoc || currentDoc.studioId !== savingStudioId) {
            return;
          }
          setStatus('Save error', 'error');
          showToast('Save error: ' + err.message, 'error');
        });
      }

      function triggerAutosave() {
        isDirty = true;
        syncMetaStateFromInputs();
        updateSaveEligibilityUi();

        if (!hasPersistedDraft) {
          if (!isFirstSaveEligibleClient(currentDoc)) {
            if (autosaveTimer) clearTimeout(autosaveTimer);
            return;
          }
        }

        setStatus('Unsaved changes', '');

        if (autosaveTimer) clearTimeout(autosaveTimer);
        autosaveTimer = setTimeout(function() {
          saveDraft(true);
        }, 800);
      }

      function setStatus(text, type) {
        var indicator = document.getElementById('status-indicator');
        var dot = document.getElementById('status-dot');
        if (indicator) indicator.textContent = text;
        if (dot) {
          dot.className = 'status-dot' + (type ? ' ' + type : '');
        }
      }

      function showToast(msg, type) {
        var container = document.getElementById('toast-container');
        if (!container) return;

        var toast = document.createElement('div');
        toast.className = 'studio-toast' + (type ? ' ' + type : '');
        toast.innerHTML = '<span>✦</span><span>' + escapeHtml(msg) + '</span>';
        container.appendChild(toast);

        setTimeout(function() {
          toast.style.opacity = '0';
          toast.style.transform = 'translateY(10px)';
          setTimeout(function() { toast.remove(); }, 300);
        }, 3000);
      }

      // ── Delete Confirmation Modal ───────────────────────
      function confirmDelete(title, message, onConfirm) {
        var modal = document.getElementById('delete-confirm-modal');
        var titleEl = document.getElementById('delete-modal-title');
        var msgEl = document.getElementById('delete-modal-message');
        if (!modal) {
          if (confirm(message)) onConfirm();
          return;
        }

        if (titleEl) titleEl.textContent = title;
        if (msgEl) msgEl.textContent = message;
        pendingDeleteCallback = onConfirm;
        modal.style.display = 'flex';
      }

      document.getElementById('btn-cancel-delete').addEventListener('click', function() {
        document.getElementById('delete-confirm-modal').style.display = 'none';
        pendingDeleteCallback = null;
      });

      document.getElementById('btn-confirm-delete').addEventListener('click', function() {
        document.getElementById('delete-confirm-modal').style.display = 'none';
        if (typeof pendingDeleteCallback === 'function') {
          pendingDeleteCallback();
        }
        pendingDeleteCallback = null;
      });

      // ── New Article Draft ───────────────────────────────
      document.getElementById('btn-new').addEventListener('click', function() {
        if (isDirty) {
          confirmDelete(
            'START NEW ARTICLE?',
            'You have unsaved changes in the current scroll. Create a new blank draft?',
            function() {
              createNewArticle();
            }
          );
        } else {
          createNewArticle();
        }
      });

      function createNewArticle() {
        if (autosaveTimer) {
          clearTimeout(autosaveTimer);
          autosaveTimer = null;
        }
        isDirty = false;
        isExistingPublished = false;
        originalPublishedSlug = '';
        hasPersistedDraft = false;
        try {
          localStorage.removeItem('covenArticleStudio:lastDraftId');
        } catch (e) {}

        // Remove ?draft= and ?new= from browser URL immediately
        if (window.location.search) {
          history.replaceState(null, '', window.location.pathname);
        }

        var warningEl = document.getElementById('slug-published-warning');
        if (warningEl) warningEl.style.display = 'none';

        currentDoc = {
          version: 1,
          studioId: uid('draft'),
          slug: '',
          meta: {
            title: '',
            description: '',
            author: 'Mich Alvarez',
            category: 'Salesforce',
            difficulty: 'Lv. 1 - Incantation',
            tags: [],
            rank: 'Mechanic',
            readingTime: '1 min',
            aetherReward: 120,
            status: 'draft',
            featured: false,
            wide: true,
            coverImageSrc: '',
            coverImageAlt: '',
            showCoverImageOnArticle: true
          },
          sections: []
        };
        activeSectionId = null;
        renderSections();
        syncMetaInputsFromState();
        updateSaveEligibilityUi();
        setStatus('Not saved yet', '');
        showToast('New article created', 'success');
      }

      // ── Drafts Modal ────────────────────────────────────
      var btnDraftsEl = document.getElementById('btn-drafts');
      if (btnDraftsEl) {
        btnDraftsEl.addEventListener('click', function() {
          loadDraftsList();
          document.getElementById('drafts-modal').style.display = 'flex';
        });
      }

      document.getElementById('btn-close-drafts').addEventListener('click', function() {
        closeInlineDelete();
        document.getElementById('drafts-modal').style.display = 'none';
      });

      function deleteDraft(studioId, title, triggerBtn) {
        showInlineDelete(
          triggerBtn,
          'Delete this draft?',
          null,
          function() {
            if (triggerBtn) triggerBtn.disabled = true;
            fetch('/__article-studio/drafts/' + encodeURIComponent(studioId), { method: 'DELETE' })
              .then(function(res) {
                if (!res.ok) throw new Error('Delete failed');
                showToast('Draft deleted');
                loadDraftsList();
                // If currently open draft was deleted, reset to a fresh article
                if (currentDoc && currentDoc.studioId === studioId) {
                  createNewArticle();
                }
              })
              .catch(function(err) {
                if (triggerBtn) triggerBtn.disabled = false;
                showToast('Failed to delete draft', 'error');
              });
          }
        );
      }

      function loadDraftsList() {
        var listContainer = document.getElementById('drafts-list');
        listContainer.innerHTML = '<div style="color:var(--studio-text-muted);font-size:12px">Loading drafts…</div>';

        fetch('/__article-studio/drafts', { cache: 'no-store' })
          .then(function(res) { return res.json(); })
          .then(function(data) {
            var drafts = data.drafts || [];
            if (drafts.length === 0) {
              listContainer.innerHTML = '<div style="color:var(--studio-text-muted);font-size:13px;padding:12px 0">No saved drafts found.</div>';
              return;
            }

            listContainer.innerHTML = '';
            drafts.forEach(function(d) {
              var card = document.createElement('div');
              card.style.cssText = 'background:rgba(21,18,28,0.8);border:1px solid var(--studio-border);border-radius:6px;padding:12px 14px;display:flex;justify-content:space-between;align-items:center;gap:12px';

              var dateStr = new Date(d.updatedAt).toLocaleString();
              card.innerHTML =
                '<div>' +
                  '<div style="font-family:var(--font-display);font-size:13px;color:var(--studio-gold-bright);margin-bottom:3px">' + escapeHtml(d.title || 'Untitled Scroll') + '</div>' +
                  '<div style="font-family:var(--font-mono);font-size:10px;color:var(--studio-purple)">' + escapeHtml(d.category) + ' · ' + escapeHtml(d.status).toUpperCase() + ' · ' + dateStr + '</div>' +
                '</div>' +
                '<div style="display:flex;gap:6px">' +
                  '<button type="button" class="studio-btn studio-btn--sm btn-open-draft" data-id="' + d.studioId + '">Open</button>' +
                  '<button type="button" class="studio-btn studio-btn--sm studio-btn--danger btn-del-draft" data-id="' + d.studioId + '">✕</button>' +
                '</div>';

              card.querySelector('.btn-open-draft').addEventListener('click', function() {
                openDraft(d.studioId);
                document.getElementById('drafts-modal').style.display = 'none';
              });

              card.querySelector('.btn-del-draft').addEventListener('click', function(e) {
                e.stopPropagation();
                deleteDraft(d.studioId, d.title, e.currentTarget);
              });

              listContainer.appendChild(card);
            });
          });
      }

      function openDraft(studioId) {
        closeInlineDelete();
        if (autosaveTimer) {
          clearTimeout(autosaveTimer);
          autosaveTimer = null;
        }
        isDirty = false;
        try {
          localStorage.setItem('covenArticleStudio:lastDraftId', studioId);
        } catch (e) {}

        fetch('/__article-studio/drafts/' + encodeURIComponent(studioId), { cache: 'no-store' })
          .then(function(res) {
            if (!res.ok) throw new Error('Draft not found');
            return res.json();
          })
          .then(function(doc) {
            normalizeDocument(doc);
            currentDoc = doc;
            hasPersistedDraft = true;
            activeSectionId = doc.sections.length > 0 ? doc.sections[0].id : null;
            renderSections();
            syncMetaInputsFromState();
            updateSaveEligibilityUi();
            setStatus('Draft restored', 'saved');
            showToast('Draft opened: ' + (doc.meta.title || 'Untitled'));

            var targetUrl = '/template-preview/studio?draft=' + encodeURIComponent(doc.studioId);
            if (window.location.search !== '?draft=' + encodeURIComponent(doc.studioId)) {
              history.replaceState(null, '', targetUrl);
            }
          })
          .catch(function(err) {
            showToast('Draft not found, opening new article', 'warning');
            try { localStorage.removeItem('covenArticleStudio:lastDraftId'); } catch (e) {}
            createNewArticle();
          });
      }

      // ── Duplicate Article ───────────────────────────────
      document.getElementById('btn-duplicate-article').addEventListener('click', function() {
        var dupBtn = document.getElementById('btn-duplicate-article');
        if (dupBtn && dupBtn.disabled) return;

        syncMetaStateFromInputs();
        sanitizeDocumentGridContract(currentDoc);

        if (autosaveTimer) {
          clearTimeout(autosaveTimer);
          autosaveTimer = null;
        }

        var newDraftId = uid('draft');
        var rawBase = (currentDoc.slug || 'untitled').replace(/-copy(-\d+)?$/i, '');
        var targetSlug = normalizeSlugClient(rawBase + '-copy', false);
        var targetTitle = (currentDoc.meta.title || 'Untitled Scroll') + ' (Copy)';
        var sourceSnapshot = JSON.parse(JSON.stringify(currentDoc));

        if (dupBtn) dupBtn.disabled = true;
        setStatus('Duplicating…', 'saving');

        fetch('/__article-studio/duplicate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            document: sourceSnapshot,
            preserveClientIdentity: true,
            targetStudioId: newDraftId,
            targetSlug: targetSlug,
            targetTitle: targetTitle
          })
        })
        .then(function(res) {
          return res.json().then(function(data) {
            return { ok: res.ok, data: data };
          });
        })
        .then(function(result) {
          if (!result.ok || !result.data || !result.data.success || !result.data.draft) {
            var errMsg = (result.data && result.data.error) || 'Failed to duplicate article assets.';
            setStatus('Duplicate failed', 'error');
            showToast(errMsg, 'error');
            return;
          }

          var copyDoc = result.data.draft;
          normalizeDocument(copyDoc);
          currentDoc = copyDoc;
          hasPersistedDraft = true;
          isDirty = false;
          isExistingPublished = false;
          originalPublishedSlug = '';
          activeSectionId = currentDoc.sections.length > 0 ? currentDoc.sections[0].id : null;

          try {
            localStorage.setItem('covenArticleStudio:lastDraftId', currentDoc.studioId);
          } catch (e) {}
          var targetUrl = '/template-preview/studio?draft=' + encodeURIComponent(currentDoc.studioId);
          if (window.location.search !== '?draft=' + encodeURIComponent(currentDoc.studioId)) {
            history.replaceState(null, '', targetUrl);
          }

          renderSections();
          syncMetaInputsFromState();
          updateSaveEligibilityUi();
          setStatus('Saved', 'saved');
          showToast('Article duplicated as new draft', 'success');
        })
        .catch(function(err) {
          setStatus('Duplicate failed', 'error');
          showToast((err && err.message) || 'Network error while duplicating article.', 'error');
        })
        .finally(function() {
          if (dupBtn) dupBtn.disabled = false;
        });
      });

      // ── Focus Canvas Toggle ──────────────────────────────
      var btnFocus = document.getElementById('btn-focus-canvas');
      if (btnFocus) {
        btnFocus.addEventListener('click', function() {
          var isFocused = document.body.classList.toggle('is-canvas-focused');
          btnFocus.textContent = isFocused ? '⛶ Normal View' : '⛶ Focus Canvas';
          btnFocus.setAttribute('title', isFocused ? 'Restore normal 3-column workspace' : 'Toggle full-width canvas workspace');
          showToast(isFocused ? 'Focus Canvas mode enabled' : 'Normal workspace view restored', 'info');
        });
      }

      // ── Save Draft Button ───────────────────────────────
      document.getElementById('btn-save-draft').addEventListener('click', function() {
        saveDraft(false);
      });

      // ── Single-Tab Reusable Live Preview ────────────────
      document.getElementById('btn-preview').addEventListener('click', function() {
        syncMetaStateFromInputs();
        sanitizeDocumentGridContract(currentDoc);
        showToast('Preparing preview…', 'saving');

        fetch('/__article-studio/preview', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(currentDoc)
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.success) {
            window.open('/template-preview/article', 'coven-article-preview');
            showToast('Preview updated in tab', 'success');
          } else {
            showToast(data.error || 'Preview failed', 'error');
          }
        })
        .catch(function(err) {
          showToast('Preview error: ' + err.message, 'error');
        });
      });

      // ── Publish Action ──────────────────────────────────
      var isPublishing = false;
      var btnPublishEl = document.getElementById('btn-publish');
      btnPublishEl.addEventListener('click', function() {
        if (isPublishing) {
          showToast('Publish already in progress…', 'info');
          return;
        }
        syncMetaStateFromInputs();

        // Validation
        if (currentDoc.meta.status !== 'published') {
          showToast('Set status to Published before publishing scroll', 'warning');
          return;
        }
        if (!currentDoc.meta.title || !currentDoc.meta.title.trim()) {
          showToast('Title is required to publish', 'error');
          document.getElementById('meta-title').focus();
          return;
        }

        var rawSlug = (currentDoc.slug || '').trim();
        if (!rawSlug) {
          showToast('Choose a URL slug before publishing this scroll.', 'error');
          document.getElementById('meta-slug').focus();
          return;
        }
        var finalSlug = normalizeSlugClient(rawSlug, false);
        if (!isValidSlugClient(finalSlug)) {
          showToast('Invalid slug. Must be lowercase alphanumeric characters and single hyphens.', 'error');
          document.getElementById('meta-slug').focus();
          return;
        }
        currentDoc.slug = finalSlug;

        // Collision validation against published articles
        var publishedArticles = window.STUDIO_PUBLISHED_ARTICLES || [];
        var matchSlug = publishedArticles.find(function(a) { return a.slug === finalSlug; });
        if (matchSlug) {
          if (matchSlug.studioId && matchSlug.studioId !== currentDoc.studioId) {
            showToast('This article URL is already in use.', 'error');
            return;
          }
        }

        if (!currentDoc.meta.category || !currentDoc.meta.category.trim()) {
          showToast('Choose an article category before publishing this scroll.', 'error');
          return;
        }
        if (!currentDoc.meta.difficulty) {
          showToast('Choose an article difficulty before publishing this scroll.', 'error');
          return;
        }
        if (currentDoc.sections.length === 0) {
          showToast('Add at least one section before publishing', 'error');
          return;
        }
        if (currentDoc.meta.coverImageSrc && String(currentDoc.meta.coverImageSrc).trim()) {
          if (!currentDoc.meta.coverImageAlt || !String(currentDoc.meta.coverImageAlt).trim()) {
            showToast('Cover image requires alt text for accessibility.', 'error');
            return;
          }
        }

        // Validate active blocks in both Legacy and Grid sections (alt texts, table minimums, Embed safety, ambiguous sections)
        var errors = [];
        function validateBlockRecursive(blk, sIdx, secTitle) {
          if (!blk || !blk.data) {
            errors.push('Section ' + (sIdx + 1) + ': Malformed block encountered.');
            return;
          }
          var d = blk.data;
          var labelPrefix = 'Section ' + (sIdx + 1) + (secTitle ? ' ("' + secTitle + '")' : '') + ' — Block "' + (blk.id || 'unknown') + '" (' + blk.type + ')';
          if ((d.src || d.imageSrc) && (!d.alt || !String(d.alt).trim())) {
            errors.push(labelPrefix + ': Alt text is required for image.');
          }
          if (blk.type === 'technical-table') {
            if (!d.columns || d.columns.length === 0) {
              errors.push(labelPrefix + ': At least 1 column is required.');
            }
          }
          if (blk.type === 'embed') {
            if (typeof window.validateEmbedBlockData === 'function') {
              var embedRes = window.validateEmbedBlockData(d, labelPrefix);
              if (!embedRes.valid) {
                errors.push(embedRes.error);
              }
            } else {
              var rawUrl = String(d.url || '').trim();
              if (!rawUrl || /^(javascript|data|vbscript|file):/i.test(rawUrl)) {
                errors.push(labelPrefix + ': Valid safe Embed URL is required.');
              }
            }
          }
          if (Array.isArray(d.blocks)) {
            d.blocks.forEach(function(cb) { validateBlockRecursive(cb, sIdx, secTitle); });
          }
          if (Array.isArray(d.columns)) {
            d.columns.forEach(function(col) {
              if (col && Array.isArray(col.blocks)) {
                col.blocks.forEach(function(cb) { validateBlockRecursive(cb, sIdx, secTitle); });
              }
            });
          }
        }

        currentDoc.sections.forEach(function(sec, sIdx) {
          var secTitle = sec && sec.title ? sec.title : '';
          if (isAmbiguousSectionClient(sec)) {
            errors.push('Section ' + (sIdx + 1) + (secTitle ? ' ("' + secTitle + '")' : '') + ': Ambiguous section contains both legacy blocks and Grid layoutItems.');
            return;
          }
          var activeBlocks = getActiveSectionBlocksClient(sec);
          activeBlocks.forEach(function(blk) {
            validateBlockRecursive(blk, sIdx, secTitle);
          });
        });

        if (errors.length === 0 && typeof window.validateDocumentForPublish === 'function') {
          var sharedCheck = window.validateDocumentForPublish(currentDoc);
          if (!sharedCheck.valid && sharedCheck.error) {
            errors.push(sharedCheck.error);
          }
        }

        if (errors.length > 0) {
          showToast(errors[0], 'error');
          return;
        }

        sanitizeDocumentGridContract(currentDoc);

        isPublishing = true;
        btnPublishEl.disabled = true;
        showToast('Publishing scroll to archives…', 'saving');
        fetch('/__article-studio/publish', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(currentDoc)
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.success) {
            isDirty = false;
            isExistingPublished = true;
            originalPublishedSlug = data.slug;
            currentDoc.sourceArticleSlug = data.slug;
            setStatus('Published', 'saved');
            showToast('✦ Scroll published successfully: ' + data.slug, 'success');
            setTimeout(function() {
              window.open(data.articleUrl || ('/article/' + data.slug), 'coven-published-article');
            }, 1000);
          } else {
            showToast('Publish failed: ' + (data.error || 'Server error'), 'error');
          }
        })
        .catch(function(err) {
          showToast('Publish error: ' + err.message, 'error');
        })
        .finally(function() {
          isPublishing = false;
          btnPublishEl.disabled = false;
        });
      });

      // ── Initial Boot ────────────────────────────────────
      function bootStudio() {
        initLibrary();
        initCategoryCombobox();
        initDifficultyDropdown();
        initTagsCombobox();
        initCustomColorPicker();
        initCustomIconModal();

        // Restore draft from URL query, lastDraftId, or create new
        var urlParams = new URLSearchParams(window.location.search);
        var paramDraftId = urlParams.get('draft');
        var paramNew = urlParams.get('new');

        if (paramDraftId) {
          openDraft(paramDraftId);
        } else if (paramNew === '1') {
          createNewArticle();
        } else {
          var lastDraftId = null;
          try {
            lastDraftId = localStorage.getItem('covenArticleStudio:lastDraftId');
          } catch (e) {}

          if (lastDraftId) {
            openDraft(lastDraftId);
          } else {
            createNewArticle();
          }
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bootStudio);
      } else {
        bootStudio();
      }

      // Expose state globally for browser QA automation
      try {
        Object.defineProperty(window, 'currentDoc', {
          configurable: true,
          enumerable: true,
          get: function() { return currentDoc; },
          set: function(v) { currentDoc = v; }
        });
      } catch (e) {
        window.currentDoc = currentDoc;
      }
      try {
        Object.defineProperty(window, 'hasPersistedDraft', {
          configurable: true,
          enumerable: true,
          get: function() { return hasPersistedDraft; },
          set: function(v) { hasPersistedDraft = Boolean(v); updateSaveEligibilityUi(); }
        });
      } catch (e) {
        window.hasPersistedDraft = hasPersistedDraft;
      }
      window.isFirstSaveEligibleClient = isFirstSaveEligibleClient;
      window.hasMeaningfulArticleContentClient = hasMeaningfulArticleContentClient;
      window.updateSaveEligibilityUi = updateSaveEligibilityUi;
      window.openDraft = openDraft;
      window.createNewArticle = createNewArticle;
      window.triggerAutosave = triggerAutosave;
      window.resolveBlockLocation = resolveBlockLocation;
      window.renderSections = renderSections;
      window.renderMetadata = syncMetaInputsFromState;
      window.syncMetaInputsFromState = syncMetaInputsFromState;
      window.calculateReadingTime = calculateReadingTime;
      window.saveDraft = saveDraft;
      window.sanitizeRichText = sanitizeRichText;
      window.applyColorClass = applyColorClass;
      window.applyBgClass = applyBgClass;
      window.getSavedColors = getSavedColors;
      window.saveColorToPalette = saveColorToPalette;
      window.removeColorFromPalette = removeColorFromPalette;
      window.closeAllPopovers = closeAllPopovers;
      window.openCustomColorPicker = openCustomColorPicker;
      window.normalizeHex = normalizeHex;
      window.addBlockToActiveSection = addBlockToActiveSection;
      window.addSection = addSection;

    })();
  </script>

</body>
</html>
