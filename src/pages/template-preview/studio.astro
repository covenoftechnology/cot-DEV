        );
      }

      // ── Block Library Initialization ────────────────────
      function initLibrary() {
        var container = document.getElementById('palette-categories-container');
        if (!container) return;
        container.innerHTML = '';

        var firstCategory = true;

        window.STUDIO_CATEGORIES.forEach(function(cat) {
          var matchingBlocks = Object.values(window.STUDIO_REGISTRY).filter(function(b) {
            return b.category === cat && isInsertablePaletteBlock(b);
          });

          if (matchingBlocks.length === 0) {
            return;
          }

          var accordion = document.createElement('div');
          accordion.className = 'category-accordion' + (firstCategory ? ' open' : '');
          firstCategory = false;
          accordion.setAttribute('data-category', cat);

          var header = document.createElement('button');
          header.type = 'button';
          header.className = 'category-accordion-header';

          header.innerHTML =
            '<div class="category-accordion-title">' +
              '<span class="category-arrow">▸</span>' +
              '<span>' + escapeHtml(cat) + '</span>' +
            '</div>' +
            '<span class="category-items-count">' + matchingBlocks.length + '</span>';

          header.addEventListener('click', function() {
            accordion.classList.toggle('open');
          });

          var body = document.createElement('div');
          body.className = 'category-accordion-body';

          matchingBlocks.forEach(function(blk) {
            var card = document.createElement('div');
            card.className = 'library-block-card';
            card.setAttribute('draggable', 'true');
            card.setAttribute('data-block-type', blk.type);
            card.setAttribute('data-keywords', (blk.label + ' ' + blk.description + ' ' + blk.category).toLowerCase());

            var glyph = BLOCK_GLYPHS[blk.type] || '✦';

            card.innerHTML =
              '<div class="lib-card-handle" title="Drag to insert into section">⋮⋮</div>' +
              '<div class="lib-card-glyph">' + glyph + '</div>' +
              '<div class="lib-card-content">' +
                '<div class="lib-card-title">' + escapeHtml(blk.label) + '</div>' +
                '<div class="lib-card-desc">' + escapeHtml(blk.description) + '</div>' +
              '</div>' +
              '<button type="button" class="studio-btn studio-btn--insert" data-block-type="' + blk.type + '" title="Insert into active section">+ Insert</button>';

            var lastDragEndTime = 0;

            card.querySelector('.studio-btn--insert').addEventListener('click', function(e) {
              e.stopPropagation();
              addBlockToActiveSection(blk.type);
            });

            card.addEventListener('click', function() {
              if (Date.now() - lastDragEndTime < 250) return;
              addBlockToActiveSection(blk.type);
            });

            // Pointer-based Library Drag Engine (Deterministic WYSIWYG placement)
            card.addEventListener('pointerdown', function(pdEvent) {
              if (pdEvent.target && pdEvent.target.closest('.studio-btn--insert')) return;
              if (pdEvent.button !== 0) return;

              var startX = pdEvent.clientX;
              var startY = pdEvent.clientY;
              var isDragging = false;
              var avatar = null;
              var lastPointerTarget = null;
              var activeCanvas = null;

              function onPointerMove(pmEvent) {
                var cx = pmEvent.clientX;
                var cy = pmEvent.clientY;
                var dist = Math.hypot(cx - startX, cy - startY);

                if (!isDragging) {
                  if (dist < 6) return;
                  isDragging = true;
                  try { card.setPointerCapture(pmEvent.pointerId); } catch(err) {}
                  document.body.classList.add('is-grid-dragging');

                  avatar = document.createElement('div');
                  avatar.className = 'grid-drag-avatar';
                  avatar.innerHTML = '<span class="grid-drag-avatar-glyph">' + glyph + '</span><span>' + escapeHtml(blk.label) + ' (25%)</span>';
                  document.body.appendChild(avatar);
                  startDragAutoScroll();
                }

                if (avatar) {
                  avatar.style.left = (cx + 12) + 'px';
                  avatar.style.top = (cy + 12) + 'px';
                }

                var canvases = document.querySelectorAll('.grid-composer-canvas');
                var foundCanvas = null;
                var foundSec = null;

                for (var ci = 0; ci < canvases.length; ci++) {
                  var cEl = canvases[ci];
                  var cRect = cEl.getBoundingClientRect();
                  if (cx >= cRect.left && cx <= cRect.right && cy >= cRect.top && cy <= cRect.bottom) {
                    foundCanvas = cEl;
                    var sId = cEl.getAttribute('data-sec-id');
                    foundSec = currentDoc.sections.find(function(s) { return s.id === sId; });
                    break;
                  }
                }

                if (activeCanvas && activeCanvas !== foundCanvas) {
                  clearReorderPreview(activeCanvas);
                  var prevGhost = activeCanvas.querySelector('.grid-placement-preview');
                  if (prevGhost) prevGhost.remove();
                }
                activeCanvas = foundCanvas;

                if (foundCanvas && foundSec && hasVisualGridSection(foundSec)) {
                  var vg = foundSec.visualGrid;
                  var reqSpan = 1; // Default 25% for library drop

                  var ghost = foundCanvas.querySelector('.grid-placement-preview');
                  if (!ghost) {
                    ghost = document.createElement('div');
                    ghost.className = 'grid-placement-preview';
                    foundCanvas.appendChild(ghost);
                  }

                  var occIntent = resolveOccupiedTargetIntent(cx, cy, foundCanvas, foundSec, { columnSpan: reqSpan, rowSpan: 1 }, 'library-new');
                  if (occIntent) {
                    if (occIntent.action === 'occupied-invalid') {
                      renderReorderPreview(foundCanvas, foundSec, occIntent, null, ghost, false);
                      lastPointerTarget = {
                        mode: 'occupied-invalid',
                        sec: foundSec,
                        blockType: blk.type,
                        reason: occIntent.reason || 'Space Occupied'
                      };
                    } else {
                      var libInsCand = computeInsertionCandidate(
                        vg.layoutItems,
                        {
                          mode: 'library-new',
                          newItem: {
                            id: '__lib_drag_cand__',
                            columnSpan: reqSpan,
                            rowSpan: 1,
                            verticalAlign: 'start',
                            blockType: blk.type
                          }
                        },
                        occIntent.targetItem.id,
                        occIntent.axis,
                        occIntent.position
                      );
                      renderReorderPreview(foundCanvas, foundSec, occIntent, libInsCand, ghost, false);
                      lastPointerTarget = {
                        mode: 'insert-between',
                        sec: foundSec,
                        blockType: blk.type,
                        candidate: libInsCand
                      };
                    }
                  } else {
                    clearReorderPreview(foundCanvas);
                    ghost.style.display = '';
                    var cell = resolvePointerToGridCell(cx, cy, foundCanvas, vg.minRowHeight, vg.rowGap, vg.columnGap);
                    var res = resolvePlacementTarget(vg.layoutItems, cell.col, cell.row, reqSpan, false);

                    ghost.style.gridColumn = res.columnStart + ' / span ' + res.columnSpan;
                    ghost.style.gridRow = res.rowStart + ' / span 1';

                    if (res.valid) {
                      ghost.className = 'grid-placement-preview is-valid' + (res.autoFitApplied ? ' is-autofit' : '');
                      ghost.textContent = '+ Place ' + escapeHtml(blk.label) + ' (' + getSpanPercentageLabel(res.columnSpan) + (res.autoFitApplied ? ' · Auto-fit' : '') + ')';
                      lastPointerTarget = {
                        mode: 'empty-cell',
                        sec: foundSec,
                        blockType: blk.type,
                        colStart: res.columnStart,
                        colSpan: res.columnSpan,
                        rowStart: res.rowStart
                      };
                    } else {
                      ghost.className = 'grid-placement-preview is-invalid-drop';
                      ghost.textContent = '⚠ ' + (res.reason || 'Space Occupied');
                      lastPointerTarget = {
                        mode: 'occupied-invalid',
                        sec: foundSec,
                        blockType: blk.type,
                        reason: res.reason || 'Space Occupied'
                      };
                    }
                  }
                } else {
                  if (activeCanvas) {
                    clearReorderPreview(activeCanvas);
                    var g = activeCanvas.querySelector('.grid-placement-preview');
                    if (g) g.remove();
                  }
                  lastPointerTarget = null;
                }
              }

              function onPointerUp(puEvent) {
                window.removeEventListener('pointermove', onPointerMove);
                window.removeEventListener('pointerup', onPointerUp);
                window.removeEventListener('pointercancel', onPointerUp);
                try { card.releasePointerCapture(puEvent.pointerId); } catch(err) {}

                document.body.classList.remove('is-grid-dragging');
                stopDragAutoScroll();

                if (avatar) {
                  avatar.remove();
                  avatar = null;
                }
                if (activeCanvas) {
                  clearReorderPreview(activeCanvas);
                  var g = activeCanvas.querySelector('.grid-placement-preview');
                  if (g) g.remove();
                  activeCanvas = null;
                }

                if (isDragging) {
                  lastDragEndTime = Date.now();
                  if (lastPointerTarget && lastPointerTarget.mode === 'insert-between' && lastPointerTarget.sec) {
                    if (lastPointerTarget.candidate && lastPointerTarget.candidate.valid) {
                      var bTypeToInsert = lastPointerTarget.blockType;
                      commitNewCandidateInsertion(lastPointerTarget.sec, lastPointerTarget.candidate, function() {
                        return createFreshGridBlock(bTypeToInsert);
                      });
                    } else {
                      showToast((lastPointerTarget.candidate && lastPointerTarget.candidate.reason) || 'Cannot insert block here', 'warning');
                    }
                  } else if (lastPointerTarget && lastPointerTarget.mode === 'occupied-invalid') {
                    showToast(lastPointerTarget.reason || 'Space Occupied', 'warning');
                  } else if (lastPointerTarget && lastPointerTarget.sec && lastPointerTarget.colStart) {
                    commitBlockPlacement(lastPointerTarget.sec, lastPointerTarget.blockType, lastPointerTarget.colStart, lastPointerTarget.colSpan, lastPointerTarget.rowStart);
                  } else {
                    // Check if dropped over a Legacy section card
                    var legacyCards = document.querySelectorAll('.section-card[data-section-mode="legacy"]');
                    var matchedLegacySecId = null;
                    for (var li = 0; li < legacyCards.length; li++) {
                      var lRect = legacyCards[li].getBoundingClientRect();
                      if (puEvent.clientX >= lRect.left && puEvent.clientX <= lRect.right && puEvent.clientY >= lRect.top && puEvent.clientY <= lRect.bottom) {
                        matchedLegacySecId = legacyCards[li].getAttribute('data-sec-id');
                        break;
                      }
                    }
                    if (matchedLegacySecId) {
                      addBlockToActiveSection(blk.type, matchedLegacySecId);
                    } else {
                      showToast('Choose a valid Grid location.', 'warning');
                    }
                  }
                  lastPointerTarget = null;
                }
              }

              window.addEventListener('pointermove', onPointerMove);
              window.addEventListener('pointerup', onPointerUp);
              window.addEventListener('pointercancel', onPointerUp);
            });

            card.addEventListener('dragstart', function(e) {
              draggedBlockData = { source: 'library', type: blk.type, widthSpan: 1 };
              window.draggedBlockData = draggedBlockData;
              e.dataTransfer.setData('text/plain', JSON.stringify(draggedBlockData));
              e.dataTransfer.effectAllowed = 'copy';
              startDragAutoScroll();
            });

            card.addEventListener('dragend', function() {
