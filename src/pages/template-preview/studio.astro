      function moveBlock(secId, blockId, direction) {
        var sec = currentDoc.sections.find(function(s) { return s.id === secId; });
        if (!sec) return;
        var idx = sec.blocks.findIndex(function(b) { return b.id === blockId; });
        if (idx === -1) return;
        var targetIdx = idx + direction;
        if (targetIdx < 0 || targetIdx >= sec.blocks.length) return;
        var temp = sec.blocks[idx];
        sec.blocks[idx] = sec.blocks[targetIdx];
        sec.blocks[targetIdx] = temp;
        renderSections();
        triggerAutosave();
      }

      function moveBlockToSection(sourceSecId, blockId, targetSecId, insertIndex) {
        var srcSec = currentDoc.sections.find(function(s) { return s.id === sourceSecId; });
        var dstSec = currentDoc.sections.find(function(s) { return s.id === targetSecId; });
        if (!srcSec || !dstSec) return;

        var bIdx = srcSec.blocks.findIndex(function(b) { return b.id === blockId; });
        if (bIdx === -1) return;

        var [block] = srcSec.blocks.splice(bIdx, 1);
        if (insertIndex !== undefined && insertIndex >= 0) {
          dstSec.blocks.splice(insertIndex, 0, block);
        } else {
          dstSec.blocks.push(block);
        }

        activeSectionId = dstSec.id;
        renderSections();
        triggerAutosave();
        showToast('Block moved');
      }

      // ── Shared Accent Palette Renderer for Callout & Pullquote ──
      function renderAccentPaletteHtml(activeAccentKeyOrHex, customHex, blockType, blockId) {
        var isCustom = false;
        var activePresetKey = '';
        var effectiveCustomHex = '';

        // Check if custom is active:
        // Case A: explicit accentColor === 'custom' and valid accentCustomColor
        if (activeAccentKeyOrHex === 'custom' && customHex && (window.isValidHexColor ? window.isValidHexColor(customHex) : normalizeHex(customHex))) {
          isCustom = true;
          effectiveCustomHex = (window.sanitizeHexColor ? window.sanitizeHexColor(customHex) : normalizeHex(customHex)) || '#C45AFF';
        }
        // Case B: accentCustomColor exists and is valid
        else if (customHex && (window.isValidHexColor ? window.isValidHexColor(customHex) : normalizeHex(customHex))) {
          isCustom = true;
          effectiveCustomHex = (window.sanitizeHexColor ? window.sanitizeHexColor(customHex) : normalizeHex(customHex)) || '#C45AFF';
        }
        // Case C: Legacy data where activeAccentKeyOrHex is a direct hex (e.g. "#52E8A5" or "#C45AFF")
        else if (activeAccentKeyOrHex && (window.isValidHexColor ? window.isValidHexColor(activeAccentKeyOrHex) : normalizeHex(activeAccentKeyOrHex))) {
          var cleanHex = (window.sanitizeHexColor ? window.sanitizeHexColor(activeAccentKeyOrHex) : normalizeHex(activeAccentKeyOrHex));
          var hexMap = {
            '#D8B56B': 'gold',
            '#B98FD8': 'purple',
            '#52E8A5': 'emerald',
            '#E06B9F': 'rose',
            '#7EB2FF': 'moonlight',
            '#E05656': 'crimson'
          };
          if (cleanHex && hexMap[cleanHex]) {
            activePresetKey = hexMap[cleanHex];
          } else if (cleanHex) {
            isCustom = true;
            effectiveCustomHex = cleanHex;
          }
        }
        // Case D: Semantic token match
        else if (activeAccentKeyOrHex && typeof activeAccentKeyOrHex === 'string') {
          var lower = activeAccentKeyOrHex.trim().toLowerCase();
          if (['gold', 'purple', 'emerald', 'rose', 'moonlight', 'crimson'].indexOf(lower) !== -1) {
            activePresetKey = lower;
          }
        }

        var isDefault = !isCustom && !activePresetKey;
        var savedColors = getSavedColors();

        var html = '<div class="coven-accent-palette-control" data-block-id="' + (blockId || '') + '" data-active-custom-hex="' + (isCustom ? effectiveCustomHex : '') + '">';
        html += '<div class="coven-accent-palette-label">ACCENT COLOR</div>';

        // 1. Group A: Presets
        html += '<div class="coven-accent-palette-group">';
        html += '<div class="coven-accent-palette-sublabel">COVEN PRESETS</div>';
        html += '<div class="coven-accent-palette-chips" role="radiogroup" aria-label="Coven Presets">';

        // Default chip
        html += '<button type="button" class="accent-chip' + (isDefault ? ' is-active' : '') + '" data-act="select-accent-chip" data-accent="" role="radio" aria-checked="' + (isDefault ? 'true' : 'false') + '" aria-label="Default Accent">' +
          '<span class="accent-chip-dot accent-chip-dot--default" aria-hidden="true">◉</span>' +
          '<span class="accent-chip-name">Default</span>' +
          (isDefault ? '<span class="accent-chip-check" aria-hidden="true">✓</span>' : '') +
        '</button>';

        // Canonical preset options
        var colors = [
          { key: 'gold', label: 'Gold', hex: '#d8b56b' },
          { key: 'purple', label: 'Purple', hex: '#b98fd8' },
          { key: 'emerald', label: 'Emerald', hex: '#52e8a5' },
          { key: 'rose', label: 'Rose', hex: '#e06b9f' },
          { key: 'moonlight', label: 'Moonlight', hex: '#7eb2ff' },
          { key: 'crimson', label: 'Crimson', hex: '#e05656' }
        ];

        colors.forEach(function(c) {
          var isActive = !isCustom && activePresetKey === c.key;
          html += '<button type="button" class="accent-chip' + (isActive ? ' is-active' : '') + '" data-act="select-accent-chip" data-accent="' + c.key + '" role="radio" aria-checked="' + (isActive ? 'true' : 'false') + '" aria-label="' + c.label + ' Accent">' +
            '<span class="accent-chip-dot" style="background-color:' + c.hex + ';" aria-hidden="true"></span>' +
            '<span class="accent-chip-name">' + c.label + '</span>' +
            (isActive ? '<span class="accent-chip-check" aria-hidden="true">✓</span>' : '') +
          '</button>';
        });

        html += '</div></div>';

        // 2. Group B: My Colors (Saved Palette)
        var hasSaved = savedColors && savedColors.length > 0;
        html += '<div class="coven-accent-palette-group coven-saved-palette-group"' + (hasSaved ? '' : ' style="display:none;"') + '>';
        html += '<div class="coven-accent-palette-sublabel">MY COLORS</div>';
        html += '<div class="coven-accent-palette-chips coven-saved-colors-chips" role="radiogroup" aria-label="My Saved Colors">';

        if (hasSaved) {
          savedColors.forEach(function(c) {
            var isSavedActive = isCustom && effectiveCustomHex.toUpperCase() === c.toUpperCase();
            html += '<div class="accent-chip accent-chip--saved' + (isSavedActive ? ' is-active' : '') + '">' +
              '<button type="button" class="accent-chip-select-btn" data-act="select-saved-color" data-hex="' + c + '" role="radio" aria-checked="' + (isSavedActive ? 'true' : 'false') + '" aria-label="Use saved color ' + c + '" title="Use saved color ' + c + '">' +
                '<span class="accent-chip-dot" style="background-color:' + c + ';" aria-hidden="true"></span>' +
                '<span class="accent-chip-hex">' + c + '</span>' +
                (isSavedActive ? '<span class="accent-chip-check" aria-hidden="true">✓</span>' : '') +
              '</button>' +
              '<button type="button" class="accent-chip-del-btn" data-act="remove-saved-color" data-hex="' + c + '" title="Remove ' + c + ' from My Colors" aria-label="Remove ' + c + ' from My Colors">×</button>' +
            '</div>';
          });
        }

        html += '</div></div>';

        // 3. Group C: Custom Accent
        var curDisplayHex = isCustom ? effectiveCustomHex : (customHex && normalizeHex(customHex) ? normalizeHex(customHex) : '#C45AFF');
        html += '<div class="coven-accent-palette-group">';
        html += '<div class="coven-accent-palette-sublabel">CUSTOM ACCENT</div>';
        html += '<div class="coven-accent-palette-chips">';
        html += '<button type="button" class="accent-chip accent-chip--custom' + (isCustom ? ' is-active' : '') + '" data-act="open-custom-accent" data-accent="custom" data-block-id="' + (blockId || '') + '" data-current-hex="' + curDisplayHex + '" role="radio" aria-checked="' + (isCustom ? 'true' : 'false') + '" aria-label="Custom Accent Color' + (isCustom ? ': ' + curDisplayHex : '') + '" title="' + (isCustom ? 'Active custom accent: ' + curDisplayHex + ' (Click to change)' : 'Choose custom accent color') + '">' +
          '<span class="accent-chip-icon" aria-hidden="true">🎨</span>' +
          '<span class="accent-chip-name">Custom</span>' +
          (isCustom ? '<span class="accent-chip-dot" style="background-color:' + curDisplayHex + ';" aria-hidden="true"></span><span class="accent-chip-hex">' + curDisplayHex + '</span><span class="accent-chip-check" aria-hidden="true">✓</span>' : '') +
        '</button>';
        html += '</div></div>';

        html += '</div>';
        return html;
      }

