      // ── Visual Table Builder V2 (Ephemeral Editor State & Controller) ──
      // Selection & panel open states live strictly in memory — NEVER persisted into article JSON.
      var tableEditorSelectionMap = {};
      var tableStylePanelOpenMap = {};
      window.__getTableEditorSelection = function(blockId) { return tableEditorSelectionMap[blockId] || null; };
      window.__setTableEditorSelection = function(blockId, sel) {
        if (sel) tableEditorSelectionMap[blockId] = sel;
        else delete tableEditorSelectionMap[blockId];
      };

      function toTableColLetter(index) {
        var n = index + 1;
        var out = '';
        while (n > 0) {
          var rem = (n - 1) % 26;
          out = String.fromCharCode(65 + rem) + out;
          n = Math.floor((n - 1) / 26);
        }
        return out;
      }

      function renderTableSelectionToolbarHtml(block, d, sel) {
        var AT = window.ArticleTable;
        var cols = d.columns || [];
        var rows = d.rows || [];
        var merges = Array.isArray(d.mergeRegions) ? d.mergeRegions : [];
        if (!sel || !AT) {
          return '<div class="table-selection-toolbar is-empty" data-table-sel-bar="true"><span class="table-sel-hint">Click any cell, drag across cells, or click a row/column handle for Table Design actions</span></div>';
        }

        var canMerge = AT.canMergeSelection(sel, merges);
        var unmergeTarget = AT.canUnmergeSelection(sel, merges);
        var rSpan = sel.rowEnd - sel.rowStart + 1;
        var cSpan = sel.colEnd - sel.colStart + 1;

        var badgeLabel = '';
        if (sel.kind === 'column') {
          badgeLabel = 'Column ' + toTableColLetter(sel.colStart);
        } else if (sel.kind === 'row') {
          badgeLabel = sel.section === 'header' ? 'Header Row' : ('Row ' + (sel.rowStart + 1));
        } else if (unmergeTarget) {
          badgeLabel = 'Merged ' + unmergeTarget.rowSpan + '×' + unmergeTarget.columnSpan;
        } else if (sel.kind === 'range') {
          badgeLabel = 'Range ' + rSpan + '×' + cSpan;
        } else {
          badgeLabel = (sel.section === 'header' ? 'H' : ('R' + (sel.rowStart + 1))) + '·' + toTableColLetter(sel.colStart);
        }

        var bgPresets = AT.CELL_BACKGROUND_PRESETS || [];
        var savedColors = typeof window.getSavedPalette === 'function' ? window.getSavedPalette() : [];

        var bgItemsHtml = bgPresets.map(function(p) {
          var swatchStyle = p.id === 'default'
            ? 'background:transparent;border:1px dashed rgba(216,181,107,0.45)'
            : ('background:' + p.swatch);
          return '<button type="button" class="table-style-menu-item" data-table-v2-act="set-cell-bg" data-val="' + escapeHtml(p.id) + '">' +
            '<span class="table-bg-swatch" style="' + swatchStyle + '"></span>' +
            '<span>' + escapeHtml(p.label) + '</span>' +
          '</button>';
        }).join('');

        var savedBgChipsHtml = savedColors.length > 0
          ? '<div class="table-style-menu-divider"></div><div class="table-style-menu-section-label">MY COLORS</div><div class="table-saved-color-row">' +
            savedColors.map(function(hex) {
              return '<button type="button" class="table-saved-color-chip" data-table-v2-act="set-cell-bg" data-val="' + escapeHtml(hex) + '" title="Apply tint ' + escapeHtml(hex) + '" style="background:' + escapeHtml(hex) + '"></button>';
            }).join('') +
            '</div>'
          : '';

        var structButtonsHtml = '';
        if (canMerge) {
          structButtonsHtml += '<button type="button" class="studio-btn studio-btn--sm table-ctx-btn table-ctx-btn--accent" data-table-v2-act="merge-cells" title="Merge selected contiguous cells">⊞ Merge Cells</button>';
        }
        if (unmergeTarget) {
          structButtonsHtml += '<button type="button" class="studio-btn studio-btn--sm table-ctx-btn table-ctx-btn--accent" data-table-v2-act="unmerge-cells" title="Restore hidden cells from merged region">⊟ Unmerge</button>';
        }
        if (sel.kind === 'row' && sel.section === 'body') {
          structButtonsHtml +=
            '<button type="button" class="studio-btn studio-btn--sm table-ctx-btn" data-table-v2-act="insert-row-above" title="Insert Row Above">↑ Insert Above</button>' +
            '<button type="button" class="studio-btn studio-btn--sm table-ctx-btn" data-table-v2-act="insert-row-below" title="Insert Row Below">↓ Insert Below</button>' +
            '<button type="button" class="studio-btn studio-btn--sm studio-btn--danger table-ctx-btn" data-table-v2-act="delete-selected-row" ' + (rows.length <= 1 ? 'disabled' : '') + ' title="Delete Selected Row">✕ Delete Row</button>';
        }
        if (sel.kind === 'column') {
          structButtonsHtml +=
            '<button type="button" class="studio-btn studio-btn--sm table-ctx-btn" data-table-v2-act="insert-col-left" title="Insert Column Left">← Insert Left</button>' +
            '<button type="button" class="studio-btn studio-btn--sm table-ctx-btn" data-table-v2-act="insert-col-right" title="Insert Column Right">→ Insert Right</button>' +
            '<button type="button" class="studio-btn studio-btn--sm studio-btn--danger table-ctx-btn" data-table-v2-act="delete-selected-col" ' + (cols.length <= 1 ? 'disabled' : '') + ' title="Delete Selected Column">✕ Delete Column</button>';
        }

        return (
          '<div class="table-selection-toolbar" data-table-sel-bar="true" data-sel-kind="' + escapeHtml(sel.kind) + '">' +
            '<span class="table-sel-badge">' + escapeHtml(badgeLabel) + '</span>' +
            '<div class="table-style-dropdown-wrap">' +
              '<button type="button" class="studio-btn studio-btn--sm table-ctx-btn" data-table-v2-act="toggle-bg-menu">Background ▾</button>' +
              '<div class="table-style-popover" data-table-menu="bg" style="display:none">' +
                '<div class="table-style-menu-title">CELL BACKGROUND</div>' +
                bgItemsHtml +
                savedBgChipsHtml +
              '</div>' +
            '</div>' +
            '<div class="table-ctx-align-group" role="group" aria-label="Cell alignment">' +
              '<button type="button" class="studio-btn studio-btn--sm table-ctx-btn" data-table-v2-act="set-cell-align" data-val="left" title="Align Left">≡←</button>' +
              '<button type="button" class="studio-btn studio-btn--sm table-ctx-btn" data-table-v2-act="set-cell-align" data-val="center" title="Align Center">≡↔</button>' +
              '<button type="button" class="studio-btn studio-btn--sm table-ctx-btn" data-table-v2-act="set-cell-align" data-val="right" title="Align Right">→≡</button>' +
