            '<div style="display:flex;align-items:center;gap:10px;overflow:hidden;min-width:0;">' +
              '<span class="custom-icon-item-glyph">' + escapeHtml(ic.icon) + '</span>' +
              '<span class="custom-icon-item-label">' + escapeHtml(ic.label) + '</span>' +
            '</div>' +
            '<button type="button" class="studio-btn studio-btn--icon studio-btn--danger btn-del-custom-icon" data-icon-id="' + escapeHtml(ic.id) + '" aria-label="Remove ' + escapeHtml(ic.label) + ' from My Icons" title="Remove from My Icons" style="padding:2px 6px;font-size:11px;line-height:1;flex-shrink:0;">✕</button>' +
          '</div>';
