        var liveInSurface = isValidRangeForSurface(targetSurface, liveRange);
        var candidate = null;

        if (liveInSurface && !liveRange.collapsed && liveRange.toString().length > 0) {
          candidate = liveRange.cloneRange();
        } else if (isValidRangeForSurface(targetSurface, explicitRange)) {
          candidate = explicitRange.cloneRange();
        } else if (isValidRangeForSurface(targetSurface, targetSurface.__covenSavedRange)) {
          candidate = targetSurface.__covenSavedRange.cloneRange();
        } else if (liveInSurface) {
          candidate = liveRange.cloneRange();
