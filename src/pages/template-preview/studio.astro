        if (!window.STUDIO_REGISTRY || !window.STUDIO_REGISTRY[type]) return false;
        return isInsertablePaletteBlock(type);
      }
      window.isAllowedInGridSlot = isAllowedInGridSlot;

      // ── PLACEMENT MODE, CLICK-TO-MOVE & DUPLICATE PLACEMENT CONTROLS ──
      function enterPlacementMode(blockType, defaultWidth) {
        if (window.activeFocusedBlock) window.closeBlockFocusEditor();
        var canonicalType = blockType;
        if (blockType === 'paragraph') canonicalType = 'solo-text';
        if (blockType === 'quote') canonicalType = 'pullquote';
        if (blockType === 'image' || blockType === 'media-image') canonicalType = 'single-image';

        if (!isAllowedInGridSlot(canonicalType)) {
          showToast('Block type is non-insertable: ' + blockType, 'warning');
          return;
        }

        var def = window.STUDIO_REGISTRY[canonicalType];
        if (!def) {
          showToast('Unknown block type: ' + canonicalType, 'error');
          return;
        }

        var span = defaultWidth || 4; // Default 100%
        activePlacement = {
          blockType: canonicalType,
          widthSpan: span,
          explicitWidth: Boolean(defaultWidth),
          label: def.label || canonicalType
        };
        window.activePlacement = activePlacement;
        activeMove = null;
        window.activeMove = null;
        activeDuplicate = null;
        window.activeDuplicate = null;

        document.body.classList.add('is-grid-placement-mode');
        document.body.classList.remove('is-grid-move-mode', 'is-grid-duplicate-mode');
        renderSections();
        showToast('Placement Mode: Click an available cell or between blocks to place ' + (def.label || canonicalType) + ' (Esc to cancel)', 'info');
      }
      window.enterPlacementMode = enterPlacementMode;

      function exitPlacementMode() {
        activePlacement = null;
        window.activePlacement = null;
        document.body.classList.remove('is-grid-placement-mode');
        renderSections();
      }
      window.exitPlacementMode = exitPlacementMode;

      function enterMoveMode(sec, item) {
        if (window.activeFocusedBlock) window.closeBlockFocusEditor();
        activeMove = {
          secId: sec.id,
          itemId: item.id,
          item: item
        };
        window.activeMove = activeMove;
        activePlacement = null;
        window.activePlacement = null;
        activeDuplicate = null;
        window.activeDuplicate = null;

        document.body.classList.add('is-grid-move-mode');
        document.body.classList.remove('is-grid-placement-mode', 'is-grid-duplicate-mode');
        renderSections();
        showToast('Move Mode: Click an available cell or between blocks to move ' + getItemLabel(item) + ' (Esc to cancel)', 'info');
      }
      window.enterMoveMode = enterMoveMode;

      function exitMoveMode() {
        activeMove = null;
        window.activeMove = null;
        document.body.classList.remove('is-grid-move-mode');
        renderSections();
      }
      window.exitMoveMode = exitMoveMode;

      function enterDuplicateMode(sec, item) {
        if (!sec || !item || !item.block) return;
        if (window.activeFocusedBlock) window.closeBlockFocusEditor();
        var span = clampVal(item.columnSpan || 4, 1, 4);
        var rSpan = clampVal(item.rowSpan || 1, 1, MAX_GRID_ROWS);
        var vAlign = (item.verticalAlign === 'center' || item.verticalAlign === 'end') ? item.verticalAlign : 'start';
        var lbl = getItemLabel(item);

        activeDuplicate = {
          secId: sec.id,
          sourceItemId: item.id,
          sourceItem: item,
          sourceBlock: JSON.parse(JSON.stringify(item.block)),
          columnSpan: span,
          rowSpan: rSpan,
          verticalAlign: vAlign,
          label: lbl
        };
        window.activeDuplicate = activeDuplicate;
        activePlacement = null;
        window.activePlacement = null;
        activeMove = null;
        window.activeMove = null;

        document.body.classList.add('is-grid-duplicate-mode');
        document.body.classList.remove('is-grid-placement-mode', 'is-grid-move-mode');
        renderSections();
        showToast('Duplicate Mode: Click an open cell or between blocks to place ' + lbl + ' (' + getSpanPercentageLabel(span) + ') · Esc to cancel', 'info');
      }
      window.enterDuplicateMode = enterDuplicateMode;

      function exitDuplicateMode() {
        activeDuplicate = null;
        window.activeDuplicate = null;
        document.body.classList.remove('is-grid-duplicate-mode');
        renderSections();
      }
      window.exitDuplicateMode = exitDuplicateMode;

      // ── FOCUS EDITOR AUTHORING STATE (25% Block Comfortable Editor) ──
      var activeFocusedBlock = null;
      window.activeFocusedBlock = null;

      function closeBlockFocusEditor() {
        if (!activeFocusedBlock) return;
        var entry = activeFocusedBlock;
        activeFocusedBlock = null;
        window.activeFocusedBlock = null;

        var itemEl = entry.itemEl;
        var anchorEl = entry.anchorEl;
        var btn = itemEl ? itemEl.querySelector('[data-act="toggle-focus"]') : null;

        if (itemEl) {
          itemEl.classList.remove('is-focused-editor');
          itemEl.style.position = '';
          itemEl.style.gridColumn = (entry.item.columnStart || 1) + ' / span ' + (entry.item.columnSpan || 1);
          itemEl.style.gridRow = (entry.item.rowStart || 1) + ' / span 1';
          itemEl.style.top = '';
          itemEl.style.left = '';
          itemEl.style.width = '';
          itemEl.style.zIndex = '';
        }

        if (anchorEl && anchorEl.parentNode) {
          anchorEl.remove();
        }

        if (btn) {
          btn.innerHTML = '⛶ Edit';
          btn.classList.remove('is-active');
          btn.title = 'Expand to comfortable authoring width (640px)';
        }

        if (entry.canvasEl) {
          entry.canvasEl._cachedRowGeometry = null;
          if (entry.sec && entry.sec.visualGrid) {
            computeCanvasRowGeometry(entry.canvasEl, null, entry.sec.visualGrid.rowGap, entry.sec.visualGrid.minRowHeight);
          }
        }
      }
      window.closeBlockFocusEditor = closeBlockFocusEditor;

      function openBlockFocusEditor(sec, item, itemEl, canvasEl) {
        if (!sec || !item || !itemEl) return;

        if (activeFocusedBlock && activeFocusedBlock.itemId === item.id) {
          closeBlockFocusEditor();
          return;
        }

        if (activeFocusedBlock) {
          closeBlockFocusEditor();
        }

        var cEl = canvasEl || itemEl.closest('.grid-composer-canvas');
        if (!cEl) return;

        var origHeight = itemEl.offsetHeight;
        var canvasWidth = cEl.clientWidth;
        var targetWidth = 640;

        var blk = item.block;
        var blkDef = blk ? (window.STUDIO_REGISTRY[blk.type] || { label: blk.type }) : { label: 'Block' };
        var glyph = blk ? (BLOCK_GLYPHS[blk.type] || '✦') : '✧';
        var spanCols = clampVal(item.columnSpan || 1, 1, 4);

        var anchor = document.createElement('div');
        anchor.className = 'grid-block-anchor';
        anchor.setAttribute('data-anchor-for', item.id);
        anchor.setAttribute('data-col-start', item.columnStart);
        anchor.setAttribute('data-row-start', item.rowStart);
        anchor.style.gridColumn = item.columnStart + ' / span ' + spanCols;
        anchor.style.gridRow = item.rowStart + ' / span 1';
        anchor.style.minHeight = Math.max(120, origHeight) + 'px';
        anchor.innerHTML =
          '<div class="grid-block-anchor-inner">' +
            '<span class="grid-block-anchor-glyph">' + glyph + '</span>' +
            '<span class="grid-block-anchor-text">Editing ' + escapeHtml(getItemLabel(item)) + ' · ' + getSpanPercentageLabel(spanCols) + '</span>' +
            '<span class="grid-block-anchor-hint">Esc or ✕ to close</span>' +
          '</div>';

        anchor.addEventListener('click', function(e) {
          e.stopPropagation();
          closeBlockFocusEditor();
        });

        cEl.insertBefore(anchor, itemEl);

        var anchorLeft = anchor.offsetLeft;
        var anchorTop = anchor.offsetTop;
        var anchorWidth = anchor.offsetWidth;

        var leftPos = anchorLeft;
        if (item.columnStart === 1) {
          leftPos = anchorLeft;
        } else if (item.columnStart === 4) {
          leftPos = (anchorLeft + anchorWidth) - targetWidth;
        } else {
          leftPos = anchorLeft + (anchorWidth / 2) - (targetWidth / 2);
        }

        var minLeft = 16;
        var maxLeft = Math.max(16, canvasWidth - targetWidth - 16);
        leftPos = Math.max(minLeft, Math.min(leftPos, maxLeft));

        itemEl.classList.add('is-focused-editor');
        itemEl.style.position = 'absolute';
        itemEl.style.gridColumn = 'auto';
        itemEl.style.gridRow = 'auto';
        itemEl.style.top = anchorTop + 'px';
        itemEl.style.left = leftPos + 'px';
        itemEl.style.width = targetWidth + 'px';
        itemEl.style.zIndex = '100';

        var btn = itemEl.querySelector('[data-act="toggle-focus"]');
        if (btn) {
          btn.innerHTML = '✕ Done';
          btn.classList.add('is-active');
          btn.title = 'Finish editing and restore layout view';
        }

        activeFocusedBlock = {
          secId: sec.id,
          itemId: item.id,
          sec: sec,
          item: item,
          itemEl: itemEl,
          anchorEl: anchor,
          canvasEl: cEl
        };
        window.activeFocusedBlock = activeFocusedBlock;

        cEl._cachedRowGeometry = null;
      }
      window.openBlockFocusEditor = openBlockFocusEditor;

      window.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' || e.keyCode === 27) {
          if (activeFocusedBlock) {
            closeBlockFocusEditor();
            return;
          }
          if (activePlacement) {
            exitPlacementMode();
            showToast('Placement cancelled', 'info');
          } else if (activeMove) {
            exitMoveMode();
            showToast('Move cancelled', 'info');
          } else if (activeDuplicate) {
            exitDuplicateMode();
            showToast('Duplicate placement cancelled', 'info');
          }
        }
      });

      document.addEventListener('pointerdown', function(e) {
        if (!activeFocusedBlock) return;
        if (e.target.closest('.is-focused-editor, .grid-block-anchor, .coven-studio-overlay-root, .rich-color-menu, .rich-highlight-menu, .rich-link-popover, .ql-tooltip, .rich-text-popover, .dialog-popover, .coven-modal, .custom-color-popover, .coven-custom-color-popover, .nested-marker-dropdown')) {
          return;
        }
        closeBlockFocusEditor();
      });

      function createFreshGridBlock(blockType, preloadedData) {
        var def = window.STUDIO_REGISTRY[blockType];
        if (!def) return null;

        var mergedData = JSON.parse(JSON.stringify(def.defaultData || {}));
        if (preloadedData && typeof preloadedData === 'object') {
          Object.assign(mergedData, JSON.parse(JSON.stringify(preloadedData)));
        }
        if ((blockType === 'solo-text' || blockType === 'title-text') && (!Array.isArray(mergedData.paragraphs) || mergedData.paragraphs.length === 0)) {
          mergedData.paragraphs = [mergedData.text || ''];
        }
        if (blockType === 'callout' && (!Array.isArray(mergedData.blocks) || mergedData.blocks.length === 0)) {
          mergedData.blocks = [
            {
              id: uid('blk'),
              type: 'solo-text',
              data: { paragraphs: [{ text: '', align: 'left' }] }
            }
          ];
        }

        var newBlock = {
          id: uid('blk'),
          type: blockType,
          data: mergedData
        };
        regenerateBlockNestedIds(newBlock);
        return newBlock;
      }
      window.createFreshGridBlock = createFreshGridBlock;

      function cloneBlockForDuplicate(sourceBlock) {
        if (!sourceBlock) return null;
        var copyBlock = JSON.parse(JSON.stringify(sourceBlock));
        copyBlock.id = uid('blk');
        regenerateBlockNestedIds(copyBlock);
        return copyBlock;
      }
      window.cloneBlockForDuplicate = cloneBlockForDuplicate;

      function commitBlockPlacement(sec, blockType, colStart, colSpan, rowStart, preloadedData) {
        var def = window.STUDIO_REGISTRY[blockType];
        if (!def) return null;

        var newBlock = createFreshGridBlock(blockType, preloadedData);
        if (!newBlock) return null;

        var span = clampVal(colSpan || 4, 1, 4);
        var start = clampVal(colStart || 1, 1, 4 - span + 1);
        var rStart = clampVal(rowStart || 1, 1, MAX_GRID_ROWS);

        var newItem = {
          id: uid('grid_item'),
          columnStart: start,
          columnSpan: span,
          rowStart: rStart,
          rowSpan: 1,
          verticalAlign: 'start',
          block: newBlock
        };

        pushSectionHistory(sec);
        sec.visualGrid.layoutItems.push(newItem);
        secActiveSlotIds[sec.id] = newItem.id;

        normalizeDocument(currentDoc);
        normalizeSectionRows(sec);
        renderSections();
        triggerAutosave();
        showToast('Placed ' + (def.label || blockType) + ' (' + getSpanPercentageLabel(span) + ') on Grid', 'success');
        return newItem;
      }
      window.commitBlockPlacement = commitBlockPlacement;

      function commitDuplicatePlacementToCell(sec, dupState, colStart, colSpan, rowStart) {
        if (!sec || !sec.visualGrid || !dupState || !dupState.sourceBlock) return null;
        var span = clampVal(colSpan || dupState.columnSpan || 4, 1, 4);
        var start = clampVal(colStart || 1, 1, 4 - span + 1);
        var rStart = clampVal(rowStart || 1, 1, MAX_GRID_ROWS);
        var rSpan = clampVal(dupState.rowSpan || 1, 1, MAX_GRID_ROWS);
        var vAlign = (dupState.verticalAlign === 'center' || dupState.verticalAlign === 'end') ? dupState.verticalAlign : 'start';

        var cand = {
          columnStart: start,
          columnSpan: span,
          rowStart: rStart,
          rowSpan: rSpan
        };

        if (checkSlotCollisionState(sec.visualGrid.layoutItems, null, cand)) {
          showToast('Space occupied — cannot place duplicate here', 'warning');
          renderSections();
          return null;
        }

        var copyBlock = cloneBlockForDuplicate(dupState.sourceBlock);
        if (!copyBlock) return null;

        var dupItem = {
          id: uid('grid_item'),
          columnStart: start,
          columnSpan: span,
          rowStart: rStart,
          rowSpan: rSpan,
          verticalAlign: vAlign,
          block: copyBlock
        };

        pushSectionHistory(sec);
        sec.visualGrid.layoutItems.push(dupItem);
        secActiveSlotIds[sec.id] = dupItem.id;

        normalizeDocument(currentDoc);
        normalizeSectionRows(sec);
        renderSections();
        triggerAutosave();
        showToast('Duplicated ' + getItemLabel(dupItem) + ' (' + getSpanPercentageLabel(span) + ')', 'success');
        return dupItem;
      }
      window.commitDuplicatePlacementToCell = commitDuplicatePlacementToCell;

      function commitNewCandidateInsertion(sec, candidate, blockFactoryFn) {
        if (!sec || !sec.visualGrid || !candidate) return null;
        if (!candidate.valid) {
          showToast(candidate.reason || 'Cannot insert block here', 'warning');
          renderSections();
          return null;
        }

        var vg = sec.visualGrid;
        var tempCandidateId = candidate.sourceId;
        var validation = validateReorderCandidate(vg.layoutItems, candidate.layoutItems, { allowNewItemId: tempCandidateId });
        if (!validation.valid) {
          showToast(validation.reason || 'Invalid insertion layout', 'warning');
          renderSections();
          return null;
        }

        var newCandEntry = candidate.layoutItems.find(function(cit) { return cit.id === tempCandidateId; });
        if (!newCandEntry) {
          showToast('Insertion target position not found', 'warning');
          renderSections();
          return null;
        }

        var createdBlock = (typeof blockFactoryFn === 'function') ? blockFactoryFn() : null;
        if (!createdBlock) {
          showToast('Could not create block for insertion', 'error');
          renderSections();
          return null;
        }

        pushSectionHistory(sec);

        var posMap = {};
        candidate.layoutItems.forEach(function(cit) {
          if (cit.id === tempCandidateId) return;
          posMap[cit.id] = {
            columnStart: cit.columnStart,
            columnSpan: cit.columnSpan,
            rowStart: cit.rowStart,
            rowSpan: cit.rowSpan || 1,
            verticalAlign: cit.verticalAlign || 'start'
          };
        });

        vg.layoutItems.forEach(function(it) {
          var nextPos = posMap[it.id];
          if (nextPos) {
            it.columnStart = nextPos.columnStart;
            it.columnSpan = nextPos.columnSpan;
            delete it.columnEnd;
            it.rowStart = nextPos.rowStart;
            it.rowSpan = nextPos.rowSpan;
            delete it.rowEnd;
            it.verticalAlign = nextPos.verticalAlign;
          }
        });

        var newItem = {
          id: uid('grid_item'),
          columnStart: newCandEntry.columnStart,
          columnSpan: newCandEntry.columnSpan,
          rowStart: newCandEntry.rowStart,
          rowSpan: newCandEntry.rowSpan || 1,
          verticalAlign: (newCandEntry.verticalAlign === 'center' || newCandEntry.verticalAlign === 'end') ? newCandEntry.verticalAlign : 'start',
          block: createdBlock
        };

        vg.layoutItems.push(newItem);
        secActiveSlotIds[sec.id] = newItem.id;

        var tgtItem = vg.layoutItems.find(function(it) { return it.id === candidate.targetId; });
        var posLabel = candidate.position === 'before' ? 'before' : 'after';

        normalizeDocument(currentDoc);
        normalizeSectionRows(sec);
        renderSections();
        triggerAutosave();

        if (candidate.mode === 'duplicate-new') {
          showToast('Duplicated ' + getItemLabel(newItem) + ' ' + posLabel + ' ' + getItemLabel(tgtItem), 'success');
        } else {
          showToast('Inserted ' + getItemLabel(newItem) + ' ' + posLabel + ' ' + getItemLabel(tgtItem), 'success');
        }
        return newItem;
      }
      window.commitNewCandidateInsertion = commitNewCandidateInsertion;

      function commitBlockMove(sec, item, targetCol, targetRow) {
        var span = item.columnSpan || 4;
        var candColStart = clampVal(targetCol, 1, 4 - span + 1);
        var candRowStart = clampVal(targetRow, 1, MAX_GRID_ROWS);

        var cand = {
          columnStart: candColStart,
          columnSpan: span,
          rowStart: candRowStart,
          rowSpan: 1
        };

        if (checkSlotCollisionState(sec.visualGrid.layoutItems, item.id, cand)) {
          showToast('Space occupied — cannot move here', 'warning');
          renderSections();
          return false;
        }

        pushSectionHistory(sec);
        item.columnStart = cand.columnStart;
        delete item.columnEnd;
        item.rowStart = cand.rowStart;
        item.rowSpan = 1;
        delete item.rowEnd;

        normalizeSectionRows(sec);
        renderSections();
        triggerAutosave();
        showToast('Moved ' + getItemLabel(item) + ' to row ' + item.rowStart, 'success');
        return true;
      }
      window.commitBlockMove = commitBlockMove;

      function commitGridReorder(sec, candidate) {
        if (!sec || !sec.visualGrid || !candidate) return false;
        if (!candidate.valid) {
          showToast(candidate.reason || 'Cannot reorder blocks here', 'warning');
          renderSections();
          return false;
        }
        if (candidate.isNoOp) {
          renderSections();
          return true;
        }

        var vg = sec.visualGrid;
        var validation = validateReorderCandidate(vg.layoutItems, candidate.layoutItems);
        if (!validation.valid) {
          showToast(validation.reason || 'Invalid reorder layout', 'warning');
          renderSections();
          return false;
        }

        pushSectionHistory(sec);

        var posMap = {};
        candidate.layoutItems.forEach(function(cit) {
          posMap[cit.id] = {
            columnStart: cit.columnStart,
            columnSpan: cit.columnSpan,
            rowStart: cit.rowStart,
            rowSpan: cit.rowSpan || 1,
            verticalAlign: cit.verticalAlign || 'start'
          };
        });

        vg.layoutItems.forEach(function(it) {
          var nextPos = posMap[it.id];
          if (nextPos) {
            it.columnStart = nextPos.columnStart;
            it.columnSpan = nextPos.columnSpan;
            delete it.columnEnd;
            it.rowStart = nextPos.rowStart;
            it.rowSpan = nextPos.rowSpan;
            delete it.rowEnd;
            it.verticalAlign = nextPos.verticalAlign;
          }
        });

        normalizeSectionRows(sec);
        renderSections();
        triggerAutosave();

        var srcItem = vg.layoutItems.find(function(it) { return it.id === candidate.sourceId; });
        var tgtItem = vg.layoutItems.find(function(it) { return it.id === candidate.targetId; });
        if (candidate.action === 'swap') {
          showToast('Swapped ' + getItemLabel(srcItem) + ' ⇄ ' + getItemLabel(tgtItem), 'success');
        } else {
          var posLabel = candidate.position === 'before' ? 'before' : 'after';
          showToast('Moved ' + getItemLabel(srcItem) + ' ' + posLabel + ' ' + getItemLabel(tgtItem), 'success');
        }
        return true;
      }
      window.commitGridReorder = commitGridReorder;

      function setBlockItemWidth(sec, item, newSpan) {
        var span = clampVal(newSpan, 1, 4);
        if (span === item.columnSpan) return;

        var targetStart = item.columnStart;
        if (targetStart + span - 1 > 4) {
          targetStart = 4 - span + 1;
        }

        var cand = {
          columnStart: targetStart,
          columnSpan: span,
          rowStart: item.rowStart,
          rowSpan: 1
        };

        if (checkSlotCollisionState(sec.visualGrid.layoutItems, item.id, cand)) {
          showToast('Space occupied — cannot expand to ' + getSpanPercentageLabel(span), 'warning');
          renderSections();
          return;
        }

        if (activeFocusedBlock) closeBlockFocusEditor();
        pushSectionHistory(sec);
        item.columnStart = cand.columnStart;
        item.columnSpan = cand.columnSpan;
        delete item.columnEnd;
        item.rowSpan = 1;
        delete item.rowEnd;

        normalizeSectionRows(sec);
        renderSections();
        triggerAutosave();
        showToast('Resized ' + getItemLabel(item) + ' to ' + getSpanPercentageLabel(span), 'success');
      }
      window.setBlockItemWidth = setBlockItemWidth;

      function insertBlockDirectly(blockType, secId, preferredSpan, preferredRow) {
        var canonicalType = blockType;
        if (blockType === 'paragraph') canonicalType = 'solo-text';
        if (blockType === 'quote') canonicalType = 'pullquote';
        if (blockType === 'image' || blockType === 'media-image') canonicalType = 'single-image';
        blockType = canonicalType;

        if (!isAllowedInGridSlot(blockType)) {
          showToast('Block type is non-insertable: ' + blockType, 'warning');
          return null;
        }

        var def = window.STUDIO_REGISTRY[blockType];
        if (!def) {
          showToast('Unknown block type: ' + blockType, 'error');
          return null;
        }

        var targetSecId = secId || activeSectionId || (currentDoc.sections[0] ? currentDoc.sections[0].id : null);
        var sec = currentDoc.sections.find(function(s) { return s.id === targetSecId; }) || currentDoc.sections[0];
        if (!sec || !hasVisualGridSection(sec)) return null;

        normalizeGridSection(sec);
        var vg = sec.visualGrid;

        var span = clampVal(preferredSpan || 4, 1, 4);
        var placement = findFirstAvailablePlacement(vg.layoutItems, vg.rows, span, 1);
        if (preferredRow) {
          placement.rowStart = preferredRow;
        }

        return commitBlockPlacement(sec, blockType, placement.columnStart, span, placement.rowStart);
      }
      window.insertBlockDirectly = insertBlockDirectly;

      function duplicateGridItem(sec, itemId) {
        if (!sec || !sec.visualGrid) return;
        var vg = sec.visualGrid;
        var item = vg.layoutItems.find(function(it) { return it.id === itemId; });
        if (!item || !item.block) return;

        enterDuplicateMode(sec, item);
      }
      window.duplicateGridItem = duplicateGridItem;

      function deleteGridItem(sec, itemId, force) {
        var vg = sec.visualGrid;
        var item = vg.layoutItems.find(function(it) { return it.id === itemId; });
        if (!item) return;

        if (!force) {
          var triggerEl = document.querySelector('.grid-block-item[data-item-id="' + itemId + '"] [data-act="del-item"]') || document.body;
          showInlineDelete(
            triggerEl,
            'Delete ' + getItemLabel(item) + ' from grid?',
            null,
            function() {
              deleteGridItem(sec, itemId, true);
            }
          );
          return;
        }

        if (activeFocusedBlock && activeFocusedBlock.itemId === itemId) {
          closeBlockFocusEditor();
        }

        pushSectionHistory(sec);
        vg.layoutItems = vg.layoutItems.filter(function(it) { return it.id !== itemId; });
        if (secActiveSlotIds[sec.id] === itemId) {
          secActiveSlotIds[sec.id] = null;
        }

        normalizeSectionRows(sec);
        renderSections();
        triggerAutosave();
        showToast('Deleted ' + getItemLabel(item), 'info');
      }
      window.deleteGridItem = deleteGridItem;

      function computeCanvasRowGeometry(canvasEl, visibleRows, rowGap, minRowHeight) {
        if (!canvasEl) return { rowBounds: [] };
        var canvasRect = canvasEl.getBoundingClientRect();
        var rGap = (typeof rowGap === 'number') ? rowGap : 16;
        var minH = (typeof minRowHeight === 'number') ? minRowHeight : 80;
        var maxRows = Math.max(visibleRows || 1, 1);

        var rowTops = {};
        var rowBottoms = {};

        var cellSlots = canvasEl.querySelectorAll('.grid-cell-slot, .grid-block-anchor');
        for (var i = 0; i < cellSlots.length; i++) {
          var slot = cellSlots[i];
          var r = parseInt(slot.getAttribute('data-row') || slot.getAttribute('data-row-start'), 10);
          if (!isNaN(r)) {
            var sRect = slot.getBoundingClientRect();
            if (sRect.height > 0) {
              if (rowTops[r] === undefined || sRect.top < rowTops[r]) rowTops[r] = sRect.top;
              if (rowBottoms[r] === undefined || sRect.bottom > rowBottoms[r]) rowBottoms[r] = sRect.bottom;
              if (r > maxRows) maxRows = r;
            }
          }
        }

        var blockItems = canvasEl.querySelectorAll('.grid-block-item:not(.is-focused-editor)');
        for (var j = 0; j < blockItems.length; j++) {
          var bItem = blockItems[j];
          var bStart = parseInt(bItem.getAttribute('data-row-start'), 10);
          if (!isNaN(bStart)) {
            var bRect = bItem.getBoundingClientRect();
            if (bRect.height > 0) {
              if (rowTops[bStart] === undefined || bRect.top < rowTops[bStart]) rowTops[bStart] = bRect.top;
              if (rowBottoms[bStart] === undefined || bRect.bottom > rowBottoms[bStart]) rowBottoms[bStart] = bRect.bottom;
              if (bStart > maxRows) maxRows = bStart;
            }
          }
        }

        var rowBounds = [];
        var currentTop = canvasRect.top + 16;
        for (var r = 1; r <= maxRows; r++) {
          var top = rowTops[r];
          var bottom = rowBottoms[r];
          if (top !== undefined && bottom !== undefined && bottom > top) {
            rowBounds.push({ row: r, top: top, bottom: bottom });
            currentTop = bottom + rGap;
          } else {
            var estTop = currentTop;
            var estBottom = estTop + minH;
            rowBounds.push({ row: r, top: estTop, bottom: estBottom });
            currentTop = estBottom + rGap;
          }
        }

        var result = {
          canvasRect: canvasRect,
          rowBounds: rowBounds
        };
        if (canvasEl.isConnected && canvasRect.width > 0) {
          canvasEl._cachedRowGeometry = result;
        }
        return result;
      }
      window.computeCanvasRowGeometry = computeCanvasRowGeometry;

      function resolvePointerToGridCell(clientX, clientY, canvasEl, minRowHeight, rowGap, columnGap, cachedRect, cachedRowGeometry) {
        var rect = cachedRect || canvasEl.getBoundingClientRect();
        var padding = 16;
        var innerW = Math.max(1, rect.width - (2 * padding));
        var colGap = columnGap || 16;
        var rGap = rowGap || 16;
        var minH = minRowHeight || 80;

        var colTrackSize = ((innerW - (3 * colGap)) / 4) + colGap;

        var x = (typeof clientX === 'number' && !isNaN(clientX)) ? clientX : (rect.left + padding);
        var y = (typeof clientY === 'number' && !isNaN(clientY)) ? clientY : (rect.top + padding);
        var relX = x - (rect.left + padding);

        var col = Math.floor(relX / colTrackSize) + 1;
        col = clampVal(col, 1, 4);

        var cachedGeom = cachedRowGeometry || (canvasEl && canvasEl._cachedRowGeometry);
        if (cachedGeom && (!cachedGeom.canvasRect || cachedGeom.canvasRect.width === 0 || Math.abs(cachedGeom.canvasRect.top - rect.top) > 1)) {
          cachedGeom = null;
        }
        var geom = cachedGeom || (canvasEl ? computeCanvasRowGeometry(canvasEl, null, rGap, minH) : null);
        var row = 1;
        if (geom && Array.isArray(geom.rowBounds) && geom.rowBounds.length > 0) {
          var bounds = geom.rowBounds;
          if (y < bounds[0].top) {
            row = 1;
          } else if (y > bounds[bounds.length - 1].bottom) {
            var last = bounds[bounds.length - 1];
            var extra = Math.floor((y - last.bottom) / (minH + rGap));
            row = clampVal(last.row + Math.max(1, extra), 1, MAX_GRID_ROWS);
          } else {
            for (var i = 0; i < bounds.length; i++) {
              var b = bounds[i];
              if (y >= b.top && y <= b.bottom) {
                row = b.row;
                break;
              }
              if (i < bounds.length - 1 && y > b.bottom && y < bounds[i + 1].top) {
                var mid = (b.bottom + bounds[i + 1].top) / 2;
                row = y <= mid ? b.row : bounds[i + 1].row;
                break;
              }
            }
          }
        } else {
          var rowTrackSize = Math.max(40, minH + rGap);
          var relY = y - (rect.top + padding);
          row = Math.floor(relY / rowTrackSize) + 1;
        }

        return {
          col: clampVal(col, 1, 4),
          row: clampVal(row, 1, MAX_GRID_ROWS)
        };
      }
      window.resolvePointerToGridCell = resolvePointerToGridCell;

      function startBlockMoveAction(sec, item, canvasEl, initialEvent) {
        if (window.activeFocusedBlock) window.closeBlockFocusEditor();
        var vg = sec.visualGrid;
        var canvasRect = canvasEl.getBoundingClientRect();
        var startX = initialEvent.clientX;
        var startY = initialEvent.clientY;
        var startCell = resolvePointerToGridCell(startX, startY, canvasEl, vg.minRowHeight, vg.rowGap, vg.columnGap, canvasRect);
        var originRect = {
          columnStart: item.columnStart,
          columnSpan: item.columnSpan,
          columnEnd: item.columnStart + item.columnSpan,
          rowStart: item.rowStart,
          rowSpan: 1,
          rowEnd: item.rowStart + 1
        };
        var isDragging = false;
        var ghostEl = null;
        var moveRafId = null;
        var lastMoveTarget = null;

        var itemEl = canvasEl.querySelector('.grid-block-item[data-item-id="' + item.id + '"]');

        function onMove(e) {
          var clientX = e.clientX;
          var clientY = e.clientY;
          var dist = Math.hypot(clientX - startX, clientY - startY);
          if (!isDragging) {
            if (dist < 4) return;
            isDragging = true;
            document.body.classList.add('is-grid-dragging');
            canvasEl.classList.add('is-dragging-active');
            if (itemEl) itemEl.classList.add('is-moving');
            ghostEl = canvasEl.querySelector('.grid-placement-preview');
            if (!ghostEl) {
              ghostEl = document.createElement('div');
              ghostEl.className = 'grid-placement-preview is-valid';
              canvasEl.appendChild(ghostEl);
            }
          }

          if (moveRafId) return;
          moveRafId = requestAnimationFrame(function() {
            moveRafId = null;

            var occupiedIntent = resolveOccupiedTargetIntent(clientX, clientY, canvasEl, sec, item);
            if (occupiedIntent) {
              var reorderCand = (occupiedIntent.action === 'swap')
                ? computeSwapCandidate(vg.layoutItems, item.id, occupiedIntent.targetItem.id)
                : computeInsertionCandidate(vg.layoutItems, item.id, occupiedIntent.targetItem.id, occupiedIntent.axis, occupiedIntent.position);

              var targetKey = occupiedIntent.action + ':' + occupiedIntent.targetItem.id + ':' + (occupiedIntent.axis || '') + ':' + (occupiedIntent.position || '') + ':' + reorderCand.valid;
              if (!lastMoveTarget || lastMoveTarget.reorderKey !== targetKey) {
                lastMoveTarget = { reorderKey: targetKey };
                renderReorderPreview(canvasEl, sec, occupiedIntent, reorderCand, ghostEl, false);
              }

              secGridInteractions[sec.id] = {
                mode: 'reordering',
                itemId: item.id,
                reorderCandidate: reorderCand,
                hasCollision: !reorderCand.valid
              };
              return;
            }

            clearReorderPreview(canvasEl);
            if (ghostEl) ghostEl.style.display = '';

            var curCell = resolvePointerToGridCell(clientX, clientY, canvasEl, vg.minRowHeight, vg.rowGap, vg.columnGap, canvasRect);
            var deltaCol = curCell.col - startCell.col;
            var deltaRow = curCell.row - startCell.row;

            var candColStart = clampVal(originRect.columnStart + deltaCol, 1, 4 - originRect.columnSpan + 1);
            var candRowStart = clampVal(originRect.rowStart + deltaRow, 1, MAX_GRID_ROWS);

            var res = resolvePlacementTarget(vg.layoutItems, candColStart, candRowStart, originRect.columnSpan, true, item.id);

            if (lastMoveTarget &&
                !lastMoveTarget.reorderKey &&
                lastMoveTarget.colStart === res.columnStart &&
                lastMoveTarget.rowStart === res.rowStart &&
                lastMoveTarget.valid === res.valid) {
              return;
            }
            lastMoveTarget = { colStart: res.columnStart, rowStart: res.rowStart, valid: res.valid };

            if (ghostEl) {
              ghostEl.style.gridColumn = res.columnStart + ' / span ' + res.columnSpan;
              ghostEl.style.gridRow = res.rowStart + ' / span 1';
              if (res.valid) {
                ghostEl.className = 'grid-placement-preview is-valid';
                ghostEl.textContent = '✦ Move to (' + res.columnStart + ',' + res.rowStart + ') · ' + getSpanPercentageLabel(res.columnSpan);
              } else {
                ghostEl.className = 'grid-placement-preview is-invalid-drop';
                ghostEl.textContent = '⚠ ' + (res.reason || 'Space Occupied');
              }
            }

            secGridInteractions[sec.id] = {
              mode: 'moving',
              itemId: item.id,
              previewRect: { columnStart: res.columnStart, columnSpan: res.columnSpan, rowStart: res.rowStart, rowSpan: 1 },
              hasCollision: !res.valid
            };
          });
        }

        function onUp(e) {
          if (moveRafId) {
            cancelAnimationFrame(moveRafId);
            moveRafId = null;
          }
          window.removeEventListener('pointermove', onMove);
          window.removeEventListener('pointerup', onUp);
          window.removeEventListener('pointercancel', onUp);

          document.body.classList.remove('is-grid-dragging');
          canvasEl.classList.remove('is-dragging-active');
          clearReorderPreview(canvasEl);
          if (ghostEl) ghostEl.remove();
          if (itemEl) itemEl.classList.remove('is-moving');

          var act = secGridInteractions[sec.id];
          secGridInteractions[sec.id] = { mode: 'idle' };

          if (e && e.type === 'pointercancel') {
            renderSections();
            return;
          }

          if (isDragging && act && act.mode === 'reordering') {
            commitGridReorder(sec, act.reorderCandidate);
          } else if (isDragging && act && act.mode === 'moving') {
            if (act.hasCollision) {
              showToast('Space occupied — position reverted', 'warning');
              renderSections();
            } else if (act.previewRect && (act.previewRect.columnStart !== originRect.columnStart || act.previewRect.rowStart !== originRect.rowStart)) {
              commitBlockMove(sec, item, act.previewRect.columnStart, act.previewRect.rowStart);
            } else {
              renderSections();
            }
          }
        }

        window.addEventListener('pointermove', onMove);
        window.addEventListener('pointerup', onUp);
        window.addEventListener('pointercancel', onUp);
      }

      function startBlockResizeAction(sec, item, edge, canvasEl, initialEvent) {
        if (window.activeFocusedBlock) window.closeBlockFocusEditor();
        var vg = sec.visualGrid;
        var canvasRect = canvasEl.getBoundingClientRect();
        var originRect = {
          columnStart: item.columnStart,
          columnSpan: item.columnSpan,
          columnEnd: item.columnStart + item.columnSpan,
          rowStart: item.rowStart,
          rowSpan: 1,
          rowEnd: item.rowStart + 1
        };

        var itemEl = canvasEl.querySelector('.grid-block-item[data-item-id="' + item.id + '"]');
        if (itemEl) itemEl.classList.add('is-resizing');
        document.body.classList.add('is-grid-dragging');
        canvasEl.classList.add('is-dragging-active');

        var ghostEl = canvasEl.querySelector('.grid-placement-preview');
        if (!ghostEl) {
          ghostEl = document.createElement('div');
          ghostEl.className = 'grid-placement-preview is-valid';
          canvasEl.appendChild(ghostEl);
        }

        var tooltip = document.createElement('div');
        tooltip.className = 'grid-resize-tooltip';
        if (itemEl) itemEl.appendChild(tooltip);

