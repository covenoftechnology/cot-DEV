                    'data-rich-callout-heading="true"',
                    headingVal,
                    curDefaultTitle
                  ) : ''
                ) +
              '</div>';

            var legacyVal = d.text !== undefined ? d.text : d.body;
            var isLegacyCallout = (!Array.isArray(d.blocks) || d.blocks.length === 0) && (
              typeof legacyVal === 'string' ? legacyVal.trim().length > 0 : (legacyVal && typeof legacyVal === 'object' && legacyVal.text && legacyVal.text.trim().length > 0)
            );

            if (isLegacyCallout) {
              html +=
                renderRichTextFieldHtml('Content', 'data-rich-field="text"', legacyVal, 'Advisory message body...') +
                '<div class="callout-legacy-upgrade-bar">' +
