---
import { ARTICLE_BLOCK_REGISTRY, ARTICLE_BLOCK_CATEGORIES, getInsertablePaletteBlocks } from '../../lib/article-block-registry';
import {
  ARTICLE_CATEGORIES,
  ARTICLE_DIFFICULTIES,
  ARTICLE_TAGS,
  DIFFICULTY_GLYPHS,
  mergeCategories,
  mergeTags,
} from '../../lib/article-taxonomy';
import { getArticleCategories, getArticleTags, getPublishedArticles } from '../../lib/articles';
import '../../styles/article-studio.css';

const blockRegistry = ARTICLE_BLOCK_REGISTRY;
const blockCategories = ARTICLE_BLOCK_CATEGORIES;
const publishedCats = getArticleCategories();
const publishedTags = getArticleTags();
const mergedCategories = mergeCategories(publishedCats);
const mergedTags = mergeTags(publishedTags);
const publishedArticles = getPublishedArticles().map(a => ({
  slug: a.slug,
  title: a.meta.title,
  category: a.meta.category,
  difficulty: a.meta.difficulty,
  tags: a.meta.tags,
}));
const canonicalCategories = ARTICLE_CATEGORIES;
const canonicalDifficulties = ARTICLE_DIFFICULTIES;
const canonicalTags = ARTICLE_TAGS;
const difficultyGlyphs = DIFFICULTY_GLYPHS;
const totalBlockCount = getInsertablePaletteBlocks().length;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Coven Article Studio — Local Authoring CMS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
  <link href="https://fonts.googleapis.com/css2?family=Metamorphous&family=EB+Garamond:ital,wght@0,400..700;1,400..700&family=IBM+Plex+Mono:wght@400;600&family=Cinzel:wght@600;700&display=swap" rel="stylesheet" />
</head>
<body class="coven-studio">

  <!-- Top Sticky Toolbar -->
  <header class="studio-topbar">
    <a href="/" class="studio-brand" aria-label="Go to Coven of Technology home">
      <div class="brand-icon">✶</div>
      <div class="brand-title">Coven Article Studio</div>
      <div class="brand-badge">V2 Authoring</div>
      <div class="status-indicator">
        <span class="status-dot" id="status-dot"></span>
        <span id="status-indicator">Ready</span>
      </div>
      <div class="editing-indicator" id="editing-source-indicator" style="display:none;align-items:center;gap:6px;font-family:var(--font-mono);font-size:11px;color:var(--studio-gold-bright);background:rgba(216,181,107,0.1);border:1px solid rgba(216,181,107,0.25);padding:3px 10px;border-radius:4px;margin-left:8px;">Editing: <span id="editing-source-title"></span></div>
    </a>

    <div class="studio-actions">
      <button class="studio-btn studio-btn--secondary" id="btn-new" title="Create a new article draft" type="button">+ New Article</button>
      <a href="/template-preview/articles" class="studio-btn studio-btn--ghost" id="btn-article-center" title="Open Coven Article Center">Article Center</a>
      <button class="studio-btn studio-btn--ghost" id="btn-duplicate-article" title="Duplicate current article" type="button">Duplicate</button>
      <button class="studio-btn studio-btn--secondary" id="btn-save-draft" title="Save draft immediately" type="button">Save Draft</button>
      <button class="studio-btn studio-btn--secondary" id="btn-preview" title="Live preview in single reusable tab" type="button">Preview ↗</button>
      <button class="studio-btn studio-btn--primary" id="btn-publish" title="Publish article to src/articles" type="button">Publish ✦</button>
    </div>
  </header>

  <!-- Main 3-Column Workspace -->
  <main class="studio-workspace">

    <!-- Column 1: Block Library -->
    <aside class="studio-library-pane" id="pane-library">
      <div class="library-header">
        <span class="library-title">Block Library</span>
        <span class="library-count-badge" id="block-library-count">{totalBlockCount} Patterns</span>
      </div>

      <div class="library-search-wrap">
        <input type="text" id="library-search-input" class="studio-input" placeholder="Search blocks..." autocomplete="off" />
        <button type="button" id="library-search-clear" class="library-search-clear-btn" aria-label="Clear block search" title="Clear search" style="display:none">×</button>
      </div>

      <div class="library-categories-list" id="palette-categories-container">
        <!-- Rendered dynamically -->
      </div>
    </aside>

    <!-- Column 2: Article Content Structure -->
    <section class="studio-center-pane" id="pane-center">
      <div class="center-header">
        <span class="center-title">Article Content Structure</span>
        <span class="section-counter-badge" id="section-counter-badge">0 Sections</span>
      </div>

      <div class="sections-container" id="sections-container">
        <!-- Sections will be rendered here dynamically -->
      </div>

      <!-- Trailing Add Section Action (only visible when 1+ sections exist) -->
      <div class="add-section-zone" id="trailing-add-section-zone" style="display:none">
        <button type="button" class="studio-btn studio-btn--secondary" id="btn-add-section-trailing" style="padding:0 24px">
          <span>✦ Add New Section</span>
        </button>
      </div>
    </section>

    <!-- Column 3: Article Settings -->
    <aside class="studio-settings-pane" id="pane-settings">
      <div class="settings-header">
        <span class="settings-title">Article Settings</span>
        <span class="settings-subtitle">Primary Metadata</span>
      </div>

      <!-- PRIMARY SETTINGS -->
      <div class="studio-form-group">
        <label class="studio-label" for="meta-title">Title *</label>
        <input type="text" id="meta-title" class="studio-input" placeholder="Sacred Title of the Scroll..." autocomplete="off" />
      </div>

      <div class="studio-form-group">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
          <label class="studio-label" for="meta-slug" style="margin-bottom:0">Slug</label>
          <button type="button" class="studio-btn studio-btn--sm" id="btn-slug-generate" style="padding:2px 8px;font-size:10px;height:22px;letter-spacing:0.5px" title="Generate slug once from current title">Generate from Title</button>
        </div>
        <input type="text" id="meta-slug" class="studio-input slug-full-input" placeholder="my-custom-article-slug" autocomplete="off" />
        <div class="slug-url-preview-bar">
          <span class="slug-url-label">ARTICLE URL</span>
          <span class="slug-url-path" id="slug-url-preview">/article/untitled-scroll</span>
        </div>
        <div id="slug-published-warning" class="slug-published-warning" style="display:none">
          ⚠️ Changing the slug changes this article's public URL.
        </div>
      </div>

      <div class="studio-form-group">
        <label class="studio-label" for="meta-desc">Description / Excerpt *</label>
        <textarea id="meta-desc" class="studio-textarea" style="min-height:95px" placeholder="Editorial excerpt for the library and hero lead..."></textarea>
      </div>

      <div class="studio-form-group">
        <label class="studio-label" for="meta-author">Author</label>
        <input type="text" id="meta-author" class="studio-input" value="Oracle of Orgs" autocomplete="off" />
      </div>

      <div class="studio-form-group">
        <label class="studio-label" id="category-label">Category *</label>
        <div class="coven-combobox" id="category-combobox" role="combobox" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="category-label">
          <button type="button" class="combobox-trigger" id="category-trigger" aria-controls="category-dropdown" aria-label="Select Category">
            <span class="combobox-value" id="category-trigger-text">Salesforce</span>
            <span class="combobox-caret">▾</span>
          </button>
          <div class="combobox-menu" id="category-dropdown" role="listbox" aria-labelledby="category-label" style="display:none">
            <div class="combobox-search-box">
              <input type="text" id="category-search-input" class="combobox-search-input" placeholder="Search category..." autocomplete="off" aria-autocomplete="list" />
            </div>
            <div class="combobox-options" id="category-options-list">
              <!-- Populated via JS -->
            </div>
            <div class="combobox-create-option" id="category-create-row" style="display:none">
              <!-- "+ Create ..." -->
            </div>
          </div>
          <input type="hidden" id="meta-category" value="Salesforce" />
        </div>
      </div>

      <div class="studio-form-group">
        <label class="studio-label" id="difficulty-label">Difficulty *</label>
        <div class="coven-select-dropdown" id="difficulty-combobox" role="combobox" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="difficulty-label">
          <button type="button" class="combobox-trigger" id="difficulty-trigger" aria-controls="difficulty-options-menu" aria-label="Select Difficulty">
            <span class="combobox-value" id="difficulty-trigger-text">✦ Lv. 1 - Incantation</span>
            <span class="combobox-caret">▾</span>
          </button>
          <div class="combobox-menu" id="difficulty-options-menu" role="listbox" aria-labelledby="difficulty-label" style="display:none">
            <div class="combobox-options" id="difficulty-options-list">
              <!-- Populated dynamically with Lv. 1, Lv. 2, Lv. 3 -->
            </div>
          </div>
          <input type="hidden" id="meta-difficulty" value="Lv. 1 - Incantation" />
        </div>
      </div>

      <div class="studio-form-group">
        <label class="studio-label" id="tags-label">Tags</label>
        <div class="coven-tags-combobox" id="tags-combobox-wrap" role="combobox" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="tags-label">
          <div class="tag-chips-container" id="tag-chips-container" tabindex="-1">
            <input type="text" id="tag-inline-input" class="tag-input-inline" placeholder="Search or add a tag..." autocomplete="off" aria-autocomplete="list" aria-controls="tags-dropdown-menu" />
          </div>
          <div class="combobox-menu tag-suggestions-menu" id="tags-dropdown-menu" role="listbox" aria-labelledby="tags-label" style="display:none">
            <div class="combobox-options" id="tags-options-list">
              <!-- Populated dynamically -->
            </div>
            <div class="combobox-create-option" id="tag-create-row" style="display:none">
              <!-- "+ Create ..." -->
            </div>
          </div>
        </div>
        <div style="font-family:var(--font-mono);font-size:10px;color:var(--studio-text-muted);margin-top:4px">Type to search, press Enter/comma or select suggestion</div>
      </div>

      <div class="studio-form-group">
        <label class="studio-label">Status</label>
        <div class="segmented-control" id="status-segmented">
          <button type="button" class="segment-btn active" data-status="draft">Draft</button>
          <button type="button" class="segment-btn" data-status="published">Published</button>
        </div>
      </div>

      <div class="studio-form-group">
        <label class="studio-label">Reading Time (Calculated)</label>
        <div class="reading-time-pill" id="reading-time-pill">
          <span>⏱</span>
          <span id="reading-time-text">≈ 1 min</span>
        </div>
      </div>

      <!-- ADVANCED SETTINGS (DISCLOSURE) -->
      <div class="advanced-settings-box" id="adv-settings-box">
        <button type="button" class="advanced-settings-toggle" id="adv-settings-toggle">
          <span>Advanced Settings</span>
          <span class="adv-arrow">▾</span>
        </button>
        <div class="advanced-settings-body" id="adv-settings-body">
          <div class="studio-form-group">
            <label class="studio-label">Rank</label>
            <select id="meta-rank" class="studio-select">
              <option value="Novice">Novice</option>
              <option value="Initiate">Initiate</option>
              <option value="Acolyte">Acolyte</option>
              <option value="Mechanic" selected>Mechanic</option>
              <option value="Architect">Architect</option>
              <option value="Archmage">Archmage</option>
            </select>
          </div>

          <div class="studio-form-group">
            <label class="studio-label">Aether Reward</label>
            <input type="number" id="meta-aether" class="studio-input" value="120" />
          </div>

          <label class="checkbox-row">
            <input type="checkbox" id="meta-featured" />
            <span>Featured Scroll</span>
          </label>

          <label class="checkbox-row">
            <input type="checkbox" id="meta-wide" checked />
            <span>Wide Editorial Layout</span>
          </label>

          <div class="studio-form-group">
            <label class="studio-label">Cover Image URL / Upload</label>
            <div class="image-picker-row">
              <input type="text" id="meta-cover" class="studio-input" placeholder="Start empty or paste URL / upload" />
              <input type="file" id="cover-file-upload" style="display:none" accept="image/*" />
              <button type="button" class="studio-btn studio-btn--sm" id="btn-upload-cover">Upload</button>
            </div>
          </div>

          <div class="studio-form-group" id="cover-caption-group" style="display:none">
            <label class="studio-label">Cover Caption</label>
            <input type="text" id="meta-cover-caption" class="studio-input" placeholder="Figure · Architectural overview..." />
          </div>
        </div>
      </div>

    </aside>

  </main>

  <!-- Modals -->
  <!-- 1. Drafts Modal -->
  <div class="studio-modal-backdrop" id="drafts-modal">
    <div class="studio-modal">
      <div class="studio-modal-title">SAVED DRAFTS</div>
      <div id="drafts-list" style="display:flex;flex-direction:column;gap:10px;max-height:360px;overflow-y:auto;padding-right:6px">
        <!-- Draft cards -->
      </div>
      <div class="studio-modal-actions">
        <button type="button" class="studio-btn studio-btn--secondary" id="btn-close-drafts">Close</button>
      </div>
    </div>
  </div>

  <!-- 2. Delete Confirmation Modal (Replaces window.confirm) -->
  <div class="studio-modal-backdrop" id="delete-confirm-modal">
    <div class="studio-modal" style="width:420px">
      <div class="studio-modal-title" id="delete-modal-title" style="color:var(--studio-gold-bright)">DELETE CONFIRMATION</div>
      <div id="delete-modal-message" style="font-family:var(--font-body);font-size:15px;color:var(--studio-text-dim);line-height:1.5">
        Are you sure you wish to proceed? This cannot be undone.
      </div>
      <div class="studio-modal-actions">
        <button type="button" class="studio-btn studio-btn--secondary" id="btn-cancel-delete">Cancel</button>
        <button type="button" class="studio-btn studio-btn--danger" id="btn-confirm-delete">Delete</button>
      </div>
    </div>
  </div>

  <!-- Toast Notification Container -->
  <div class="studio-toast-container" id="toast-container"></div>

  <!-- Custom Color Popover -->
  <div id="coven-custom-color-popover" class="coven-custom-color-popover" style="display:none" role="dialog" aria-label="Custom color picker">
    <div class="custom-color-popover-header">
      <span class="custom-color-popover-title">CUSTOM COLOR</span>
      <span class="custom-color-swatch-badge" id="coven-custom-color-preview-badge" style="background:#C45AFF" title="Active preview"></span>
    </div>

    <div class="custom-color-picker-row">
      <button type="button" class="custom-color-trigger-btn" id="coven-custom-color-trigger-btn" aria-label="Choose custom color" title="Open color chooser">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="13.5" cy="6.5" r=".5" fill="currentColor"></circle>
          <circle cx="17.5" cy="10.5" r=".5" fill="currentColor"></circle>
          <circle cx="8.5" cy="7.5" r=".5" fill="currentColor"></circle>
          <circle cx="6.5" cy="12.5" r=".5" fill="currentColor"></circle>
          <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"></path>
        </svg>
        <span class="custom-color-trigger-indicator" id="coven-custom-color-trigger-swatch" style="background:#C45AFF"></span>
      </button>

      <input type="color" id="coven-custom-color-native" class="custom-color-native-hidden" value="#C45AFF" tabindex="-1" aria-hidden="true" />

      <div class="custom-color-hex-group">
        <input type="text" id="coven-custom-color-hex" class="custom-color-hex-field" value="#C45AFF" maxlength="7" spellcheck="false" aria-label="Hex color value" placeholder="#C45AFF" />
      </div>
    </div>

    <div class="custom-color-error" id="coven-custom-color-error" style="display:none">Invalid HEX color</div>

    <div class="custom-color-popover-actions">
      <button type="button" class="studio-btn studio-btn--sm custom-color-btn-cancel" id="coven-custom-color-cancel">Cancel</button>
      <button type="button" class="studio-btn studio-btn--sm studio-btn--primary custom-color-btn-apply" id="coven-custom-color-apply">Apply</button>
    </div>

    <div class="custom-color-save-row">
      <button type="button" class="custom-color-save-action" id="coven-custom-color-save" title="Save this color to your reusable palette">
        <span class="custom-color-save-star">★</span> Save to Palette
      </button>
    </div>
  </div>

  <!-- Client-side Logic -->
  <script define:vars={{
    blockRegistry,
    blockCategories,
    canonicalCategories,
    canonicalDifficulties,
    canonicalTags,
    difficultyGlyphs,
    mergedCategories,
    mergedTags,
    publishedArticles
  }}>
    window.STUDIO_REGISTRY = blockRegistry;
    window.STUDIO_CATEGORIES = blockCategories;
    window.STUDIO_CANONICAL_CATEGORIES = canonicalCategories;
    window.STUDIO_CANONICAL_DIFFICULTIES = canonicalDifficulties;
    window.STUDIO_CANONICAL_TAGS = canonicalTags;
    window.STUDIO_DIFFICULTY_GLYPHS = difficultyGlyphs;
    window.STUDIO_MERGED_CATEGORIES = mergedCategories;
    window.STUDIO_MERGED_TAGS = mergedTags;
    window.STUDIO_PUBLISHED_ARTICLES = publishedArticles;

    function isInsertablePaletteBlock(b) {
      var type = typeof b === 'string' ? b : (b ? b.type : '');
      return type !== 'text-title' && type !== 'bullet-list';
    }
    window.isInsertablePaletteBlock = isInsertablePaletteBlock;
    window.getInsertablePaletteBlocks = function() {
      return Object.values(window.STUDIO_REGISTRY).filter(isInsertablePaletteBlock);
    };

    function canNestInCallout(b) {
      var type = typeof b === 'string' ? b : (b ? b.type : '');
      if (!type) return false;
      var def = window.STUDIO_REGISTRY ? window.STUDIO_REGISTRY[type] : null;
      if (def && typeof def.canNestInCallout === 'boolean') {
        return def.canNestInCallout;
      }
      return type !== 'callout' && type !== 'flex-layout' && type !== 'article-trial';
    }
    window.canNestInCallout = canNestInCallout;

    function canNestInFlexLayout(b) {
      var type = typeof b === 'string' ? b : (b ? b.type : '');
      if (!type) return false;
      var def = window.STUDIO_REGISTRY ? window.STUDIO_REGISTRY[type] : null;
      if (def && typeof def.canNestInFlexLayout === 'boolean') {
        return def.canNestInFlexLayout;
      }
      return type !== 'flex-layout';
    }
    window.canNestInFlexLayout = canNestInFlexLayout;

    // Abstract glyphs for each block type in library and card headers
    var BLOCK_GLYPHS = {
      'title-text': '=',
      'text-title': '≈',
      'solo-text': '¶',
      'bullet-list': '✦',
      'nested-bullets': '◈',
      'numbered-steps': '①',
      'text-image': '◫',
      'image-text': '◪',
      'two-columns': '▥',
      'three-columns': '▤',
      'flex-layout': '⊞',
      'single-image': '📷',
      'full-image': '🖼',
      'two-images': '⚏',
      'three-images': '⚌',
      'gallery-scroll': '☷',
      'card-grid-2': '⊞',
      'card-grid-3': '⊟',
      'comparison': '⚖',
      'stats-metrics': '%',
      'technical-table': '▦',
      'callout': '▲',
      'pullquote': '❝',
      'code-block': '</>',
      'faq': '?',
      'exercise': '⚔',
      'article-trial': '✶',
      'key-takeaways': '★',
      'related-docs': '↗'
    };

    (function() {
      // ── Stable ID Generator ─────────────────────────────
      function uid(prefix) {
        return (prefix || 'id') + '_' + Date.now().toString(36) + '_' + Math.random().toString(36).substring(2, 7);
      }

      // ── Canonical Slug Normalization ────────────────────
      function normalizeSlugClient(input, allowTrailingHyphen) {
        if (!input || typeof input !== 'string') return '';
        var normalized = input
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/-+/g, '-')
          .replace(/^-+/g, '');

        if (!allowTrailingHyphen) {
          normalized = normalized.replace(/-+$/g, '');
        }
        return normalized;
      }

      function isValidSlugClient(slug) {
        if (!slug || typeof slug !== 'string') return false;
        return /^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug);
      }

      function slugify(text) {
        return (text || '')
          .toString()
          .toLowerCase()
          .trim()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/(^-|-$)/g, '');
      }

      function escapeHtml(str) {
        if (!str && str !== 0) return '';
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }

      // ── Rich Text Helpers (Basic Typography: title-text, text-title, solo-text) ──
      function getRichData(val) {
        if (val && typeof val === 'object') {
          return {
            text: typeof val.text === 'string' ? val.text : (typeof val.content === 'string' ? val.content : ''),
            align: (val.align === 'center' || val.align === 'right') ? val.align : 'left'
          };
        }
        return {
          text: typeof val === 'string' ? val : '',
          align: 'left'
        };
      }

      function validateLinkUrl(url) {
        if (!url || typeof url !== 'string') return false;
        var trimmed = url.trim();
        if (!trimmed) return false;

        // Internal relative route
        if (trimmed.startsWith('/')) {
          if (trimmed.startsWith('//')) return false;
          if (trimmed.includes('\\')) return false;
          if (trimmed.includes('/../') || trimmed.endsWith('/..') || trimmed === '/..') return false;
          if (trimmed.includes('/./') || trimmed.endsWith('/.') || trimmed === '/.') return false;
          return true;
        }

        // External URL: only http: and https:
        if (/^https?:\/\//i.test(trimmed)) {
          try {
            var parsed = new URL(trimmed);
            if (parsed.protocol !== 'http:' && parsed.protocol !== 'https:') return false;
            if (!parsed.hostname || parsed.hostname.indexOf('.') === -1) return false;
            return true;
          } catch (e) {
            return false;
          }
        }

        return false;
      }

      function sanitizeRichText(html) {
        if (!html || typeof html !== 'string') return '';
        var parser = new DOMParser();
        var doc = parser.parseFromString('<div>' + html + '</div>', 'text/html');
        var root = doc.body.firstElementChild || doc.body;

        function cleanNode(node) {
          var children = Array.from(node.childNodes);
          for (var i = 0; i < children.length; i++) {
            var child = children[i];
            if (child.nodeType === 3) continue;
            if (child.nodeType === 1) {
              var tag = child.tagName.toLowerCase();
              cleanNode(child);
              if (tag === 'b' || tag === 'strong') {
                var strong = doc.createElement('strong');
                while (child.firstChild) strong.appendChild(child.firstChild);
                child.parentNode.replaceChild(strong, child);
              } else if (tag === 'i' || tag === 'em') {
                var em = doc.createElement('em');
                while (child.firstChild) em.appendChild(child.firstChild);
                child.parentNode.replaceChild(em, child);
              } else if (tag === 'u') {
                var u = doc.createElement('u');
                while (child.firstChild) u.appendChild(child.firstChild);
                child.parentNode.replaceChild(u, child);
              } else if (tag === 'span') {
                var allowedColorClasses = ['article-text-gold', 'article-text-purple', 'article-text-muted'];
                var allowedBgClasses = [
                  'article-text-bg-neutral',
                  'article-text-bg-purple',
                  'article-text-bg-gold',
                  'article-text-bg-green',
                  'article-text-bg-red'
                ];
                var matchedColor = allowedColorClasses.find(function(c) { return child.classList.contains(c); });
                var matchedBg = allowedBgClasses.find(function(c) { return child.classList.contains(c); });

                var styleAttr = child.getAttribute('style') || '';
                var validStyles = [];
                var validClasses = [];

                if (child.classList.contains('article-text-custom-color')) {
                  var mCol = styleAttr.match(/--coven-custom-text-color:\s*(#[0-9a-fA-F]{3,6})/i);
                  if (mCol && /^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/.test(mCol[1])) {
                    var normCol = normalizeHex(mCol[1]);
                    validClasses.push('article-text-custom-color');
                    validStyles.push('--coven-custom-text-color:' + normCol);
                  }
                } else if (matchedColor) {
                  validClasses.push(matchedColor);
                }

                if (child.classList.contains('article-text-custom-bg')) {
                  var mBg = styleAttr.match(/--coven-custom-bg:\s*(#[0-9a-fA-F]{3,6})/i);
                  if (mBg && /^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/.test(mBg[1])) {
                    var normBg = normalizeHex(mBg[1]);
                    validClasses.push('article-text-custom-bg');
                    validStyles.push('--coven-custom-bg:' + normBg);
                  }
                } else if (matchedBg) {
                  validClasses.push(matchedBg);
                }

                if (validClasses.length > 0) {
                  child.className = validClasses.join(' ');
                  if (validStyles.length > 0) {
                    child.setAttribute('style', validStyles.join(';'));
                  } else {
                    child.removeAttribute('style');
                  }
                } else {
                  while (child.firstChild) child.parentNode.insertBefore(child.firstChild, child);
                  child.parentNode.removeChild(child);
                }
              } else if (tag === 'a') {
                var rawHref = child.getAttribute('href') || '';
                if (validateLinkUrl(rawHref)) {
                  // Prevent nested anchors: unwrap any <a> inside this <a>
                  var nestedAnchors = Array.from(child.querySelectorAll('a'));
                  nestedAnchors.forEach(function(na) {
                    while (na.firstChild) na.parentNode.insertBefore(na.firstChild, na);
                    na.parentNode.removeChild(na);
                  });

                  var cleanA = doc.createElement('a');
                  cleanA.setAttribute('href', rawHref.trim());
                  var isExt = /^https?:\/\//i.test(rawHref.trim());
                  if (isExt) {
                    cleanA.setAttribute('target', '_blank');
                    cleanA.setAttribute('rel', 'noopener noreferrer');
                  }
                  var allowedLinkColorClasses = [
                    'article-rich-link--gold',
                    'article-rich-link--purple',
                    'article-rich-link--parchment',
                    'article-rich-link--muted'
                  ];
                  var matchedClass = allowedLinkColorClasses.find(function(c) { return child.classList.contains(c); });
                  cleanA.className = 'article-rich-link' + (matchedClass ? ' ' + matchedClass : '');
                  while (child.firstChild) cleanA.appendChild(child.firstChild);
                  child.parentNode.replaceChild(cleanA, child);
                } else {
                  // Unsafe or invalid href: unwrap children, remove anchor!
                  while (child.firstChild) child.parentNode.insertBefore(child.firstChild, child);
                  child.parentNode.removeChild(child);
                }
              } else if (tag === 'br') {
                // keep br
              } else {
                while (child.firstChild) child.parentNode.insertBefore(child.firstChild, child);
                child.parentNode.removeChild(child);
              }
            } else {
              child.parentNode.removeChild(child);
            }
          }
        }

        cleanNode(root);
        return root.innerHTML;
      }

      var SAVED_COLORS_KEY = 'coven.articleStudio.savedColors.v1';
      var DEFAULT_SAVED_COLORS = ['#C45AFF', '#52E8A5'];

      function normalizeHex(hex) {
        if (!hex || typeof hex !== 'string') return null;
        hex = hex.trim();
        if (!/^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/.test(hex)) return null;
        if (hex.length === 4) {
          return ('#' + hex[1] + hex[1] + hex[2] + hex[2] + hex[3] + hex[3]).toUpperCase();
        }
        return hex.toUpperCase();
      }

      function getSavedColors() {
        try {
          var raw = localStorage.getItem(SAVED_COLORS_KEY);
          if (raw === null) {
            localStorage.setItem(SAVED_COLORS_KEY, JSON.stringify(DEFAULT_SAVED_COLORS));
            return DEFAULT_SAVED_COLORS.slice();
          }
          var parsed = JSON.parse(raw);
          return Array.isArray(parsed) && parsed.length > 0 ? parsed : DEFAULT_SAVED_COLORS.slice();
        } catch (e) {
          return DEFAULT_SAVED_COLORS.slice();
        }
      }

      function saveColorToPalette(hex) {
        var norm = normalizeHex(hex);
        if (!norm) return false;
        var colors = getSavedColors();
        var exists = colors.some(function(c) { return c.toUpperCase() === norm.toUpperCase(); });
        if (!exists) {
          colors.push(norm);
          try {
            localStorage.setItem(SAVED_COLORS_KEY, JSON.stringify(colors));
          } catch (e) {}
        }
        updateAllSavedSwatchesUI();
        return true;
      }

      function removeColorFromPalette(hex) {
        var norm = normalizeHex(hex);
        if (!norm) return;
        var colors = getSavedColors().filter(function(c) {
          return c.toUpperCase() !== norm.toUpperCase();
        });
        try {
          localStorage.setItem(SAVED_COLORS_KEY, JSON.stringify(colors));
        } catch (e) {}
        updateAllSavedSwatchesUI();
      }

      function updateAllSavedSwatchesUI() {
        var saved = getSavedColors();

        document.querySelectorAll('.rich-palette-saved-section').forEach(function(sec) {
          sec.style.display = 'flex';
          var grid = sec.querySelector('.rich-saved-swatches-grid');
          if (!grid) return;
          grid.innerHTML = '';
          saved.forEach(function(hex) {
            var chip = document.createElement('div');
            chip.className = 'saved-swatch-chip';
            chip.setAttribute('data-hex', hex);
            chip.setAttribute('title', hex);
            chip.style.backgroundColor = hex;

            var delBtn = document.createElement('button');
            delBtn.type = 'button';
            delBtn.className = 'saved-swatch-del';
            delBtn.setAttribute('data-del-hex', hex);
            delBtn.setAttribute('title', 'Remove ' + hex + ' from favorites');
            delBtn.innerHTML = '×';

            chip.appendChild(delBtn);
            grid.appendChild(chip);
          });
        });

        document.querySelectorAll('.callout-saved-swatches').forEach(function(row) {
          row.innerHTML = '';
          var activeHex = (row.getAttribute('data-active-hex') || '').toUpperCase();
          saved.forEach(function(hex) {
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'studio-swatch callout-accent-swatch' + (activeHex === hex.toUpperCase() ? ' is-active' : '');
            btn.setAttribute('data-act', 'callout-accent-swatch');
            btn.setAttribute('data-hex', hex);
            btn.setAttribute('title', 'Callout accent ' + hex);
            btn.style.width = '24px';
            btn.style.height = '24px';
            btn.style.borderRadius = '3px';
            btn.style.backgroundColor = hex;
            btn.style.border = (activeHex === hex.toUpperCase()) ? '2px solid var(--studio-gold)' : '1px solid rgba(255,255,255,0.25)';
            btn.style.cursor = 'pointer';
            row.appendChild(btn);
          });
        });
      }

      var customColorPickerState = {
        anchorEl: null,
        savedRange: null,
        surface: null,
        onApply: null,
        onSave: null
      };

      function openAnchoredPopover(popoverEl, triggerEl) {
        closeAllPopovers(popoverEl);

        popoverEl.style.display = 'flex';
        popoverEl.style.position = 'fixed';
        popoverEl.style.zIndex = '99999';
        popoverEl.style.visibility = 'hidden';

        var trigRect = triggerEl.getBoundingClientRect();

        if (popoverEl.classList.contains('nested-marker-dropdown')) {
          var targetWidth = Math.max(180, Math.round(trigRect.width));
          popoverEl.style.width = targetWidth + 'px';
          popoverEl.style.right = 'auto';
        }

        var popRect = popoverEl.getBoundingClientRect();
        var popHeight = popRect.height || 220;
        var popWidth = popRect.width || 170;

        var spaceBelow = window.innerHeight - trigRect.bottom;
        var spaceAbove = trigRect.top;

        var top;
        if (spaceBelow < (popHeight + 12) && spaceAbove > spaceBelow) {
          top = Math.max(8, trigRect.top - popHeight - 4);
          popoverEl.classList.add('is-flipped-above');
        } else {
          top = Math.min(window.innerHeight - popHeight - 8, trigRect.bottom + 4);
          popoverEl.classList.remove('is-flipped-above');
        }

        var left = trigRect.left;
        if (left + popWidth > window.innerWidth - 8) {
          left = Math.max(8, window.innerWidth - popWidth - 8);
        }
        if (left < 8) left = 8;

        popoverEl.style.top = Math.round(top) + 'px';
        popoverEl.style.left = Math.round(left) + 'px';
        popoverEl.style.visibility = 'visible';
      }

      function closeAllPopovers(exceptEl) {
        document.querySelectorAll('.rich-color-menu, .rich-highlight-menu, .rich-link-popover, .coven-custom-color-popover, .nested-marker-dropdown').forEach(function(m) {
          if (m !== exceptEl) {
            m.style.display = 'none';
            m.classList.remove('is-flipped-above');
            m.style.top = '';
            m.style.left = '';
            m.style.width = '';
            m.style.right = '';
            m.style.position = '';
            m.style.zIndex = '';
          }
        });
      }

      function openCustomColorPicker(anchorEl, initialHex, onApply, onSave, targetSurface, formatType) {
        var popover = document.getElementById('coven-custom-color-popover');
        if (!popover) return;

        var hexInput = document.getElementById('coven-custom-color-hex');
        var nativeInput = document.getElementById('coven-custom-color-native');
        var previewBadge = document.getElementById('coven-custom-color-preview-badge');
        var triggerSwatch = document.getElementById('coven-custom-color-trigger-swatch');
        var errorEl = document.getElementById('coven-custom-color-error');
        var applyBtn = document.getElementById('coven-custom-color-apply');
        var saveBtn = document.getElementById('coven-custom-color-save');

        var norm = normalizeHex(initialHex) || '#C45AFF';
        if (hexInput) hexInput.value = norm;
        if (nativeInput) nativeInput.value = norm;
        if (previewBadge) previewBadge.style.background = norm;
        if (triggerSwatch) triggerSwatch.style.background = norm;
        if (errorEl) errorEl.style.display = 'none';
        if (applyBtn) applyBtn.disabled = false;
        if (saveBtn) saveBtn.disabled = false;

        customColorPickerState.anchorEl = anchorEl;
        customColorPickerState.onApply = onApply;
        customColorPickerState.onSave = onSave;
        customColorPickerState.surface = targetSurface || null;

        if (targetSurface) {
          var r = resolveSmartRange(targetSurface, formatType || 'color');
          customColorPickerState.savedRange = r ? r.cloneRange() : null;
        } else {
          customColorPickerState.savedRange = null;
        }

        openAnchoredPopover(popover, anchorEl);
        if (hexInput) {
          hexInput.focus();
          hexInput.select();
        }
      }

      function initCustomColorPicker() {
        var popover = document.getElementById('coven-custom-color-popover');
        if (!popover) return;

        var triggerBtn = document.getElementById('coven-custom-color-trigger-btn');
        var triggerSwatch = document.getElementById('coven-custom-color-trigger-swatch');
        var previewBadge = document.getElementById('coven-custom-color-preview-badge');
        var nativeInput = document.getElementById('coven-custom-color-native');
        var hexInput = document.getElementById('coven-custom-color-hex');
        var errorEl = document.getElementById('coven-custom-color-error');
        var cancelBtn = document.getElementById('coven-custom-color-cancel');
        var applyBtn = document.getElementById('coven-custom-color-apply');
        var saveBtn = document.getElementById('coven-custom-color-save');

        if (triggerBtn && nativeInput) {
          triggerBtn.addEventListener('click', function(e) {
            e.preventDefault();
            nativeInput.click();
          });
        }

        if (nativeInput) {
          nativeInput.addEventListener('input', function() {
            var val = (nativeInput.value || '').toUpperCase();
            if (hexInput) hexInput.value = val;
            if (previewBadge) previewBadge.style.background = val;
            if (triggerSwatch) triggerSwatch.style.background = val;
            if (errorEl) errorEl.style.display = 'none';
            if (applyBtn) applyBtn.disabled = false;
            if (saveBtn) saveBtn.disabled = false;
          });
        }

        function getNormalizedHexFromInput() {
          if (!hexInput) return null;
          var raw = hexInput.value.trim();
          if (!raw) return null;
          if (!raw.startsWith('#')) raw = '#' + raw;
          return normalizeHex(raw);
        }

        function syncHexToPreview() {
          var norm = getNormalizedHexFromInput();
          if (norm) {
            if (previewBadge) previewBadge.style.background = norm;
            if (triggerSwatch) triggerSwatch.style.background = norm;
            if (nativeInput) nativeInput.value = norm;
            if (errorEl) errorEl.style.display = 'none';
            if (applyBtn) applyBtn.disabled = false;
            if (saveBtn) saveBtn.disabled = false;
          } else {
            if (errorEl) {
              errorEl.textContent = 'Invalid HEX color';
              errorEl.style.display = 'block';
            }
            if (applyBtn) applyBtn.disabled = true;
            if (saveBtn) saveBtn.disabled = true;
          }
        }

        if (hexInput) {
          hexInput.addEventListener('input', syncHexToPreview);
          hexInput.addEventListener('change', function() {
            var norm = getNormalizedHexFromInput();
            if (norm) hexInput.value = norm;
          });
        }

        if (cancelBtn) {
          cancelBtn.addEventListener('click', function(e) {
            e.preventDefault();
            popover.style.display = 'none';
            if (customColorPickerState.surface) {
              customColorPickerState.surface.focus();
            }
          });
        }

        function finishPicker(shouldSave) {
          var norm = getNormalizedHexFromInput();
          if (!norm) {
            if (errorEl) {
              errorEl.textContent = 'Invalid HEX color';
              errorEl.style.display = 'block';
            }
            if (applyBtn) applyBtn.disabled = true;
            if (saveBtn) saveBtn.disabled = true;
            return;
          }

          if (shouldSave) {
            saveColorToPalette(norm);
          }

          popover.style.display = 'none';

          if (customColorPickerState.surface && customColorPickerState.savedRange) {
            customColorPickerState.surface.focus();
            var sel = window.getSelection();
            if (sel) {
              sel.removeAllRanges();
              sel.addRange(customColorPickerState.savedRange);
            }
          }

          if (typeof customColorPickerState.onApply === 'function') {
            customColorPickerState.onApply(norm);
          }

          updateAllSavedSwatchesUI();
          customColorPickerState.savedRange = null;
          customColorPickerState.surface = null;
        }

        if (applyBtn) {
          applyBtn.addEventListener('click', function(e) {
            e.preventDefault();
            finishPicker(false);
          });
        }

        if (saveBtn) {
          saveBtn.addEventListener('click', function(e) {
            e.preventDefault();
            finishPicker(true);
          });
        }

        if (hexInput) {
          hexInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
              e.preventDefault();
              if (applyBtn && !applyBtn.disabled) finishPicker(false);
            } else if (e.key === 'Escape') {
              e.preventDefault();
              popover.style.display = 'none';
              if (customColorPickerState.surface) customColorPickerState.surface.focus();
            }
          });
        }
      }

      function resolveSmartRange(surface, formatType) {
        var sel = window.getSelection();
        if (!sel || !sel.rangeCount) return null;
        var range = sel.getRangeAt(0);
        if (!surface.contains(range.commonAncestorContainer)) return null;

        // 1. Manual non-collapsed selection
        if (!range.collapsed && range.toString().length > 0) {
          return range;
        }

        // 2. Collapsed caret inside existing formatting run of this type
        var node = range.commonAncestorContainer;
        var elem = (node.nodeType === 3) ? node.parentNode : node;
        if (elem && surface.contains(elem)) {
          if (formatType === 'bold') {
            var bEl = elem.closest('b, strong');
            if (bEl && surface.contains(bEl)) {
              var r = document.createRange();
              r.selectNode(bEl);
              sel.removeAllRanges();
              sel.addRange(r);
              return r;
            }
          } else if (formatType === 'italic') {
            var iEl = elem.closest('i, em');
            if (iEl && surface.contains(iEl)) {
              var r = document.createRange();
              r.selectNode(iEl);
              sel.removeAllRanges();
              sel.addRange(r);
              return r;
            }
          } else if (formatType === 'underline') {
            var uEl = elem.closest('u');
            if (uEl && surface.contains(uEl)) {
              var r = document.createRange();
              r.selectNode(uEl);
              sel.removeAllRanges();
              sel.addRange(r);
              return r;
            }
          } else if (formatType === 'color') {
            var colEl = elem.closest('.article-text-gold, .article-text-purple, .article-text-muted, .article-text-custom-color');
            if (colEl && surface.contains(colEl)) {
              var r = document.createRange();
              r.selectNode(colEl);
              sel.removeAllRanges();
              sel.addRange(r);
              return r;
            }
          } else if (formatType === 'highlight' || formatType === 'bg') {
            var bgEl = elem.closest('.article-text-bg-neutral, .article-text-bg-purple, .article-text-bg-gold, .article-text-bg-green, .article-text-bg-red, .article-text-custom-bg');
            if (bgEl && surface.contains(bgEl)) {
              var r = document.createRange();
              r.selectNode(bgEl);
              sel.removeAllRanges();
              sel.addRange(r);
              return r;
            }
          } else if (formatType === 'link') {
            var aEl = elem.closest('a');
            if (aEl && surface.contains(aEl)) {
              var r = document.createRange();
              r.selectNode(aEl);
              sel.removeAllRanges();
              sel.addRange(r);
              return r;
            }
          }
        }

        // 3. Target word under caret
        if (node.nodeType === 3) {
          var text = node.textContent || '';
          if (!text.length) return null;
          var offset = range.startOffset;

          var charBefore = offset > 0 ? text[offset - 1] : '';
          var charAfter = offset < text.length ? text[offset] : '';
          var isSpaceBefore = !charBefore || /\s/.test(charBefore);
          var isSpaceAfter = !charAfter || /\s/.test(charAfter);

          if (isSpaceBefore && isSpaceAfter) {
            return null;
          }

          function isWordChar(ch) {
            if (!ch) return false;
            return /[^\s.,;:!?"'()\[\]{}«»""]/.test(ch);
          }

          var start = offset;
          if (start > 0 && !isWordChar(text[start]) && isWordChar(text[start - 1])) {
            start = start - 1;
          }
          while (start > 0 && isWordChar(text[start - 1])) {
            start--;
          }

          var end = offset;
          while (end < text.length && isWordChar(text[end])) {
            end++;
          }

          while (end < text.length - 1 && (text[end] === "'" || text[end] === '-') && isWordChar(text[end + 1])) {
            end += 2;
            while (end < text.length && isWordChar(text[end])) {
              end++;
            }
          }

          if (start < end) {
            var wordRange = document.createRange();
            wordRange.setStart(node, start);
            wordRange.setEnd(node, end);
            sel.removeAllRanges();
            sel.addRange(wordRange);
            return wordRange;
          }
        }

        return null;
      }

      function handleCovenCopy(e, isCut, surface, getCurrentData, setCurrentData, updateToolbarActiveStates) {
        var sel = window.getSelection();
        if (!sel || !sel.rangeCount) return;
        var range = sel.getRangeAt(0);
        if (!surface.contains(range.commonAncestorContainer)) return;

        var container = document.createElement('div');
        container.appendChild(range.cloneContents());
        var sanitized = sanitizeRichText(container.innerHTML);
        var plainText = range.toString();

        if (e.clipboardData) {
          e.preventDefault();
          e.clipboardData.setData('text/plain', plainText);
          e.clipboardData.setData('application/x-coven-rich-text', sanitized);
          e.clipboardData.setData('text/html', '<!-- coven-rich-text -->' + sanitized);
          if (isCut) {
            document.execCommand('delete');
            var cur = getCurrentData();
            cur.text = sanitizeRichText(surface.innerHTML);
            setCurrentData(cur);
            if (updateToolbarActiveStates) updateToolbarActiveStates();
          }
        }
      }

      function handleCovenPaste(e, surface, getCurrentData, setCurrentData, updateToolbarActiveStates) {
        e.preventDefault();
        var clip = e.clipboardData || window.clipboardData;
        if (!clip) return;

        var covenHtml = clip.getData('application/x-coven-rich-text');
        if (!covenHtml) {
          var rawHtml = clip.getData('text/html') || '';
          if (rawHtml.indexOf('<!-- coven-rich-text -->') !== -1) {
            covenHtml = rawHtml.replace('<!-- coven-rich-text -->', '');
          }
        }

        if (covenHtml) {
          var safeHtml = sanitizeRichText(covenHtml);
          document.execCommand('insertHTML', false, safeHtml);
        } else {
          var text = clip.getData('text/plain') || '';
          document.execCommand('insertText', false, text);
        }

        var cur = getCurrentData();
        cur.text = sanitizeRichText(surface.innerHTML);
        setCurrentData(cur);
        if (updateToolbarActiveStates) updateToolbarActiveStates();
      }

      function applyColorClass(surface, colorClass) {
        var sel = window.getSelection();
        if (!sel || !sel.rangeCount) return;
        var range = resolveSmartRange(surface, 'color');
        if (!range) return;

        var ALL_COLOR_CLASSES = ['article-text-gold', 'article-text-purple', 'article-text-muted', 'article-text-custom-color'];
        var oldSpans = surface.querySelectorAll('.article-text-gold, .article-text-purple, .article-text-muted, .article-text-custom-color');
        for (var j = 0; j < oldSpans.length; j++) {
          var osp = oldSpans[j];
          if (range.intersectsNode ? range.intersectsNode(osp) : true) {
            ALL_COLOR_CLASSES.forEach(function(c) { osp.classList.remove(c); });
            osp.style.removeProperty('--coven-custom-text-color');
            if (osp.classList.length === 0 && !osp.id && !osp.getAttribute('style')) {
              while (osp.firstChild) osp.parentNode.insertBefore(osp.firstChild, osp);
              osp.parentNode.removeChild(osp);
            }
          }
        }

        if (colorClass !== 'default') {
          var isCustom = colorClass.startsWith('#');
          var normHex = isCustom ? normalizeHex(colorClass) : null;
          var span = document.createElement('span');
          if (isCustom && normHex) {
            span.className = 'article-text-custom-color';
            span.style.setProperty('--coven-custom-text-color', normHex);
          } else {
            span.className = colorClass;
          }

          try {
            range.surroundContents(span);
            var newRange = document.createRange();
            newRange.selectNodeContents(span);
            sel.removeAllRanges();
            sel.addRange(newRange);
          } catch (err) {
            var fragment = range.extractContents();
            span.appendChild(fragment);
            range.insertNode(span);
            var reselRange = document.createRange();
            reselRange.selectNodeContents(span);
            sel.removeAllRanges();
            sel.addRange(reselRange);
          }
        }
      }

      function applyBgClass(surface, bgClass) {
        var sel = window.getSelection();
        if (!sel || !sel.rangeCount) return;
        var range = resolveSmartRange(surface, 'highlight');
        if (!range) return;

        var ALL_BG_CLASSES = [
          'article-text-bg-neutral',
          'article-text-bg-purple',
          'article-text-bg-gold',
          'article-text-bg-green',
          'article-text-bg-red',
          'article-text-custom-bg'
        ];

        var oldBgSpans = surface.querySelectorAll('.article-text-bg-neutral, .article-text-bg-purple, .article-text-bg-gold, .article-text-bg-green, .article-text-bg-red, .article-text-custom-bg');
        for (var j = 0; j < oldBgSpans.length; j++) {
          var bsp = oldBgSpans[j];
          if (range.intersectsNode ? range.intersectsNode(bsp) : true) {
            ALL_BG_CLASSES.forEach(function(c) { bsp.classList.remove(c); });
            bsp.style.removeProperty('--coven-custom-bg');
            if (bsp.classList.length === 0 && !bsp.id && !bsp.getAttribute('style')) {
              while (bsp.firstChild) bsp.parentNode.insertBefore(bsp.firstChild, bsp);
              bsp.parentNode.removeChild(bsp);
            }
          }
        }

        if (bgClass !== 'default') {
          var isCustom = bgClass.startsWith('#');
          var normHex = isCustom ? normalizeHex(bgClass) : null;
          var span = document.createElement('span');
          if (isCustom && normHex) {
            span.className = 'article-text-custom-bg';
            span.style.setProperty('--coven-custom-bg', normHex);
          } else {
            span.className = bgClass;
          }

          try {
            range.surroundContents(span);
            var newRange = document.createRange();
            newRange.selectNodeContents(span);
            sel.removeAllRanges();
            sel.addRange(newRange);
          } catch (err) {
            var fragment = range.extractContents();
            span.appendChild(fragment);
            range.insertNode(span);
            var reselRange = document.createRange();
            reselRange.selectNodeContents(span);
            sel.removeAllRanges();
            sel.addRange(reselRange);
          }
        }
      }

