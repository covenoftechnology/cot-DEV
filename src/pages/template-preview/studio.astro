            '<div class="' + wrapClassList + '" data-table-preset="' + escapeHtml(tableStyle.preset) + '">' +
              '<table class="' + tableClassList + '" data-table-preset="' + escapeHtml(tableStyle.preset) + '" style="--table-cols:' + cols.length + '">' +
                '<thead>' +
                  '<tr class="studio-table-col-handles">' +
                    '<th class="studio-table-corner-cell" aria-hidden="true"></th>';

        cols.forEach(function(col, cIdx) {
          var isColSel = Boolean(sel && sel.kind === 'column' && sel.colStart === cIdx);
          html +=
            '<th class="studio-table-col-handle' + (isColSel ? ' is-handle-active' : '') + '" data-table-col-handle="' + cIdx + '" data-col-id="' + escapeHtml(col.id) + '" title="Select column ' + toTableColLetter(cIdx) + '">' +
              '<span>' + toTableColLetter(cIdx) + '</span>' +
            '</th>';
        });
        html += '</tr>';

        // Header data row
        var isHeaderRowSel = Boolean(sel && sel.kind === 'row' && sel.section === 'header');
        html += '<tr class="studio-table-header-row">' +
          '<th class="studio-table-row-handle' + (isHeaderRowSel ? ' is-handle-active' : '') + '" data-table-row-handle="header" data-row-idx="0" title="Select Header Row">H</th>';

        cols.forEach(function(col, cIdx) {
          if (AT && AT.isCellCovered(merges, 0, cIdx, 'header')) return;
          var origin = AT ? AT.getMergeOrigin(merges, 0, cIdx, 'header') : null;
          var cSpan = origin ? origin.columnSpan : 1;
          var cRich = getRichData(col.label);
          var effStyle = AT ? AT.resolveEffectiveCellStyle(d, 'header', 0, cIdx, 'header', col.id) : {};
          var finalAlign = effStyle.align || cRich.align || 'left';
          var inlineStyle = AT ? AT.buildCellInlineStyle({ background: effStyle.background, textColor: effStyle.textColor, align: finalAlign !== 'left' ? finalAlign : undefined }) : '';
          var selClasses = AT ? AT.getSelectionBoundaryClasses(sel, 'header', 0, cIdx, 1, cSpan, rows.length) : [];
          var colPosClasses = (cIdx % 2 === 1 ? ' coven-col-band-even' : '') + (cIdx === 0 ? ' coven-col-first' : '') + (cIdx + cSpan === cols.length ? ' coven-col-last' : '');
          var mergeBadge = cSpan > 1 ? '<span class="table-merge-badge" aria-hidden="true">1×' + cSpan + '</span>' : '';

          html +=
            '<th class="studio-table-data-cell' + colPosClasses + ' ' + selClasses.join(' ') + '"' +
              (cSpan > 1 ? ' colspan="' + cSpan + '"' : '') +
              ' data-table-cell="true" data-cell-section="header" data-row-idx="0" data-col-idx="' + cIdx + '" data-row-id="header" data-col-id="' + escapeHtml(col.id) + '"' +
              (inlineStyle ? ' style="' + escapeHtml(inlineStyle) + '"' : '') + '>' +
              mergeBadge +
              '<div class="studio-table-cell-input rich-text-surface rich-align-' + finalAlign + '" contenteditable="true" spellcheck="false" data-table-header="' + escapeHtml(col.id) + '" data-table-align="' + finalAlign + '">' + sanitizeRichText(cRich.text) + '</div>' +
            '</th>';
        });
        html += '</tr></thead><tbody>';

        rows.forEach(function(r, rIdx) {
          var isRowSel = Boolean(sel && sel.kind === 'row' && sel.section === 'body' && sel.rowStart === rIdx);
          html +=
            '<tr data-table-body-row="' + rIdx + '" data-row-id="' + escapeHtml(r.id) + '">' +
              '<td class="studio-table-row-handle' + (isRowSel ? ' is-handle-active' : '') + '" data-table-row-handle="body" data-row-idx="' + rIdx + '" data-row-id="' + escapeHtml(r.id) + '" title="Select Row ' + (rIdx + 1) + '">' +
                '<span class="row-handle-grip">⋮</span><span>' + (rIdx + 1) + '</span>' +
              '</td>';

          cols.forEach(function(col, cIdx) {
            if (AT && AT.isCellCovered(merges, rIdx, cIdx, 'body')) return;
            var origin = AT ? AT.getMergeOrigin(merges, rIdx, cIdx, 'body') : null;
            var rSpan = origin ? origin.rowSpan : 1;
            var cSpan = origin ? origin.columnSpan : 1;
            var cellVal = r.cells ? (r.cells[col.id] || '') : '';
            var cellRich = getRichData(cellVal);
            var effStyle = AT ? AT.resolveEffectiveCellStyle(d, 'body', rIdx, cIdx, r.id, col.id) : {};
            var finalAlign = effStyle.align || cellRich.align || 'left';
            var inlineStyle = AT ? AT.buildCellInlineStyle({ background: effStyle.background, textColor: effStyle.textColor, align: finalAlign !== 'left' ? finalAlign : undefined }) : '';
            var selClasses = AT ? AT.getSelectionBoundaryClasses(sel, 'body', rIdx, cIdx, rSpan, cSpan, rows.length) : [];
            var colPosClasses = (cIdx % 2 === 1 ? ' coven-col-band-even' : '') + (cIdx === 0 ? ' coven-col-first' : '') + (cIdx + cSpan === cols.length ? ' coven-col-last' : '');
            var mergeBadge = (rSpan > 1 || cSpan > 1) ? '<span class="table-merge-badge" aria-hidden="true">' + rSpan + '×' + cSpan + '</span>' : '';

            html +=
              '<td class="studio-table-data-cell' + colPosClasses + ' ' + selClasses.join(' ') + '"' +
                (rSpan > 1 ? ' rowspan="' + rSpan + '"' : '') +
                (cSpan > 1 ? ' colspan="' + cSpan + '"' : '') +
                ' data-table-cell="true" data-cell-section="body" data-row-idx="' + rIdx + '" data-col-idx="' + cIdx + '" data-row-id="' + escapeHtml(r.id) + '" data-col-id="' + escapeHtml(col.id) + '"' +
                (inlineStyle ? ' style="' + escapeHtml(inlineStyle) + '"' : '') + '>' +
                mergeBadge +
                '<div class="studio-table-cell-input rich-text-surface rich-align-' + finalAlign + '" contenteditable="true" spellcheck="false" data-table-row="' + escapeHtml(r.id) + '" data-table-col="' + escapeHtml(col.id) + '" data-table-align="' + finalAlign + '">' + sanitizeRichText(cellRich.text) + '</div>' +
              '</td>';
          });
          html += '</tr>';
        });

        html +=
                '</tbody>' +
              '</table>' +
            '</div>' +
            '<div style="display:flex;gap:8px;margin-top:8px;align-items:center;flex-wrap:wrap">' +
              '<button type="button" class="studio-btn studio-btn--sm" data-act="add-table-col">+ Add Column</button>' +
              '<button type="button" class="studio-btn studio-btn--sm" data-act="add-table-row">+ Add Row</button>' +
            '</div>' +
          '</div>';
        return html;
      }

      function attachTableBuilderV2Listeners(bBody, sec, block) {
        var AT = window.ArticleTable;
        if (!AT) return;
        var d = block.data;
        var root = bBody.querySelector('.studio-table-v2-root');
        if (!root) return;

        var isPointerDragging = false;
        var dragStartedMulti = false;
        var dragSection = null;
        var dragAnchorRow = -1;
        var dragAnchorCol = -1;

        function getSel() {
          return tableEditorSelectionMap[block.id] || null;
        }

        function setSel(nextSel) {
          if (nextSel) tableEditorSelectionMap[block.id] = nextSel;
          else delete tableEditorSelectionMap[block.id];
          refreshSelectionVisualsInDom();
        }

        function refreshSelectionVisualsInDom() {
          var sel = getSel();
          var rows = d.rows || [];
          var merges = Array.isArray(d.mergeRegions) ? d.mergeRegions : [];

          // Update cell boundary classes cleanly without destroying contenteditable focus
          root.querySelectorAll('[data-table-cell="true"]').forEach(function(td) {
            var secKind = td.getAttribute('data-cell-section') || 'body';
            var rIdx = parseInt(td.getAttribute('data-row-idx') || '0', 10);
            var cIdx = parseInt(td.getAttribute('data-col-idx') || '0', 10);
            var rSpan = parseInt(td.getAttribute('rowspan') || '1', 10);
            var cSpan = parseInt(td.getAttribute('colspan') || '1', 10);
            td.classList.remove('is-table-cell-selected', 'is-sel-top', 'is-sel-bottom', 'is-sel-left', 'is-sel-right');
            var cls = AT.getSelectionBoundaryClasses(sel, secKind, rIdx, cIdx, rSpan, cSpan, rows.length);
            cls.forEach(function(c) { td.classList.add(c); });
          });

          // Update row/column handle active states
          root.querySelectorAll('[data-table-col-handle]').forEach(function(h) {
            var idx = parseInt(h.getAttribute('data-table-col-handle'), 10);
            h.classList.toggle('is-handle-active', Boolean(sel && sel.kind === 'column' && sel.colStart === idx));
          });
          root.querySelectorAll('[data-table-row-handle]').forEach(function(h) {
            var secKind = h.getAttribute('data-table-row-handle');
            var idx = parseInt(h.getAttribute('data-row-idx') || '0', 10);
            h.classList.toggle('is-handle-active', Boolean(sel && sel.kind === 'row' && sel.section === secKind && sel.rowStart === idx));
          });

          // Re-render only the contextual selection action bar
          var barEl = root.querySelector('[data-table-sel-bar="true"]');
          if (barEl) {
            var tmp = document.createElement('div');
            tmp.innerHTML = renderTableSelectionToolbarHtml(block, d, sel);
            var nextBar = tmp.firstElementChild;
            if (nextBar) {
              barEl.replaceWith(nextBar);
            }
          }
        }

        function applySemanticPropToSelection(propName, val) {
          var sel = getSel();
          if (!sel) return;
          var cols = d.columns || [];
          var rows = d.rows || [];

          function setOnMap(mapKey, key) {
            d[mapKey] = d[mapKey] || {};
            d[mapKey][key] = d[mapKey][key] || {};
            if (!val || val === 'default') {
              delete d[mapKey][key][propName];
              if (Object.keys(d[mapKey][key]).length === 0) delete d[mapKey][key];
              if (Object.keys(d[mapKey]).length === 0) delete d[mapKey];
            } else {
              d[mapKey][key][propName] = val;
            }
          }

          if (sel.kind === 'column') {
            var col = cols[sel.colStart];
            if (!col) return;
            setOnMap('colStyles', col.id);
            // Keep rich align in sync when alignment is set on a column
            if (propName === 'align') {
              if (col.label && typeof col.label === 'object') col.label.align = val;
              rows.forEach(function(r) {
                if (r.cells && r.cells[col.id] && typeof r.cells[col.id] === 'object') {
                  r.cells[col.id].align = val;
                }
              });
            }
          } else if (sel.kind === 'row') {
            var rowKey = sel.section === 'header' ? 'header' : (rows[sel.rowStart] ? rows[sel.rowStart].id : null);
            if (!rowKey) return;
            setOnMap('rowStyles', rowKey);
            if (propName === 'align') {
              if (sel.section === 'header') {
                cols.forEach(function(c) { if (c.label && typeof c.label === 'object') c.label.align = val; });
              } else if (rows[sel.rowStart]) {
                var rr = rows[sel.rowStart];
                cols.forEach(function(c) {
                  if (rr.cells && rr.cells[c.id] && typeof rr.cells[c.id] === 'object') rr.cells[c.id].align = val;
                });
              }
            }
          } else {
            // Single cell or rectangular range
            var r0 = sel.section === 'header' ? 0 : sel.rowStart;
            var r1 = sel.section === 'header' ? 0 : sel.rowEnd;
            for (var r = r0; r <= r1; r++) {
              var rObj = sel.section === 'header' ? null : rows[r];
              var rKey = sel.section === 'header' ? 'header' : (rObj ? rObj.id : null);
              if (!rKey) continue;
              for (var c = sel.colStart; c <= sel.colEnd; c++) {
                var cObj = cols[c];
                if (!cObj) continue;
                setOnMap('cellStyles', rKey + ':' + cObj.id);
                if (propName === 'align') {
                  if (sel.section === 'header' && cObj.label && typeof cObj.label === 'object') {
                    cObj.label.align = val;
                  } else if (rObj && rObj.cells && rObj.cells[cObj.id] && typeof rObj.cells[cObj.id] === 'object') {
                    rObj.cells[cObj.id].align = val;
                  }
                }
              }
            }
          }

          closeAllPopovers();
          renderSections();
          triggerAutosave();
        }

        function resetSelectionStyles() {
          var sel = getSel();
          if (!sel) return;
          var cols = d.columns || [];
          var rows = d.rows || [];

          if (sel.kind === 'column') {
            var col = cols[sel.colStart];
            if (col) {
              if (d.colStyles) delete d.colStyles[col.id];
              if (d.cellStyles) {
                Object.keys(d.cellStyles).forEach(function(k) {
                  if (k.endsWith(':' + col.id)) delete d.cellStyles[k];
                });
              }
              if (col.label && typeof col.label === 'object') col.label.align = 'left';
              rows.forEach(function(r) {
                if (r.cells && r.cells[col.id] && typeof r.cells[col.id] === 'object') r.cells[col.id].align = 'left';
              });
            }
          } else if (sel.kind === 'row') {
            var rKey = sel.section === 'header' ? 'header' : (rows[sel.rowStart] ? rows[sel.rowStart].id : null);
            if (rKey) {
              if (d.rowStyles) delete d.rowStyles[rKey];
              if (d.cellStyles) {
                Object.keys(d.cellStyles).forEach(function(k) {
                  if (k.startsWith(rKey + ':')) delete d.cellStyles[k];
                });
              }
              if (sel.section === 'header') {
                cols.forEach(function(c) { if (c.label && typeof c.label === 'object') c.label.align = 'left'; });
              } else if (rows[sel.rowStart]) {
                var rr = rows[sel.rowStart];
                cols.forEach(function(c) {
                  if (rr.cells && rr.cells[c.id] && typeof rr.cells[c.id] === 'object') rr.cells[c.id].align = 'left';
                });
              }
            }
          } else {
            var r0 = sel.section === 'header' ? 0 : sel.rowStart;
            var r1 = sel.section === 'header' ? 0 : sel.rowEnd;
            for (var r = r0; r <= r1; r++) {
              var rObj = sel.section === 'header' ? null : rows[r];
              var rowKey2 = sel.section === 'header' ? 'header' : (rObj ? rObj.id : null);
              if (!rowKey2) continue;
              for (var c = sel.colStart; c <= sel.colEnd; c++) {
                var cObj = cols[c];
                if (!cObj) continue;
                if (d.cellStyles) delete d.cellStyles[rowKey2 + ':' + cObj.id];
                if (sel.section === 'header' && cObj.label && typeof cObj.label === 'object') cObj.label.align = 'left';
                else if (rObj && rObj.cells && rObj.cells[cObj.id] && typeof rObj.cells[cObj.id] === 'object') rObj.cells[cObj.id].align = 'left';
              }
            }
          }

          if (d.colStyles && Object.keys(d.colStyles).length === 0) delete d.colStyles;
          if (d.rowStyles && Object.keys(d.rowStyles).length === 0) delete d.rowStyles;
          if (d.cellStyles && Object.keys(d.cellStyles).length === 0) delete d.cellStyles;

          closeAllPopovers();
          renderSections();
          triggerAutosave();
        }

        // Mouse-based cell selection (single click, Shift+click, pointer drag rectangle)
        root.querySelectorAll('[data-table-cell="true"]').forEach(function(td) {
          td.addEventListener('mousedown', function(e) {
            if (e.button !== 0) return;
            var secKind = td.getAttribute('data-cell-section') || 'body';
            var rIdx = parseInt(td.getAttribute('data-row-idx') || '0', 10);
            var cIdx = parseInt(td.getAttribute('data-col-idx') || '0', 10);
            var merges = Array.isArray(d.mergeRegions) ? d.mergeRegions : [];
            var prevSel = getSel();

            if (e.shiftKey && prevSel && prevSel.section === secKind && prevSel.kind !== 'column') {
              e.preventDefault();
              var rectSel = AT.createRectSelection(secKind, prevSel.rowStart, prevSel.colStart, rIdx, cIdx, merges);
              setSel(rectSel);
              return;
            }

            isPointerDragging = true;
            dragStartedMulti = false;
            dragSection = secKind;
            dragAnchorRow = rIdx;
            dragAnchorCol = cIdx;
            var singleSel = AT.createSingleCellSelection(secKind, rIdx, cIdx, merges);
            setSel(singleSel);
          });

          td.addEventListener('mouseenter', function() {
            if (!isPointerDragging) return;
            var secKind = td.getAttribute('data-cell-section') || 'body';
            if (secKind !== dragSection) return;
            var rIdx = parseInt(td.getAttribute('data-row-idx') || '0', 10);
            var cIdx = parseInt(td.getAttribute('data-col-idx') || '0', 10);
            if (rIdx !== dragAnchorRow || cIdx !== dragAnchorCol) {
              dragStartedMulti = true;
              try {
                var winSel = window.getSelection();
                if (winSel) winSel.removeAllRanges();
              } catch (_) {}
            }
            if (dragStartedMulti) {
              var merges = Array.isArray(d.mergeRegions) ? d.mergeRegions : [];
              var rectSel = AT.createRectSelection(dragSection, dragAnchorRow, dragAnchorCol, rIdx, cIdx, merges);
              setSel(rectSel);
            }
          });
        });

        function handleTablePointerUp() {
          if (!isPointerDragging) return;
          isPointerDragging = false;
          dragStartedMulti = false;
        }
        document.addEventListener('mouseup', handleTablePointerUp, { passive: true });

        // Column & Row selection handles
        root.querySelectorAll('[data-table-col-handle]').forEach(function(colHandle) {
          colHandle.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            var cIdx = parseInt(colHandle.getAttribute('data-table-col-handle'), 10);
            setSel(AT.createColumnSelection(cIdx, (d.rows || []).length));
          });
        });

        root.querySelectorAll('[data-table-row-handle]').forEach(function(rowHandle) {
          rowHandle.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            var secKind = rowHandle.getAttribute('data-table-row-handle') === 'header' ? 'header' : 'body';
            var rIdx = parseInt(rowHandle.getAttribute('data-row-idx') || '0', 10);
            setSel(AT.createRowSelection(secKind, rIdx, (d.columns || []).length));
          });
        });

        // Table Style Options checkboxes (Header Row, Banded Rows, Banded Columns, Emphasize First/Last Col)
        root.querySelectorAll('[data-table-v2-opt]').forEach(function(cb) {
          cb.addEventListener('change', function() {
            var optKey = cb.getAttribute('data-table-v2-opt');
