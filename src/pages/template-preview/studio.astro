                '<label class="table-style-opt-chip"><input type="checkbox" data-table-v2-opt="emphasizeFirstColumn"' + (tableStyle.emphasizeFirstColumn ? ' checked' : '') + ' /><span>Emphasize First Column</span></label>' +
                '<label class="table-style-opt-chip"><input type="checkbox" data-table-v2-opt="emphasizeLastColumn"' + (tableStyle.emphasizeLastColumn ? ' checked' : '') + ' /><span>Emphasize Last Column</span></label>' +
              '</div>' +
