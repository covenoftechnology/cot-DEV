      function updateSaveEligibilityUi() {
        var saveBtn = document.getElementById('btn-save-draft');
        if (!hasPersistedDraft) {
          var eligible = isFirstSaveEligibleClient(currentDoc);
          if (saveBtn) {
            saveBtn.disabled = !eligible;
            saveBtn.setAttribute(
              'title',
              eligible ? 'Save draft immediately' : 'Add title, valid slug, and content to save'
            );
          }
          var statusEl = document.getElementById('status-indicator');
          var currentStatus = statusEl ? statusEl.textContent : '';
          if (currentStatus !== 'Saving…' && currentStatus !== 'Saved') {
            setStatus('Not saved yet', '');
