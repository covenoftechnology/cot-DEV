      function duplicateSection(secId) {
        var idx = currentDoc.sections.findIndex(function(s) { return s.id === secId; });
        if (idx === -1) return;
        var original = currentDoc.sections[idx];
        var copy = JSON.parse(JSON.stringify(original));
        copy.id = uid('sec');
        copy.title = copy.title + ' — Copy';
        if (Array.isArray(copy.blocks)) {
          copy.blocks.forEach(function(b) {
            b.id = uid('blk');
            regenerateBlockNestedIds(b);
          });
        }
        if (copy.visualGrid && Array.isArray(copy.visualGrid.layoutItems)) {
          copy.visualGrid.layoutItems.forEach(function(it) {
            it.id = uid('grid_item');
            if (it.block) {
              it.block.id = uid('blk');
              regenerateBlockNestedIds(it.block);
            }
          });
