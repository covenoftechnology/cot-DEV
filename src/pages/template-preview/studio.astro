      function refreshAllIconSelects(applyValToSelect, targetSelect) {
        document.querySelectorAll('.coven-icon-select').forEach(function(sel) {
          var currentVal = (sel === targetSelect && applyValToSelect) ? applyValToSelect : (sel.getAttribute('data-last-val') || sel.value);
          if (typeof window.renderIconSelectOptgroupsHtml === 'function') {
            sel.innerHTML = window.renderIconSelectOptgroupsHtml(currentVal);
          }
          sel.value = currentVal;
          sel.setAttribute('data-last-val', currentVal);
        });
      }

      function openCustomIconModal(ctx) {
        activeCustomIconContext = ctx || null;
        var modal = document.getElementById('coven-custom-icon-modal');
        if (!modal) return;

        var iconInput = document.getElementById('coven-custom-icon-input');
        var labelInput = document.getElementById('coven-custom-icon-label');
        var errorEl = document.getElementById('coven-custom-icon-error');

        if (iconInput) iconInput.value = '';
        if (labelInput) labelInput.value = '';
        if (errorEl) {
          errorEl.textContent = '';
          errorEl.style.display = 'none';
        }

        renderCustomIconModalList();
        modal.style.display = 'flex';

        if (iconInput) {
          setTimeout(function() {
            iconInput.focus();
          }, 50);
        }
      }

      function closeCustomIconModal(canceled) {
        var modal = document.getElementById('coven-custom-icon-modal');
        if (!modal) return;

        var ctx = activeCustomIconContext;
        if (canceled && ctx && ctx.targetSelect) {
          var prev = ctx.previousValue || '';
          ctx.targetSelect.value = prev;
          ctx.targetSelect.setAttribute('data-last-val', prev);
          try { ctx.targetSelect.focus(); } catch (e) {}
        }

        modal.style.display = 'none';
        activeCustomIconContext = null;
      }

      function saveCustomIconFromModal() {
        var iconInput = document.getElementById('coven-custom-icon-input');
        var labelInput = document.getElementById('coven-custom-icon-label');
        var errorEl = document.getElementById('coven-custom-icon-error');

        var rawGlyph = iconInput ? iconInput.value.trim() : '';
        var rawLabel = labelInput ? labelInput.value.trim() : '';

        if (!rawGlyph) {
          if (errorEl) {
            errorEl.textContent = 'Please enter a symbol or emoji for the icon.';
            errorEl.style.display = 'block';
          }
          if (iconInput) iconInput.focus();
          return;
        }

        if (typeof window.isValidCustomGlyph === 'function' && !window.isValidCustomGlyph(rawGlyph)) {
          if (errorEl) {
            errorEl.textContent = 'Invalid icon format. Please provide a single visible character or emoji (e.g. 🧠, ⚡, ☕).';
            errorEl.style.display = 'block';
          }
          if (iconInput) iconInput.focus();
          return;
        }

        if (!rawLabel) {
          if (errorEl) {
            errorEl.textContent = 'Please enter a name for the icon.';
            errorEl.style.display = 'block';
          }
          if (labelInput) labelInput.focus();
          return;
        }

        if (typeof window.isValidCustomLabel === 'function' && !window.isValidCustomLabel(rawLabel)) {
          if (errorEl) {
            errorEl.textContent = 'Invalid icon name. Must be 1–40 characters without HTML tags.';
            errorEl.style.display = 'block';
          }
          if (labelInput) labelInput.focus();
          return;
        }

        if (typeof window.saveCustomIcon !== 'function') {
          if (errorEl) {
            errorEl.textContent = 'Icon saving service is not available.';
            errorEl.style.display = 'block';
          }
          return;
        }

        var res = window.saveCustomIcon(rawGlyph, rawLabel);
        if (!res.success) {
          if (errorEl) {
            errorEl.textContent = res.message || 'Failed to save icon.';
            errorEl.style.display = 'block';
          }
          return;
        }

        if (errorEl) errorEl.style.display = 'none';
        var savedGlyph = res.icon ? res.icon.icon : rawGlyph;

        var ctx = activeCustomIconContext;
        if (ctx && ctx.block && ctx.block.data && ctx.field) {
          ctx.block.data[ctx.field] = savedGlyph;
          if (ctx.targetSelect) {
            ctx.targetSelect.setAttribute('data-last-val', savedGlyph);
          }
          refreshAllIconSelects(savedGlyph, ctx.targetSelect);
          calculateReadingTime();
          triggerAutosave();
          showToast('✦ Icon saved and applied to ' + (ctx.field || 'block'), 'saved');
        } else {
          refreshAllIconSelects();
          showToast('✦ ' + res.message, 'saved');
        }

        var targetToFocus = (ctx && ctx.targetSelect) ? ctx.targetSelect : null;
        closeCustomIconModal(false);
        if (targetToFocus) {
          try { targetToFocus.focus(); } catch (e) {}
        }
      }

      function initCustomIconModal() {
        window.openCustomIconModal = openCustomIconModal;
        window.closeCustomIconModal = closeCustomIconModal;
        var modal = document.getElementById('coven-custom-icon-modal');
        if (!modal) return;

        var closeBtn = document.getElementById('coven-custom-icon-close');
        var cancelBtn = document.getElementById('coven-custom-icon-cancel');
        var saveBtn = document.getElementById('coven-custom-icon-save');
        var iconInput = document.getElementById('coven-custom-icon-input');
        var labelInput = document.getElementById('coven-custom-icon-label');

        if (closeBtn) {
          closeBtn.addEventListener('click', function(e) {
            e.preventDefault();
            closeCustomIconModal(true);
          });
        }

        if (cancelBtn) {
          cancelBtn.addEventListener('click', function(e) {
            e.preventDefault();
            closeCustomIconModal(true);
          });
        }

        if (saveBtn) {
          saveBtn.addEventListener('click', function(e) {
            e.preventDefault();
            saveCustomIconFromModal();
          });
        }

        modal.addEventListener('click', function(e) {
          if (e.target === modal) {
            closeCustomIconModal(true);
          }
        });

        modal.addEventListener('keydown', function(e) {
          if (e.key === 'Escape') {
            e.preventDefault();
