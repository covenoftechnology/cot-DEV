        var captionAttr = opts.captionAttr || '';

        if (!src) {
          return (
            '<div class="studio-img-picker" data-img-prop="' + propPrefix + '">' +
              '<div class="studio-img-dropzone" data-act="trigger-upload" data-img-prop="' + propPrefix + '">' +
                '<div style="font-size:22px;color:var(--studio-gold);opacity:0.8">🖼</div>' +
                '<div style="font-size:13px;color:var(--studio-text-dim)">Drop image here or click to upload</div>' +
                '<button type="button" class="studio-btn studio-btn--sm" data-act="trigger-upload" data-img-prop="' + propPrefix + '">Upload Image</button>' +
                '<div style="font-size:11px;color:var(--studio-purple);cursor:pointer;margin-top:2px" data-act="toggle-ext-url" data-img-prop="' + propPrefix + '">+ Use External URL</div>' +
                '<div class="ext-url-input-wrap" style="display:none;width:100%;margin-top:6px">' +
                  '<input type="text" class="studio-input" placeholder="https://..." data-ext-url-input data-img-prop="' + propPrefix + '" />' +
                '</div>' +
