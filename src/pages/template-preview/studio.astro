      function unwrapFormattingSpanPreservingRange(osp, range) {
        var parent = osp.parentNode;
        if (!parent) return;
        var firstChild = osp.firstChild;
        var lastChild = osp.lastChild;
        var origStartContainer = range.startContainer;
        var origStartOffset = range.startOffset;
        var origEndContainer = range.endContainer;
        var origEndOffset = range.endOffset;
        var ospIdx = Array.prototype.indexOf.call(parent.childNodes, osp);
        var startsAtOspRoot = (origStartContainer === osp);
        var endsAtOspRoot = (origEndContainer === osp);
        var startsInOspDescendant = (!startsAtOspRoot && osp.contains(origStartContainer));
        var endsInOspDescendant = (!endsAtOspRoot && osp.contains(origEndContainer));
        var selectsOspInParent = (
          origStartContainer === parent &&
          origEndContainer === parent &&
          origStartOffset === ospIdx &&
          origEndOffset === ospIdx + 1
