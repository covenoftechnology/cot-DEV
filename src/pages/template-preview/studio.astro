            activeSurface = cell;
            updateToolbarActiveStates();
          });

          cell.addEventListener('mouseup', function() {
            activeSurface = cell;
            updateToolbarActiveStates();
          });

          cell.addEventListener('keydown', function(e) {
            if ((e.ctrlKey || e.metaKey) && !e.shiftKey && !e.altKey) {
              var k = e.key.toLowerCase();
              if (k === 'b' || k === 'i' || k === 'u') {
                var cmd = k === 'b' ? 'bold' : (k === 'i' ? 'italic' : 'underline');
                e.preventDefault();
                var range = resolveSmartRange(cell, cmd);
                if (range) {
                  document.execCommand(cmd, false, null);
                  updateToolbarActiveStates();
                  var cur = getActiveData();
                  cur.text = sanitizeRichText(cell.innerHTML);
                  setActiveData(cur);
                }
              }
            }
          });

          cell.addEventListener('copy', function(e) {
            handleCovenCopy(e, false, cell, getActiveData, setActiveData, updateToolbarActiveStates);
          });

          cell.addEventListener('cut', function(e) {
            handleCovenCopy(e, true, cell, getActiveData, setActiveData, updateToolbarActiveStates);
          });

          cell.addEventListener('paste', function(e) {
            handleCovenPaste(e, cell, getActiveData, setActiveData, updateToolbarActiveStates);
          });
        });
