            var r = sel.getRangeAt(0);
            if (!isValidRangeForSurface(surface, r)) return null;
            preservedFormatRange = r.cloneRange();
            surface.__covenSavedRange = preservedFormatRange;
            return preservedFormatRange;
          }

          var directField = surface.getAttribute('data-rich-field');
          var isCalloutHeading = surface.getAttribute('data-rich-callout-heading') === 'true';
          var arrayField = surface.getAttribute('data-rich-array');
          var arrayIdx = arrayField ? parseInt(surface.getAttribute('data-rich-idx'), 10) : -1;
          var arrayObjField = surface.getAttribute('data-rich-array-obj');
          var arrayObjId = surface.getAttribute('data-rich-item-id');
          var arrayObjProp = surface.getAttribute('data-rich-prop') || 'text';
          var isNestedSub = surface.getAttribute('data-rich-nested-sub') === 'true';
          var nestedParentId = surface.getAttribute('data-rich-parent-id');
          var nestedSubId = surface.getAttribute('data-rich-sub-id');
          var trialQId = surface.getAttribute('data-rich-trial-q-id');
          var trialQProp = surface.getAttribute('data-rich-trial-q-prop');
          var trialAnsId = surface.getAttribute('data-rich-trial-ans-id');

          function getCurrentData() {
            if (isCalloutHeading) {
              if (d.titleMode === 'custom' && d.title !== undefined) {
                return getRichData(d.title);
              }
              var cType = window.normalizeCalloutStyle ? window.normalizeCalloutStyle(d.calloutType) : (d.calloutType || 'grimoire');
              var sDefs = window.CALLOUT_STYLES || {};
              var defTitle = (sDefs[cType] && sDefs[cType].defaultTitle) ? sDefs[cType].defaultTitle : 'Grimoire Note';
              return { text: defTitle, align: 'left' };
            }
            if (directField) {
              return getRichData(d[directField]);
            }
            if (arrayField && Array.isArray(d[arrayField])) {
              return getRichData(d[arrayField][arrayIdx]);
            }
            if (arrayObjField && Array.isArray(d[arrayObjField])) {
              var target = d[arrayObjField].find(function(it) { return it.id === arrayObjId; });
              return target ? getRichData(target[arrayObjProp]) : { text: '', align: 'left' };
            }
            if (isNestedSub && Array.isArray(d.items)) {
              var foundSub = findNestedBulletNodeById(d.items, nestedSubId);
              return (foundSub && foundSub.node) ? getRichData(foundSub.node.text) : { text: '', align: 'left' };
            }
            if (trialQId) {
              var tq = (d.questions || []).find(function(q) { return q.id === trialQId; });
              if (tq) {
                if (trialAnsId && Array.isArray(tq.answers)) {
                  var ta = tq.answers.find(function(a) { return a.id === trialAnsId; });
                  return ta ? getRichData(ta.text) : { text: '', align: 'left' };
                }
                if (trialQProp) {
                  return getRichData(tq[trialQProp]);
                }
              }
              return { text: '', align: 'left' };
            }
            return { text: '', align: 'left' };
          }

          function setCurrentData(richObj) {
            if (isCalloutHeading) {
              d.title = richObj;
              d.titleMode = 'custom';
              d.showTitle = true;
              var headingBox = bBody.querySelector('.callout-heading-control-wrap');
              if (headingBox) {
                var headingHeader = headingBox.firstElementChild;
                var existingBtn = headingBox.querySelector('[data-act="callout-use-default"]');
                if (!existingBtn && headingHeader) {
                  var btn = document.createElement('button');
                  btn.type = 'button';
                  btn.className = 'callout-btn-use-default';
                  btn.setAttribute('data-act', 'callout-use-default');
                  btn.title = 'Reset heading to default variant label';
                  btn.textContent = 'Use Default';
                  headingHeader.appendChild(btn);
                }
                var defSpan = headingBox.querySelector('.callout-default-badge');
                if (defSpan) defSpan.remove();
              }
            } else if (directField) {
              d[directField] = richObj;
            } else if (arrayField && Array.isArray(d[arrayField])) {
              d[arrayField][arrayIdx] = richObj;
            } else if (arrayObjField && Array.isArray(d[arrayObjField])) {
              var target = d[arrayObjField].find(function(it) { return it.id === arrayObjId; });
              if (target) {
                target[arrayObjProp] = richObj;
              }
            } else if (isNestedSub && Array.isArray(d.items)) {
              var foundSub = findNestedBulletNodeById(d.items, nestedSubId);
              if (foundSub && foundSub.node) {
                foundSub.node.text = richObj;
              }
            } else if (trialQId) {
              var tq = (d.questions || []).find(function(q) { return q.id === trialQId; });
              if (tq) {
                if (trialAnsId && Array.isArray(tq.answers)) {
                  var ta = tq.answers.find(function(a) { return a.id === trialAnsId; });
                  if (ta) ta.text = richObj;
                } else if (trialQProp) {
                  tq[trialQProp] = richObj;
                }
              }
            }
            calculateReadingTime();
            triggerAutosave();
          }

          function getAnchorAtSelection() {
            var sel = window.getSelection();
            if (!sel || !sel.rangeCount) return null;
            var range = sel.getRangeAt(0);
            if (!surface.contains(range.commonAncestorContainer)) return null;
            var node = range.commonAncestorContainer;
            if (node.nodeType === 3) node = node.parentNode;
            var a = node ? (node.closest ? node.closest('a') : null) : null;
            return (a && surface.contains(a)) ? a : null;
          }

          function getSelectionInfo() {
            var sel = window.getSelection();
            if (!sel || !sel.rangeCount) return { hasSelection: false, anchor: null, range: null };
            var range = sel.getRangeAt(0);
            if (!surface.contains(range.commonAncestorContainer)) return { hasSelection: false, anchor: null, range: null };
            var anchor = getAnchorAtSelection();
            var hasText = !range.collapsed && range.toString().trim().length > 0;
            return { hasSelection: hasText || !!anchor, hasText: hasText, anchor: anchor, range: range };
          }

          function updateToolbarActiveStates() {
            var boldBtn = toolbar.querySelector('[data-cmd="bold"]');
            var italicBtn = toolbar.querySelector('[data-cmd="italic"]');
            var underlineBtn = toolbar.querySelector('[data-cmd="underline"]');

            if (boldBtn) boldBtn.classList.toggle('is-active', document.queryCommandState('bold'));
            if (italicBtn) italicBtn.classList.toggle('is-active', document.queryCommandState('italic'));
            if (underlineBtn) underlineBtn.classList.toggle('is-active', document.queryCommandState('underline'));

            var cur = getCurrentData();
            toolbar.querySelectorAll('.rich-btn-align').forEach(function(btn) {
              btn.classList.toggle('is-active', btn.getAttribute('data-align') === cur.align);
            });

            // Active Highlight & Color states at selection / caret
            var activeBgClass = 'default';
            var activeColorClass = 'default';
            var currentSel = window.getSelection();
            if (currentSel && currentSel.rangeCount) {
              var cRange = currentSel.getRangeAt(0);
              if (surface.contains(cRange.commonAncestorContainer)) {
                var cNode = cRange.commonAncestorContainer;
                if (cNode.nodeType === 3) cNode = cNode.parentNode;
                var bSpan = cNode ? cNode.closest('.article-text-bg-neutral, .article-text-bg-purple, .article-text-bg-gold, .article-text-bg-green, .article-text-bg-red') : null;
                if (bSpan && surface.contains(bSpan)) {
                  var ALL_BGS = ['article-text-bg-neutral', 'article-text-bg-purple', 'article-text-bg-gold', 'article-text-bg-green', 'article-text-bg-red'];
                  for (var bi = 0; bi < ALL_BGS.length; bi++) {
                    if (bSpan.classList.contains(ALL_BGS[bi])) {
                      activeBgClass = ALL_BGS[bi];
                      break;
                    }
                  }
                }
                var colSpan = cNode ? cNode.closest('.article-text-gold, .article-text-purple, .article-text-muted') : null;
                if (colSpan && surface.contains(colSpan)) {
                  var ALL_COLS = ['article-text-gold', 'article-text-purple', 'article-text-muted'];
                  for (var ci = 0; ci < ALL_COLS.length; ci++) {
                    if (colSpan.classList.contains(ALL_COLS[ci])) {
                      activeColorClass = ALL_COLS[ci];
                      break;
                    }
                  }
                }
              }
            }

            if (highlightTrigger) {
              highlightTrigger.classList.toggle('is-active', activeBgClass !== 'default');
            }
            if (highlightMenu) {
              highlightMenu.querySelectorAll('.rich-highlight-item').forEach(function(item) {
                item.classList.toggle('is-active', item.getAttribute('data-bg') === activeBgClass);
              });
            }
            if (colorTrigger) {
              colorTrigger.classList.toggle('is-active', activeColorClass !== 'default');
            }
            if (colorMenu) {
              colorMenu.querySelectorAll('.rich-color-item').forEach(function(item) {
                item.classList.toggle('is-active', item.getAttribute('data-color') === activeColorClass);
              });
            }

            var selInfo = getSelectionInfo();
            if (linkBtn) {
              if (selInfo.anchor) {
                linkBtn.classList.add('is-active');
                linkBtn.style.opacity = '1';
                linkBtn.title = 'Edit link';
              } else if (selInfo.hasText) {
                linkBtn.classList.remove('is-active');
                linkBtn.style.opacity = '1';
                linkBtn.title = 'Add link';
              } else {
                linkBtn.classList.remove('is-active');
                linkBtn.style.opacity = '0.5';
                linkBtn.title = 'Select text before creating a link';
              }
            }
          }

          function updateSwatchActive() {
            swatchBtns.forEach(function(sb) {
              sb.classList.toggle('is-active', sb.getAttribute('data-link-color') === selectedLinkColor);
            });
          }

          function populateInternalArticleOptions() {
            if (!internalSelect) return;
            var curVal = internalSelect.value;
            var pubArticles = window.STUDIO_PUBLISHED_ARTICLES || [];
            internalSelect.innerHTML = '<option value="">Choose published scroll...</option>';
            pubArticles.forEach(function(pa) {
              var opt = document.createElement('option');
              opt.value = pa.slug;
              opt.textContent = pa.title + (pa.category ? ' (' + pa.category + ')' : '');
              internalSelect.appendChild(opt);
            });
            if (curVal) internalSelect.value = curVal;
          }

          function setLinkType(newType) {
            currentLinkType = newType;
            typeTabs.forEach(function(btn) {
              var isActive = btn.getAttribute('data-link-type') === newType;
              btn.classList.toggle('active', isActive);
              btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
            });
            if (newType === 'internal') {
              if (panelInternal) panelInternal.style.display = 'block';
              if (panelExternal) panelExternal.style.display = 'none';
              if (urlError) urlError.style.display = 'none';
              validateLinkState();
            } else {
              if (panelInternal) panelInternal.style.display = 'none';
              if (panelExternal) panelExternal.style.display = 'block';
              validateLinkState();
            }
          }

          function validateLinkState() {
            if (currentLinkType === 'internal') {
              var slug = internalSelect ? internalSelect.value : '';
              if (urlError) urlError.style.display = 'none';
              if (applyBtn) applyBtn.disabled = !slug;
            } else {
              var val = urlInput ? urlInput.value.trim() : '';
              var isValid = validateLinkUrl(val);
              if (!val) {
                if (urlError) urlError.style.display = 'none';
                if (applyBtn) applyBtn.disabled = true;
              } else if (isValid) {
                if (urlError) urlError.style.display = 'none';
                if (applyBtn) applyBtn.disabled = false;
              } else {
                if (urlError) {
                  urlError.textContent = 'Enter a valid http(s) URL or Coven internal path.';
                  urlError.style.display = 'block';
                }
                if (applyBtn) applyBtn.disabled = true;
              }
            }
          }

          function closeLinkPopover() {
            if (linkPopover) {
              linkPopover.style.display = 'none';
              linkPopover.style.position = '';
              linkPopover.style.zIndex = '';
              linkPopover.style.top = '';
              linkPopover.style.left = '';
              linkPopover.style.visibility = '';
              linkPopover.classList.remove('is-flipped-above');
              restoreFromOverlayRoot(linkPopover);
              linkPopover.__anchorTrigger = null;
            }
            if (applyBtn) applyBtn.style.display = 'inline-block';
            savedRange = null;
            activeAnchor = null;
          }

          toolbar.querySelectorAll('button').forEach(function(btn) {
            btn.addEventListener('mousedown', function(e) {
              e.preventDefault();
            });
          });

          toolbar.querySelectorAll('[data-cmd="bold"], [data-cmd="italic"], [data-cmd="underline"]').forEach(function(btn) {
            btn.addEventListener('click', function(e) {
              e.preventDefault();
              var cmd = btn.getAttribute('data-cmd');
              surface.focus();
              var range = resolveSmartRange(surface, cmd);
              if (range) {
                document.execCommand(cmd, false, null);
                updateToolbarActiveStates();
                var cur = getCurrentData();
                cur.text = sanitizeRichText(surface.innerHTML);
                setCurrentData(cur);
              }
            });
          });

          function applyRichTextColorFromPalette(colorValue, explicitRange) {
            if (!colorValue) return;
            var targetRange = isValidRangeForSurface(surface, explicitRange)
              ? explicitRange
              : preservedFormatRange;
            applyColorClass(surface, colorValue, targetRange);
            captureSurfaceSelection();
            closeAllPopovers();
            updateToolbarActiveStates();
            var cur = getCurrentData();
            cur.text = sanitizeRichText(surface.innerHTML);
            setCurrentData(cur);
          }

          function applyRichTextHighlightFromPalette(bgValue, explicitRange) {
            if (!bgValue) return;
            var targetRange = isValidRangeForSurface(surface, explicitRange)
              ? explicitRange
              : preservedFormatRange;
            applyBgClass(surface, bgValue, targetRange);
            captureSurfaceSelection();
            closeAllPopovers();
            updateToolbarActiveStates();
            var cur = getCurrentData();
            cur.text = sanitizeRichText(surface.innerHTML);
            setCurrentData(cur);
          }

          if (colorTrigger && colorMenu) {
            colorMenu.addEventListener('mousedown', function(e) {
              e.preventDefault();
            });

            colorTrigger.addEventListener('mousedown', function(e) {
              e.preventDefault();
              captureSurfaceSelection();
            });

            colorTrigger.addEventListener('click', function(e) {
              e.preventDefault();
              captureSurfaceSelection();
              var isOpen = colorMenu.style.display === 'flex';
              closeAllPopovers(colorMenu);
              if (isOpen) {
                colorMenu.style.display = 'none';
              } else {
                updateAllSavedSwatchesUI();
                openAnchoredPopover(colorMenu, colorTrigger);
              }
            });

            colorMenu.querySelectorAll('.rich-color-item').forEach(function(item) {
              item.addEventListener('click', function(e) {
                e.preventDefault();
                var colorClass = item.getAttribute('data-color');
                applyRichTextColorFromPalette(colorClass);
              });
            });

            colorMenu.addEventListener('click', function(e) {
              var delBtn = e.target.closest('.saved-swatch-del');
              if (delBtn) {
                e.preventDefault();
                e.stopPropagation();
                var hex = delBtn.getAttribute('data-del-hex');
                if (hex) {
                  removeColorFromPalette(hex);
                  updateAllSavedSwatchesUI();
                }
                return;
              }
              var chip = e.target.closest('.saved-swatch-chip');
              if (chip) {
                e.preventDefault();
                var hex = chip.getAttribute('data-hex');
                if (hex) {
                  applyRichTextColorFromPalette(hex);
                }
                return;
              }
              var customBtn = e.target.closest('.rich-btn-custom-color');
              if (customBtn) {
                e.preventDefault();
                var rangeForPicker = isValidRangeForSurface(surface, preservedFormatRange)
                  ? preservedFormatRange.cloneRange()
                  : captureSurfaceSelection();
                closeAllPopovers();
                openCustomColorPicker(colorTrigger, '#C45AFF', function(chosenHex, pickerRange) {
                  applyRichTextColorFromPalette(chosenHex, pickerRange || rangeForPicker);
                }, function(savedHex, pickerRange) {
                  applyRichTextColorFromPalette(savedHex, pickerRange || rangeForPicker);
                }, surface, 'color', rangeForPicker);
              }
            });
          }

          if (highlightTrigger && highlightMenu) {
            highlightMenu.addEventListener('mousedown', function(e) {
              e.preventDefault();
            });

            highlightTrigger.addEventListener('mousedown', function(e) {
              e.preventDefault();
              captureSurfaceSelection();
            });

            highlightTrigger.addEventListener('click', function(e) {
              e.preventDefault();
              captureSurfaceSelection();
              var isOpen = highlightMenu.style.display === 'flex';
              closeAllPopovers(highlightMenu);
              if (isOpen) {
                highlightMenu.style.display = 'none';
              } else {
                updateAllSavedSwatchesUI();
                openAnchoredPopover(highlightMenu, highlightTrigger);
              }
            });

            highlightMenu.querySelectorAll('.rich-highlight-item').forEach(function(item) {
              item.addEventListener('click', function(e) {
                e.preventDefault();
                var bgClass = item.getAttribute('data-bg');
                applyRichTextHighlightFromPalette(bgClass);
              });
            });

            highlightMenu.addEventListener('click', function(e) {
              var delBtn = e.target.closest('.saved-swatch-del');
              if (delBtn) {
                e.preventDefault();
                e.stopPropagation();
                var hex = delBtn.getAttribute('data-del-hex');
                if (hex) {
                  removeColorFromPalette(hex);
                  updateAllSavedSwatchesUI();
                }
                return;
              }
              var chip = e.target.closest('.saved-swatch-chip');
              if (chip) {
                e.preventDefault();
                var hex = chip.getAttribute('data-hex');
                if (hex) {
                  applyRichTextHighlightFromPalette(hex);
                }
                return;
              }
              var customBtn = e.target.closest('.rich-btn-custom-color');
              if (customBtn) {
                e.preventDefault();
                var rangeForBgPicker = isValidRangeForSurface(surface, preservedFormatRange)
                  ? preservedFormatRange.cloneRange()
                  : captureSurfaceSelection();
                closeAllPopovers();
                openCustomColorPicker(highlightTrigger, '#344A3D', function(chosenHex, pickerRange) {
                  applyRichTextHighlightFromPalette(chosenHex, pickerRange || rangeForBgPicker);
                }, function(savedHex, pickerRange) {
                  applyRichTextHighlightFromPalette(savedHex, pickerRange || rangeForBgPicker);
                }, surface, 'highlight', rangeForBgPicker);
              }
            });
          }

          // ── Link Button & Popover Events ──────────────────
          if (linkBtn && linkPopover) {
            linkBtn.addEventListener('click', function(e) {
              e.preventDefault();
              var isOpen = linkPopover.style.display === 'flex';
              if (isOpen) {
                closeLinkPopover();
                return;
              }
              document.querySelectorAll('.rich-color-menu').forEach(function(m) { m.style.display = 'none'; });
              document.querySelectorAll('.rich-link-popover').forEach(function(p) { p.style.display = 'none'; });

              populateInternalArticleOptions();
              var selInfo = getSelectionInfo();

              if (selInfo.anchor) {
                // Editing existing anchor
                activeAnchor = selInfo.anchor;
                savedRange = null;
                var rawHref = (activeAnchor.getAttribute('href') || '').trim();

                // Check if href points to /article/<slug> matching an existing published article
                var pubArticles = window.STUDIO_PUBLISHED_ARTICLES || [];
                var match = rawHref.match(/^\/article\/([a-zA-Z0-9_-]+)\/?$/);
                var matchedPa = null;
                if (match) {
                  var slug = match[1];
                  matchedPa = pubArticles.find(function(a) { return a.slug === slug; });
                }

                if (matchedPa) {
                  setLinkType('internal');
                  if (internalSelect) internalSelect.value = matchedPa.slug;
                  if (urlInput) urlInput.value = rawHref;
                } else {
                  setLinkType('external');
                  if (urlInput) urlInput.value = rawHref;
                  if (internalSelect) internalSelect.value = '';
                }

                var cls = activeAnchor.className || '';
                selectedLinkColor = 'default';
                if (cls.indexOf('article-rich-link--gold') !== -1) selectedLinkColor = 'gold';
                else if (cls.indexOf('article-rich-link--purple') !== -1) selectedLinkColor = 'purple';
                else if (cls.indexOf('article-rich-link--parchment') !== -1) selectedLinkColor = 'parchment';
                else if (cls.indexOf('article-rich-link--muted') !== -1) selectedLinkColor = 'muted';

                updateSwatchActive();
                var tabsWrap = linkPopover.querySelector('.rich-link-type-tabs');
                if (tabsWrap) tabsWrap.style.display = 'flex';
                var typeLabel = linkPopover.querySelector('.rich-link-popover__label');
                if (typeLabel) typeLabel.style.display = 'block';
                if (colorSection) colorSection.style.display = 'block';
                if (popoverMsg) popoverMsg.style.display = 'none';
                if (removeBtn) removeBtn.style.display = 'inline-block';
                if (applyBtn) {
                  applyBtn.style.display = 'inline-block';
                  applyBtn.textContent = 'Update Link';
                }
                if (urlError) urlError.style.display = 'none';
                validateLinkState();

                openAnchoredPopover(linkPopover, linkBtn);
                setTimeout(function() {
                  if (currentLinkType === 'internal') {
                    if (internalSelect) internalSelect.focus({ preventScroll: true });
                  } else {
                    if (urlInput) urlInput.focus({ preventScroll: true });
                  }
                }, 30);
              } else if (selInfo.hasText) {
                // Creating new link on selected range
                activeAnchor = null;
                savedRange = selInfo.range.cloneRange();
                setLinkType('internal');
                if (internalSelect) internalSelect.value = '';
                if (urlInput) urlInput.value = '';
                selectedLinkColor = 'default';
                updateSwatchActive();

                var tabsWrap = linkPopover.querySelector('.rich-link-type-tabs');
                if (tabsWrap) tabsWrap.style.display = 'flex';
                var typeLabel = linkPopover.querySelector('.rich-link-popover__label');
                if (typeLabel) typeLabel.style.display = 'block';
                if (colorSection) colorSection.style.display = 'block';
                if (popoverMsg) popoverMsg.style.display = 'none';
                if (removeBtn) removeBtn.style.display = 'none';
                if (applyBtn) {
                  applyBtn.style.display = 'inline-block';
                  applyBtn.textContent = 'Apply Link';
                }
                if (urlError) urlError.style.display = 'none';
                validateLinkState();

                openAnchoredPopover(linkPopover, linkBtn);
                setTimeout(function() {
                  if (internalSelect) internalSelect.focus({ preventScroll: true });
                }, 30);
              } else {
                // Selection collapsed: show message
                activeAnchor = null;
                savedRange = null;
                var tabsWrap = linkPopover.querySelector('.rich-link-type-tabs');
                if (tabsWrap) tabsWrap.style.display = 'none';
                var typeLabel = linkPopover.querySelector('.rich-link-popover__label');
                if (typeLabel) typeLabel.style.display = 'none';
                if (panelInternal) panelInternal.style.display = 'none';
                if (panelExternal) panelExternal.style.display = 'none';
                if (colorSection) colorSection.style.display = 'none';
                if (popoverMsg) {
                  popoverMsg.textContent = 'Select text before creating a link.';
                  popoverMsg.style.display = 'block';
                }
                if (removeBtn) removeBtn.style.display = 'none';
                if (applyBtn) applyBtn.style.display = 'none';
                if (urlError) urlError.style.display = 'none';

                openAnchoredPopover(linkPopover, linkBtn);
              }
            });

            linkPopover.addEventListener('mousedown', function(e) {
              if (e.target.tagName !== 'INPUT' && e.target.tagName !== 'SELECT' && e.target.tagName !== 'OPTION') {
                e.preventDefault();
              }
            });

            typeTabs.forEach(function(tab) {
              tab.addEventListener('click', function(e) {
                e.preventDefault();
                var targetType = tab.getAttribute('data-link-type');
                if (targetType === currentLinkType) return;
                setLinkType(targetType);
                if (targetType === 'internal') {
                  var inputVal = urlInput ? urlInput.value.trim() : '';
                  var m = inputVal.match(/^\/article\/([a-zA-Z0-9_-]+)\/?$/);
                  if (m && internalSelect) {
                    var slug = m[1];
                    var opt = internalSelect.querySelector('option[value="' + slug + '"]');
                    if (opt) internalSelect.value = slug;
                  }
                  validateLinkState();
                  setTimeout(function() { if (internalSelect) internalSelect.focus({ preventScroll: true }); }, 30);
                } else {
                  if (internalSelect && internalSelect.value && urlInput && !urlInput.value) {
                    urlInput.value = '/article/' + internalSelect.value;
                  }
                  validateLinkState();
                  setTimeout(function() { if (urlInput) urlInput.focus({ preventScroll: true }); }, 30);
                }
              });
            });

            if (internalSelect) {
              ['change', 'input'].forEach(function(evt) {
                internalSelect.addEventListener(evt, validateLinkState);
              });

              internalSelect.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                  e.preventDefault();
                  closeLinkPopover();
                  surface.focus();
                } else if (e.key === 'Enter') {
                  e.preventDefault();
                  validateLinkState();
                  if (applyBtn && !applyBtn.disabled) {
                    applyBtn.click();
                  }
                }
              });
            }

            swatchBtns.forEach(function(sb) {
              sb.addEventListener('click', function(e) {
                e.preventDefault();
                selectedLinkColor = sb.getAttribute('data-link-color') || 'default';
                updateSwatchActive();
              });
            });

            if (urlInput) {
              ['input', 'change', 'keyup', 'paste'].forEach(function(evt) {
                urlInput.addEventListener(evt, validateLinkState);
              });

              urlInput.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                  e.preventDefault();
                  closeLinkPopover();
                  surface.focus();
                } else if (e.key === 'Enter') {
                  e.preventDefault();
                  validateLinkState();
                  if (applyBtn && !applyBtn.disabled) {
                    applyBtn.click();
                  }
                }
              });
            }

            if (cancelBtn) {
              cancelBtn.addEventListener('click', function(e) {
                e.preventDefault();
                closeLinkPopover();
                surface.focus();
              });
            }

            if (removeBtn) {
              removeBtn.addEventListener('click', function(e) {
                e.preventDefault();
                if (activeAnchor) {
                  while (activeAnchor.firstChild) {
                    activeAnchor.parentNode.insertBefore(activeAnchor.firstChild, activeAnchor);
                  }
                  activeAnchor.parentNode.removeChild(activeAnchor);
                }
                closeLinkPopover();
                surface.focus();
                var cur = getCurrentData();
                cur.text = sanitizeRichText(surface.innerHTML);
                setCurrentData(cur);
                updateToolbarActiveStates();
              });
            }

            if (applyBtn) {
              applyBtn.addEventListener('click', function(e) {
                e.preventDefault();
                var targetUrl = '';
                var isExt = false;

                if (currentLinkType === 'internal') {
                  var slug = internalSelect ? internalSelect.value : '';
                  if (!slug) return;
                  targetUrl = '/article/' + slug;
                  isExt = false;
                } else {
                  var url = urlInput ? urlInput.value.trim() : '';
                  if (!validateLinkUrl(url)) return;
                  targetUrl = url;
                  isExt = /^https?:\/\//i.test(targetUrl);
                }

                var colorClass = selectedLinkColor !== 'default' ? ' article-rich-link--' + selectedLinkColor : '';

                if (activeAnchor) {
                  activeAnchor.setAttribute('href', targetUrl);
                  if (isExt) {
                    activeAnchor.setAttribute('target', '_blank');
                    activeAnchor.setAttribute('rel', 'noopener noreferrer');
                  } else {
                    activeAnchor.removeAttribute('target');
                    activeAnchor.removeAttribute('rel');
                  }
                  activeAnchor.className = 'article-rich-link' + colorClass;
                } else if (savedRange) {
                  var sel = window.getSelection();
                  sel.removeAllRanges();
                  sel.addRange(savedRange);

                  // Prevent nested anchors
                  var insideAnchors = surface.querySelectorAll('a');
                  for (var k = 0; k < insideAnchors.length; k++) {
                    var ia = insideAnchors[k];
                    if (savedRange.intersectsNode ? savedRange.intersectsNode(ia) : false) {
                      while (ia.firstChild) ia.parentNode.insertBefore(ia.firstChild, ia);
                      ia.parentNode.removeChild(ia);
                    }
                  }

                  var a = document.createElement('a');
                  a.setAttribute('href', targetUrl);
                  if (isExt) {
                    a.setAttribute('target', '_blank');
                    a.setAttribute('rel', 'noopener noreferrer');
                  }
                  a.className = 'article-rich-link' + colorClass;

                  try {
                    savedRange.surroundContents(a);
                  } catch (err) {
                    var fragment = savedRange.extractContents();
                    a.appendChild(fragment);
                    savedRange.insertNode(a);
                  }

                  var newRange = document.createRange();
                  newRange.selectNodeContents(a);
                  closeLinkPopover();
                  surface.focus();
                  var sel2 = window.getSelection();
                  sel2.removeAllRanges();
                  sel2.addRange(newRange);
                }

                closeLinkPopover();
                surface.focus();
                var cur = getCurrentData();
                cur.text = sanitizeRichText(surface.innerHTML);
                setCurrentData(cur);
                updateToolbarActiveStates();
              });
            }
          }

          toolbar.querySelectorAll('.rich-btn-align').forEach(function(btn) {
            btn.addEventListener('click', function(e) {
              e.preventDefault();
              var align = btn.getAttribute('data-align');
              surface.classList.remove('rich-align-left', 'rich-align-center', 'rich-align-right');
              surface.classList.add('rich-align-' + align);
              toolbar.querySelectorAll('.rich-btn-align').forEach(function(b) {
                b.classList.toggle('is-active', b === btn);
              });
              var cur = getCurrentData();
              cur.align = align;
              cur.text = sanitizeRichText(surface.innerHTML);
              setCurrentData(cur);
            });
          });

          surface.addEventListener('click', function(e) {
            var anchor = e.target.closest('a');
            if (anchor) {
              e.preventDefault();
              updateToolbarActiveStates();
            }
          });

          surface.addEventListener('input', function() {
            captureSurfaceSelection();
            var cur = getCurrentData();
            cur.text = sanitizeRichText(surface.innerHTML);
            setCurrentData(cur);
            updateToolbarActiveStates();
          });

          surface.addEventListener('keyup', function() {
            captureSurfaceSelection();
            updateToolbarActiveStates();
          });
          surface.addEventListener('mouseup', function() {
            captureSurfaceSelection();
            updateToolbarActiveStates();
          });
          surface.addEventListener('touchend', function() {
            captureSurfaceSelection();
            updateToolbarActiveStates();
          });

          surface.addEventListener('keydown', function(e) {
            if ((e.ctrlKey || e.metaKey) && !e.shiftKey && !e.altKey) {
              var k = e.key.toLowerCase();
              if (k === 'b' || k === 'i' || k === 'u') {
                var cmd = k === 'b' ? 'bold' : (k === 'i' ? 'italic' : 'underline');
                e.preventDefault();
                var range = resolveSmartRange(surface, cmd);
                if (range) {
                  document.execCommand(cmd, false, null);
                  updateToolbarActiveStates();
                  var cur = getCurrentData();
                  cur.text = sanitizeRichText(surface.innerHTML);
                  setCurrentData(cur);
                }
              }
            }
          });

          surface.addEventListener('copy', function(e) {
            handleCovenCopy(e, false, surface, getCurrentData, setCurrentData, updateToolbarActiveStates);
          });

          surface.addEventListener('cut', function(e) {
            handleCovenCopy(e, true, surface, getCurrentData, setCurrentData, updateToolbarActiveStates);
          });

          surface.addEventListener('paste', function(e) {
            handleCovenPaste(e, surface, getCurrentData, setCurrentData, updateToolbarActiveStates);
          });

          surface.addEventListener('focus', function() {
            wrap.classList.add('is-focused');
            try {
              document.execCommand('defaultParagraphSeparator', false, 'br');
            } catch (e) {}
            updateToolbarActiveStates();
          });

          surface.addEventListener('blur', function() {
            wrap.classList.remove('is-focused');
            var cur = getCurrentData();
            cur.text = sanitizeRichText(surface.innerHTML);
            setCurrentData(cur);
          });
        });
      }

