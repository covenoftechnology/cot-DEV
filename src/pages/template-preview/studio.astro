                  renderRichTextFieldHtml('Step Title', 'data-rich-array-obj="steps" data-rich-item-id="' + st.id + '" data-rich-prop="title"', st.title, 'e.g. Telemetry Verification') +
                  renderRichTextFieldHtml('Description', 'data-rich-array-obj="steps" data-rich-item-id="' + st.id + '" data-rich-prop="text"', st.text, 'Instructions or ritual breakdown...') +
                '</div>';
