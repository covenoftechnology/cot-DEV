              '<button type="button" class="accent-chip-select-btn" data-act="select-saved-color" data-hex="' + c + '" role="radio" aria-checked="' + (isSavedActive ? 'true' : 'false') + '" aria-label="Use saved color ' + c + '" title="Use saved color ' + c + '">' +
                '<span class="accent-chip-dot" style="background-color:' + c + ';" aria-hidden="true"></span>' +
                '<span class="accent-chip-hex">' + c + '</span>' +
                (isSavedActive ? '<span class="accent-chip-check" aria-hidden="true">✓</span>' : '') +
              '</button>' +
              '<button type="button" class="accent-chip-del-btn" data-act="remove-saved-color" data-hex="' + c + '" title="Remove ' + c + ' from My Colors" aria-label="Remove ' + c + ' from My Colors">×</button>' +
            '</div>';
          });
          chipsContainer.innerHTML = chipsHtml;
        });

        // 3. Legacy callout-saved-swatches container
        document.querySelectorAll('.callout-saved-swatches').forEach(function(row) {
          row.innerHTML = '';
          var activeHex = (row.getAttribute('data-active-hex') || '').toUpperCase();
          saved.forEach(function(hex) {
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'studio-swatch callout-accent-swatch' + (activeHex === hex.toUpperCase() ? ' is-active' : '');
            btn.setAttribute('data-act', 'callout-accent-swatch');
            btn.setAttribute('data-hex', hex);
            btn.setAttribute('title', 'Callout accent ' + hex);
            btn.style.width = '24px';
            btn.style.height = '24px';
            btn.style.borderRadius = '3px';
            btn.style.backgroundColor = hex;
            btn.style.border = (activeHex === hex.toUpperCase()) ? '2px solid var(--studio-gold)' : '1px solid rgba(255,255,255,0.25)';
            btn.style.cursor = 'pointer';
            row.appendChild(btn);
          });
        });
      }

      var customColorPickerState = {
        anchorEl: null,
        savedRange: null,
        surface: null,
        onApply: null,
        onSave: null
      };

      function getStudioOverlayRoot() {
        var root = document.getElementById('coven-studio-overlay-root');
        if (!root) {
          root = document.createElement('div');
          root.id = 'coven-studio-overlay-root';
          root.className = 'coven-studio-overlay-root';
          var studioEl = document.querySelector('.coven-studio') || document.body;
          studioEl.appendChild(root);
        }
        return root;
      }

      function teleportToOverlayRoot(el) {
        if (!el || el.id === 'coven-custom-color-popover') return;
        var root = getStudioOverlayRoot();
        if (el.parentNode === root) return;
        if (!el.__portalPlaceholder) {
          var placeholder = document.createComment('coven-portal-anchor');
          if (el.parentNode) {
            el.parentNode.insertBefore(placeholder, el);
            el.__portalPlaceholder = placeholder;
          }
        }
        root.appendChild(el);
      }

      function restoreFromOverlayRoot(el) {
        if (!el || el.id === 'coven-custom-color-popover') return;
        if (el.__portalPlaceholder) {
          if (el.__portalPlaceholder.parentNode) {
            el.__portalPlaceholder.parentNode.insertBefore(el, el.__portalPlaceholder);
            el.__portalPlaceholder.remove();
          } else if (el.parentNode) {
            el.remove();
          }
          el.__portalPlaceholder = null;
        }
      }

      function openAnchoredPopover(popoverEl, triggerEl) {
        closeAllPopovers(popoverEl);

        teleportToOverlayRoot(popoverEl);
        popoverEl.__anchorTrigger = triggerEl;

        popoverEl.style.display = 'flex';
        popoverEl.style.position = 'fixed';
        popoverEl.style.zIndex = (popoverEl.id === 'coven-custom-color-popover') ? '100000' : '90000';
        popoverEl.style.visibility = 'hidden';

        var trigRect = triggerEl.getBoundingClientRect();

        if (popoverEl.classList.contains('nested-marker-dropdown')) {
          var targetWidth = Math.max(180, Math.round(trigRect.width));
          popoverEl.style.width = targetWidth + 'px';
          popoverEl.style.right = 'auto';
        }

        var popRect = popoverEl.getBoundingClientRect();
        var popHeight = popRect.height || 220;
        var popWidth = popRect.width || (popoverEl.classList.contains('coven-custom-color-popover') ? 330 : (popoverEl.classList.contains('rich-link-popover') ? 320 : 170));

        var spaceBelow = window.innerHeight - trigRect.bottom;
        var spaceAbove = trigRect.top;

        var top;
        if (spaceBelow < (popHeight + 12) && spaceAbove > spaceBelow) {
          top = Math.max(8, trigRect.top - popHeight - 4);
          popoverEl.classList.add('is-flipped-above');
        } else {
          top = Math.min(window.innerHeight - popHeight - 8, trigRect.bottom + 4);
          popoverEl.classList.remove('is-flipped-above');
        }

        var left = trigRect.left;
        if (left + popWidth > window.innerWidth - 8) {
          left = Math.max(8, window.innerWidth - popWidth - 8);
        }
        if (left < 8) left = 8;

        popoverEl.style.top = Math.round(top) + 'px';
        popoverEl.style.left = Math.round(left) + 'px';
        popoverEl.style.visibility = 'visible';
      }

      function closeAllPopovers(exceptEl) {
        document.querySelectorAll('.rich-color-menu, .rich-highlight-menu, .rich-link-popover, .coven-custom-color-popover, .nested-marker-dropdown').forEach(function(m) {
          if (m !== exceptEl) {
            m.style.display = 'none';
            m.classList.remove('is-flipped-above');
            m.style.top = '';
            m.style.left = '';
            m.style.width = '';
            m.style.right = '';
            m.style.position = '';
            m.style.zIndex = '';
            m.style.visibility = '';
            restoreFromOverlayRoot(m);
            m.__anchorTrigger = null;
          }
        });
      }

      function openCustomColorPicker(anchorEl, initialHex, onApply, onSave, targetSurface, formatType, explicitRange) {
        var popover = document.getElementById('coven-custom-color-popover');
        if (!popover) return;

        var hexInput = document.getElementById('coven-custom-color-hex');
        var nativeInput = document.getElementById('coven-custom-color-native');
        var previewBadge = document.getElementById('coven-custom-color-preview-badge');
        var previewBanner = document.getElementById('coven-custom-color-preview-banner');
        var currentText = document.getElementById('coven-custom-color-current-text');
        var triggerSwatch = document.getElementById('coven-custom-color-trigger-swatch');
        var errorEl = document.getElementById('coven-custom-color-error');
        var applyBtn = document.getElementById('coven-custom-color-apply');
        var saveBtn = document.getElementById('coven-custom-color-save');

        var norm = normalizeHex(initialHex) || '#C45AFF';
        if (hexInput) hexInput.value = norm;
        if (nativeInput) nativeInput.value = norm;
        if (previewBadge) previewBadge.textContent = norm;
        if (previewBanner) previewBanner.style.background = norm;
        if (currentText) currentText.textContent = '● ' + norm;
        if (triggerSwatch) triggerSwatch.style.background = norm;
        if (errorEl) errorEl.style.display = 'none';
        if (applyBtn) applyBtn.disabled = false;
        if (saveBtn) saveBtn.disabled = false;

        customColorPickerState.anchorEl = anchorEl;
        customColorPickerState.onApply = onApply;
        customColorPickerState.onSave = onSave;
        customColorPickerState.surface = targetSurface || null;

        if (targetSurface) {
          var preserved = isValidRangeForSurface(targetSurface, explicitRange)
            ? explicitRange.cloneRange()
            : (isValidRangeForSurface(targetSurface, targetSurface.__covenSavedRange) ? targetSurface.__covenSavedRange.cloneRange() : null);
          var r = resolveSmartRange(targetSurface, formatType || 'color');
          if (r && !r.collapsed && r.toString().length > 0) {
            customColorPickerState.savedRange = r.cloneRange();
          } else if (preserved && !preserved.collapsed && preserved.toString().length > 0) {
            customColorPickerState.savedRange = preserved.cloneRange();
          } else {
            customColorPickerState.savedRange = r ? r.cloneRange() : preserved;
          }
        } else {
          customColorPickerState.savedRange = null;
        }

        openAnchoredPopover(popover, anchorEl);
        if (hexInput) {
          hexInput.focus();
          hexInput.select();
        }
      }

      function initCustomColorPicker() {
        var popover = document.getElementById('coven-custom-color-popover');
        if (!popover) return;

        var triggerBtn = document.getElementById('coven-custom-color-trigger-btn');
        var triggerSwatch = document.getElementById('coven-custom-color-trigger-swatch');
        var previewBadge = document.getElementById('coven-custom-color-preview-badge');
        var previewBanner = document.getElementById('coven-custom-color-preview-banner');
        var currentText = document.getElementById('coven-custom-color-current-text');
        var nativeInput = document.getElementById('coven-custom-color-native');
        var hexInput = document.getElementById('coven-custom-color-hex');
        var errorEl = document.getElementById('coven-custom-color-error');
        var cancelBtn = document.getElementById('coven-custom-color-cancel');
        var applyBtn = document.getElementById('coven-custom-color-apply');
        var saveBtn = document.getElementById('coven-custom-color-save');

        function updatePopoverPreviews(norm) {
          if (previewBadge) previewBadge.textContent = norm;
          if (previewBanner) previewBanner.style.background = norm;
          if (currentText) currentText.textContent = '● ' + norm;
          if (triggerSwatch) triggerSwatch.style.background = norm;
          if (nativeInput) nativeInput.value = norm;
        }

        if (triggerBtn && nativeInput) {
          triggerBtn.addEventListener('click', function(e) {
            e.preventDefault();
            nativeInput.click();
          });
        }

        if (nativeInput) {
          nativeInput.addEventListener('input', function() {
            var val = (nativeInput.value || '').toUpperCase();
            if (hexInput) hexInput.value = val;
            updatePopoverPreviews(val);
            if (errorEl) errorEl.style.display = 'none';
            if (applyBtn) applyBtn.disabled = false;
            if (saveBtn) saveBtn.disabled = false;
          });
        }

        function getNormalizedHexFromInput() {
          if (!hexInput) return null;
          var raw = hexInput.value.trim();
          if (!raw) return null;
          if (!raw.startsWith('#')) raw = '#' + raw;
          return normalizeHex(raw);
        }

        function syncHexToPreview() {
          var norm = getNormalizedHexFromInput();
          if (norm) {
            updatePopoverPreviews(norm);
            if (errorEl) errorEl.style.display = 'none';
            if (applyBtn) applyBtn.disabled = false;
            if (saveBtn) saveBtn.disabled = false;
          } else {
            if (errorEl) {
              errorEl.textContent = 'Invalid HEX color';
              errorEl.style.display = 'block';
            }
            if (applyBtn) applyBtn.disabled = true;
            if (saveBtn) saveBtn.disabled = true;
          }
        }

        if (hexInput) {
          hexInput.addEventListener('input', syncHexToPreview);
          hexInput.addEventListener('change', function() {
            var norm = getNormalizedHexFromInput();
            if (norm) hexInput.value = norm;
          });
        }

        if (cancelBtn) {
          cancelBtn.addEventListener('click', function(e) {
            e.preventDefault();
            popover.style.display = 'none';
            if (customColorPickerState.surface) {
              customColorPickerState.surface.focus();
            }
          });
        }

        function finishPicker(shouldSave) {
          var norm = getNormalizedHexFromInput();
          if (!norm) {
            if (errorEl) {
              errorEl.textContent = 'Invalid HEX color';
              errorEl.style.display = 'block';
            }
            if (applyBtn) applyBtn.disabled = true;
            if (saveBtn) saveBtn.disabled = true;
            return;
          }

          var rangeToApply = customColorPickerState.savedRange
            ? customColorPickerState.savedRange.cloneRange()
            : null;
          var surfaceToApply = customColorPickerState.surface;

          if (shouldSave) {
            saveColorToPalette(norm);
          }

          popover.style.display = 'none';

          if (surfaceToApply && rangeToApply && isValidRangeForSurface(surfaceToApply, rangeToApply)) {
            surfaceToApply.__covenSavedRange = rangeToApply.cloneRange();
            surfaceToApply.focus({ preventScroll: true });
            var sel = window.getSelection();
            if (sel) {
              sel.removeAllRanges();
              sel.addRange(rangeToApply.cloneRange());
            }
          }

          if (typeof customColorPickerState.onApply === 'function') {
            customColorPickerState.onApply(norm, rangeToApply);
          }

          updateAllSavedSwatchesUI();
          customColorPickerState.savedRange = null;
          customColorPickerState.surface = null;
        }

        if (applyBtn) {
          applyBtn.addEventListener('click', function(e) {
            e.preventDefault();
            finishPicker(false);
          });
        }

        if (saveBtn) {
          saveBtn.addEventListener('click', function(e) {
            e.preventDefault();
            finishPicker(true);
          });
        }

        if (hexInput) {
          hexInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
              e.preventDefault();
              if (applyBtn && !applyBtn.disabled) finishPicker(false);
            } else if (e.key === 'Escape') {
              e.preventDefault();
              popover.style.display = 'none';
              if (customColorPickerState.surface) customColorPickerState.surface.focus();
            }
          });
        }
      }

      // ── Custom Icon Modal ("MY ICONS") Controller ──────────
      var activeCustomIconContext = null;

      function renderCustomIconModalList() {
        var listEl = document.getElementById('coven-custom-icon-list');
        var countEl = document.getElementById('coven-custom-icon-count');
        if (!listEl) return;

        var saved = (typeof window.getSavedCustomIcons === 'function') ? window.getSavedCustomIcons() : [];
