              (d.title !== undefined ?
                renderRichTextFieldHtml('<span>Title</span>', 'data-rich-field="title"', d.title, 'Key Takeaways for the Initiate', '<span class="field-label-remove" data-act="remove-field" data-opt-field="title">✕ Remove</span>') :
                '<div style="margin-bottom:8px"><button type="button" class="studio-btn--add-field" data-act="add-field" data-opt-field="title">+ Add Title</button></div>'
              ) +
              '<div class="studio-form-group"><label class="studio-label">Takeaway Doctrines</label><div style="display:flex;flex-direction:column;gap:10px">';
            (d.items || []).forEach(function(item, tIdx) {
              html +=
                '<div class="nested-parent-card">' +
                  '<div style="display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(216,181,107,0.12);padding-bottom:6px">' +
                    '<span style="font-family:var(--font-mono);font-size:11px;color:var(--studio-gold)">DOCTRINE ' + String(tIdx + 1).padStart(2, '0') + '</span>' +
                    '<div style="display:flex;gap:4px">' +
                      '<button type="button" class="studio-btn studio-btn--icon" data-act="dup-takeaway" data-item-id="' + item.id + '" title="Duplicate">⧉</button>' +
                      '<button type="button" class="studio-btn studio-btn--icon studio-btn--danger" data-act="del-takeaway" data-item-id="' + item.id + '" ' + (d.items.length <= 1 ? 'disabled' : '') + ' title="Delete">✕</button>' +
                    '</div>' +
                  '</div>' +
                  renderRichTextFieldHtml('Term / Concept', 'data-rich-array-obj="items" data-rich-item-id="' + item.id + '" data-rich-prop="term"', item.term, 'e.g. Core Rule 1') +
                  renderRichTextFieldHtml('Description', 'data-rich-array-obj="items" data-rich-item-id="' + item.id + '" data-rich-prop="desc"', item.desc, 'Principle summary...') +
                '</div>';
            });
            html += '</div><div style="margin-top:8px"><button type="button" class="studio-btn studio-btn--sm" data-act="add-takeaway">+ Add Takeaway</button></div></div>';
            break;

          case 'related-docs':
            var pubArticles = window.STUDIO_PUBLISHED_ARTICLES || [];
            html += '<div class="studio-form-group"><label class="studio-label">Related Scrolls & External Docs</label><div style="display:flex;flex-direction:column;gap:12px">';
            (d.items || []).forEach(function(rd, rIdx) {
              var isInternal = rd.type !== 'external';
              html +=
                '<div class="nested-parent-card">' +
                  '<div style="display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(216,181,107,0.12);padding-bottom:6px">' +
                    '<span style="font-family:var(--font-mono);font-size:11px;color:var(--studio-gold)">DOC ' + String(rIdx + 1).padStart(2, '0') + '</span>' +
                    '<div style="display:flex;gap:4px">' +
                      '<button type="button" class="studio-btn studio-btn--icon" data-act="dup-doc" data-item-id="' + rd.id + '" title="Duplicate">⧉</button>' +
                      '<button type="button" class="studio-btn studio-btn--icon studio-btn--danger" data-act="del-doc" data-item-id="' + rd.id + '" ' + (d.items.length <= 1 ? 'disabled' : '') + ' title="Delete">✕</button>' +
                    '</div>' +
                  '</div>' +
                  '<div class="studio-form-group">' +
                    '<label class="studio-label">Resource Type</label>' +
                    '<div style="display:flex;gap:14px;align-items:center">' +
                      '<label style="display:flex;align-items:center;gap:6px;font-family:var(--font-body);font-size:14px;cursor:pointer">' +
                        '<input type="radio" name="rd_type_' + rd.id + '" data-act="toggle-doc-type" data-doc-id="' + rd.id + '" data-val="internal" ' + (isInternal ? 'checked' : '') + ' />' +
                        '<span>Internal Coven Scroll</span>' +
                      '</label>' +
                      '<label style="display:flex;align-items:center;gap:6px;font-family:var(--font-body);font-size:14px;cursor:pointer">' +
                        '<input type="radio" name="rd_type_' + rd.id + '" data-act="toggle-doc-type" data-doc-id="' + rd.id + '" data-val="external" ' + (!isInternal ? 'checked' : '') + ' />' +
                        '<span>External Documentation</span>' +
                      '</label>' +
                    '</div>' +
                  '</div>';

              if (isInternal) {
                html +=
                  '<div class="studio-form-group"><label class="studio-label">Select Published Scroll</label>' +
                    '<select class="studio-select" data-doc-select-slug="' + rd.id + '">' +
                      '<option value="">-- Choose scroll or keep custom --</option>';
                pubArticles.forEach(function(pa) {
                  var sel = (rd.slug === pa.slug || rd.url === '/article/' + pa.slug) ? ' selected' : '';
                  html += '<option value="' + pa.slug + '"' + sel + '>' + escapeHtml(pa.title) + ' (' + escapeHtml(pa.category) + ')</option>';
                });
                html +=
                    '</select>' +
                  '</div>' +
                  renderRichTextFieldHtml('Title', 'data-rich-array-obj="items" data-rich-item-id="' + rd.id + '" data-rich-prop="title"', rd.title, 'Scroll title...') +
                  '<div class="studio-form-group"><label class="studio-label">CTA Text</label><input type="text" class="studio-input" data-array-obj="items" data-item-id="' + rd.id + '" data-prop="ctaText" value="' + escapeHtml(rd.ctaText || 'Study scroll') + '" /></div>';
              } else {
                html +=
                  renderRichTextFieldHtml('Title', 'data-rich-array-obj="items" data-rich-item-id="' + rd.id + '" data-rich-prop="title"', rd.title, 'e.g. Official Salesforce Documentation') +
                  '<div class="studio-form-group"><label class="studio-label">External URL</label><input type="text" class="studio-input" data-array-obj="items" data-item-id="' + rd.id + '" data-prop="url" value="' + escapeHtml(rd.url || '') + '" placeholder="https://..." /></div>' +
                  '<div class="studio-form-group"><label class="studio-label">CTA Text</label><input type="text" class="studio-input" data-array-obj="items" data-item-id="' + rd.id + '" data-prop="ctaText" value="' + escapeHtml(rd.ctaText || 'Official documentation') + '" /></div>';
              }

              html += '</div>';
            });
            html += '</div><div style="margin-top:8px"><button type="button" class="studio-btn studio-btn--sm" data-act="add-doc">+ Add Documentation</button></div></div>';
            break;

          default:
            html += '<div style="color:var(--studio-text-muted);font-size:12px">Block fields for ' + escapeHtml(block.type) + '</div>';
            break;
        }

        return html;
      }

      // ── Attach Event Listeners to Block Fields ──────────
      function attachBlockListeners(bBody, sec, block) {
        var d = block.data;

        // Rich text listeners for any block with rich-text-field-wrap
        if (bBody.querySelector('.rich-text-field-wrap')) {
          attachRichTextListeners(bBody, sec, block);
        }

        // Table rich text & Visual Table Builder V2 listeners for technical-table
        if (block.type === 'technical-table') {
          attachTableRichTextListeners(bBody, sec, block);
          attachTableBuilderV2Listeners(bBody, sec, block);
        }

        // 1. Direct field inputs
        bBody.querySelectorAll('[data-field]').forEach(function(input) {
          var field = input.getAttribute('data-field');
          function handleFieldUpdate(e) {
            var newVal = e.target.value;
            // Sentinel detection for Add New Icon action
            if (input.classList.contains('coven-icon-select') && newVal === '__add_custom_icon__') {
              var prevVal = input.getAttribute('data-last-val') || d[field] || '';
              input.value = prevVal; // Revert immediately; never persist sentinel into block
              openCustomIconModal({
                targetSelect: input,
                sec: sec,
                block: block,
                field: field,
                previousValue: prevVal
              });
              return;
            }
            if (input.classList.contains('coven-icon-select')) {
              input.setAttribute('data-last-val', newVal);
            }
            var changed = d[field] !== newVal;
            d[field] = newVal;
            calculateReadingTime();
            triggerAutosave();
            if (changed && block.type === 'embed' && field === 'embedType') {
              var focusedId = activeFocusedBlock ? activeFocusedBlock.itemId : null;
              renderSections();
              if (focusedId) {
                var newItemEl = document.querySelector('.grid-block-item[data-item-id="' + focusedId + '"]');
                var foundItem = (sec.visualGrid && sec.visualGrid.layoutItems) ? sec.visualGrid.layoutItems.find(function(it) { return it.id === focusedId; }) : null;
                if (newItemEl && foundItem) {
                  openBlockFocusEditor(sec, foundItem, newItemEl, newItemEl.closest('.grid-composer-canvas'));
                }
              }
            }
          }
          input.addEventListener('input', handleFieldUpdate);
          if (input.tagName === 'SELECT') {
            input.addEventListener('change', handleFieldUpdate);
          }
        });

        // 2. Array primitive fields (e.g. paragraphs)
        bBody.querySelectorAll('[data-array-field]').forEach(function(input) {
          var field = input.getAttribute('data-array-field');
          var idx = parseInt(input.getAttribute('data-array-idx'), 10);
          input.addEventListener('input', function(e) {
            if (Array.isArray(d[field])) {
              d[field][idx] = e.target.value;
              calculateReadingTime();
              triggerAutosave();
            }
          });
        });

        // 3. Array of objects fields (e.g. steps, items, columns)
        bBody.querySelectorAll('[data-array-obj]').forEach(function(input) {
          var arrayName = input.getAttribute('data-array-obj');
          var itemId = input.getAttribute('data-item-id');
          var prop = input.getAttribute('data-prop');
          input.addEventListener('input', function(e) {
            var arr = d[arrayName];
            if (Array.isArray(arr)) {
              var target = arr.find(function(it) { return it.id === itemId; });
              if (target) {
                target[prop] = e.target.value;
                calculateReadingTime();
                triggerAutosave();
              }
            }
          });
        });

        // 4. Nested sub-items
        bBody.querySelectorAll('[data-nested-sub="true"]').forEach(function(input) {
          var subId = input.getAttribute('data-sub-id');
          input.addEventListener('input', function(e) {
            var foundSub = findNestedBulletNodeById(d.items || [], subId);
            if (foundSub && foundSub.node) {
              foundSub.node.text = e.target.value;
              calculateReadingTime();
              triggerAutosave();
            }
          });
        });

        // 5. Image sub-fields (alt, caption)
        bBody.querySelectorAll('[data-img-subfield]').forEach(function(input) {
          var sub = input.getAttribute('data-img-subfield');
          var propPrefix = input.getAttribute('data-img-prop');
          input.addEventListener('input', function(e) {
            if (propPrefix === 'imageSrc' || propPrefix === 'src') {
              d[sub] = e.target.value;
            } else if (propPrefix.startsWith('img') && propPrefix.length === 4) {
              // e.g. img1, img2, img3
              d[propPrefix + (sub === 'alt' ? 'Alt' : 'Caption')] = e.target.value;
            } else if (propPrefix.startsWith('gcard_')) {
              var cardId = propPrefix.replace('gcard_', '');
              var card = (d.cards || []).find(function(c) { return c.id === cardId; });
              if (card) card[sub] = e.target.value;
            }
            calculateReadingTime();
            triggerAutosave();
          });
        });

        // 6. External URL input for images
        bBody.querySelectorAll('[data-ext-url-input]').forEach(function(input) {
          var propPrefix = input.getAttribute('data-img-prop');
          input.addEventListener('change', function(e) {
            var url = (e.target.value || '').trim();
            if (!url) return;
            applyImageUrl(d, propPrefix, url);
            renderSections();
            triggerAutosave();
          });
        });

        // 7. Table Builder cell inputs are handled canonically by attachTableRichTextListeners (contenteditable Rich Text).

        // 8. Trial Builder inputs
        bBody.querySelectorAll('[data-trial-q]').forEach(function(input) {
          var qId = input.getAttribute('data-q-id');
          var prop = input.getAttribute('data-trial-q');
          input.addEventListener('input', function(e) {
            var q = (d.questions || []).find(function(it) { return it.id === qId; });
            if (q) {
              q[prop === 'text' ? 'question' : prop] = e.target.value;
              calculateReadingTime();
              triggerAutosave();
            }
          });
        });

        bBody.querySelectorAll('[data-trial-ans]').forEach(function(input) {
          var qId = input.getAttribute('data-q-id');
          var ansId = input.getAttribute('data-ans-id');
          input.addEventListener('input', function(e) {
            var q = (d.questions || []).find(function(it) { return it.id === qId; });
            if (q && Array.isArray(q.answers)) {
              var ans = q.answers.find(function(a) { return a.id === ansId; });
              if (ans) {
                ans.text = e.target.value;
                calculateReadingTime();
                triggerAutosave();
              }
            }
          });
        });

        // 9. Related Docs Select dropdown
        bBody.querySelectorAll('[data-doc-select-slug]').forEach(function(select) {
          var docId = select.getAttribute('data-doc-select-slug');
          select.addEventListener('change', function(e) {
            var slug = e.target.value;
            var docItem = (d.items || []).find(function(it) { return it.id === docId; });
            if (docItem) {
              var found = (window.STUDIO_PUBLISHED_ARTICLES || []).find(function(a) { return a.slug === slug; });
              if (found) {
                docItem.title = found.title;
                docItem.slug = found.slug;
                docItem.url = '/article/' + found.slug;
                docItem.ctaText = 'Study scroll';
              }
              renderSections();
              triggerAutosave();
            }
          });
        });

        // 10. Drag & Drop support for image dropzones inside block
        bBody.querySelectorAll('.studio-img-dropzone').forEach(function(dz) {
          var propPrefix = dz.getAttribute('data-img-prop');
          dz.addEventListener('dragover', function(e) {
            e.preventDefault();
            e.stopPropagation();
            dz.style.borderColor = 'var(--studio-gold)';
          });
          dz.addEventListener('dragleave', function(e) {
            e.stopPropagation();
            dz.style.borderColor = '';
          });
          dz.addEventListener('drop', function(e) {
            e.preventDefault();
            e.stopPropagation();
            dz.style.borderColor = '';
            var file = e.dataTransfer.files && e.dataTransfer.files[0];
            if (file && file.type.startsWith('image/')) {
              showToast('Uploading image...', 'saving');
              uploadImageFile(file, function(err, url) {
                if (err) {
                  showToast('Upload failed: ' + err.message, 'error');
                } else {
                  showToast('Image uploaded: ' + file.name, 'success');
                  applyImageUrl(d, propPrefix, url);
                  renderSections();
                  triggerAutosave();
                }
              });
            }
          });
        });

        // Callout Show Heading Toggle
        bBody.querySelectorAll('.callout-toggle-heading').forEach(function(cb) {
          cb.addEventListener('change', function(e) {
            d.showTitle = e.target.checked;
            renderSections();
            triggerAutosave();
          });
        });

        // 11. Nested bullet marker style & custom value inputs
        bBody.querySelectorAll('[data-act="set-nested-item-marker-style"]').forEach(function(sel) {
          sel.addEventListener('change', function(e) {
            var itemId = sel.getAttribute('data-item-id');
            var found = findNestedBulletNodeById(d.items || [], itemId);
            if (found && found.node) {
              found.node.markerStyle = sel.value;
              if (sel.value === 'auto' && !found.node.markerValue) delete found.node.markerStyle;
              var bar = sel.closest('.studio-marker-bar');
              if (bar) {
                var pill = bar.querySelector('.studio-marker-pill');
                if (pill && window.resolveListMarker) {
                  pill.textContent = window.resolveListMarker({
                    customValue: found.node.markerValue,
                    itemStyle: found.node.markerStyle,
                    blockDefaultStyle: d.markerStyle,
                    index: found.index,
                    depth: found.depth,
                    isSteps: false
                  });
                }
              }
              renderSections();
              triggerAutosave();
            }
          });
        });

        bBody.querySelectorAll('[data-act="set-nested-item-marker-val"]').forEach(function(inp) {
          var itemId = inp.getAttribute('data-item-id');
          function updateNestedMarkerVal() {
            var found = findNestedBulletNodeById(d.items || [], itemId);
            if (found && found.node) {
              var cleanVal = window.sanitizeMarkerValue ? window.sanitizeMarkerValue(inp.value) : inp.value.trim();
              if (cleanVal) {
                found.node.markerValue = cleanVal;
                if (!found.node.markerStyle || found.node.markerStyle === 'auto') found.node.markerStyle = 'custom';
              } else {
                delete found.node.markerValue;
                if (found.node.markerStyle === 'custom') found.node.markerStyle = 'auto';
              }
              var bar = inp.closest('.studio-marker-bar');
              if (bar) {
                var pill = bar.querySelector('.studio-marker-pill');
                if (pill && window.resolveListMarker) {
                  pill.textContent = window.resolveListMarker({
                    customValue: found.node.markerValue,
                    itemStyle: found.node.markerStyle,
                    blockDefaultStyle: d.markerStyle,
                    index: found.index,
                    depth: found.depth,
                    isSteps: false
                  });
                }
                var sel = bar.querySelector('.studio-marker-select');
                if (sel && found.node.markerStyle) sel.value = found.node.markerStyle;
              }
              triggerAutosave();
            }
          }
          inp.addEventListener('input', updateNestedMarkerVal);
          inp.addEventListener('change', function() {
            renderSections();
            triggerAutosave();
          });
        });

        // 12. Numbered steps marker style, custom value & block-level default inputs
        bBody.querySelectorAll('[data-act="set-steps-block-marker-style"]').forEach(function(sel) {
          sel.addEventListener('change', function(e) {
            d.markerStyle = sel.value;
            if (Array.isArray(d.steps)) {
              d.steps.forEach(function(st, idx) {
                if (window.resolveListMarker) {
                  st.badge = window.resolveListMarker({
                    customValue: st.markerValue,
                    itemStyle: st.markerStyle,
                    blockDefaultStyle: d.markerStyle,
                    index: idx,
                    depth: 1,
                    isSteps: true,
                    legacyBadge: st.badge
                  });
                }
              });
            }
            renderSections();
            triggerAutosave();
          });
        });

        bBody.querySelectorAll('[data-act="set-step-marker-style"]').forEach(function(sel) {
          sel.addEventListener('change', function(e) {
            var stepId = sel.getAttribute('data-step-id');
            var sIdx = (d.steps || []).findIndex(function(s) { return s.id === stepId; });
            if (sIdx !== -1) {
              var st = d.steps[sIdx];
              st.markerStyle = sel.value;
              if (sel.value === 'auto' && !st.markerValue) delete st.markerStyle;
              var res = window.resolveListMarker ? window.resolveListMarker({
                customValue: st.markerValue,
                itemStyle: st.markerStyle,
                blockDefaultStyle: d.markerStyle,
                index: sIdx,
                depth: 1,
                isSteps: true
              }) : (st.markerValue || String(sIdx + 1));
              st.badge = res;
              var bar = sel.closest('.studio-marker-bar');
              if (bar) {
                var pill = bar.querySelector('.studio-marker-pill');
                if (pill) pill.textContent = res;
              }
              var card = sel.closest('.studio-step-card');
              if (card) {
                var stepBadge = card.querySelector('.studio-step-badge');
                if (stepBadge) stepBadge.textContent = res;
              }
              renderSections();
              triggerAutosave();
            }
          });
        });

        bBody.querySelectorAll('[data-act="set-step-marker-val"]').forEach(function(inp) {
          var stepId = inp.getAttribute('data-step-id');
          function updateStepVal() {
            var sIdx = (d.steps || []).findIndex(function(s) { return s.id === stepId; });
            if (sIdx !== -1) {
              var st = d.steps[sIdx];
              var cleanVal = window.sanitizeMarkerValue ? window.sanitizeMarkerValue(inp.value) : inp.value.trim();
              if (cleanVal) {
                st.markerValue = cleanVal;
                if (!st.markerStyle || st.markerStyle === 'auto') st.markerStyle = 'custom';
              } else {
                delete st.markerValue;
                if (st.markerStyle === 'custom') st.markerStyle = 'auto';
              }
              var res = window.resolveListMarker ? window.resolveListMarker({
                customValue: st.markerValue,
                itemStyle: st.markerStyle,
                blockDefaultStyle: d.markerStyle,
                index: sIdx,
                depth: 1,
                isSteps: true
              }) : (st.markerValue || String(sIdx + 1));
              st.badge = res;
              var bar = inp.closest('.studio-marker-bar');
              if (bar) {
                var pill = bar.querySelector('.studio-marker-pill');
                if (pill) pill.textContent = res;
                var sel = bar.querySelector('.studio-marker-select');
                if (sel && st.markerStyle) sel.value = st.markerStyle;
              }
              var card = inp.closest('.studio-step-card');
              if (card) {
                var stepBadge = card.querySelector('.studio-step-badge');
                if (stepBadge) stepBadge.textContent = res;
              }
              triggerAutosave();
            }
          }
          inp.addEventListener('input', updateStepVal);
          inp.addEventListener('change', function() {
            renderSections();
            triggerAutosave();
          });
        });

        // 13. Unified Action Delegator for buttons
        bBody.addEventListener('click', function(e) {
          if (e.target.closest('.block-editor-body') !== bBody) return;
          if (activeSectionId !== sec.id) {
            setActiveSection(sec.id);
          }
          var actBtn = e.target.closest('[data-act]');
          if (!actBtn) return;
          var act = actBtn.getAttribute('data-act');

          switch (act) {
            // Optional Fields
            case 'add-field':
              var optField = actBtn.getAttribute('data-opt-field');
              d[optField] = '';
              renderSections();
              triggerAutosave();
              var blockEl = document.querySelector('[data-block-id="' + block.id + '"]');
              if (blockEl) {
                var newInput = blockEl.querySelector('[data-field="' + optField + '"]');
                if (newInput) newInput.focus();
              }
              break;

            case 'remove-field':
              var remField = actBtn.getAttribute('data-opt-field');
              delete d[remField];
              renderSections();
              triggerAutosave();
              break;

            // Toggle Show Text
            case 'toggle-show-text':
              d.showText = d.showText === false ? true : false;
              renderSections();
              triggerAutosave();
              calculateReadingTime();
              showToast(d.showText ? 'Paragraphs visible' : 'Paragraphs hidden');
              break;

            // Paragraphs
            case 'add-paragraph':
              d.paragraphs = d.paragraphs || [];
              d.paragraphs.push({ text: '', align: 'left' });
              renderSections();
              triggerAutosave();
              break;

            case 'del-paragraph':
              var pIdx = parseInt(actBtn.getAttribute('data-idx'), 10);
              if (d.paragraphs && d.paragraphs.length > 1) {
                d.paragraphs.splice(pIdx, 1);
                renderSections();
                triggerAutosave();
              }
              break;

            // Bullets
            case 'add-bullet':
              d.items = d.items || [];
              d.items.push({ id: uid('item'), text: '' });
              renderSections();
              triggerAutosave();
              break;

            case 'del-bullet':
              var bId = actBtn.getAttribute('data-item-id');
              if (d.items && d.items.length > 1) {
                d.items = d.items.filter(function(it) { return it.id !== bId; });
                renderSections();
                triggerAutosave();
              }
              break;

            // Nested Bullets
            case 'set-nested-layout':
              e.stopPropagation();
              var layoutVal = actBtn.getAttribute('data-layout') || 'vertical';
              var blkCard = actBtn.closest('.block-card, .block-editor-card');
              var blkId = blkCard ? blkCard.getAttribute('data-block-id') : block.id;
              var loc = resolveBlockLocation(blkId);
              var targetBlock = loc ? loc.block : block;
              if (targetBlock && targetBlock.data) {
                targetBlock.data.layout = layoutVal;
              } else {
                d.layout = layoutVal;
              }
              renderSections();
              triggerAutosave();
              break;

            case 'add-nested-main':
              d.items = d.items || [];
              d.items.push({ id: uid('main'), text: { text: '', align: 'left' }, children: [] });
              renderSections();
              triggerAutosave();
              break;

            case 'del-nested-main':
              var mId = actBtn.getAttribute('data-item-id');
              if (d.items && d.items.length > 1) {
                d.items = d.items.filter(function(m) { return m.id !== mId; });
                renderSections();
                triggerAutosave();
              }
              break;

            case 'add-nested-sub':
              var pId = actBtn.getAttribute('data-parent-id');
              var foundParent = findNestedBulletNodeById(d.items || [], pId);
              if (foundParent && foundParent.node && canAddNestedListChild(foundParent.depth)) {
                var nextDepth = foundParent.depth + 1;
                foundParent.node.children = Array.isArray(foundParent.node.children) ? foundParent.node.children : [];
                foundParent.node.children.push({
                  id: uid('sub_l' + nextDepth),
                  text: { text: '', align: 'left' },
                  children: []
                });
                renderSections();
                triggerAutosave();
              }
              break;

            case 'del-nested-sub':
              var subId = actBtn.getAttribute('data-sub-id');
              var foundTarget = findNestedBulletNodeById(d.items || [], subId);
              if (foundTarget && foundTarget.parentArray && foundTarget.index !== -1) {
                foundTarget.parentArray.splice(foundTarget.index, 1);
                renderSections();
                triggerAutosave();
              }
              break;

            case 'reset-nested-item-marker':
              e.stopPropagation();
              var rItemId = actBtn.getAttribute('data-item-id');
              var rFound = findNestedBulletNodeById(d.items || [], rItemId);
              if (rFound && rFound.node) {
                delete rFound.node.markerValue;
                rFound.node.markerStyle = 'auto';
                renderSections();
                triggerAutosave();
              }
              break;

            // Numbered Steps
            case 'add-step':
              d.steps = d.steps || [];
              var newStep = {
                id: uid('step'),
                markerStyle: 'auto',
                title: { text: '', align: 'left' },
                text: { text: '', align: 'left' }
              };
              d.steps.push(newStep);
              renderSections();
              triggerAutosave();
              break;

            case 'del-step':
              var sId = actBtn.getAttribute('data-step-id');
              if (d.steps && d.steps.length > 1) {
                d.steps = d.steps.filter(function(s) { return s.id !== sId; });
                renderSections();
                triggerAutosave();
              }
              break;

            case 'dup-step':
              var stId = actBtn.getAttribute('data-step-id');
              var sIdx = (d.steps || []).findIndex(function(s) { return s.id === stId; });
              if (sIdx !== -1) {
                var copyS = JSON.parse(JSON.stringify(d.steps[sIdx]));
                copyS.id = uid('step');
                d.steps.splice(sIdx + 1, 0, copyS);
                renderSections();
                triggerAutosave();
              }
              break;

            case 'move-step':
              var mvId = actBtn.getAttribute('data-step-id');
              var dir = parseInt(actBtn.getAttribute('data-dir'), 10);
              var curIdx = (d.steps || []).findIndex(function(s) { return s.id === mvId; });
              if (curIdx !== -1) {
                var tgtIdx = curIdx + dir;
                if (tgtIdx >= 0 && tgtIdx < d.steps.length) {
                  var tmp = d.steps[curIdx];
                  d.steps[curIdx] = d.steps[tgtIdx];
                  d.steps[tgtIdx] = tmp;
                  renderSections();
                  triggerAutosave();
                }
              }
              break;

            case 'reset-step-marker':
              e.stopPropagation();
              var rStepId = actBtn.getAttribute('data-step-id');
              var rStep = (d.steps || []).find(function(s) { return s.id === rStepId; });
              if (rStep) {
                delete rStep.markerValue;
                rStep.markerStyle = 'auto';
                renderSections();
                triggerAutosave();
              }
              break;

            // ── FLEXIBLE LAYOUT COMPOSER ACTIONS ──
            case 'set-flex-col-count':
              var targetCount = parseInt(actBtn.getAttribute('data-count'), 10);
              d.columnCount = targetCount;
              if (targetCount === 3 && d.columns.length < 3) {
                d.columns.push({ id: uid('fcol'), blocks: [] });
              }
              renderSections();
              triggerAutosave();
              break;

            case 'set-flex-ratio':
              var rVal = actBtn.getAttribute('data-ratio');
              d.ratio = rVal;
              renderSections();
              triggerAutosave();
              break;

            // Image Upload & Removal
            case 'trigger-upload':
              var prop = actBtn.getAttribute('data-img-prop');
              openImageUploader(function(url, filename) {
                applyImageUrl(d, prop, url);
                renderSections();
                triggerAutosave();
              });
              break;

            case 'remove-image':
              var remProp = actBtn.getAttribute('data-img-prop');
              applyImageUrl(d, remProp, '');
              renderSections();
              triggerAutosave();
              break;

            case 'toggle-ext-url':
              var wrap = actBtn.parentElement.querySelector('.ext-url-input-wrap');
              if (wrap) {
                wrap.style.display = wrap.style.display === 'none' ? 'block' : 'none';
              }
              break;

            // Gallery Scroll Cards
            case 'add-gallery-card':
              d.cards = d.cards || [];
              d.cards.push({ id: uid('gcard'), src: '', alt: '', caption: { text: '', align: 'left' } });
              renderSections();
              triggerAutosave();
              break;

            case 'del-gallery-card':
              var gcId = actBtn.getAttribute('data-card-id');
              d.cards = (d.cards || []).filter(function(c) { return c.id !== gcId; });
              renderSections();
              triggerAutosave();
              break;

            case 'dup-gallery-card':
              var gcDupId = actBtn.getAttribute('data-card-id');
              var cIdx = (d.cards || []).findIndex(function(c) { return c.id === gcDupId; });
              if (cIdx !== -1) {
                var copyCard = JSON.parse(JSON.stringify(d.cards[cIdx]));
                copyCard.id = uid('gcard');
                d.cards.splice(cIdx + 1, 0, copyCard);
                renderSections();
                triggerAutosave();
              }
              break;

            // Comparison Items
            case 'add-col-item':
              var side = actBtn.getAttribute('data-side');
              var key = side === '1' ? 'col1Items' : 'col2Items';
              d[key] = d[key] || [];
              d[key].push({ id: uid('cmp'), text: { text: '', align: 'left' } });
              renderSections();
              triggerAutosave();
              break;

            case 'del-col-item':
              var dSide = actBtn.getAttribute('data-side');
              var dKey = dSide === '1' ? 'col1Items' : 'col2Items';
              var cItemId = actBtn.getAttribute('data-item-id');
              d[dKey] = (d[dKey] || []).filter(function(it) { return it.id !== cItemId; });
              renderSections();
              triggerAutosave();
              break;

            // Table Builder (merge-safe via canonical ArticleTable helpers)
            case 'add-table-col':
              if (window.ArticleTable && typeof window.ArticleTable.insertColumn === 'function') {
                window.ArticleTable.insertColumn(d, (d.columns || []).length, function() { return uid('col'); });
              } else {
                d.columns = d.columns || [];
                var newColId = uid('col');
                d.columns.push({ id: newColId, label: { text: 'Column ' + (d.columns.length + 1), align: 'left' } });
                (d.rows || []).forEach(function(r) {
                  r.cells = r.cells || {};
                  r.cells[newColId] = { text: '', align: 'left' };
                });
              }
              renderSections();
              triggerAutosave();
              break;

            case 'del-table-col':
              var delColId = actBtn.getAttribute('data-col-id');
              var delColIdx = (d.columns || []).findIndex(function(c) { return c.id === delColId; });
              if (delColIdx !== -1 && window.ArticleTable && typeof window.ArticleTable.deleteColumn === 'function') {
                if (window.ArticleTable.deleteColumn(d, delColIdx)) {
                  renderSections();
                  triggerAutosave();
                }
              }
              break;

            case 'add-table-row':
              if (window.ArticleTable && typeof window.ArticleTable.insertRow === 'function') {
                window.ArticleTable.insertRow(d, (d.rows || []).length, function() { return uid('row'); });
              } else {
                d.rows = d.rows || [];
                var newCells = {};
                (d.columns || []).forEach(function(c) { newCells[c.id] = { text: '', align: 'left' }; });
                d.rows.push({ id: uid('row'), cells: newCells });
              }
              renderSections();
              triggerAutosave();
              break;

            case 'del-table-row':
              var delRowId = actBtn.getAttribute('data-row-id');
              var delRowIdx = (d.rows || []).findIndex(function(r) { return r.id === delRowId; });
              if (delRowIdx !== -1 && window.ArticleTable && typeof window.ArticleTable.deleteRow === 'function') {
                if (window.ArticleTable.deleteRow(d, delRowIdx)) {
                  renderSections();
                  triggerAutosave();
                }
              }
              break;

            // Callout Style Variant Select
            case 'select-callout':
            case 'select-callout-style':
              var chosenStyle = actBtn.getAttribute('data-val');
              d.calloutType = chosenStyle;
              if (d.titleMode !== 'custom') {
                var sRegistry = window.CALLOUT_STYLES || {};
                var nextTitle = sRegistry[chosenStyle] ? sRegistry[chosenStyle].defaultTitle : 'Grimoire Note';
                d.title = { text: nextTitle, align: 'left' };
                d.titleMode = 'default';
              }
              renderSections();
              triggerAutosave();
              break;

            case 'callout-use-default':
              d.titleMode = 'default';
              var cType = window.normalizeCalloutStyle ? window.normalizeCalloutStyle(d.calloutType) : (d.calloutType || 'grimoire');
              var sDefs = window.CALLOUT_STYLES || {};
              var defTitle = sDefs[cType] ? sDefs[cType].defaultTitle : 'Grimoire Note';
              d.title = { text: defTitle, align: 'left' };
              renderSections();
              triggerAutosave();
              break;

            case 'select-callout-surface':
              var nextSurface = window.normalizeCalloutSurfaceStyle
                ? window.normalizeCalloutSurfaceStyle(actBtn.getAttribute('data-val'))
                : (actBtn.getAttribute('data-val') || 'solid');
              d.surfaceStyle = nextSurface;
              if (nextSurface === 'faded') {
                d.fadeDirection = window.normalizeCalloutFadeDirection
                  ? window.normalizeCalloutFadeDirection(d.fadeDirection)
                  : (d.fadeDirection || 'ltr');
              } else {
                delete d.fadeDirection;
              }
              renderSections();
              triggerAutosave();
              break;

            case 'select-callout-fade-dir':
              var nextFadeDir = window.normalizeCalloutFadeDirection
                ? window.normalizeCalloutFadeDirection(actBtn.getAttribute('data-val'))
                : (actBtn.getAttribute('data-val') || 'ltr');
              d.surfaceStyle = 'faded';
              d.fadeDirection = nextFadeDir;
              renderSections();
              triggerAutosave();
              break;

            case 'select-callout-border':
              var nextBorder = window.normalizeCalloutBorderStyle
                ? window.normalizeCalloutBorderStyle(actBtn.getAttribute('data-val'))
                : actBtn.getAttribute('data-val');
              if (nextBorder) {
                d.borderStyle = nextBorder;
              } else {
                delete d.borderStyle;
              }
              renderSections();
              triggerAutosave();
              break;

            case 'reset-callout-border':
              delete d.borderStyle;
              renderSections();
              triggerAutosave();
              break;

            // Shared Accent Palette Select (Callout & Pullquote)
            case 'select-accent-chip':
              var chAccent = actBtn.getAttribute('data-accent');
              if (!chAccent) {
                // Default clicked -> clear both preset and custom
                delete d.accentColor;
                delete d.accentCustomColor;
              } else if (chAccent === 'custom') {
                // Custom chip clicked directly
                var curCustomHex = actBtn.getAttribute('data-current-hex') || d.accentCustomColor || (normalizeHex(d.accentColor) ? d.accentColor : '#C45AFF');
                openCustomColorPicker(actBtn, curCustomHex, function(chosenHex) {
                  var clean = (window.sanitizeHexColor ? window.sanitizeHexColor(chosenHex) : normalizeHex(chosenHex));
                  if (!clean) return;
                  d.accentColor = 'custom';
                  d.accentCustomColor = clean;
                  renderSections();
                  triggerAutosave();
                }, function(savedHex) {
                  var clean = (window.sanitizeHexColor ? window.sanitizeHexColor(savedHex) : normalizeHex(savedHex));
                  if (!clean) return;
                  d.accentColor = 'custom';
                  d.accentCustomColor = clean;
                  renderSections();
                  triggerAutosave();
                });
                return;
              } else {
                // Preset clicked (gold, purple, emerald, rose, moonlight, crimson) -> set preset and clear custom
                d.accentColor = chAccent;
                delete d.accentCustomColor;
              }
              renderSections();
              triggerAutosave();
              break;

            // Shared Saved Color Selected (Callout & Pullquote)
            case 'select-saved-color':
              var sHex = actBtn.getAttribute('data-hex');
              var cleanSavedHex = (window.sanitizeHexColor ? window.sanitizeHexColor(sHex) : normalizeHex(sHex));
              if (cleanSavedHex) {
                d.accentColor = 'custom';
                d.accentCustomColor = cleanSavedHex;
                renderSections();
                triggerAutosave();
              }
              break;

            // Shared Saved Color Removed from Palette
            case 'remove-saved-color':
              e.stopPropagation();
              var delHex = actBtn.getAttribute('data-hex');
              if (delHex) {
                removeColorFromPalette(delHex);
                // Note: Block data remains untouched; re-render sections so all palettes refresh
                renderSections();
              }
              break;

            case 'open-custom-accent':
            case 'callout-accent-custom':
              var curCustomHex = actBtn.getAttribute('data-current-hex') || d.accentCustomColor || (normalizeHex(d.accentColor) ? d.accentColor : '#C45AFF');
              openCustomColorPicker(actBtn, curCustomHex, function(chosenHex) {
                var clean = (window.sanitizeHexColor ? window.sanitizeHexColor(chosenHex) : normalizeHex(chosenHex));
                if (!clean) return;
                d.accentColor = 'custom';
                d.accentCustomColor = clean;
                renderSections();
                triggerAutosave();
              }, function(savedHex) {
                var clean = (window.sanitizeHexColor ? window.sanitizeHexColor(savedHex) : normalizeHex(savedHex));
                if (!clean) return;
                d.accentColor = 'custom';
                d.accentCustomColor = clean;
                renderSections();
                triggerAutosave();
              });
              break;

            case 'callout-accent-default':
              delete d.accentColor;
              delete d.accentCustomColor;
              renderSections();
              triggerAutosave();
              break;

            case 'callout-accent-swatch':
              var hexVal = actBtn.getAttribute('data-hex');
              if (hexVal) {
                d.accentColor = 'custom';
                d.accentCustomColor = normalizeHex(hexVal);
                renderSections();
                triggerAutosave();
              }
              break;

            // FAQ
            case 'add-faq':
              d.items = d.items || [];
              d.items.push({ id: uid('faq'), question: { text: '', align: 'left' }, answer: { text: '', align: 'left' } });
