---
import { ARTICLE_BLOCK_REGISTRY, ARTICLE_BLOCK_CATEGORIES } from '../../lib/article-block-registry';
import {
  ARTICLE_CATEGORIES,
  ARTICLE_DIFFICULTIES,
  ARTICLE_TAGS,
  DIFFICULTY_GLYPHS,
  mergeCategories,
  mergeTags,
} from '../../lib/article-taxonomy';
import { getArticleCategories, getArticleTags, getPublishedArticles } from '../../lib/articles';
import '../../styles/article-studio.css';

const blockRegistry = ARTICLE_BLOCK_REGISTRY;
const blockCategories = ARTICLE_BLOCK_CATEGORIES;
const publishedCats = getArticleCategories();
const publishedTags = getArticleTags();
const mergedCategories = mergeCategories(publishedCats);
const mergedTags = mergeTags(publishedTags);
const publishedArticles = getPublishedArticles().map(a => ({
  slug: a.slug,
  title: a.meta.title,
  category: a.meta.category,
  difficulty: a.meta.difficulty,
  tags: a.meta.tags,
}));
const canonicalCategories = ARTICLE_CATEGORIES;
const canonicalDifficulties = ARTICLE_DIFFICULTIES;
const canonicalTags = ARTICLE_TAGS;
const difficultyGlyphs = DIFFICULTY_GLYPHS;
const totalBlockCount = Object.keys(blockRegistry).length;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Coven Article Studio — Local Authoring CMS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
  <link href="https://fonts.googleapis.com/css2?family=Metamorphous&family=EB+Garamond:ital,wght@0,400..700;1,400..700&family=IBM+Plex+Mono:wght@400;600&family=Cinzel:wght@600;700&display=swap" rel="stylesheet" />
</head>
<body class="coven-studio">

  <!-- Top Sticky Toolbar -->
  <header class="studio-topbar">
    <a href="/" class="studio-brand" aria-label="Go to Coven of Technology home">
      <div class="brand-icon">✶</div>
      <div class="brand-title">Coven Article Studio</div>
      <div class="brand-badge">V2 Authoring</div>
      <div class="status-indicator">
        <span class="status-dot" id="status-dot"></span>
        <span id="status-indicator">Ready</span>
      </div>
    </a>

    <div class="studio-actions">
      <button class="studio-btn studio-btn--secondary" id="btn-new" title="Create a new article draft" type="button">+ New Article</button>
      <button class="studio-btn studio-btn--ghost" id="btn-drafts" title="Open saved drafts" type="button">Saved Drafts</button>
      <button class="studio-btn studio-btn--ghost" id="btn-duplicate-article" title="Duplicate current article" type="button">Duplicate</button>
      <button class="studio-btn studio-btn--secondary" id="btn-save-draft" title="Save draft immediately" type="button">Save Draft</button>
      <button class="studio-btn studio-btn--secondary" id="btn-preview" title="Live preview in single reusable tab" type="button">Preview ↗</button>
      <button class="studio-btn studio-btn--primary" id="btn-publish" title="Publish article to src/articles" type="button">Publish ✦</button>
    </div>
  </header>

  <!-- Main 3-Column Workspace -->
  <main class="studio-workspace">

    <!-- Column 1: Block Library -->
    <aside class="studio-library-pane" id="pane-library">
      <div class="library-header">
        <span class="library-title">Block Library</span>
        <span class="library-count-badge" id="block-library-count">{totalBlockCount} Patterns</span>
      </div>

      <div class="library-search-wrap">
        <input type="text" id="library-search-input" class="studio-input" placeholder="Search blocks..." autocomplete="off" />
      </div>

      <div class="library-categories-list" id="palette-categories-container">
        <!-- Rendered dynamically -->
      </div>
    </aside>

    <!-- Column 2: Article Content Structure -->
    <section class="studio-center-pane" id="pane-center">
      <div class="center-header">
        <span class="center-title">Article Content Structure</span>
        <span class="section-counter-badge" id="section-counter-badge">0 Sections</span>
      </div>

      <div class="sections-container" id="sections-container">
        <!-- Sections will be rendered here dynamically -->
      </div>

      <!-- Trailing Add Section Action (only visible when 1+ sections exist) -->
      <div class="add-section-zone" id="trailing-add-section-zone" style="display:none">
        <button type="button" class="studio-btn studio-btn--secondary" id="btn-add-section-trailing" style="padding:0 24px">
          <span>✦ Add New Section</span>
        </button>
      </div>
    </section>

    <!-- Column 3: Article Settings -->
    <aside class="studio-settings-pane" id="pane-settings">
      <div class="settings-header">
        <span class="settings-title">Article Settings</span>
        <span class="settings-subtitle">Primary Metadata</span>
      </div>

      <!-- PRIMARY SETTINGS -->
      <div class="studio-form-group">
        <label class="studio-label" for="meta-title">Title *</label>
        <input type="text" id="meta-title" class="studio-input" placeholder="Sacred Title of the Scroll..." autocomplete="off" />
      </div>

      <div class="studio-form-group">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
          <label class="studio-label" for="meta-slug" style="margin-bottom:0">Slug</label>
          <button type="button" class="studio-btn studio-btn--sm" id="btn-slug-generate" style="padding:2px 8px;font-size:10px;height:22px;letter-spacing:0.5px" title="Generate slug once from current title">Generate from Title</button>
        </div>
        <input type="text" id="meta-slug" class="studio-input slug-full-input" placeholder="my-custom-article-slug" autocomplete="off" />
        <div class="slug-url-preview-bar">
          <span class="slug-url-label">ARTICLE URL</span>
          <span class="slug-url-path" id="slug-url-preview">/article/untitled-scroll</span>
        </div>
        <div id="slug-published-warning" class="slug-published-warning" style="display:none">
          ⚠️ Changing the slug changes this article's public URL.
        </div>
      </div>

      <div class="studio-form-group">
        <label class="studio-label" for="meta-desc">Description / Excerpt *</label>
        <textarea id="meta-desc" class="studio-textarea" style="min-height:95px" placeholder="Editorial excerpt for the library and hero lead..."></textarea>
      </div>

      <div class="studio-form-group">
        <label class="studio-label" for="meta-author">Author</label>
        <input type="text" id="meta-author" class="studio-input" value="Oracle of Orgs" autocomplete="off" />
      </div>

      <div class="studio-form-group">
        <label class="studio-label" id="category-label">Category *</label>
        <div class="coven-combobox" id="category-combobox" role="combobox" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="category-label">
          <button type="button" class="combobox-trigger" id="category-trigger" aria-controls="category-dropdown" aria-label="Select Category">
            <span class="combobox-value" id="category-trigger-text">Salesforce</span>
            <span class="combobox-caret">▾</span>
          </button>
          <div class="combobox-menu" id="category-dropdown" role="listbox" aria-labelledby="category-label" style="display:none">
            <div class="combobox-search-box">
              <input type="text" id="category-search-input" class="combobox-search-input" placeholder="Search category..." autocomplete="off" aria-autocomplete="list" />
            </div>
            <div class="combobox-options" id="category-options-list">
              <!-- Populated via JS -->
            </div>
            <div class="combobox-create-option" id="category-create-row" style="display:none">
              <!-- "+ Create ..." -->
            </div>
          </div>
          <input type="hidden" id="meta-category" value="Salesforce" />
        </div>
      </div>

      <div class="studio-form-group">
        <label class="studio-label" id="difficulty-label">Difficulty *</label>
        <div class="coven-select-dropdown" id="difficulty-combobox" role="combobox" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="difficulty-label">
          <button type="button" class="combobox-trigger" id="difficulty-trigger" aria-controls="difficulty-options-menu" aria-label="Select Difficulty">
            <span class="combobox-value" id="difficulty-trigger-text">✦ Lv. 1 - Incantation</span>
            <span class="combobox-caret">▾</span>
          </button>
          <div class="combobox-menu" id="difficulty-options-menu" role="listbox" aria-labelledby="difficulty-label" style="display:none">
            <div class="combobox-options" id="difficulty-options-list">
              <!-- Populated dynamically with Lv. 1, Lv. 2, Lv. 3 -->
            </div>
          </div>
          <input type="hidden" id="meta-difficulty" value="Lv. 1 - Incantation" />
        </div>
      </div>

      <div class="studio-form-group">
        <label class="studio-label" id="tags-label">Tags</label>
        <div class="coven-tags-combobox" id="tags-combobox-wrap" role="combobox" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="tags-label">
          <div class="tag-chips-container" id="tag-chips-container" tabindex="-1">
            <input type="text" id="tag-inline-input" class="tag-input-inline" placeholder="Search or add a tag..." autocomplete="off" aria-autocomplete="list" aria-controls="tags-dropdown-menu" />
          </div>
          <div class="combobox-menu tag-suggestions-menu" id="tags-dropdown-menu" role="listbox" aria-labelledby="tags-label" style="display:none">
            <div class="combobox-options" id="tags-options-list">
              <!-- Populated dynamically -->
            </div>
            <div class="combobox-create-option" id="tag-create-row" style="display:none">
              <!-- "+ Create ..." -->
            </div>
          </div>
        </div>
        <div style="font-family:var(--font-mono);font-size:10px;color:var(--studio-text-muted);margin-top:4px">Type to search, press Enter/comma or select suggestion</div>
      </div>

      <div class="studio-form-group">
        <label class="studio-label">Status</label>
        <div class="segmented-control" id="status-segmented">
          <button type="button" class="segment-btn active" data-status="draft">Draft</button>
          <button type="button" class="segment-btn" data-status="published">Published</button>
        </div>
      </div>

      <div class="studio-form-group">
        <label class="studio-label">Reading Time (Calculated)</label>
        <div class="reading-time-pill" id="reading-time-pill">
          <span>⏱</span>
          <span id="reading-time-text">≈ 1 min</span>
        </div>
      </div>

      <!-- ADVANCED SETTINGS (DISCLOSURE) -->
      <div class="advanced-settings-box" id="adv-settings-box">
        <button type="button" class="advanced-settings-toggle" id="adv-settings-toggle">
          <span>Advanced Settings</span>
          <span class="adv-arrow">▾</span>
        </button>
        <div class="advanced-settings-body" id="adv-settings-body">
          <div class="studio-form-group">
            <label class="studio-label">Rank</label>
            <select id="meta-rank" class="studio-select">
              <option value="Novice">Novice</option>
              <option value="Initiate">Initiate</option>
              <option value="Acolyte">Acolyte</option>
              <option value="Mechanic" selected>Mechanic</option>
              <option value="Architect">Architect</option>
              <option value="Archmage">Archmage</option>
            </select>
          </div>

          <div class="studio-form-group">
            <label class="studio-label">Aether Reward</label>
            <input type="number" id="meta-aether" class="studio-input" value="120" />
          </div>

          <label class="checkbox-row">
            <input type="checkbox" id="meta-featured" />
            <span>Featured Scroll</span>
          </label>

          <label class="checkbox-row">
            <input type="checkbox" id="meta-wide" checked />
            <span>Wide Editorial Layout</span>
          </label>

          <div class="studio-form-group">
            <label class="studio-label">Cover Image URL / Upload</label>
            <div class="image-picker-row">
              <input type="text" id="meta-cover" class="studio-input" placeholder="Start empty or paste URL / upload" />
              <input type="file" id="cover-file-upload" style="display:none" accept="image/*" />
              <button type="button" class="studio-btn studio-btn--sm" id="btn-upload-cover">Upload</button>
            </div>
          </div>

          <div class="studio-form-group" id="cover-caption-group" style="display:none">
            <label class="studio-label">Cover Caption</label>
            <input type="text" id="meta-cover-caption" class="studio-input" placeholder="Figure · Architectural overview..." />
          </div>
        </div>
      </div>

    </aside>

  </main>

  <!-- Modals -->
  <!-- 1. Drafts Modal -->
  <div class="studio-modal-backdrop" id="drafts-modal">
    <div class="studio-modal">
      <div class="studio-modal-title">SAVED DRAFTS</div>
      <div id="drafts-list" style="display:flex;flex-direction:column;gap:10px;max-height:360px;overflow-y:auto;padding-right:6px">
        <!-- Draft cards -->
      </div>
      <div class="studio-modal-actions">
        <button type="button" class="studio-btn studio-btn--secondary" id="btn-close-drafts">Close</button>
      </div>
    </div>
  </div>

  <!-- 2. Delete Confirmation Modal (Replaces window.confirm) -->
  <div class="studio-modal-backdrop" id="delete-confirm-modal">
    <div class="studio-modal" style="width:420px">
      <div class="studio-modal-title" id="delete-modal-title" style="color:var(--studio-gold-bright)">DELETE CONFIRMATION</div>
      <div id="delete-modal-message" style="font-family:var(--font-body);font-size:15px;color:var(--studio-text-dim);line-height:1.5">
        Are you sure you wish to proceed? This cannot be undone.
      </div>
      <div class="studio-modal-actions">
        <button type="button" class="studio-btn studio-btn--secondary" id="btn-cancel-delete">Cancel</button>
        <button type="button" class="studio-btn studio-btn--danger" id="btn-confirm-delete">Delete</button>
      </div>
    </div>
  </div>

  <!-- Toast Notification Container -->
  <div class="studio-toast-container" id="toast-container"></div>

  <!-- Client-side Logic -->
  <script define:vars={{
    blockRegistry,
    blockCategories,
    canonicalCategories,
    canonicalDifficulties,
    canonicalTags,
    difficultyGlyphs,
    mergedCategories,
    mergedTags,
    publishedArticles
  }}>
    window.STUDIO_REGISTRY = blockRegistry;
    window.STUDIO_CATEGORIES = blockCategories;
    window.STUDIO_CANONICAL_CATEGORIES = canonicalCategories;
    window.STUDIO_CANONICAL_DIFFICULTIES = canonicalDifficulties;
    window.STUDIO_CANONICAL_TAGS = canonicalTags;
    window.STUDIO_DIFFICULTY_GLYPHS = difficultyGlyphs;
    window.STUDIO_MERGED_CATEGORIES = mergedCategories;
    window.STUDIO_MERGED_TAGS = mergedTags;
    window.STUDIO_PUBLISHED_ARTICLES = publishedArticles;

    // Abstract glyphs for each block type in library and card headers
    var BLOCK_GLYPHS = {
      'title-text': '=',
      'text-title': '≈',
      'solo-text': '¶',
      'bullet-list': '✦',
      'nested-bullets': '◈',
      'numbered-steps': '①',
      'text-image': '◫',
      'image-text': '◪',
      'two-columns': '▥',
      'three-columns': '▤',
      'single-image': '📷',
      'full-image': '🖼',
      'two-images': '⚏',
      'three-images': '⚌',
      'gallery-scroll': '☷',
      'card-grid-2': '⊞',
      'card-grid-3': '⊟',
      'comparison': '⚖',
      'stats-metrics': '%',
      'technical-table': '▦',
      'callout': '▲',
      'pullquote': '❝',
      'code-block': '</>',
      'faq': '?',
      'exercise': '⚔',
      'article-trial': '✶',
      'key-takeaways': '★',
      'related-docs': '↗'
    };

    (function() {
      // ── Stable ID Generator ─────────────────────────────
      function uid(prefix) {
        return (prefix || 'id') + '_' + Date.now().toString(36) + '_' + Math.random().toString(36).substring(2, 7);
      }

      // ── Canonical Slug Normalization ────────────────────
      function normalizeSlugClient(input, allowTrailingHyphen) {
        if (!input || typeof input !== 'string') return '';
        var normalized = input
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/-+/g, '-')
          .replace(/^-+/g, '');

        if (!allowTrailingHyphen) {
          normalized = normalized.replace(/-+$/g, '');
        }
        return normalized;
      }

      function isValidSlugClient(slug) {
        if (!slug || typeof slug !== 'string') return false;
        return /^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug);
      }

      function slugify(text) {
        return (text || '')
          .toString()
          .toLowerCase()
          .trim()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/(^-|-$)/g, '');
      }

      function escapeHtml(str) {
        if (!str && str !== 0) return '';
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }

      // ── Rich Text Helpers (Basic Typography: title-text, text-title, solo-text) ──
      function getRichData(val) {
        if (val && typeof val === 'object') {
          return {
            text: typeof val.text === 'string' ? val.text : (typeof val.content === 'string' ? val.content : ''),
            align: (val.align === 'center' || val.align === 'right') ? val.align : 'left'
          };
        }
        return {
          text: typeof val === 'string' ? val : '',
          align: 'left'
        };
      }

      function validateLinkUrl(url) {
        if (!url || typeof url !== 'string') return false;
        var trimmed = url.trim();
        if (!trimmed) return false;

        // Internal relative route
        if (trimmed.startsWith('/')) {
          if (trimmed.startsWith('//')) return false;
          if (trimmed.includes('\\')) return false;
          if (trimmed.includes('/../') || trimmed.endsWith('/..') || trimmed === '/..') return false;
          if (trimmed.includes('/./') || trimmed.endsWith('/.') || trimmed === '/.') return false;
          return true;
        }

        // External URL: only http: and https:
        if (/^https?:\/\//i.test(trimmed)) {
          try {
            var parsed = new URL(trimmed);
            if (parsed.protocol !== 'http:' && parsed.protocol !== 'https:') return false;
            if (!parsed.hostname || parsed.hostname.indexOf('.') === -1) return false;
            return true;
          } catch (e) {
            return false;
          }
        }

        return false;
      }

      function sanitizeRichText(html) {
        if (!html || typeof html !== 'string') return '';
        var parser = new DOMParser();
        var doc = parser.parseFromString('<div>' + html + '</div>', 'text/html');
        var root = doc.body.firstElementChild || doc.body;

        function cleanNode(node) {
          var children = Array.from(node.childNodes);
          for (var i = 0; i < children.length; i++) {
            var child = children[i];
            if (child.nodeType === 3) continue;
            if (child.nodeType === 1) {
              var tag = child.tagName.toLowerCase();
              cleanNode(child);
              if (tag === 'b' || tag === 'strong') {
                var strong = doc.createElement('strong');
                while (child.firstChild) strong.appendChild(child.firstChild);
                child.parentNode.replaceChild(strong, child);
              } else if (tag === 'i' || tag === 'em') {
                var em = doc.createElement('em');
                while (child.firstChild) em.appendChild(child.firstChild);
                child.parentNode.replaceChild(em, child);
              } else if (tag === 'u') {
                var u = doc.createElement('u');
                while (child.firstChild) u.appendChild(child.firstChild);
                child.parentNode.replaceChild(u, child);
              } else if (tag === 'span') {
                var allowedClasses = ['article-text-gold', 'article-text-purple', 'article-text-muted'];
                var matched = allowedClasses.find(function(c) { return child.classList.contains(c); });
                if (matched) {
                  child.className = matched;
                  child.removeAttribute('style');
                } else {
                  while (child.firstChild) child.parentNode.insertBefore(child.firstChild, child);
                  child.parentNode.removeChild(child);
                }
              } else if (tag === 'a') {
                var rawHref = child.getAttribute('href') || '';
                if (validateLinkUrl(rawHref)) {
                  // Prevent nested anchors: unwrap any <a> inside this <a>
                  var nestedAnchors = Array.from(child.querySelectorAll('a'));
                  nestedAnchors.forEach(function(na) {
                    while (na.firstChild) na.parentNode.insertBefore(na.firstChild, na);
                    na.parentNode.removeChild(na);
                  });

                  var cleanA = doc.createElement('a');
                  cleanA.setAttribute('href', rawHref.trim());
                  var isExt = /^https?:\/\//i.test(rawHref.trim());
                  if (isExt) {
                    cleanA.setAttribute('target', '_blank');
                    cleanA.setAttribute('rel', 'noopener noreferrer');
                  }
                  var allowedLinkColorClasses = [
                    'article-rich-link--gold',
                    'article-rich-link--purple',
                    'article-rich-link--parchment',
                    'article-rich-link--muted'
                  ];
                  var matchedClass = allowedLinkColorClasses.find(function(c) { return child.classList.contains(c); });
                  cleanA.className = 'article-rich-link' + (matchedClass ? ' ' + matchedClass : '');
                  while (child.firstChild) cleanA.appendChild(child.firstChild);
                  child.parentNode.replaceChild(cleanA, child);
                } else {
                  // Unsafe or invalid href: unwrap children, remove anchor!
                  while (child.firstChild) child.parentNode.insertBefore(child.firstChild, child);
                  child.parentNode.removeChild(child);
                }
              } else if (tag === 'br') {
                // keep br
              } else {
                while (child.firstChild) child.parentNode.insertBefore(child.firstChild, child);
                child.parentNode.removeChild(child);
              }
            } else {
              child.parentNode.removeChild(child);
            }
          }
        }

        cleanNode(root);
        return root.innerHTML;
      }

      function applyColorClass(surface, colorClass) {
        var sel = window.getSelection();
        if (!sel || !sel.rangeCount) return;
        var range = sel.getRangeAt(0);
        if (!surface.contains(range.commonAncestorContainer)) return;
        if (range.collapsed) return;

        var oldSpans = surface.querySelectorAll('.article-text-gold, .article-text-purple, .article-text-muted');
        for (var j = 0; j < oldSpans.length; j++) {
          var osp = oldSpans[j];
          if (range.intersectsNode ? range.intersectsNode(osp) : true) {
            var tn = document.createTextNode(osp.textContent);
            osp.parentNode.replaceChild(tn, osp);
          }
        }

        if (colorClass !== 'default') {
          try {
            var span = document.createElement('span');
            span.className = colorClass;
            range.surroundContents(span);
            var newRange = document.createRange();
            newRange.selectNodeContents(span);
            sel.removeAllRanges();
            sel.addRange(newRange);
          } catch (err) {
            var fragment = range.extractContents();
            var spanNode = document.createElement('span');
            spanNode.className = colorClass;
            spanNode.appendChild(fragment);
            range.insertNode(spanNode);
            var reselRange = document.createRange();
            reselRange.selectNodeContents(spanNode);
            sel.removeAllRanges();
            sel.addRange(reselRange);
          }
        }
      }

      function renderRichTextFieldHtml(label, fieldAttr, rawData, placeholder, removeBtnHtml) {
        var rich = getRichData(rawData);
        var align = rich.align || 'left';
        var text = rich.text || '';

        return (
          '<div class="studio-form-group rich-text-field-wrap">' +
            '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">' +
              '<label class="studio-label" style="margin-bottom:0">' + label + '</label>' +
              (removeBtnHtml || '') +
            '</div>' +
            '<div class="rich-text-toolbar" role="toolbar" aria-label="Text formatting">' +
              '<button type="button" class="rich-btn rich-btn-bold" data-cmd="bold" title="Bold (Ctrl+B)"><b>B</b></button>' +
              '<button type="button" class="rich-btn rich-btn-italic" data-cmd="italic" title="Italic (Ctrl+I)"><i>I</i></button>' +
              '<button type="button" class="rich-btn rich-btn-underline" data-cmd="underline" title="Underline (Ctrl+U)"><u>U</u></button>' +
              '<div class="rich-color-dropdown-wrap">' +
                '<button type="button" class="rich-btn rich-btn-color" data-cmd="toggle-color" title="Text Color"><span class="rich-color-glyph">A</span><span class="rich-color-caret">▾</span></button>' +
                '<div class="rich-color-menu" style="display:none">' +
                  '<div class="rich-color-menu-title">TEXT COLOR</div>' +
                  '<button type="button" class="rich-color-item" data-color="default"><span class="rich-color-swatch swatch-default"></span>Default</button>' +
                  '<button type="button" class="rich-color-item" data-color="article-text-gold"><span class="rich-color-swatch swatch-gold"></span>Coven Gold</button>' +
                  '<button type="button" class="rich-color-item" data-color="article-text-purple"><span class="rich-color-swatch swatch-purple"></span>Coven Purple</button>' +
                  '<button type="button" class="rich-color-item" data-color="article-text-muted"><span class="rich-color-swatch swatch-muted"></span>Muted Parchment</button>' +
                '</div>' +
              '</div>' +
              '<div class="rich-link-dropdown-wrap">' +
                '<button type="button" class="rich-btn rich-btn-link" data-cmd="link" title="Add or edit link" aria-label="Add or edit link">' +
                  '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:block">' +
                    '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>' +
                    '<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>' +
                  '</svg>' +
                '</button>' +
                '<div class="rich-link-popover" style="display:none" role="dialog" aria-label="Link destination and style">' +
                  '<div class="rich-link-popover__label">LINK DESTINATION</div>' +
                  '<input type="text" class="rich-link-popover__input" placeholder="https://example.com or /article/..." aria-label="Link URL" />' +
                  '<div class="rich-link-popover__error" style="display:none">Enter a valid http(s) URL or Coven internal path.</div>' +
                  '<div class="rich-link-popover__msg" style="display:none">Select text before creating a link.</div>' +
                  '<div class="rich-link-popover__color-section">' +
                    '<div class="rich-link-popover__label" style="margin-top:4px">LINK COLOR</div>' +
                    '<div class="rich-link-popover__swatches" role="radiogroup" aria-label="Link color">' +
                      '<button type="button" class="rich-link-swatch is-active" data-link-color="default" title="Default Coven Link"><span class="rich-color-swatch swatch-gold"></span>Default</button>' +
                      '<button type="button" class="rich-link-swatch" data-link-color="gold" title="Coven Gold"><span class="rich-color-swatch swatch-gold"></span>Gold</button>' +
                      '<button type="button" class="rich-link-swatch" data-link-color="purple" title="Coven Purple"><span class="rich-color-swatch swatch-purple"></span>Purple</button>' +
                      '<button type="button" class="rich-link-swatch" data-link-color="parchment" title="Parchment"><span class="rich-color-swatch swatch-default"></span>Parchment</button>' +
                      '<button type="button" class="rich-link-swatch" data-link-color="muted" title="Muted Parchment"><span class="rich-color-swatch swatch-muted"></span>Muted</button>' +
                    '</div>' +
                  '</div>' +
                  '<div class="rich-link-popover__actions">' +
                    '<button type="button" class="studio-btn studio-btn--danger rich-link-btn--remove" style="display:none">Remove Link</button>' +
                    '<div style="flex:1"></div>' +
                    '<button type="button" class="studio-btn rich-link-btn--cancel">Cancel</button>' +
                    '<button type="button" class="studio-btn studio-btn--primary rich-link-btn--apply" disabled>Apply Link</button>' +
                  '</div>' +
                '</div>' +
              '</div>' +
              '<span class="rich-toolbar-divider"></span>' +
              '<button type="button" class="rich-btn rich-btn-align ' + (align === 'left' ? 'is-active' : '') + '" data-align="left" title="Align Left">≡←</button>' +
              '<button type="button" class="rich-btn rich-btn-align ' + (align === 'center' ? 'is-active' : '') + '" data-align="center" title="Align Center">≡↔</button>' +
              '<button type="button" class="rich-btn rich-btn-align ' + (align === 'right' ? 'is-active' : '') + '" data-align="right" title="Align Right">→≡</button>' +
            '</div>' +
            '<div class="rich-text-surface rich-align-' + align + '" contenteditable="true" spellcheck="false" ' + fieldAttr + ' data-placeholder="' + escapeHtml(placeholder || '') + '">' + sanitizeRichText(text) + '</div>' +
          '</div>'
        );
      }

      function attachRichTextListeners(bBody, sec, block) {
        var d = block.data;

        bBody.querySelectorAll('.rich-text-field-wrap').forEach(function(wrap) {
          var toolbar = wrap.querySelector('.rich-text-toolbar');
          var surface = wrap.querySelector('.rich-text-surface');
          var colorMenu = wrap.querySelector('.rich-color-menu');
          var colorTrigger = wrap.querySelector('.rich-btn-color');
          var linkBtn = wrap.querySelector('.rich-btn-link');
          var linkPopover = wrap.querySelector('.rich-link-popover');
          var urlInput = linkPopover ? linkPopover.querySelector('.rich-link-popover__input') : null;
          var urlError = linkPopover ? linkPopover.querySelector('.rich-link-popover__error') : null;
          var popoverMsg = linkPopover ? linkPopover.querySelector('.rich-link-popover__msg') : null;
          var colorSection = linkPopover ? linkPopover.querySelector('.rich-link-popover__color-section') : null;
          var removeBtn = linkPopover ? linkPopover.querySelector('.rich-link-btn--remove') : null;
          var cancelBtn = linkPopover ? linkPopover.querySelector('.rich-link-btn--cancel') : null;
          var applyBtn = linkPopover ? linkPopover.querySelector('.rich-link-btn--apply') : null;
          var swatchBtns = linkPopover ? linkPopover.querySelectorAll('.rich-link-swatch') : [];

          var savedRange = null;
          var activeAnchor = null;
          var selectedLinkColor = 'default';

          if (!toolbar || !surface) return;

          var directField = surface.getAttribute('data-rich-field');
          var arrayField = surface.getAttribute('data-rich-array');
          var arrayIdx = arrayField ? parseInt(surface.getAttribute('data-rich-idx'), 10) : -1;

          function getCurrentData() {
            if (directField) {
              return getRichData(d[directField]);
            }
            if (arrayField && Array.isArray(d[arrayField])) {
              return getRichData(d[arrayField][arrayIdx]);
            }
            return { text: '', align: 'left' };
          }

          function setCurrentData(richObj) {
            if (directField) {
              d[directField] = richObj;
            } else if (arrayField && Array.isArray(d[arrayField])) {
              d[arrayField][arrayIdx] = richObj;
            }
            calculateReadingTime();
            triggerAutosave();
          }

          function getAnchorAtSelection() {
            var sel = window.getSelection();
            if (!sel || !sel.rangeCount) return null;
            var range = sel.getRangeAt(0);
            if (!surface.contains(range.commonAncestorContainer)) return null;
            var node = range.commonAncestorContainer;
            if (node.nodeType === 3) node = node.parentNode;
            var a = node ? (node.closest ? node.closest('a') : null) : null;
            return (a && surface.contains(a)) ? a : null;
          }

          function getSelectionInfo() {
            var sel = window.getSelection();
            if (!sel || !sel.rangeCount) return { hasSelection: false, anchor: null, range: null };
            var range = sel.getRangeAt(0);
            if (!surface.contains(range.commonAncestorContainer)) return { hasSelection: false, anchor: null, range: null };
            var anchor = getAnchorAtSelection();
            var hasText = !range.collapsed && range.toString().trim().length > 0;
            return { hasSelection: hasText || !!anchor, hasText: hasText, anchor: anchor, range: range };
          }

          function updateToolbarActiveStates() {
            var boldBtn = toolbar.querySelector('[data-cmd="bold"]');
            var italicBtn = toolbar.querySelector('[data-cmd="italic"]');
            var underlineBtn = toolbar.querySelector('[data-cmd="underline"]');

            if (boldBtn) boldBtn.classList.toggle('is-active', document.queryCommandState('bold'));
            if (italicBtn) italicBtn.classList.toggle('is-active', document.queryCommandState('italic'));
            if (underlineBtn) underlineBtn.classList.toggle('is-active', document.queryCommandState('underline'));

            var cur = getCurrentData();
            toolbar.querySelectorAll('.rich-btn-align').forEach(function(btn) {
              btn.classList.toggle('is-active', btn.getAttribute('data-align') === cur.align);
            });

            var selInfo = getSelectionInfo();
            if (linkBtn) {
              if (selInfo.anchor) {
                linkBtn.classList.add('is-active');
                linkBtn.style.opacity = '1';
                linkBtn.title = 'Edit link';
              } else if (selInfo.hasText) {
                linkBtn.classList.remove('is-active');
                linkBtn.style.opacity = '1';
                linkBtn.title = 'Add link';
              } else {
                linkBtn.classList.remove('is-active');
                linkBtn.style.opacity = '0.5';
                linkBtn.title = 'Select text before creating a link';
              }
            }
          }

          function updateSwatchActive() {
            swatchBtns.forEach(function(sb) {
              sb.classList.toggle('is-active', sb.getAttribute('data-link-color') === selectedLinkColor);
            });
          }

          function closeLinkPopover() {
            if (linkPopover) linkPopover.style.display = 'none';
            if (applyBtn) applyBtn.style.display = 'inline-block';
            savedRange = null;
            activeAnchor = null;
          }

          toolbar.querySelectorAll('button').forEach(function(btn) {
            btn.addEventListener('mousedown', function(e) {
              e.preventDefault();
            });
          });

          toolbar.querySelectorAll('[data-cmd="bold"], [data-cmd="italic"], [data-cmd="underline"]').forEach(function(btn) {
            btn.addEventListener('click', function(e) {
              e.preventDefault();
              var cmd = btn.getAttribute('data-cmd');
              surface.focus();
              document.execCommand(cmd, false, null);
              updateToolbarActiveStates();
              var cur = getCurrentData();
              cur.text = sanitizeRichText(surface.innerHTML);
              setCurrentData(cur);
            });
          });

          if (colorTrigger && colorMenu) {
            colorTrigger.addEventListener('click', function(e) {
              e.preventDefault();
              var isOpen = colorMenu.style.display === 'block';
              document.querySelectorAll('.rich-color-menu').forEach(function(m) { m.style.display = 'none'; });
              document.querySelectorAll('.rich-link-popover').forEach(function(p) { p.style.display = 'none'; });
              colorMenu.style.display = isOpen ? 'none' : 'block';
            });

            colorMenu.querySelectorAll('.rich-color-item').forEach(function(item) {
              item.addEventListener('click', function(e) {
                e.preventDefault();
                var colorClass = item.getAttribute('data-color');
                surface.focus();
                applyColorClass(surface, colorClass);
                colorMenu.style.display = 'none';
                updateToolbarActiveStates();
                var cur = getCurrentData();
                cur.text = sanitizeRichText(surface.innerHTML);
                setCurrentData(cur);
              });
            });
          }

          // ── Link Button & Popover Events ──────────────────
          if (linkBtn && linkPopover) {
            linkBtn.addEventListener('click', function(e) {
              e.preventDefault();
              var isOpen = linkPopover.style.display === 'flex';
              if (isOpen) {
                closeLinkPopover();
                return;
              }
              document.querySelectorAll('.rich-color-menu').forEach(function(m) { m.style.display = 'none'; });
              document.querySelectorAll('.rich-link-popover').forEach(function(p) { p.style.display = 'none'; });

              var selInfo = getSelectionInfo();

              if (selInfo.anchor) {
                // Editing existing anchor
                activeAnchor = selInfo.anchor;
                savedRange = null;
                if (urlInput) urlInput.value = activeAnchor.getAttribute('href') || '';
                var cls = activeAnchor.className || '';
                selectedLinkColor = 'default';
                if (cls.indexOf('article-rich-link--gold') !== -1) selectedLinkColor = 'gold';
                else if (cls.indexOf('article-rich-link--purple') !== -1) selectedLinkColor = 'purple';
                else if (cls.indexOf('article-rich-link--parchment') !== -1) selectedLinkColor = 'parchment';
                else if (cls.indexOf('article-rich-link--muted') !== -1) selectedLinkColor = 'muted';

                updateSwatchActive();
                if (urlInput) urlInput.style.display = 'block';
                if (colorSection) colorSection.style.display = 'block';
                if (popoverMsg) popoverMsg.style.display = 'none';
                if (removeBtn) removeBtn.style.display = 'inline-block';
                if (applyBtn) {
                  applyBtn.style.display = 'inline-block';
                  applyBtn.textContent = 'Update Link';
                  applyBtn.disabled = !validateLinkUrl(urlInput ? urlInput.value : '');
                }
                if (urlError) urlError.style.display = 'none';

                linkPopover.style.display = 'flex';
                setTimeout(function() { if (urlInput) urlInput.focus(); }, 30);
              } else if (selInfo.hasText) {
                // Creating new link on selected range
                activeAnchor = null;
                savedRange = selInfo.range.cloneRange();
                if (urlInput) urlInput.value = '';
                selectedLinkColor = 'default';
                updateSwatchActive();

                if (urlInput) urlInput.style.display = 'block';
                if (colorSection) colorSection.style.display = 'block';
                if (popoverMsg) popoverMsg.style.display = 'none';
                if (removeBtn) removeBtn.style.display = 'none';
                if (applyBtn) {
                  applyBtn.style.display = 'inline-block';
                  applyBtn.textContent = 'Apply Link';
                  applyBtn.disabled = true;
                }
                if (urlError) urlError.style.display = 'none';

                linkPopover.style.display = 'flex';
                setTimeout(function() { if (urlInput) urlInput.focus(); }, 30);
              } else {
                // Selection collapsed: show message
                activeAnchor = null;
                savedRange = null;
                if (urlInput) urlInput.style.display = 'none';
                if (colorSection) colorSection.style.display = 'none';
                if (popoverMsg) {
                  popoverMsg.textContent = 'Select text before creating a link.';
                  popoverMsg.style.display = 'block';
                }
                if (removeBtn) removeBtn.style.display = 'none';
                if (applyBtn) applyBtn.style.display = 'none';
                if (urlError) urlError.style.display = 'none';

                linkPopover.style.display = 'flex';
              }
            });

            linkPopover.addEventListener('mousedown', function(e) {
              if (e.target.tagName !== 'INPUT') {
                e.preventDefault();
              }
            });

            swatchBtns.forEach(function(sb) {
              sb.addEventListener('click', function(e) {
                e.preventDefault();
                selectedLinkColor = sb.getAttribute('data-link-color') || 'default';
                updateSwatchActive();
              });
            });

            if (urlInput) {
              function checkUrlValidity() {
                var val = urlInput.value.trim();
                var isValid = validateLinkUrl(val);
                if (!val) {
                  if (urlError) urlError.style.display = 'none';
                  if (applyBtn) applyBtn.disabled = true;
                } else if (isValid) {
                  if (urlError) urlError.style.display = 'none';
                  if (applyBtn) applyBtn.disabled = false;
                } else {
                  if (urlError) {
                    urlError.textContent = 'Enter a valid http(s) URL or Coven internal path.';
                    urlError.style.display = 'block';
                  }
                  if (applyBtn) applyBtn.disabled = true;
                }
              }

              ['input', 'change', 'keyup', 'paste'].forEach(function(evt) {
                urlInput.addEventListener(evt, checkUrlValidity);
              });

              urlInput.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                  e.preventDefault();
                  closeLinkPopover();
                  surface.focus();
                } else if (e.key === 'Enter') {
                  e.preventDefault();
                  checkUrlValidity();
                  if (applyBtn && !applyBtn.disabled) {
                    applyBtn.click();
                  }
                }
              });
            }

            if (cancelBtn) {
              cancelBtn.addEventListener('click', function(e) {
                e.preventDefault();
                closeLinkPopover();
                surface.focus();
              });
            }

            if (removeBtn) {
              removeBtn.addEventListener('click', function(e) {
                e.preventDefault();
                if (activeAnchor) {
                  while (activeAnchor.firstChild) {
                    activeAnchor.parentNode.insertBefore(activeAnchor.firstChild, activeAnchor);
                  }
                  activeAnchor.parentNode.removeChild(activeAnchor);
                }
                closeLinkPopover();
                surface.focus();
                var cur = getCurrentData();
                cur.text = sanitizeRichText(surface.innerHTML);
                setCurrentData(cur);
                updateToolbarActiveStates();
              });
            }

            if (applyBtn) {
              applyBtn.addEventListener('click', function(e) {
                e.preventDefault();
                var url = urlInput ? urlInput.value.trim() : '';
                if (!validateLinkUrl(url)) return;

                var isExt = /^https?:\/\//i.test(url);
                var colorClass = selectedLinkColor !== 'default' ? ' article-rich-link--' + selectedLinkColor : '';

                if (activeAnchor) {
                  activeAnchor.setAttribute('href', url);
                  if (isExt) {
                    activeAnchor.setAttribute('target', '_blank');
                    activeAnchor.setAttribute('rel', 'noopener noreferrer');
                  } else {
                    activeAnchor.removeAttribute('target');
                    activeAnchor.removeAttribute('rel');
                  }
                  activeAnchor.className = 'article-rich-link' + colorClass;
                } else if (savedRange) {
                  var sel = window.getSelection();
                  sel.removeAllRanges();
                  sel.addRange(savedRange);

                  // Prevent nested anchors
                  var insideAnchors = surface.querySelectorAll('a');
                  for (var k = 0; k < insideAnchors.length; k++) {
                    var ia = insideAnchors[k];
                    if (savedRange.intersectsNode ? savedRange.intersectsNode(ia) : false) {
                      while (ia.firstChild) ia.parentNode.insertBefore(ia.firstChild, ia);
                      ia.parentNode.removeChild(ia);
                    }
                  }

                  var a = document.createElement('a');
                  a.setAttribute('href', url);
                  if (isExt) {
                    a.setAttribute('target', '_blank');
                    a.setAttribute('rel', 'noopener noreferrer');
                  }
                  a.className = 'article-rich-link' + colorClass;

                  try {
                    savedRange.surroundContents(a);
                  } catch (err) {
                    var fragment = savedRange.extractContents();
                    a.appendChild(fragment);
                    savedRange.insertNode(a);
                  }

                  var newRange = document.createRange();
                  newRange.selectNodeContents(a);
                  sel.removeAllRanges();
                  sel.addRange(newRange);
                }

                closeLinkPopover();
                surface.focus();
                var cur = getCurrentData();
                cur.text = sanitizeRichText(surface.innerHTML);
                setCurrentData(cur);
                updateToolbarActiveStates();
              });
            }
          }

          toolbar.querySelectorAll('.rich-btn-align').forEach(function(btn) {
            btn.addEventListener('click', function(e) {
              e.preventDefault();
              var align = btn.getAttribute('data-align');
              surface.classList.remove('rich-align-left', 'rich-align-center', 'rich-align-right');
              surface.classList.add('rich-align-' + align);
              toolbar.querySelectorAll('.rich-btn-align').forEach(function(b) {
                b.classList.toggle('is-active', b === btn);
              });
              var cur = getCurrentData();
              cur.align = align;
              cur.text = sanitizeRichText(surface.innerHTML);
              setCurrentData(cur);
            });
          });

          surface.addEventListener('click', function(e) {
            var anchor = e.target.closest('a');
            if (anchor) {
              e.preventDefault();
              updateToolbarActiveStates();
            }
          });

          surface.addEventListener('input', function() {
            var cur = getCurrentData();
            cur.text = sanitizeRichText(surface.innerHTML);
            setCurrentData(cur);
            updateToolbarActiveStates();
          });

          surface.addEventListener('keyup', updateToolbarActiveStates);
          surface.addEventListener('mouseup', updateToolbarActiveStates);

          surface.addEventListener('paste', function(e) {
            e.preventDefault();
            var text = (e.clipboardData || window.clipboardData).getData('text/plain') || '';
            document.execCommand('insertText', false, text);
            var cur = getCurrentData();
            cur.text = sanitizeRichText(surface.innerHTML);
            setCurrentData(cur);
            updateToolbarActiveStates();
          });

          surface.addEventListener('focus', function() {
            wrap.classList.add('is-focused');
            updateToolbarActiveStates();
          });

          surface.addEventListener('blur', function() {
            wrap.classList.remove('is-focused');
            if (colorMenu) colorMenu.style.display = 'none';
            var cur = getCurrentData();
            cur.text = sanitizeRichText(surface.innerHTML);
            setCurrentData(cur);
          });
        });
      }

      // ── State ───────────────────────────────────────────
      var currentDoc = {
        version: 1,
        studioId: uid('draft'),
        slug: '',
        meta: {
          title: '',
          description: '',
          author: 'Oracle of Orgs',
          category: 'Salesforce',
          difficulty: 'Lv. 1 - Incantation',
          tags: [],
          rank: 'Mechanic',
          readingTime: '1 min',
          aetherReward: 120,
          status: 'draft',
          featured: false,
          wide: true,
          cover: '',
          coverCaption: ''
        },
        sections: []
      };

      var activeSectionId = null;
      var isExistingPublished = false;
      var originalPublishedSlug = '';
      var isDirty = false;
      var autosaveTimer = null;
      var draggedBlockData = null;
      var pendingDeleteCallback = null;

      // ── Backward Compatibility Normalization ────────────
      function normalizeDocument(doc) {
        if (!doc) return;
        if (!doc.sections) doc.sections = [];
        if (!doc.meta) doc.meta = {};

        // Canonical defaults
        if (!doc.meta.category) {
          doc.meta.category = 'Salesforce';
        }
        if (!doc.meta.difficulty) {
          doc.meta.difficulty = 'Lv. 1 - Incantation';
        }
        if (!Array.isArray(doc.meta.tags)) {
          doc.meta.tags = [];
        }
        if (doc.slug === undefined || doc.slug === null) {
          doc.slug = '';
        }

        // Check if slug matches an existing published article
        var publishedSlugs = (window.STUDIO_PUBLISHED_ARTICLES || []).map(function(a) { return a.slug; });
        if (doc.slug && publishedSlugs.includes(doc.slug)) {
          isExistingPublished = true;
          originalPublishedSlug = doc.slug;
        } else {
          isExistingPublished = false;
          originalPublishedSlug = '';
        }

        doc.sections.forEach(function(sec) {
          if (!sec.id) sec.id = uid('sec');
          if (!sec.blocks) sec.blocks = [];

          sec.blocks.forEach(function(blk) {
            if (!blk.id) blk.id = uid('blk');
            var d = blk.data || {};

            switch (blk.type) {
              case 'title-text':
                if (!Array.isArray(d.paragraphs)) {
                  d.paragraphs = d.paragraph || d.text ? [d.paragraph || d.text] : [''];
                }
                d.paragraphs = d.paragraphs.map(function(p) { return getRichData(p); });
                d.heading = getRichData(d.heading);
                break;

              case 'text-title':
                d.intro = getRichData(d.intro);
                d.heading = getRichData(d.heading);
                d.paragraph = getRichData(d.paragraph || d.text);
                break;

              case 'solo-text':
                if (!Array.isArray(d.paragraphs)) {
                  d.paragraphs = d.paragraph || d.text ? [d.paragraph || d.text] : [''];
                }
                d.paragraphs = d.paragraphs.map(function(p) { return getRichData(p); });
                break;

              case 'bullet-list':
                if (Array.isArray(d.items)) {
                  d.items = d.items.map(function(it) {
                    if (typeof it === 'string') return { id: uid('item'), text: it };
                    if (!it.id) it.id = uid('item');
                    return it;
                  });
                } else {
                  d.items = [{ id: uid('item'), text: '' }];
                }
                break;

              case 'nested-bullets':
                if (Array.isArray(d.items)) {
                  d.items = d.items.map(function(main) {
                    if (typeof main === 'string') main = { text: main };
                    if (!main.id) main.id = uid('main');
                    var rawSubs = main.children || main.subItems || [];
                    main.children = rawSubs.map(function(sub) {
                      if (typeof sub === 'string') return { id: uid('sub'), text: sub };
                      if (!sub.id) sub.id = uid('sub');
                      return sub;
                    });
                    return main;
                  });
                } else {
                  d.items = [{ id: uid('main'), text: '', children: [] }];
                }
                break;

              case 'numbered-steps':
                if (Array.isArray(d.steps)) {
                  d.steps = d.steps.map(function(s, idx) {
                    if (!s.id) s.id = uid('step');
                    s.badge = String(idx + 1).padStart(2, '0');
                    return s;
                  });
                } else {
                  d.steps = [{ id: uid('step'), badge: '01', title: '', text: '' }];
                }
                break;

              case 'three-columns':
                if (!Array.isArray(d.columns) || d.columns.length === 0) {
                  d.columns = [
                    { id: 'col_1', kicker: 'PILLAR I', title: '', text: '' },
                    { id: 'col_2', kicker: 'PILLAR II', title: '', text: '' },
                    { id: 'col_3', kicker: 'PILLAR III', title: '', text: '' }
                  ];
                } else {
                  d.columns.forEach(function(c, i) {
                    if (!c.id) c.id = 'col_' + (i + 1);
                  });
                }
                break;

              case 'gallery-scroll':
                if (!Array.isArray(d.cards)) {
                  d.cards = [];
                } else {
                  d.cards.forEach(function(c) {
                    if (!c.id) c.id = uid('gcard');
                  });
                }
                break;

              case 'comparison':
                if (Array.isArray(d.col1Items)) {
                  d.col1Items = d.col1Items.map(function(it) {
                    if (typeof it === 'string') return { id: uid('c1'), text: it };
                    if (!it.id) it.id = uid('c1');
                    return it;
                  });
                } else {
                  d.col1Items = [];
                }
                if (Array.isArray(d.col2Items)) {
                  d.col2Items = d.col2Items.map(function(it) {
                    if (typeof it === 'string') return { id: uid('c2'), text: it };
                    if (!it.id) it.id = uid('c2');
                    return it;
                  });
                } else {
                  d.col2Items = [];
                }
                break;

              case 'technical-table':
                if (!Array.isArray(d.columns) || d.columns.length === 0) {
                  if (Array.isArray(d.headers) && d.headers.length > 0) {
                    d.columns = d.headers.map(function(h, idx) {
                      return { id: 'col_' + idx, label: h };
                    });
                    if (Array.isArray(d.rows)) {
                      d.rows = d.rows.map(function(r) {
                        var cells = {};
                        d.columns.forEach(function(c, cIdx) {
                          cells[c.id] = r.cells ? (r.cells[c.id] || '') : (r['col' + (cIdx + 1)] || (Array.isArray(r) ? r[cIdx] : ''));
                        });
                        return { id: r.id || uid('row'), cells: cells };
                      });
                    }
                  } else {
                    d.columns = [
                      { id: 'col_1', label: 'Feature' },
                      { id: 'col_2', label: 'Status' }
                    ];
                    d.rows = [
                      { id: uid('row'), cells: { col_1: '', col_2: '' } }
                    ];
                  }
                }
                break;

              case 'faq':
                if (Array.isArray(d.items)) {
                  d.items = d.items.map(function(it) {
                    if (!it.id) it.id = uid('faq');
                    return it;
                  });
                } else {
                  d.items = [{ id: uid('faq'), question: '', answer: '' }];
                }
                break;

              case 'article-trial':
                if (!Array.isArray(d.questions) || d.questions.length === 0) {
                  d.questions = [
                    {
                      id: uid('q'),
                      question: '',
                      answers: [
                        { id: uid('ans'), text: '', correct: true },
                        { id: uid('ans'), text: '', correct: false }
                      ],
                      explanation: ''
                    }
                  ];
                } else {
                  d.questions.forEach(function(q) {
                    if (!q.id) q.id = uid('q');
                    if (!Array.isArray(q.answers)) q.answers = [];
                    q.answers.forEach(function(a) {
                      if (!a.id) a.id = uid('ans');
                    });
                  });
                }
                break;

              case 'key-takeaways':
                if (Array.isArray(d.items)) {
                  d.items = d.items.map(function(it) {
                    if (!it.id) it.id = uid('t');
                    return it;
                  });
                } else {
                  d.items = [{ id: uid('t'), term: '', desc: '' }];
                }
                break;

              case 'related-docs':
                if (Array.isArray(d.items)) {
                  d.items = d.items.map(function(it) {
                    if (!it.id) it.id = uid('rd');
                    it.type = it.type || (it.url && it.url.startsWith('http') ? 'external' : 'internal');
                    return it;
                  });
                } else {
                  d.items = [{ id: uid('rd'), type: 'internal', title: '', slug: '', url: '', ctaText: 'Study scroll' }];
                }
                break;
            }
          });
        });
      }

      // ── Reading Time Auto Calculator ────────────────────
      function calculateReadingTime() {
        var totalWords = 0;

        function addWords(val) {
          if (!val) return;
          var str = (typeof val === 'object' && val !== null) ? (val.text || val.content || '') : val;
          if (!str || typeof str !== 'string') return;
          var clean = str.replace(/<[^>]*>/g, ' ').trim();
          if (clean) {
            totalWords += clean.split(/\s+/).length;
          }
        }

        addWords(currentDoc.meta.title);
        addWords(currentDoc.meta.description);

        (currentDoc.sections || []).forEach(function(sec) {
          addWords(sec.title);
          addWords(sec.kicker);
          addWords(sec.heading);

          (sec.blocks || []).forEach(function(blk) {
            var d = blk.data || {};
            addWords(d.heading);
            addWords(d.intro);
            addWords(d.text);
            addWords(d.paragraph);
            addWords(d.quote);
            addWords(d.author);
            addWords(d.caption);
            addWords(d.solutionTitle);
            addWords(d.solutionText);
            addWords(d.scenario);
            addWords(d.alt);
            addWords(d.col1Title);
            addWords(d.col1Text);
            addWords(d.col2Title);
            addWords(d.col2Text);
            addWords(d.card1Title);
            addWords(d.card1Desc);
            addWords(d.card2Title);
            addWords(d.card2Desc);
            addWords(d.card3Title);
            addWords(d.card3Desc);

            if (Array.isArray(d.paragraphs)) {
              d.paragraphs.forEach(function(p) { addWords(typeof p === 'object' ? p.text : p); });
            }

            if (Array.isArray(d.items)) {
              d.items.forEach(function(it) {
                if (typeof it === 'string') addWords(it);
                else {
                  addWords(it.term);
                  addWords(it.desc);
                  addWords(it.text);
                  addWords(it.question);
                  addWords(it.answer);
                  addWords(it.title);
                  if (Array.isArray(it.children)) {
                    it.children.forEach(function(c) { addWords(typeof c === 'object' ? c.text : c); });
                  }
                }
              });
            }

            if (Array.isArray(d.steps)) {
              d.steps.forEach(function(s) {
                addWords(s.title);
                addWords(s.text);
              });
            }

            if (Array.isArray(d.columns)) {
              d.columns.forEach(function(c) {
                addWords(c.title);
                addWords(c.text);
                addWords(c.label);
              });
            }

            if (Array.isArray(d.rows)) {
              d.rows.forEach(function(r) {
                if (r.cells) {
                  Object.values(r.cells).forEach(addWords);
                }
              });
            }

            if (Array.isArray(d.questions)) {
              d.questions.forEach(function(q) {
                addWords(q.question);
                addWords(q.explanation);
                if (Array.isArray(q.answers)) {
                  q.answers.forEach(function(a) { addWords(a.text); });
                }
              });
            }

            if (Array.isArray(d.cards)) {
              d.cards.forEach(function(c) {
                addWords(c.caption);
                addWords(c.alt);
              });
            }
          });
        });

        var minutes = Math.max(1, Math.round(totalWords / 200));
        var str = minutes + ' min';
        currentDoc.meta.readingTime = str;

        var el = document.getElementById('reading-time-text');
        if (el) el.textContent = '≈ ' + str;

        return str;
      }

      // ── Image Upload & Reusable Image Picker ────────────
      function uploadImageFile(file, callback) {
        var reader = new FileReader();
        reader.onload = function(evt) {
          fetch('/__article-studio/upload', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ filename: file.name, base64: evt.target.result })
          })
          .then(function(res) { return res.json(); })
          .then(function(data) {
            if (data.success && data.url) {
              callback(null, data.url);
            } else {
              callback(new Error(data.error || 'Upload failed'));
            }
          })
          .catch(function(err) {
            callback(err);
          });
        };
        reader.readAsDataURL(file);
      }

      function openImageUploader(onUploaded) {
        var fileInput = document.createElement('input');
        fileInput.type = 'file';
        fileInput.accept = 'image/*';
        fileInput.style.display = 'none';
        document.body.appendChild(fileInput);

        fileInput.addEventListener('change', function(e) {
          var file = e.target.files[0];
          if (!file) {
            fileInput.remove();
            return;
          }
          showToast('Uploading image...', 'saving');
          uploadImageFile(file, function(err, url) {
            fileInput.remove();
            if (err) {
              showToast('Upload failed: ' + err.message, 'error');
            } else {
              showToast('Image uploaded successfully', 'success');
              onUploaded(url, file.name);
            }
          });
        });

        fileInput.click();
      }

