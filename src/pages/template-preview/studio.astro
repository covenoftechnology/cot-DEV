        if (linkBtn && linkPopover) {
          linkBtn.addEventListener('click', function(e) {
            e.preventDefault();
            if (!activeSurface) return;
            var isOpen = linkPopover.style.display === 'flex';
            if (isOpen) {
              closeLinkPopover();
              return;
            }
            document.querySelectorAll('.rich-color-menu').forEach(function(m) { m.style.display = 'none'; });
            document.querySelectorAll('.rich-link-popover').forEach(function(p) { p.style.display = 'none'; });

            populateInternalArticleOptions();
            var sel = window.getSelection();
            var anchor = null;
            var range = null;
            var hasText = false;
            if (sel && sel.rangeCount) {
              range = sel.getRangeAt(0);
              if (activeSurface.contains(range.commonAncestorContainer)) {
                var node = range.commonAncestorContainer;
                if (node.nodeType === 3) node = node.parentNode;
                anchor = (node && node.closest) ? node.closest('a') : null;
                hasText = !range.collapsed && range.toString().trim().length > 0;
              }
            }

            if (anchor) {
              activeAnchor = anchor;
              savedRange = null;
              var rawHref = (activeAnchor.getAttribute('href') || '').trim();

              // Check if href matches a published article
              var pubArticles = window.STUDIO_PUBLISHED_ARTICLES || [];
              var match = rawHref.match(/^\/article\/([a-zA-Z0-9_-]+)\/?$/);
              var matchedPa = null;
              if (match) {
                var slug = match[1];
                matchedPa = pubArticles.find(function(a) { return a.slug === slug; });
              }

              if (matchedPa) {
                setLinkType('internal');
                if (internalSelect) internalSelect.value = matchedPa.slug;
                if (urlInput) urlInput.value = rawHref;
              } else {
                setLinkType('external');
                if (urlInput) urlInput.value = rawHref;
                if (internalSelect) internalSelect.value = '';
              }

              var cls = activeAnchor.className || '';
              selectedLinkColor = 'default';
              if (cls.indexOf('article-rich-link--gold') !== -1) selectedLinkColor = 'gold';
              else if (cls.indexOf('article-rich-link--purple') !== -1) selectedLinkColor = 'purple';
              else if (cls.indexOf('article-rich-link--parchment') !== -1) selectedLinkColor = 'parchment';
              else if (cls.indexOf('article-rich-link--muted') !== -1) selectedLinkColor = 'muted';

              updateSwatchActive();
              var tabsWrap = linkPopover.querySelector('.rich-link-type-tabs');
