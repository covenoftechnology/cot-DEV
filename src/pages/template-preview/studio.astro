              openAnchoredPopover(linkPopover, linkBtn);
              setTimeout(function() {
                if (currentLinkType === 'internal') {
                  if (internalSelect) internalSelect.focus({ preventScroll: true });
                } else {
                  if (urlInput) urlInput.focus({ preventScroll: true });
                }
              }, 30);
            } else if (hasText) {
              activeAnchor = null;
              savedRange = range.cloneRange();
              setLinkType('internal');
              if (internalSelect) internalSelect.value = '';
              if (urlInput) urlInput.value = '';
              selectedLinkColor = 'default';
              updateSwatchActive();

              var tabsWrap = linkPopover.querySelector('.rich-link-type-tabs');
              if (tabsWrap) tabsWrap.style.display = 'flex';
              var typeLabel = linkPopover.querySelector('.rich-link-popover__label');
              if (typeLabel) typeLabel.style.display = 'block';
              if (colorSection) colorSection.style.display = 'block';
              if (popoverMsg) popoverMsg.style.display = 'none';
              if (removeBtn) removeBtn.style.display = 'none';
              if (applyBtn) {
                applyBtn.style.display = 'inline-block';
                applyBtn.textContent = 'Apply Link';
              }
              if (urlError) urlError.style.display = 'none';
              validateTableLinkState();

              openAnchoredPopover(linkPopover, linkBtn);
              setTimeout(function() {
                if (internalSelect) internalSelect.focus({ preventScroll: true });
              }, 30);
            } else {
              activeAnchor = null;
              savedRange = null;
              var tabsWrap = linkPopover.querySelector('.rich-link-type-tabs');
              if (tabsWrap) tabsWrap.style.display = 'none';
              var typeLabel = linkPopover.querySelector('.rich-link-popover__label');
              if (typeLabel) typeLabel.style.display = 'none';
              if (panelInternal) panelInternal.style.display = 'none';
              if (panelExternal) panelExternal.style.display = 'none';
              if (colorSection) colorSection.style.display = 'none';
              if (popoverMsg) {
                popoverMsg.textContent = 'Select text before creating a link.';
                popoverMsg.style.display = 'block';
              }
              if (removeBtn) removeBtn.style.display = 'none';
              if (applyBtn) applyBtn.style.display = 'none';
              if (urlError) urlError.style.display = 'none';

              openAnchoredPopover(linkPopover, linkBtn);
            }
          });

          linkPopover.addEventListener('mousedown', function(e) {
            if (e.target.tagName !== 'INPUT' && e.target.tagName !== 'SELECT' && e.target.tagName !== 'OPTION') {
              e.preventDefault();
            }
          });

          typeTabs.forEach(function(tab) {
            tab.addEventListener('click', function(e) {
              e.preventDefault();
              var targetType = tab.getAttribute('data-link-type');
              if (targetType === currentLinkType) return;
              setLinkType(targetType);
              if (targetType === 'internal') {
                var inputVal = urlInput ? urlInput.value.trim() : '';
                var m = inputVal.match(/^\/article\/([a-zA-Z0-9_-]+)\/?$/);
                if (m && internalSelect) {
                  var slug = m[1];
                  var opt = internalSelect.querySelector('option[value="' + slug + '"]');
                  if (opt) internalSelect.value = slug;
                }
                validateTableLinkState();
                setTimeout(function() { if (internalSelect) internalSelect.focus({ preventScroll: true }); }, 30);
              } else {
                if (internalSelect && internalSelect.value && urlInput && !urlInput.value) {
                  urlInput.value = '/article/' + internalSelect.value;
                }
                validateTableLinkState();
                setTimeout(function() { if (urlInput) urlInput.focus({ preventScroll: true }); }, 30);
              }
            });
          });

          if (internalSelect) {
            ['change', 'input'].forEach(function(evt) {
              internalSelect.addEventListener(evt, validateTableLinkState);
            });

            internalSelect.addEventListener('keydown', function(e) {
              if (e.key === 'Escape') {
                e.preventDefault();
                closeLinkPopover();
                if (activeSurface) activeSurface.focus();
              } else if (e.key === 'Enter') {
                e.preventDefault();
                validateTableLinkState();
                if (applyBtn && !applyBtn.disabled) {
                  applyBtn.click();
                }
              }
            });
          }

          swatchBtns.forEach(function(sb) {
            sb.addEventListener('click', function(e) {
              e.preventDefault();
              selectedLinkColor = sb.getAttribute('data-link-color') || 'default';
              updateSwatchActive();
            });
          });

          if (urlInput) {
            ['input', 'change', 'keyup', 'paste'].forEach(function(evt) {
              urlInput.addEventListener(evt, validateTableLinkState);
            });

            urlInput.addEventListener('keydown', function(e) {
              if (e.key === 'Escape') {
                e.preventDefault();
                closeLinkPopover();
                if (activeSurface) activeSurface.focus();
              } else if (e.key === 'Enter') {
                e.preventDefault();
                validateTableLinkState();
                if (applyBtn && !applyBtn.disabled) applyBtn.click();
              }
            });
          }

          if (cancelBtn) {
            cancelBtn.addEventListener('click', function(e) {
