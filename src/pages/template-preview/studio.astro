      // ── Backward Compatibility Normalization ────────────
      function normalizeDocument(doc) {
        if (!doc) return;
        if (!doc.sections) doc.sections = [];
        if (!doc.meta) doc.meta = {};

        // Canonical defaults
        if (!doc.meta.category) {
          doc.meta.category = 'Salesforce';
        }
        if (!doc.meta.difficulty) {
          doc.meta.difficulty = 'Lv. 1 - Incantation';
        }
        if (!Array.isArray(doc.meta.tags)) {
          doc.meta.tags = [];
        }
        if (doc.slug === undefined || doc.slug === null) {
          doc.slug = '';
        }

        // Check if slug matches an existing published article
        var publishedSlugs = (window.STUDIO_PUBLISHED_ARTICLES || []).map(function(a) { return a.slug; });
        if (doc.slug && publishedSlugs.includes(doc.slug)) {
          isExistingPublished = true;
          originalPublishedSlug = doc.slug;
        } else {
          isExistingPublished = false;
          originalPublishedSlug = '';
        }

        function migrateV1UnitToBlock(u) {
          if (!u || !u.type) return null;
          if (u.type === 'text') {
            var hasHeading = u.heading && ((typeof u.heading === 'string' && u.heading.trim().length > 0) || (u.heading.text && u.heading.text.trim().length > 0));
            if (hasHeading) {
              return {
                id: uid('blk'),
                type: 'title-text',
                data: {
                  heading: getRichData(u.heading),
                  paragraphs: Array.isArray(u.paragraphs) ? u.paragraphs.map(function(p) { return getRichData(p); }) : [{ text: '', align: 'left' }]
                }
              };
            } else {
              return {
                id: uid('blk'),
                type: 'solo-text',
                data: {
                  paragraphs: Array.isArray(u.paragraphs) ? u.paragraphs.map(function(p) { return getRichData(p); }) : [{ text: '', align: 'left' }]
                }
              };
            }
          } else if (u.type === 'list') {
            return {
              id: uid('blk'),
              type: 'nested-bullets',
              data: {
                title: getRichData(u.title || ''),
                markers: u.markers || { level1: 'coven', level2: 'upper-alpha', level3: 'hyphen' },
                items: Array.isArray(u.items) ? u.items : [{ id: uid('main'), text: getRichData(''), children: [] }]
              }
            };
          } else if (u.type === 'image') {
            return {
              id: uid('blk'),
              type: 'single-image',
              data: {
                src: u.imageSrc || '',
                alt: u.alt || '',
                caption: getRichData(u.caption || '')
              }
