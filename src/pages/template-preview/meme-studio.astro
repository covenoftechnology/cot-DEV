---
import { getAllMemeCategoryObjects, getMemeCategoryGlyphs } from '../../lib/memes';

const initialCategories = getAllMemeCategoryObjects();
const categoryGlyphs = getMemeCategoryGlyphs();

const canonicalCategoriesJson = JSON.stringify(initialCategories.map((c) => c.name));
const categoryGlyphsJson = JSON.stringify(categoryGlyphs);
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Coven Meme Studio — Local Meme Authoring</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
  <link href="https://fonts.googleapis.com/css2?family=Metamorphous&family=EB+Garamond:ital,wght@0,400..700;1,400..700&family=IBM+Plex+Mono:wght@400;600&family=Cinzel:wght@600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg-base: #0b0a0e;
      --bg-panel: #111017;
      --bg-card: #16141f;
      --bg-input: #0d0b12;
      --border-subtle: rgba(216, 181, 107, 0.14);
      --border-purple: rgba(185, 143, 216, 0.22);
      --border-focus: rgba(216, 181, 107, 0.55);
      --gold: #d8b56b;
      --gold-bright: #f2d492;
      --gold-dim: rgba(216, 181, 107, 0.12);
      --purple: #b98fd8;
      --purple-dim: rgba(185, 143, 216, 0.12);
      --text-main: #ece6dd;
      --text-muted: #9a938c;
      --text-dim: #6e6761;
      --green: #6bc48d;
      --green-bg: rgba(107, 196, 141, 0.12);
      --amber: #e0a958;
      --amber-bg: rgba(224, 169, 88, 0.12);
      --red: #e06c75;
      --red-bg: rgba(224, 108, 117, 0.12);
      --font-display: 'Metamorphous', 'Cinzel', serif;
      --font-cinzel: 'Cinzel', serif;
      --font-serif: 'EB Garamond', Georgia, serif;
      --font-mono: 'IBM Plex Mono', monospace;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-base);
      background-image:
        radial-gradient(circle at 12% 0%, rgba(185, 143, 216, 0.08) 0%, transparent 45%),
        radial-gradient(circle at 88% 10%, rgba(216, 181, 107, 0.06) 0%, transparent 45%);
      color: var(--text-main);
      font-family: var(--font-serif);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      -webkit-font-smoothing: antialiased;
    }

    /* Top Sticky Header */
    .studio-topbar {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(13, 11, 18, 0.94);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border-subtle);
      padding: 12px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }

    .studio-brand-wrap {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .studio-brand {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: var(--text-main);
    }

    .brand-icon {
      color: var(--gold);
      font-size: 18px;
      text-shadow: 0 0 10px rgba(216, 181, 107, 0.45);
    }

    .brand-title {
      font-family: var(--font-display);
      font-size: 17px;
      color: var(--gold-bright);
      letter-spacing: 0.05em;
    }

    .brand-badge {
      font-family: var(--font-mono);
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      padding: 3px 8px;
      border-radius: 4px;
      background: var(--purple-dim);
      color: var(--purple);
      border: 1px solid rgba(185, 143, 216, 0.3);
    }

    .mode-pill {
      font-family: var(--font-mono);
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      padding: 3px 9px;
      border-radius: 4px;
      background: var(--gold-dim);
      color: var(--gold-bright);
      border: 1px solid rgba(216, 181, 107, 0.3);
    }

    .status-indicator {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--text-muted);
      padding-left: 6px;
    }

    .status-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 8px var(--green);
    }

    .status-dot.saving {
      background: var(--amber);
      box-shadow: 0 0 8px var(--amber);
    }

    .status-dot.error {
      background: var(--red);
      box-shadow: 0 0 8px var(--red);
    }

    .studio-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .studio-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      font-family: var(--font-mono);
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      padding: 8px 14px;
      border-radius: 5px;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.16s ease;
      border: 1px solid transparent;
      white-space: nowrap;
    }

    .studio-btn:disabled {
      opacity: 0.45;
      cursor: not-allowed;
    }

    .studio-btn--primary {
      background: linear-gradient(135deg, #d8b56b 0%, #b58d3d 100%);
      color: #0b0a0e;
      border-color: #e6c883;
      box-shadow: 0 2px 12px rgba(216, 181, 107, 0.22);
    }

    .studio-btn--primary:hover:not(:disabled) {
      filter: brightness(1.08);
      box-shadow: 0 4px 16px rgba(216, 181, 107, 0.35);
    }

    .studio-btn--secondary {
      background: rgba(216, 181, 107, 0.1);
      color: var(--gold-bright);
      border-color: rgba(216, 181, 107, 0.28);
    }

    .studio-btn--secondary:hover:not(:disabled) {
      background: rgba(216, 181, 107, 0.18);
      border-color: rgba(216, 181, 107, 0.48);
    }

    .studio-btn--ghost {
      background: rgba(255, 255, 255, 0.02);
      color: var(--text-muted);
      border-color: rgba(255, 255, 255, 0.1);
    }

    .studio-btn--ghost:hover:not(:disabled) {
      color: var(--text-main);
      border-color: rgba(216, 181, 107, 0.28);
      background: rgba(216, 181, 107, 0.06);
    }

    .studio-btn--danger {
      background: var(--red-bg);
      color: var(--red);
      border-color: rgba(224, 108, 117, 0.32);
    }

    .studio-btn--danger:hover:not(:disabled) {
      background: rgba(224, 108, 117, 0.2);
      border-color: var(--red);
    }

    /* Main 2-Column Workspace */
    .meme-workspace {
      max-width: 1380px;
      width: 100%;
      margin: 0 auto;
      padding: 28px 24px 64px;
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(340px, 0.85fr);
      gap: 28px;
      align-items: start;
    }

    .panel-card {
      background: var(--bg-panel);
      border: 1px solid var(--border-subtle);
      border-radius: 10px;
      padding: 24px;
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
    }

    .panel-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding-bottom: 16px;
      margin-bottom: 20px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.07);
      flex-wrap: wrap;
    }

    .panel-title-group h1,
    .panel-title-group h2 {
      font-family: var(--font-display);
      font-size: 20px;
      font-weight: 400;
      color: var(--text-main);
      letter-spacing: 0.03em;
    }

    .panel-title-group p {
      font-size: 14px;
      color: var(--text-muted);
      margin-top: 3px;
    }

    .lifecycle-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-family: var(--font-mono);
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      padding: 5px 11px;
      border-radius: 4px;
    }

    .lifecycle-badge.is-draft {
      background: var(--amber-bg);
      color: var(--amber);
      border: 1px solid rgba(224, 169, 88, 0.35);
    }

    .lifecycle-badge.is-published {
      background: var(--green-bg);
      color: var(--green);
      border: 1px solid rgba(107, 196, 141, 0.35);
    }

    /* Form Controls */
    .form-grid {
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .form-row-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .field-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .field-label-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    .field-label {
      font-family: var(--font-mono);
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--gold);
    }

    .field-req {
      color: var(--red);
      margin-left: 2px;
    }

    .field-hint {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--text-dim);
      line-height: 1.4;
    }

    .studio-input,
    .studio-select,
    .studio-textarea {
      width: 100%;
      background: var(--bg-input);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 6px;
      color: var(--text-main);
      font-family: var(--font-serif);
      font-size: 16px;
      padding: 10px 12px;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .studio-input.mono,
    .studio-select.mono {
      font-family: var(--font-mono);
      font-size: 13px;
    }

    .studio-textarea {
      min-height: 82px;
      resize: vertical;
      line-height: 1.5;
    }

    .studio-input:focus,
    .studio-select:focus,
    .studio-textarea:focus {
      outline: none;
      border-color: var(--border-focus);
      box-shadow: 0 0 0 2px rgba(216, 181, 107, 0.12);
    }

    .studio-readonly-box {
      width: 100%;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.09);
      border-radius: 6px;
      color: var(--text-muted);
      font-family: var(--font-mono);
      font-size: 12px;
      padding: 10px 12px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .slug-input-wrap {
      display: flex;
      gap: 8px;
      align-items: center;
    }

    .btn-mini {
      font-family: var(--font-mono);
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      padding: 7px 10px;
      border-radius: 4px;
      background: rgba(255, 255, 255, 0.04);
      color: var(--text-muted);
      border: 1px solid rgba(255, 255, 255, 0.12);
      cursor: pointer;
      white-space: nowrap;
    }

    .btn-mini:hover {
      color: var(--gold-bright);
      border-color: rgba(216, 181, 107, 0.35);
    }

    /* Image Upload Box */
    .upload-zone {
      border: 1px dashed rgba(185, 143, 216, 0.38);
      border-radius: 8px;
      background: rgba(21, 18, 28, 0.65);
      padding: 20px;
      text-align: center;
      transition: all 0.16s ease;
      cursor: pointer;
      position: relative;
    }

    .upload-zone:hover,
    .upload-zone.dragover {
      border-color: var(--gold);
      background: rgba(216, 181, 107, 0.06);
    }

    .upload-empty-state {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      padding: 12px 0;
    }

    .upload-glyph {
      font-size: 26px;
      color: var(--purple);
    }

    .upload-title {
      font-family: var(--font-cinzel);
      font-size: 14px;
      color: var(--text-main);
    }

    .upload-sub {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--text-muted);
    }

    .upload-filled-state {
      display: none;
      flex-direction: column;
      gap: 12px;
      align-items: center;
    }

    .upload-thumb-wrap {
      max-height: 220px;
      max-width: 100%;
      border-radius: 6px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.12);
      background: #09080c;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .upload-thumb-wrap img {
      max-height: 216px;
      max-width: 100%;
      width: auto;
      height: auto;
      object-fit: contain;
      display: block;
    }

    .upload-path-pill {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--purple);
      background: rgba(185, 143, 216, 0.1);
      border: 1px solid rgba(185, 143, 216, 0.24);
      padding: 4px 10px;
      border-radius: 4px;
      word-break: break-all;
    }

    .upload-actions-row {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      justify-content: center;
    }

    /* Featured Toggle Card */
    .featured-toggle-card {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 14px 16px;
      border-radius: 8px;
      background: radial-gradient(420px 140px at 90% 0%, rgba(139, 92, 196, 0.16), transparent 70%), rgba(21, 18, 28, 0.9);
      border: 1px solid rgba(216, 181, 107, 0.25);
      cursor: pointer;
    }

    .featured-toggle-card input[type="checkbox"] {
      width: 18px;
      height: 18px;
      margin-top: 2px;
      accent-color: var(--gold);
      cursor: pointer;
    }

    .featured-toggle-text {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .featured-toggle-title {
      font-family: var(--font-mono);
      font-size: 12px;
      font-weight: 600;
      color: var(--gold-bright);
      letter-spacing: 0.05em;
    }

    .featured-toggle-desc {
      font-size: 13px;
      color: var(--text-muted);
      line-height: 1.4;
    }

    /* Metadata Footer Box */
    .meta-diagnostics {
      margin-top: 20px;
      padding-top: 16px;
      border-top: 1px solid rgba(255, 255, 255, 0.07);
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: 10px;
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--text-dim);
    }

    .meta-diag-item span {
      display: block;
      color: var(--text-muted);
      margin-top: 2px;
      word-break: break-all;
    }

    /* Right Column: Live Meme Card Preview */
    .preview-sticky {
      position: sticky;
      top: 76px;
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    /* Authentic Coven /memes Card Visual Language */
    .coven-meme-card-preview {
      background: #15121c;
      border: 1px solid rgba(185, 143, 216, 0.18);
      border-radius: 10px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
      box-shadow: 0 14px 34px rgba(0, 0, 0, 0.45);
    }

    .coven-meme-card-preview.is-featured {
      border-color: rgba(216, 181, 107, 0.48);
      box-shadow: 0 14px 38px rgba(216, 181, 107, 0.12);
    }

    .meme-preview-media {
      min-height: 240px;
      background: repeating-linear-gradient(135deg, rgba(185, 143, 216, 0.08) 0 12px, rgba(185, 143, 216, 0.02) 12px 24px), #0e0c13;
      border-bottom: 1px solid rgba(185, 143, 216, 0.12);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    .meme-preview-media img {
      width: 100%;
      max-height: 420px;
      object-fit: contain;
      display: block;
      background: #0b0910;
    }

    .meme-preview-placeholder {
      font-family: var(--font-mono);
      font-size: 11px;
      color: #a89fc0;
      letter-spacing: 2px;
      text-transform: uppercase;
      padding: 24px;
      text-align: center;
    }

    .meme-preview-featured-ribbon {
      display: none;
      position: absolute;
      top: 12px;
      left: 12px;
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 1.6px;
      text-transform: uppercase;
      color: #d8b56b;
      padding: 4px 10px;
      border: 1px solid rgba(216, 181, 107, 0.45);
      border-radius: 3px;
      background: rgba(15, 12, 22, 0.9);
      backdrop-filter: blur(6px);
    }

    .coven-meme-card-preview.is-featured .meme-preview-featured-ribbon {
      display: inline-block;
    }

    .meme-preview-status-ribbon {
      position: absolute;
      top: 12px;
      right: 12px;
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 1.4px;
      text-transform: uppercase;
      padding: 4px 9px;
      border-radius: 3px;
      background: rgba(15, 12, 22, 0.88);
      backdrop-filter: blur(6px);
    }

    .meme-preview-status-ribbon.is-draft {
      color: var(--amber);
      border: 1px solid rgba(224, 169, 88, 0.4);
    }

    .meme-preview-status-ribbon.is-published {
      color: var(--green);
      border: 1px solid rgba(107, 196, 141, 0.4);
    }

    .meme-preview-body {
      padding: 18px 20px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .meme-preview-meta-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      flex-wrap: wrap;
    }

    .meme-preview-cat-badge {
      display: inline-block;
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: #b98fd8;
      padding: 4px 8px;
      border: 1px solid rgba(185, 143, 216, 0.32);
      border-radius: 2px;
    }

    .meme-preview-date {
      font-family: var(--font-mono);
      font-size: 11px;
      color: #8f87a0;
    }

    .meme-preview-caption {
      font-family: var(--font-cinzel);
      font-size: 18px;
      color: #ece6dd;
      margin: 2px 0;
      line-height: 1.35;
      word-break: break-word;
    }

    .meme-preview-desc {
      font-family: var(--font-serif);
      font-size: 15px;
      color: #b9b2a8;
      line-height: 1.5;
      display: none;
      word-break: break-word;
    }

    .meme-preview-reactions {
      display: flex;
      gap: 8px;
      align-items: center;
      margin-top: 6px;
      padding-top: 10px;
      border-top: 1px solid rgba(185, 143, 216, 0.1);
      font-family: var(--font-mono);
      font-size: 11px;
      color: #b9b2a8;
    }

    .meme-preview-reaction-pill {
      padding: 4px 9px;
      border: 1px solid rgba(185, 143, 216, 0.2);
      border-radius: 4px;
    }

    .meme-preview-share {
      margin-left: auto;
      color: #b98fd8;
    }

    /* Toast Notification */
    .toast-container {
      position: fixed;
      bottom: 24px;
      right: 24px;
      z-index: 9999;
      display: flex;
      flex-direction: column;
      gap: 10px;
      max-width: 420px;
    }

    .toast-msg {
      background: #171421;
      border: 1px solid var(--border-focus);
      border-left: 4px solid var(--gold);
      color: var(--text-main);
      padding: 12px 16px;
      border-radius: 6px;
      font-family: var(--font-mono);
      font-size: 12px;
      line-height: 1.45;
      box-shadow: 0 10px 28px rgba(0, 0, 0, 0.55);
    }

    .toast-msg.toast-success {
      border-left-color: var(--green);
    }

    .toast-msg.toast-error {
      border-left-color: var(--red);
    }

    @media (max-width: 960px) {
      .meme-workspace {
        grid-template-columns: 1fr;
      }
      .preview-sticky {
        position: static;
      }
    }

    @media (max-width: 600px) {
      .studio-topbar {
        padding: 12px 16px;
      }
      .meme-workspace {
        padding: 18px 14px 48px;
      }
      .form-row-2 {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>

  <!-- Top Sticky Header -->
  <header class="studio-topbar">
    <div class="studio-brand-wrap">
      <a href="/" class="studio-brand" aria-label="Go to Coven of Technology home">
        <span class="brand-icon">✶</span>
        <span class="brand-title">Coven Meme Studio</span>
      </a>
      <span class="brand-badge">Phase 1 Authoring</span>
      <span class="mode-pill" id="studio-mode-pill">Create Mode</span>
      <div class="status-indicator">
        <span class="status-dot" id="status-dot"></span>
        <span id="status-text">Ready</span>
      </div>
    </div>

    <div class="studio-actions">
      <a href="/template-preview/meme-studio?new=1" class="studio-btn studio-btn--ghost" id="btn-create-new" title="Start a fresh meme draft">+ Create Meme</a>
      <a href="/template-preview/memes" class="studio-btn studio-btn--ghost" id="btn-meme-center" title="Open Coven Meme Center">Meme Center</a>
      <a href="/template-preview/studio" class="studio-btn studio-btn--ghost" id="btn-article-studio" title="Open Coven Article Studio">Article Studio</a>
      <button type="button" class="studio-btn studio-btn--danger" id="btn-unpublish" style="display:none;" title="Revert this meme to Draft status">Unpublish</button>
      <button type="button" class="studio-btn studio-btn--secondary" id="btn-save-draft" title="Save meme to src/memes/<slug>/meme.json">Save Draft</button>
      <button type="button" class="studio-btn studio-btn--primary" id="btn-publish" title="Validate and publish meme">Publish ✦</button>
    </div>
  </header>

  <!-- Main 2-Column Workspace -->
  <main class="meme-workspace">
    <!-- Left Column: Meme Authoring Form -->
    <section class="panel-card" aria-label="Meme Authoring Controls">
      <div class="panel-header">
        <div class="panel-title-group">
          <h1 id="form-heading">Conjure New Meme</h1>
          <p id="form-subheading">Author meme metadata, upload artwork, and manage Draft / Published state.</p>
        </div>
        <span class="lifecycle-badge is-draft" id="header-lifecycle-badge">DRAFT</span>
      </div>

      <form id="meme-studio-form" class="form-grid" onsubmit="return false;">
        <!-- Caption -->
        <div class="field-group">
          <div class="field-label-row">
            <label class="field-label" for="input-caption">Caption <span class="field-req">*</span></label>
            <span class="field-hint" id="caption-char-count">0 chars</span>
          </div>
          <input
            type="text"
            id="input-caption"
            class="studio-input"
            placeholder="e.g. &quot;It works in Sandbox.&quot; — Famous last incantations."
            autocomplete="off"
            required
          />
        </div>

        <!-- Slug & Category Row -->
        <div class="form-row-2">
          <div class="field-group">
            <div class="field-label-row">
              <label class="field-label" for="input-slug">Meme Slug <span class="field-req">*</span></label>
              <span class="field-hint" id="slug-mode-hint">Auto from caption</span>
            </div>
            <div class="slug-input-wrap">
              <input
                type="text"
                id="input-slug"
                class="studio-input mono"
                placeholder="it-works-in-sandbox"
                autocomplete="off"
              />
              <button type="button" class="btn-mini" id="btn-reset-slug" title="Re-sync slug from caption">Auto</button>
            </div>
          </div>

          <div class="field-group">
            <div class="field-label-row">
              <label class="field-label" for="input-category">Category <span class="field-req">*</span></label>
              <span class="field-hint">Managed taxonomy</span>
            </div>
            <select id="input-category" class="studio-select mono">
              {initialCategories.map((cat) => (
                <option value={cat.id}>{cat.glyph || '✦'} {cat.name}</option>
              ))}
            </select>
          </div>
        </div>

        <!-- Meme Image Upload (SVG disallowed) -->
        <div class="field-group">
          <div class="field-label-row">
            <label class="field-label" for="input-file">Meme Image <span class="field-req">* (to publish)</span></label>
            <span class="field-hint">Stored in src/memes/&lt;slug&gt;/images/</span>
          </div>

          <input
            type="file"
            id="input-file"
            accept=".png,.jpg,.jpeg,.webp,.gif,image/png,image/jpeg,image/webp,image/gif"
            style="display:none;"
          />

          <div class="upload-zone" id="upload-dropzone" role="button" tabindex="0" aria-label="Upload meme image">
            <div class="upload-empty-state" id="upload-empty-state">
              <div class="upload-glyph">🖼️</div>
              <div class="upload-title">Click or drag &amp; drop meme artwork here</div>
              <div class="upload-sub">Supports PNG, JPG, WEBP, GIF — saved directly as a file on disk</div>
            </div>

            <div class="upload-filled-state" id="upload-filled-state">
              <div class="upload-thumb-wrap">
                <img id="upload-thumb-img" src="" alt="Uploaded meme preview" />
              </div>
              <div class="upload-path-pill" id="upload-path-pill"></div>
              <div class="upload-actions-row">
                <button type="button" class="studio-btn studio-btn--secondary" id="btn-replace-image">Replace Image</button>
                <button type="button" class="studio-btn studio-btn--danger" id="btn-remove-image">Remove Image</button>
              </div>
            </div>
          </div>
        </div>

        <!-- Image Alt & Automatic Publish Lifecycle Row -->
        <div class="form-row-2">
          <div class="field-group">
            <div class="field-label-row">
              <label class="field-label" for="input-image-alt">Image Alt Text</label>
              <span class="field-hint">Optional accessibility text</span>
            </div>
            <input
              type="text"
              id="input-image-alt"
              class="studio-input"
              placeholder="Describe the meme image for screen readers..."
              autocomplete="off"
            />
          </div>

          <div class="field-group">
            <div class="field-label-row">
              <span class="field-label">Publish Lifecycle</span>
              <span class="field-hint">Managed automatically</span>
            </div>
            <div class="studio-readonly-box" id="display-publish-status">
              <span id="lifecycle-dot" style="display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--amber);"></span>
              <span id="lifecycle-text">Not published yet</span>
            </div>
          </div>
        </div>

        <!-- Optional Description -->
        <div class="field-group">
          <div class="field-label-row">
            <label class="field-label" for="input-description">Description / Lore Note</label>
            <span class="field-hint">Optional context or sub-caption</span>
          </div>
          <textarea
            id="input-description"
            class="studio-textarea"
            placeholder="Optional context or punchline lore (e.g. Every Friday at 4:55 PM when the change set finishes validating...)"
          ></textarea>
        </div>

        <!-- Featured / Cackle of the Day Toggle -->
        <label class="featured-toggle-card" for="input-featured">
          <input type="checkbox" id="input-featured" />
          <div class="featured-toggle-text">
            <span class="featured-toggle-title">🔥 Mark as "Cackle of the Day" (Featured)</span>
            <span class="featured-toggle-desc">
              Persists <code>featured: true</code> in <code>meme.json</code> so this meme can be spotlighted in the Cackle of the Day banner.
            </span>
          </div>
        </label>
      </form>

      <!-- Diagnostics / Identity Bar -->
      <div class="meta-diagnostics">
        <div class="meta-diag-item">
          Stable Meme ID
          <span id="diag-id">—</span>
        </div>
        <div class="meta-diag-item">
          Target File
          <span id="diag-filepath">src/memes/&lt;slug&gt;/meme.json</span>
        </div>
        <div class="meta-diag-item">
          Publish Date
          <span id="diag-publish-date">Not published yet</span>
        </div>
        <div class="meta-diag-item">
          Created At
          <span id="diag-created">—</span>
        </div>
        <div class="meta-diag-item">
          Updated At
          <span id="diag-updated">—</span>
        </div>
      </div>
    </section>

    <!-- Right Column: Live Meme Card Preview -->
    <aside class="preview-sticky" aria-label="Live Meme Card Preview">
      <div class="panel-card">
        <div class="panel-header">
          <div class="panel-title-group">
            <h2>Live Meme Card Preview</h2>
            <p>Renders live from current Meme Studio state</p>
          </div>
        </div>

        <article class="coven-meme-card-preview" id="live-preview-card">
          <div class="meme-preview-media">
            <span class="meme-preview-featured-ribbon" id="preview-featured-ribbon">🔥 Cackle of the Day</span>
            <span class="meme-preview-status-ribbon is-draft" id="preview-status-ribbon">Draft</span>
            <img id="preview-img" src="" alt="" style="display:none;" />
            <div class="meme-preview-placeholder" id="preview-placeholder">[ meme · upload image ]</div>
          </div>

          <div class="meme-preview-body">
            <div class="meme-preview-meta-row">
              <span class="meme-preview-cat-badge" id="preview-category">🧙 Admin life</span>
              <span class="meme-preview-date" id="preview-date"></span>
            </div>
            <h3 class="meme-preview-caption" id="preview-caption">Untitled Meme Incantation</h3>
            <p class="meme-preview-desc" id="preview-description"></p>
            <div class="meme-preview-reactions">
              <span class="meme-preview-reaction-pill">💀 Cackle · 0</span>
              <span class="meme-preview-reaction-pill">🔮 Relatable · 0</span>
              <span class="meme-preview-share">Share →</span>
            </div>
          </div>
        </article>
      </div>
    </aside>
  </main>

  <div class="toast-container" id="toast-container" aria-live="polite"></div>

  <script is:inline define:vars={{ canonicalCategoriesJson, categoryGlyphsJson }}>
    const CANONICAL_CATEGORIES = JSON.parse(canonicalCategoriesJson);
    const CATEGORY_GLYPHS = JSON.parse(categoryGlyphsJson);

    function normalizeSlug(raw) {
      if (!raw || typeof raw !== 'string') return '';
      return raw
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .trim()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/-+/g, '-')
        .replace(/^-|-$/g, '');
    }

    function generateClientMemeId() {
      return 'meme_' + Date.now().toString(36) + '_' + Math.random().toString(36).substring(2, 8);
    }

    function formatMemeDate(val) {
      if (!val) return '';
      try {
        const d = new Date(val + 'T00:00:00');
        if (Number.isNaN(d.getTime())) return val;
        return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
      } catch (_) {
        return val;
      }
    }

    const state = {
      mode: 'create', // 'create' | 'edit'
      id: generateClientMemeId(),
      slug: '',
      slugManuallyEdited: false,
      lastSavedSlug: '',
      lastUploadedSlug: '',
      status: 'draft',
      caption: '',
      description: '',
      categoryId: 'admin-life',
      category: 'Admin life',
      imageSrc: '',
      imageAlt: '',
      publishedAt: '',
      publishDate: '', // Canonical first-published timestamp assigned automatically on first publish
      featured: false,
      createdAt: '',
      updatedAt: '',
      busy: false,
    };

    // DOM References
    const elModePill = document.getElementById('studio-mode-pill');
    const elStatusDot = document.getElementById('status-dot');
    const elStatusText = document.getElementById('status-text');
    const elFormHeading = document.getElementById('form-heading');
    const elFormSubheading = document.getElementById('form-subheading');
    const elHeaderBadge = document.getElementById('header-lifecycle-badge');

    const elCaption = document.getElementById('input-caption');
    const elCaptionCount = document.getElementById('caption-char-count');
    const elSlug = document.getElementById('input-slug');
    const elSlugHint = document.getElementById('slug-mode-hint');
    const elBtnResetSlug = document.getElementById('btn-reset-slug');
    const elCategory = document.getElementById('input-category');
    const elFileInput = document.getElementById('input-file');
    const elDropzone = document.getElementById('upload-dropzone');
    const elUploadEmpty = document.getElementById('upload-empty-state');
    const elUploadFilled = document.getElementById('upload-filled-state');
    const elUploadThumb = document.getElementById('upload-thumb-img');
    const elUploadPath = document.getElementById('upload-path-pill');
    const elBtnReplaceImg = document.getElementById('btn-replace-image');
    const elBtnRemoveImg = document.getElementById('btn-remove-image');
    const elImageAlt = document.getElementById('input-image-alt');
    const elLifecycleDot = document.getElementById('lifecycle-dot');
    const elLifecycleText = document.getElementById('lifecycle-text');
    const elDescription = document.getElementById('input-description');
    const elFeatured = document.getElementById('input-featured');

    const elDiagId = document.getElementById('diag-id');
    const elDiagFilepath = document.getElementById('diag-filepath');
    const elDiagPublishDate = document.getElementById('diag-publish-date');
    const elDiagCreated = document.getElementById('diag-created');
    const elDiagUpdated = document.getElementById('diag-updated');

    const elBtnUnpublish = document.getElementById('btn-unpublish');
    const elBtnSaveDraft = document.getElementById('btn-save-draft');
    const elBtnPublish = document.getElementById('btn-publish');

    // Preview References
    const elPreviewCard = document.getElementById('live-preview-card');
    const elPreviewStatusRibbon = document.getElementById('preview-status-ribbon');
    const elPreviewImg = document.getElementById('preview-img');
    const elPreviewPlaceholder = document.getElementById('preview-placeholder');
    const elPreviewCategory = document.getElementById('preview-category');
    const elPreviewDate = document.getElementById('preview-date');
    const elPreviewCaption = document.getElementById('preview-caption');
    const elPreviewDesc = document.getElementById('preview-description');

    const elToastContainer = document.getElementById('toast-container');

    function showToast(message, type = 'info') {
      const toast = document.createElement('div');
      toast.className = `toast-msg toast-${type}`;
      toast.textContent = message;
      elToastContainer.appendChild(toast);
      setTimeout(() => {
        toast.remove();
      }, 4200);
    }

    function setStudioStatus(text, kind = 'ready') {
      elStatusText.textContent = text;
      elStatusDot.className = 'status-dot';
      if (kind === 'saving') elStatusDot.classList.add('saving');
      if (kind === 'error') elStatusDot.classList.add('error');
    }

    let allManagedCategories = [];

    function ensureCategoryOption(id, name) {
      if (!id) return;
      const exists = Array.from(elCategory.options).some((opt) => opt.value === id);
      if (!exists) {
        const opt = document.createElement('option');
        opt.value = id;
        opt.textContent = `${CATEGORY_GLYPHS[id] || CATEGORY_GLYPHS[name] || '✦'} ${name || id}`;
        elCategory.appendChild(opt);
      }
    }

    async function loadManagedCategories() {
      try {
        const res = await fetch('/__meme-studio/categories');
        const data = await res.json();
        if (res.ok && Array.isArray(data.categories)) {
          allManagedCategories = data.categories;
          const currentVal = elCategory.value;
          elCategory.innerHTML = '';
          for (const cat of data.categories) {
            const opt = document.createElement('option');
            opt.value = cat.id;
            opt.textContent = `${cat.glyph || '✦'} ${cat.name}`;
            elCategory.appendChild(opt);
          }
          if (data.glyphs) {
            Object.assign(CATEGORY_GLYPHS, data.glyphs);
          }
          const targetCatId = state.categoryId || state.category;
          if (targetCatId) {
            ensureCategoryOption(targetCatId, state.category);
          }
          if (currentVal && Array.from(elCategory.options).some((o) => o.value === currentVal)) {
            elCategory.value = currentVal;
          } else if (targetCatId && Array.from(elCategory.options).some((o) => o.value === targetCatId)) {
            elCategory.value = targetCatId;
          }
          renderUI();
        }
      } catch (_) {}
    }

    function syncFormFromState() {
      elCaption.value = state.caption;
      elSlug.value = state.slug;
      const targetCatId = state.categoryId || state.category;
      ensureCategoryOption(targetCatId, state.category);
      if (targetCatId) elCategory.value = targetCatId;
      elImageAlt.value = state.imageAlt || '';
      elDescription.value = state.description || '';
      elFeatured.checked = Boolean(state.featured);
      renderUI();
    }

    function renderUI() {
      // Mode & header
      const isEdit = state.mode === 'edit';
      elModePill.textContent = isEdit ? `Edit Mode · ${state.slug || state.id}` : 'Create Mode';
      elFormHeading.textContent = isEdit ? 'Edit Meme Scroll' : 'Conjure New Meme';
      elFormSubheading.textContent = isEdit
        ? `Editing persisted meme in src/memes/${state.slug || '<slug>'}/meme.json`
        : 'Author meme metadata, upload artwork, and manage Draft / Published state.';

      // Lifecycle badges
      const isPublished = state.status === 'published';
      elHeaderBadge.textContent = isPublished ? 'PUBLISHED' : 'DRAFT';
      elHeaderBadge.className = `lifecycle-badge ${isPublished ? 'is-published' : 'is-draft'}`;

      // Buttons
      elBtnUnpublish.style.display = isPublished && state.lastSavedSlug ? 'inline-flex' : 'none';
      elBtnSaveDraft.textContent = isPublished ? 'Save as Draft' : 'Save Draft';
      elBtnPublish.textContent = isPublished ? 'Update Published ✦' : 'Publish ✦';

      // Caption count & slug hint
      elCaptionCount.textContent = `${(state.caption || '').length} chars`;
      elSlugHint.textContent = state.slugManuallyEdited ? 'Manual slug' : 'Auto from caption';

      // Upload zone state
      if (state.imageSrc) {
        elUploadEmpty.style.display = 'none';
        elUploadFilled.style.display = 'flex';
        elUploadThumb.src = state.imageSrc;
        elUploadThumb.alt = state.imageAlt || state.caption || 'Uploaded meme image';
        elUploadPath.textContent = state.imageSrc;
      } else {
        elUploadEmpty.style.display = 'flex';
        elUploadFilled.style.display = 'none';
        elUploadThumb.removeAttribute('src');
        elUploadPath.textContent = '';
      }

      // Automatic Publish Date Indicators
      const pubDateVal = state.publishedAt || state.publishDate;
      if (isPublished) {
        elLifecycleDot.style.background = 'var(--green)';
        elLifecycleText.textContent = `Published: ${formatMemeDate(pubDateVal) || 'Active'}`;
        elDiagPublishDate.textContent = formatMemeDate(pubDateVal) || 'Published';
      } else {
        elLifecycleDot.style.background = 'var(--amber)';
        if (pubDateVal) {
          elLifecycleText.textContent = `Draft (Previously published: ${formatMemeDate(pubDateVal)})`;
          elDiagPublishDate.textContent = `${formatMemeDate(pubDateVal)} (Unpublished)`;
        } else {
          elLifecycleText.textContent = 'Not published yet';
          elDiagPublishDate.textContent = 'Not published yet';
        }
      }

      // Diagnostics
      const activeSlug = state.slug || normalizeSlug(state.caption) || '<slug>';
      elDiagId.textContent = state.id || '—';
      elDiagFilepath.textContent = `src/memes/${activeSlug}/meme.json`;
      elDiagCreated.textContent = state.createdAt ? new Date(state.createdAt).toLocaleString() : 'Unsaved';
      elDiagUpdated.textContent = state.updatedAt ? new Date(state.updatedAt).toLocaleString() : 'Unsaved';

      // Live Preview Card
      elPreviewCard.classList.toggle('is-featured', Boolean(state.featured));
      elPreviewStatusRibbon.textContent = isPublished ? 'Published' : 'Draft';
      elPreviewStatusRibbon.className = `meme-preview-status-ribbon ${isPublished ? 'is-published' : 'is-draft'}`;

      if (state.imageSrc) {
        elPreviewImg.src = state.imageSrc;
        elPreviewImg.alt = state.imageAlt || state.caption || 'Meme preview';
        elPreviewImg.style.display = 'block';
        elPreviewPlaceholder.style.display = 'none';
      } else {
        elPreviewImg.removeAttribute('src');
        elPreviewImg.style.display = 'none';
        elPreviewPlaceholder.style.display = 'block';
        const shortSlug = state.slug || 'upload-image';
        elPreviewPlaceholder.textContent = `[ meme · ${shortSlug} ]`;
      }

      const catObj = allManagedCategories.find((c) => c.id === state.categoryId);
      const catName = catObj ? catObj.name : (state.category || state.categoryId || 'Unknown Category');
      const glyph = (catObj && catObj.glyph) || CATEGORY_GLYPHS[state.categoryId] || CATEGORY_GLYPHS[state.category] || '✦';
      elPreviewCategory.textContent = `${glyph} ${catName}`;
      elPreviewDate.textContent = isPublished && pubDateVal ? formatMemeDate(pubDateVal) : '';
      elPreviewCaption.textContent = state.caption.trim() || 'Untitled Meme Incantation';

      if (state.description && state.description.trim()) {
        elPreviewDesc.textContent = state.description.trim();
        elPreviewDesc.style.display = 'block';
      } else {
        elPreviewDesc.textContent = '';
        elPreviewDesc.style.display = 'none';
      }
    }

    // Event Listeners for Live Input
    elCaption.addEventListener('input', () => {
      state.caption = elCaption.value;
      if (!state.slugManuallyEdited) {
        state.slug = normalizeSlug(state.caption);
        elSlug.value = state.slug;
      }
      renderUI();
    });

    elSlug.addEventListener('input', () => {
      state.slugManuallyEdited = true;
      state.slug = normalizeSlug(elSlug.value);
      renderUI();
    });

    elSlug.addEventListener('blur', () => {
      state.slug = normalizeSlug(elSlug.value || state.caption);
      elSlug.value = state.slug;
      renderUI();
    });

    elBtnResetSlug.addEventListener('click', () => {
      state.slugManuallyEdited = false;
      state.slug = normalizeSlug(state.caption);
      elSlug.value = state.slug;
      renderUI();
    });

    elCategory.addEventListener('change', () => {
      state.categoryId = elCategory.value;
      const catObj = allManagedCategories.find((c) => c.id === state.categoryId);
      state.category = catObj ? catObj.name : state.categoryId;
      renderUI();
    });

    elImageAlt.addEventListener('input', () => {
      state.imageAlt = elImageAlt.value;
      renderUI();
    });

    elDescription.addEventListener('input', () => {
      state.description = elDescription.value;
      renderUI();
    });

    elFeatured.addEventListener('change', () => {
      state.featured = elFeatured.checked;
      renderUI();
    });

    // Image Upload Handling (SVG blocked)
    function readFileAsDataUrl(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(reader.result);
        reader.onerror = () => reject(new Error('Failed to read image file.'));
        reader.readAsDataURL(file);
      });
    }

    async function handleFileSelect(file) {
      if (!file) return;

      const lowerName = (file.name || '').toLowerCase();
      if (lowerName.endsWith('.svg') || file.type === 'image/svg+xml') {
        showToast('SVG images are not allowed for security reasons. Please upload PNG, JPG, WEBP, or GIF.', 'error');
        elFileInput.value = '';
        return;
      }

      // Determine slug for storing the uploaded image
      let uploadSlug = normalizeSlug(state.slug || state.caption);
      if (!uploadSlug) {
        const baseFromFile = file.name.replace(/\.[^.]+$/, '');
        uploadSlug = normalizeSlug(baseFromFile) || normalizeSlug(state.id);
        state.slug = uploadSlug;
        elSlug.value = uploadSlug;
      }

      try {
        setStudioStatus('Uploading image...', 'saving');
        const base64 = await readFileAsDataUrl(file);
        const res = await fetch('/__meme-studio/upload', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            slug: uploadSlug,
            memeId: state.id,
            filename: file.name,
            base64,
          }),
        });
        const data = await res.json();
        if (!res.ok || !data.success) {
          throw new Error(data.error || 'Image upload failed.');
        }

        state.imageSrc = data.imageSrc;
        state.lastUploadedSlug = data.slug;
        if (!state.slug) {
          state.slug = data.slug;
          elSlug.value = data.slug;
        }
        setStudioStatus('Image uploaded', 'ready');
        showToast(`Uploaded ${data.filename} to src/memes/${data.slug}/images/`, 'success');
        renderUI();
      } catch (err) {
        setStudioStatus('Upload error', 'error');
        showToast(err.message || 'Failed to upload image.', 'error');
      } finally {
        elFileInput.value = '';
      }
    }

    elDropzone.addEventListener('click', (e) => {
      if (e.target.closest('#btn-remove-image')) return;
      elFileInput.click();
    });

    elDropzone.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        elFileInput.click();
      }
    });

    elBtnReplaceImg.addEventListener('click', (e) => {
      e.stopPropagation();
      elFileInput.click();
    });

    elBtnRemoveImg.addEventListener('click', (e) => {
      e.stopPropagation();
      state.imageSrc = '';
      renderUI();
      showToast('Removed image reference from current state.', 'info');
    });

    elFileInput.addEventListener('change', () => {
      if (elFileInput.files && elFileInput.files[0]) {
        handleFileSelect(elFileInput.files[0]);
      }
    });

    elDropzone.addEventListener('dragover', (e) => {
      e.preventDefault();
      elDropzone.classList.add('dragover');
    });

    elDropzone.addEventListener('dragleave', () => {
      elDropzone.classList.remove('dragover');
    });

    elDropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      elDropzone.classList.remove('dragover');
      if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]) {
        handleFileSelect(e.dataTransfer.files[0]);
      }
    });

    function buildPayload(targetStatus) {
      return {
        previousSlug: state.lastSavedSlug || state.lastUploadedSlug || '',
        meme: {
          id: state.id,
          slug: normalizeSlug(state.slug || state.caption),
          status: targetStatus,
          caption: state.caption.trim(),
          description: state.description.trim(),
          categoryId: state.categoryId || state.category,
          category: state.category,
          imageSrc: state.imageSrc,
          imageAlt: state.imageAlt.trim(),
          publishedAt: state.publishedAt || undefined,
          publishDate: state.publishDate || undefined,
          featured: Boolean(state.featured),
          createdAt: state.createdAt || undefined,
        },
      };
    }

    function applySavedMeme(saved) {
      state.mode = 'edit';
      state.id = saved.id;
      state.slug = saved.slug;
      state.lastSavedSlug = saved.slug;
      state.lastUploadedSlug = saved.slug;
      state.slugManuallyEdited = true;
      state.status = saved.status;
      state.caption = saved.caption;
      state.description = saved.description || '';
      state.categoryId = saved.categoryId || saved.category;
      state.category = saved.category;
      state.imageSrc = saved.imageSrc || '';
      state.imageAlt = saved.imageAlt || '';
      state.publishedAt = saved.publishedAt || '';
      state.publishDate = saved.publishDate || '';
      state.featured = Boolean(saved.featured);
      state.createdAt = saved.createdAt;
      state.updatedAt = saved.updatedAt;

      // Update URL bar to ?slug=<slug> without reloading
      const url = new URL(window.location.href);
      url.searchParams.delete('new');
      url.searchParams.set('slug', saved.slug);
      window.history.replaceState({}, '', url.toString());

      syncFormFromState();
    }

    // Save Draft Handler
    elBtnSaveDraft.addEventListener('click', async () => {
      if (state.busy) return;
      if (!state.caption.trim()) {
        showToast('Caption is required to save a meme draft.', 'error');
        elCaption.focus();
        return;
      }

      state.busy = true;
      setStudioStatus('Saving draft...', 'saving');
      try {
        const res = await fetch('/__meme-studio/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(buildPayload('draft')),
        });
        const data = await res.json();
        if (!res.ok || !data.success) {
          throw new Error(data.error || 'Failed to save draft.');
        }

        applySavedMeme(data.meme);
        setStudioStatus('Draft saved', 'ready');
        showToast(`Saved draft to src/memes/${data.meme.slug}/meme.json`, 'success');
      } catch (err) {
        setStudioStatus('Save failed', 'error');
        showToast(err.message || 'Failed to save meme draft.', 'error');
      } finally {
        state.busy = false;
      }
    });

    // Publish Handler (Sets publishDate automatically if empty)
    elBtnPublish.addEventListener('click', async () => {
      if (state.busy) return;
      if (!state.caption.trim()) {
        showToast('Caption is required before publishing.', 'error');
        elCaption.focus();
        return;
      }
      if (!state.imageSrc) {
        showToast('A meme image is required before publishing. Please upload an image first.', 'error');
        return;
      }

      state.busy = true;
      setStudioStatus('Publishing...', 'saving');
      try {
        const res = await fetch('/__meme-studio/publish', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(buildPayload('published')),
        });
        const data = await res.json();
        if (!res.ok || !data.success) {
          throw new Error(data.error || 'Failed to publish meme.');
        }

        applySavedMeme(data.meme);
        setStudioStatus('Published', 'ready');
        showToast(`Published "${data.meme.caption}" (${data.meme.slug})`, 'success');
      } catch (err) {
        setStudioStatus('Publish blocked', 'error');
        showToast(err.message || 'Failed to publish meme.', 'error');
      } finally {
        state.busy = false;
      }
    });

    // Unpublish Handler (Preserves original publishDate!)
    elBtnUnpublish.addEventListener('click', async () => {
      if (state.busy || !state.lastSavedSlug) return;
      state.busy = true;
      setStudioStatus('Unpublishing...', 'saving');
      try {
        const res = await fetch('/__meme-studio/unpublish', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug: state.lastSavedSlug }),
        });
        const data = await res.json();
        if (!res.ok || !data.success) {
          throw new Error(data.error || 'Failed to unpublish meme.');
        }

        applySavedMeme(data.meme);
        setStudioStatus('Reverted to Draft', 'ready');
        showToast(`Unpublished "${data.meme.caption}" — now in Draft status.`, 'info');
      } catch (err) {
        setStudioStatus('Unpublish failed', 'error');
        showToast(err.message || 'Failed to unpublish meme.', 'error');
      } finally {
        state.busy = false;
      }
    });

    // Boot / Load existing meme when ?slug=<slug> is present
    async function initMemeStudio() {
      await loadManagedCategories();

      const params = new URLSearchParams(window.location.search);
      const slugParam = params.get('slug');

      if (slugParam && !params.get('new')) {
        setStudioStatus('Loading meme...', 'saving');
        try {
          const res = await fetch(`/__meme-studio/memes/${encodeURIComponent(slugParam)}`);
          const data = await res.json();
          if (!res.ok || !data.meme) {
            throw new Error(data.error || `Meme "${slugParam}" not found.`);
          }
          applySavedMeme(data.meme);
          setStudioStatus('Loaded', 'ready');
          return;
        } catch (err) {
          setStudioStatus('Load error', 'error');
          showToast(err.message || 'Could not load requested meme.', 'error');
        }
      }

      // Default Create Mode initialization
      syncFormFromState();
      setStudioStatus('Ready', 'ready');
    }

    initMemeStudio();
  </script>
</body>
</html>
