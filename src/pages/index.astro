---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const publishedFeaturedPosts = await getCollection('blog', ({ data }) => data.status === 'published' && data.featured);
publishedFeaturedPosts.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const collectionCardsHtml = publishedFeaturedPosts.map(post => {
  const tag = (post.data.tags && post.data.tags.length > 0)
    ? post.data.tags.slice(0, 2).join(' · ').toUpperCase()
    : post.data.category.toUpperCase();
  const thumbBg = post.data.thumbBg || 'repeating-linear-gradient(135deg,rgba(216,181,107,.08) 0 10px,rgba(216,181,107,.02) 10px 20px)';
  const meta = post.data.meta || '12 min · ✦ 120 Aether';

  return `
    <div style="background:#15121c;border:1px solid rgba(216,181,107,.14);border-radius:5px;overflow:hidden;cursor:pointer" style-hover="border:1px solid rgba(216,181,107,.4)">
      <a href="/article/${post.id}" style="text-decoration:none;color:inherit;display:block">
        <div style="height:150px;background:${thumbBg};display:flex;align-items:center;justify-content:center;font-family:'IBM Plex Mono',monospace;font-size:11px;color:#8a7f70;letter-spacing:1px;border-bottom:1px solid rgba(216,181,107,.12)">[ scroll glyph · 640×360 ]</div>
        <div style="padding:22px">
          <div style="display:inline-block;font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:1.5px;color:#b98fd8;border:1px solid rgba(185,143,216,.32);border-radius:2px;padding:4px 8px;margin-bottom:14px">${tag}</div>
          <h3 style="font-family:Cinzel,serif;font-weight:600;font-size:21px;line-height:1.25;color:#ece6dd;margin:0 0 10px">${post.data.title}</h3>
          <p style="font-family:'EB Garamond',serif;font-size:15px;color:#9b9189;margin:0 0 16px;line-height:1.5">${post.data.description}</p>
          <div style="display:flex;justify-content:space-between;align-items:center;font-family:'EB Garamond',serif;font-size:13px;color:#8f857a">
            <span>${meta}</span>
            <span style="color:#e8cf95">Read →</span>
          </div>
        </div>
      </a>
    </div>
  `;
}).join('\n');

const landingHtml = `<!-- ═══════════════════════════════════════════════════════════════
  LANDING
  Edit hero copy, stats, ranks and featured scrolls in CONTENT.
════════════════════════════════════════════════════════════════ -->
<sc-if value="{{ isLanding }}" hint-placeholder-val="{{ true }}">
<div style="position:relative;overflow:hidden;background:radial-gradient(1300px 780px at 50% -16%,rgba(124,77,196,.42),transparent 58%),radial-gradient(820px 600px at 14% 2%,rgba(86,58,150,.36),transparent 60%),radial-gradient(720px 540px at 88% 12%,rgba(170,128,224,.26),transparent 62%),radial-gradient(560px 420px at 72% 34%,rgba(216,181,107,.07),transparent 60%),#08060e">

  <header class="cov-header" style="display:flex;align-items:center;justify-content:space-between;padding:18px 48px;border-bottom:1px solid rgba(216,181,107,.12);position:relative;z-index:10">
    <div onclick="{{ toLanding }}" class="cov-brand" style="display:flex;align-items:center;gap:13px;cursor:pointer">
      <div class="cov-brand-logo" style="width:36px;height:36px;border-radius:50%;border:1px solid #d8b56b;display:flex;align-items:center;justify-content:center;color:#d8b56b;font-size:16px;background:#0b0a0e;box-shadow:inset 0 0 12px rgba(216,181,107,.18)">✶</div>
      <div class="cov-brand-text" style="font-family:Cinzel,serif;font-size:14px;font-weight:600;letter-spacing:2px;color:#ece6dd">{{ brand.name }}</div>
    </div>
    <nav class="cov-nav-desktop" style="display:flex;gap:16px;font-family:'EB Garamond',serif;font-size:13px;color:#c5b9a8;letter-spacing:.3px;white-space:nowrap">
      <span onclick="{{ toLibrary }}" style="cursor:pointer" style-hover="color:#f3ecdf">Spell Book</span>
      <span onclick="{{ toMemes }}" style="cursor:pointer" style-hover="color:#f3ecdf">Grimoire of Memes</span>
      <sc-if value="{{ loggedIn }}" hint-placeholder-val="{{ false }}"><span onclick="{{ toProfile }}" style="cursor:pointer" style-hover="color:#f3ecdf">About Me</span></sc-if>
      <span onclick="{{ toTerms }}" style="cursor:pointer" style-hover="color:#f3ecdf">Mystic Terms &amp; Privacy</span>
    </nav>
    <div style="display:flex;align-items:center;gap:12px">
      <div onclick="{{ toSignup }}" class="cov-header-desktop-cta" style="padding:9px 18px;border-radius:3px;background:linear-gradient(180deg,#e3c47e,#c49a4e);color:#221809;font-family:Cinzel,serif;font-weight:600;font-size:12px;letter-spacing:1.5px;box-shadow:0 0 26px rgba(216,181,107,.30);cursor:pointer">ENTER THE COVEN</div>
      <button class="cov-mobile-toggle" aria-label="Toggle navigation menu" type="button">☰</button>
    </div>
    <div class="cov-mobile-drawer">
      <span onclick="{{ toLibrary }}">Spell Book</span>
      <span onclick="{{ toMemes }}">Grimoire of Memes</span>
      <sc-if value="{{ loggedIn }}" hint-placeholder-val="{{ false }}"><span onclick="{{ toProfile }}">About Me</span></sc-if>
      <span onclick="{{ toTerms }}">Mystic Terms &amp; Privacy</span>
      <div onclick="{{ toSignup }}" class="cov-mobile-cta">ENTER THE COVEN</div>
    </div>
  </header>

  <!-- HERO — edit text in CONTENT.hero -->
  <section class="cov-section-pad" style="padding:96px 56px 64px;text-align:center;position:relative">
    <div style="position:absolute;top:30px;right:9%;width:56px;height:56px;border-radius:50%;background:radial-gradient(circle at 38% 36%,#efe7d2,#cdbfae 58%,#6f6450);box-shadow:0 0 44px rgba(214,208,236,.4),inset -8px -6px 14px rgba(40,30,60,.55);opacity:.5;animation:covFloat 9s ease-in-out infinite"></div>
    <div style="position:absolute;top:48px;left:11%;width:4px;height:4px;border-radius:50%;background:#e8cf95;box-shadow:0 0 10px 2px rgba(232,207,149,.6);animation:covTwinkle 3s ease-in-out infinite"></div>
    <div style="position:absolute;top:120px;right:24%;width:3px;height:3px;border-radius:50%;background:#c9b8ff;box-shadow:0 0 10px 2px rgba(201,184,255,.7);animation:covTwinkle 4s ease-in-out .8s infinite"></div>
    <div style="position:absolute;top:206px;left:19%;width:3px;height:3px;border-radius:50%;background:#e8cf95;box-shadow:0 0 8px 2px rgba(232,207,149,.5);animation:covTwinkle 3.4s ease-in-out 1.4s infinite"></div>
    <div style="position:absolute;top:92px;left:33%;width:2px;height:2px;border-radius:50%;background:#d6d0ec;box-shadow:0 0 8px 2px rgba(214,208,236,.6);animation:covTwinkle 5s ease-in-out .3s infinite"></div>
    <div style="position:absolute;top:250px;right:13%;width:4px;height:4px;border-radius:50%;background:#b98fd8;box-shadow:0 0 12px 2px rgba(185,143,216,.6);animation:covTwinkle 3.8s ease-in-out 1s infinite"></div>
    <div style="position:absolute;top:300px;left:13%;width:2px;height:2px;border-radius:50%;background:#e8cf95;box-shadow:0 0 7px 2px rgba(232,207,149,.5);animation:covTwinkle 4.4s ease-in-out .5s infinite"></div>
    <div style="font-family:'EB Garamond',serif;letter-spacing:5px;text-transform:uppercase;font-size:13px;color:#b98fd8;margin-bottom:24px">{{ hero.kicker }}</div>
    <h1 style="font-family:Cinzel,serif;font-weight:700;font-size:clamp(30px,7.5vw,66px);line-height:1.08;color:#f3ecdf;margin:0 0 24px;text-shadow:0 0 44px rgba(139,92,196,.28)">{{ hero.headline1 }}<br>{{ hero.headline2 }}</h1>
    <p style="font-family:'EB Garamond',serif;font-size:clamp(16px,4vw,21px);line-height:1.62;color:#b3a99d;max-width:660px;margin:0 auto 38px">{{ hero.body }}</p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;margin-bottom:64px">
      <div onclick="{{ toSignup }}" style="padding:15px 30px;border-radius:3px;background:linear-gradient(180deg,#e3c47e,#c49a4e);color:#221809;font-family:Cinzel,serif;font-weight:600;font-size:14px;letter-spacing:1.5px;box-shadow:0 0 34px rgba(216,181,107,.34);cursor:pointer;max-width:100%">{{ hero.ctaPrimary }}</div>
      <div onclick="{{ toLibrary }}" style="padding:15px 30px;border-radius:3px;border:1px solid rgba(216,181,107,.42);color:#e8cf95;font-family:Cinzel,serif;font-weight:500;font-size:14px;letter-spacing:1.5px;cursor:pointer;max-width:100%">{{ hero.ctaSecondary }}</div>
    </div>
    <!-- Stats bar — edit values in CONTENT.stats -->
    <div class="cov-stats-row" style="display:flex;gap:clamp(20px,6vw,64px);justify-content:center;flex-wrap:wrap;border-top:1px solid rgba(216,181,107,.12);padding-top:34px;max-width:680px;margin:0 auto">
      <sc-for list="{{ heroStats }}" as="stat" hint-placeholder-count="3">
        <div>
          <div style="font-family:Cinzel,serif;font-size:34px;color:#d8b56b">{{ stat.value }}</div>
          <div style="font-family:'EB Garamond',serif;font-size:15px;color:#8f857a;letter-spacing:2px;text-transform:uppercase">{{ stat.label }}</div>
        </div>
      </sc-for>
    </div>
  </section>

  <!-- Ranks — edit names, glyphs and thresholds in CONTENT.ranks -->
  <section class="cov-section-pad" style="padding:34px 56px 70px">
    <div style="text-align:center;margin-bottom:46px">
      <div style="font-family:'EB Garamond',serif;letter-spacing:4px;text-transform:uppercase;font-size:12px;color:#b98fd8;margin-bottom:10px">The Path</div>
      <h2 style="font-family:Cinzel,serif;font-weight:600;font-size:clamp(22px,5vw,30px);color:#ece6dd;margin:0">Seven ranks of the coven</h2>
    </div>
    <div class="cov-ranks-track" style="position:relative;display:flex;justify-content:space-between;gap:4px">
      <div class="cov-ranks-line" style="position:absolute;left:6%;right:6%;top:27px;height:1px;background:linear-gradient(90deg,transparent,rgba(216,181,107,.34),transparent);z-index:0"></div>
      <sc-for list="{{ ranks }}" as="rank" hint-placeholder-count="7">
        <div style="flex:1;text-align:center;position:relative;z-index:1">
          <div style="{{ rank.circleStyle }}">{{ rank.glyph }}</div>
          <div style="{{ rank.nameStyle }}">{{ rank.name }}</div>
          <div style="font-family:'EB Garamond',serif;font-size:12px;color:#8f857a;letter-spacing:1px;margin-top:2px">{{ rank.aether }}</div>
        </div>
      </sc-for>
    </div>
  </section>

  <!-- Featured scrolls -->
  <section class="cov-section-pad" style="padding:18px 56px 70px">
    <div style="display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:30px">
      <h2 style="font-family:Cinzel,serif;font-weight:600;font-size:clamp(22px,5vw,30px);color:#ece6dd;margin:0">Featured scrolls</h2>
      <span onclick="{{ toLibrary }}" style="font-family:'EB Garamond',serif;font-size:16px;color:#b98fd8;cursor:pointer">Enter the Grimoire →</span>
    </div>
    <div class="cov-grid-3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px">
      ${collectionCardsHtml}
      <!-- Demo cards for scrolls not yet written in markdown -->
      <div style="background:#15121c;border:1px solid rgba(216,181,107,.14);border-radius:5px;overflow:hidden;cursor:pointer;min-width:0" style-hover="border:1px solid rgba(216,181,107,.4)">
        <div style="height:150px;background:repeating-linear-gradient(135deg,rgba(185,143,216,.10) 0 10px,rgba(185,143,216,.03) 10px 20px);display:flex;align-items:center;justify-content:center;font-family:'IBM Plex Mono',monospace;font-size:11px;color:#8a7f70;letter-spacing:1px;border-bottom:1px solid rgba(216,181,107,.12)">[ scroll glyph · 640×360 ]</div>
        <div style="padding:22px">
          <div style="display:inline-block;font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:1.5px;color:#b98fd8;border:1px solid rgba(185,143,216,.32);border-radius:2px;padding:4px 8px;margin-bottom:14px">THE MENTOR'S WAY</div>
          <h3 style="font-family:Cinzel,serif;font-weight:600;font-size:21px;line-height:1.25;color:#ece6dd;margin:0 0 10px">${"Guiding Apprentices: The Art of the Mentor"}</h3>
          <p style="font-family:'EB Garamond',serif;font-size:15px;color:#9b9189;margin:0 0 16px;line-height:1.5">How to grow new admins without casting their decisions for them.</p>
          <div style="display:flex;justify-content:space-between;align-items:center;font-family:'EB Garamond',serif;font-size:13px;color:#8f857a">
            <span>9 min · ✦ 90 Aether</span>
            <span style="color:#e8cf95">Read →</span>
          </div>
        </div>
      </div>
      <div style="background:#15121c;border:1px solid rgba(216,181,107,.14);border-radius:5px;overflow:hidden;cursor:pointer;min-width:0" style-hover="border:1px solid rgba(216,181,107,.4)">
        <div style="height:150px;background:repeating-linear-gradient(135deg,rgba(216,181,107,.08) 0 10px,rgba(216,181,107,.02) 10px 20px);display:flex;align-items:center;justify-content:center;font-family:'IBM Plex Mono',monospace;font-size:11px;color:#8a7f70;letter-spacing:1px;border-bottom:1px solid rgba(216,181,107,.12)">[ scroll glyph · 640×360 ]</div>
        <div style="padding:22px">
          <div style="display:inline-block;font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:1.5px;color:#b98fd8;border:1px solid rgba(185,143,216,.32);border-radius:2px;padding:4px 8px;margin-bottom:14px">DIVINATION · BA</div>
          <h3 style="font-family:Cinzel,serif;font-weight:600;font-size:21px;line-height:1.25;color:#ece6dd;margin:0 0 10px">Reading the Omens: Requirements Divination</h3>
          <p style="font-family:'EB Garamond',serif;font-size:15px;color:#9b9189;margin:0 0 16px;line-height:1.5">Ask the questions that surface what stakeholders truly need.</p>
          <div style="display:flex;justify-content:space-between;align-items:center;font-family:'EB Garamond',serif;font-size:13px;color:#8f857a">
            <span>14 min · ✦ 140 Aether</span>
            <span style="color:#e8cf95">Read →</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA banner -->
  <section class="cov-banner" style="margin:0 56px 64px;border:1px solid rgba(216,181,107,.18);border-radius:6px;padding:56px;text-align:center;background:radial-gradient(700px 300px at 50% 0%,rgba(139,92,196,.20),transparent 65%),#100d16">
    <div style="font-size:24px;color:#d8b56b;margin-bottom:14px">✦</div>
    <h2 style="font-family:Cinzel,serif;font-weight:700;font-size:clamp(24px,5.5vw,38px);color:#f3ecdf;margin:0 0 14px;text-shadow:0 0 38px rgba(139,92,196,.28)">Your initiation awaits</h2>
    <p style="font-family:'EB Garamond',serif;font-size:18px;color:#b3a99d;max-width:520px;margin:0 auto 30px">Claim your first scroll, pass the opening trial, and take your place among the coven.</p>
    <div onclick="{{ toSignup }}" style="display:inline-block;padding:15px clamp(16px,4vw,34px);border-radius:3px;background:linear-gradient(180deg,#e3c47e,#c49a4e);color:#221809;font-family:Cinzel,serif;font-weight:600;font-size:clamp(12px,3.5vw,14px);letter-spacing:1.5px;box-shadow:0 0 34px rgba(216,181,107,.34);cursor:pointer;max-width:100%">JOIN THE COVEN — IT'S FREE</div>
  </section>

  <!-- Footer — edit in CONTENT.brand -->
  <footer class="cov-section-pad cov-flex-stack" style="border-top:1px solid rgba(216,181,107,.12);padding:34px 56px;display:flex;justify-content:space-between;align-items:center;font-family:'EB Garamond',serif;font-size:14px;color:#8f857a;gap:16px">
    <div style="display:flex;align-items:center;gap:12px">
      <div style="width:28px;height:28px;border-radius:50%;border:1px solid rgba(216,181,107,.5);display:flex;align-items:center;justify-content:center;color:#d8b56b;font-size:13px">✦</div>
      <span style="color:#c5b9a8;letter-spacing:1px">COVEN OF TECHNOLOGY</span>
    </div>
    <div style="line-height:1.7">
      <div style="color:#b3a99d">{{ brand.footerBy }}</div>
      <div style="color:#6b6258">{{ brand.copyright }}</div>
    </div>
  </footer>
</div>
</sc-if>`;
---

<BaseLayout title="Coven of Technology">
  <Fragment set:html={landingHtml} />
</BaseLayout>
