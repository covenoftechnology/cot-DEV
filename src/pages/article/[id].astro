---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.status === 'published');
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const authorInitial = post.data.author.charAt(0).toUpperCase();
const tagDisplay = post.data.tags.join(' · ').toUpperCase();
---

<BaseLayout title={`Coven of Technology — ${post.data.title}`}>
  <div style="position:relative;overflow:hidden;background:radial-gradient(1100px 640px at 50% -14%,rgba(124,77,196,.40),transparent 58%),radial-gradient(720px 520px at 16% 2%,rgba(86,58,150,.32),transparent 60%),radial-gradient(640px 460px at 86% 10%,rgba(170,128,224,.24),transparent 62%),#08060e">
    <div style="position:absolute;top:64px;left:0;right:0;height:300px;z-index:0;pointer-events:none">
      <div style="position:absolute;top:60px;right:7%;width:50px;height:50px;border-radius:50%;background:radial-gradient(circle at 38% 36%,#efe7d2,#cdbfae 58%,#6f6450);box-shadow:0 0 40px rgba(214,208,236,.38),inset -7px -5px 12px rgba(40,30,60,.55);opacity:.4;animation:covFloat 9s ease-in-out infinite"></div>
      <div style="position:absolute;top:44px;left:9%;width:3px;height:3px;border-radius:50%;background:#c9b8ff;box-shadow:0 0 10px 2px rgba(201,184,255,.7);animation:covTwinkle 4s infinite"></div>
      <div style="position:absolute;top:120px;left:13%;width:2px;height:2px;border-radius:50%;background:#e8cf95;box-shadow:0 0 8px 2px rgba(232,207,149,.5);animation:covTwinkle 3.4s .6s infinite"></div>
      <div style="position:absolute;top:170px;right:11%;width:3px;height:3px;border-radius:50%;background:#d6d0ec;box-shadow:0 0 9px 2px rgba(214,208,236,.6);animation:covTwinkle 5s .3s infinite"></div>
    </div>

    <header class="cov-header cov-section-pad" style="display:flex;align-items:center;justify-content:space-between;padding:18px 48px;border-bottom:1px solid rgba(216,181,107,.12);position:relative;z-index:10;flex-wrap:wrap;gap:12px">
      <div onclick="{{ toLanding }}" class="cov-brand" style="display:flex;align-items:center;gap:13px;cursor:pointer">
        <div class="cov-brand-logo" style="width:36px;height:36px;border-radius:50%;border:1px solid #d8b56b;display:flex;align-items:center;justify-content:center;color:#d8b56b;font-size:16px;background:#0b0a0e;box-shadow:inset 0 0 12px rgba(216,181,107,.18)">✶</div>
        <div class="cov-brand-text" style="font-family:Cinzel,serif;font-size:14px;font-weight:600;letter-spacing:2px;color:#ece6dd">{"{{ brand.name }}"}</div>
      </div>
      <div style="font-family:'EB Garamond',serif;font-size:13px;color:#8f857a;max-width:100%">
        <span onclick="{{ toLibrary }}" style="cursor:pointer">The Grimoire</span> / {post.data.category} / <span style="color:#c5b9a8">{post.data.title}</span>
      </div>
      <div style="font-family:'EB Garamond',serif;font-size:13px;color:#e8cf95;border:1px solid rgba(216,181,107,.3);padding:7px 14px;border-radius:4px;white-space:nowrap">✦ 120 Aether on completion</div>
    </header>

    <div style="height:4px;background:rgba(216,181,107,.1);position:relative;z-index:1">
      <div style="width:65%;height:100%;background:linear-gradient(90deg,#c49a4e,#e3c47e)"></div>
    </div>

    <!-- ARTICLE CONTENT -->
    <div class="cov-section-pad" style="max-width:820px;margin:0 auto;padding:56px 48px 64px;position:relative;z-index:1">
      <div style="display:inline-block;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:1.5px;color:#b98fd8;border:1px solid rgba(185,143,216,.32);border-radius:2px;padding:5px 10px;margin-bottom:22px">{tagDisplay}</div>
      <h1 style="font-family:Cinzel,serif;font-weight:700;font-size:clamp(28px,6.5vw,46px);line-height:1.12;color:#f3ecdf;margin:0 0 22px;text-shadow:0 0 40px rgba(139,92,196,.2);word-break:break-word">{post.data.title}</h1>
      <div style="display:flex;align-items:center;gap:14px;margin-bottom:34px;padding-bottom:26px;border-bottom:1px solid rgba(216,181,107,.12);flex-wrap:wrap">
        <div style="width:42px;height:42px;border-radius:50%;background:radial-gradient(circle,#3a2a52,#1a1326);border:1px solid rgba(216,181,107,.4);display:flex;align-items:center;justify-content:center;color:#e8cf95;font-family:Cinzel,serif;flex-shrink:0">{authorInitial}</div>
        <div>
          <div style="font-family:'EB Garamond',serif;font-size:16px;color:#ece6dd">Inscribed by the {post.data.author}</div>
          <div style="font-family:'EB Garamond',serif;font-size:13px;color:#8f857a">12 min read · 4 incantations within</div>
        </div>
      </div>
      <div style="height:clamp(160px,35vw,240px);border-radius:6px;background:repeating-linear-gradient(135deg,rgba(216,181,107,.08) 0 12px,rgba(216,181,107,.02) 12px 24px);border:1px solid rgba(216,181,107,.14);display:flex;align-items:center;justify-content:center;font-family:'IBM Plex Mono',monospace;font-size:12px;color:#8a7f70;margin-bottom:40px">[ illustration · 1280×640 ]</div>
      
      <div class="article-markdown-body">
        <Content />
      </div>
    </div>

    <div class="cov-banner" style="margin:0 auto 48px;max-width:820px;border:1px solid rgba(216,181,107,.18);border-radius:8px;padding:36px;text-align:center;background:radial-gradient(500px 200px at 50% 0%,rgba(139,92,196,.18),transparent 65%),#100d16;position:relative;z-index:1">
      <h3 style="font-family:Cinzel,serif;font-weight:600;font-size:26px;color:#f3ecdf;margin:0 0 8px">You've reached the trial</h3>
      <p style="font-family:'EB Garamond',serif;font-size:16px;color:#b3a99d;margin:0 0 24px">Prove your mastery to claim ✦ 120 Aether and advance toward Mechanic.</p>
      <div onclick="{{ startTrial }}" style="display:inline-block;padding:14px 32px;border-radius:3px;background:linear-gradient(180deg,#e3c47e,#c49a4e);color:#221809;font-family:Cinzel,serif;font-weight:600;font-size:14px;letter-spacing:1.5px;box-shadow:0 0 30px rgba(216,181,107,.34);cursor:pointer;max-width:100%">BEGIN THE TRIAL</div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .article-markdown-body p {
    font-family: 'EB Garamond', serif;
    font-size: 19px;
    line-height: 1.75;
    color: #cdc3b6;
    margin: 0 0 24px;
  }
  .article-markdown-body h2 {
    font-family: Cinzel, serif;
    font-weight: 600;
    font-size: clamp(22px, 5vw, 26px);
    color: #ece6dd;
    margin: 38px 0 16px;
  }
  .article-markdown-body blockquote {
    border-left: 2px solid #d8b56b;
    padding: 6px 0 6px 24px;
    margin: 32px 0;
    background: linear-gradient(90deg, rgba(216, 181, 107, 0.06), transparent);
  }
  .article-markdown-body blockquote p {
    font-family: 'EB Garamond', serif;
    font-style: italic;
    font-size: clamp(17px, 4vw, 21px);
    line-height: 1.5;
    color: #e8cf95;
    margin: 0;
  }
  .article-markdown-body pre {
    background: #100d15 !important;
    border: 1px solid rgba(216, 181, 107, 0.16);
    border-radius: 6px;
    padding: clamp(14px, 3vw, 22px) clamp(16px, 3vw, 24px);
    margin: 28px 0;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13px;
    line-height: 1.7;
    color: #cbbfae;
    overflow-x: auto !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
  }
  .article-markdown-body pre code {
    background: transparent !important;
    padding: 0;
    border: none;
    font-family: inherit;
    font-size: inherit;
    color: inherit;
    white-space: pre;
    word-break: normal;
  }
</style>
