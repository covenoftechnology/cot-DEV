        // Elevate itemEl into floating absolute overlay
        itemEl.classList.add('is-focused-editor');
        itemEl.style.position = 'absolute';
        itemEl.style.gridColumn = 'auto';
        itemEl.style.gridRow = 'auto';
        itemEl.style.top = anchorTop + 'px';
        itemEl.style.left = leftPos + 'px';
        itemEl.style.width = targetWidth + 'px';
        itemEl.style.zIndex = '100';
        itemEl.style.width = targetWidth + 'px';
        itemEl.style.zIndex = '100';

        var btn = itemEl.querySelector('[data-act="toggle-focus"]');
        if (btn) {
