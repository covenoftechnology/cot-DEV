                return;
              }

              colPanel.classList.add('drag-over');

              var currentChildCards = Array.from(colBlocksContainer.querySelectorAll(':scope > .block-editor-card'));
              if (currentChildCards.length === 0) {
                var emptyDz = colBlocksContainer.querySelector('.studio-flex-empty-dropzone');
                if (emptyDz) emptyDz.classList.add('drag-over');
                return;
              }

              var mouseY = e.clientY;
              var targetCard = null;
              var insertAbove = true;

              for (var i = 0; i < currentChildCards.length; i++) {
                var r = currentChildCards[i].getBoundingClientRect();
                var mid = r.top + r.height / 2;
                if (mouseY < mid) {
                  targetCard = currentChildCards[i];
                  insertAbove = true;
                  break;
                }
                if (i === currentChildCards.length - 1) {
                  targetCard = currentChildCards[i];
                  insertAbove = false;
                }
              }

              currentChildCards.forEach(function(c) {
                c.classList.remove('drag-target-above', 'drag-target-below');
              });

              if (targetCard) {
                targetCard.classList.add(insertAbove ? 'drag-target-above' : 'drag-target-below');
              }
            });

            colPanel.addEventListener('dragleave', function(e) {
              if (e.relatedTarget && colPanel.contains(e.relatedTarget)) {
                return;
              }
              colPanel.classList.remove('drag-over', 'drag-target-forbidden');
              var emptyDz = colBlocksContainer.querySelector('.studio-flex-empty-dropzone');
              if (emptyDz) emptyDz.classList.remove('drag-over', 'drag-target-forbidden');
              colBlocksContainer.querySelectorAll(':scope > .block-editor-card').forEach(function(c) {
                c.classList.remove('drag-target-above', 'drag-target-below', 'drag-target-forbidden');
              });
            });

            colPanel.addEventListener('drop', function(e) {
              e.preventDefault();
              e.stopPropagation();

              colPanel.classList.remove('drag-over', 'drag-target-forbidden');
              var emptyDz = colBlocksContainer.querySelector('.studio-flex-empty-dropzone');
              if (emptyDz) emptyDz.classList.remove('drag-over', 'drag-target-forbidden');

              if (isDraggingFlexLayout()) return;

              var currentChildCards = Array.from(colBlocksContainer.querySelectorAll(':scope > .block-editor-card'));
              var insertIdx = 0;

              if (currentChildCards.length > 0) {
                var mouseY = e.clientY;
                insertIdx = currentChildCards.length;

                for (var i = 0; i < currentChildCards.length; i++) {
                  var r = currentChildCards[i].getBoundingClientRect();
                  var mid = r.top + r.height / 2;
                  if (mouseY < mid) {
                    insertIdx = i;
                    break;
                  }
                }

                currentChildCards.forEach(function(c) {
                  c.classList.remove('drag-target-above', 'drag-target-below', 'drag-target-forbidden');
                });
              }

              handleBlockDrop(e, {
                type: 'flex-col',
                secId: sec.id,
                flexBlockId: b.id,
                colId: col.id,
                colIdx: cIdx,
                insertIdx: insertIdx
              });
            });
          });
        }

        // Special Container Handling for Composable Callout Advisory V2
        if (b.type === 'callout') {
          var calloutPanel = bBody.querySelector('.studio-callout-blocks-panel[data-callout-id="' + b.id + '"]');
          var calloutBlocksContainer = bBody.querySelector('.studio-callout-blocks[data-callout-id="' + b.id + '"]');
          var upgradeBtn = bBody.querySelector('[data-act="callout-upgrade-composable"]');
          var addTextBtn = bBody.querySelector('[data-act="callout-add-text"]');

          if (upgradeBtn) {
            upgradeBtn.addEventListener('click', function(e) {
              e.stopPropagation();
              var richPara = getRichData(b.data.text !== undefined ? b.data.text : b.data.body);
              b.data.blocks = [
                {
                  id: uid('blk'),
                  type: 'solo-text',
                  data: {
                    paragraphs: [richPara]
                  }
                }
              ];
              b.data.text = { text: '', align: 'left' };
              delete b.data.body;
              renderSections();
              triggerAutosave();
              showToast('Upgraded Callout to composable blocks');
            });
          }

          if (addTextBtn) {
            addTextBtn.addEventListener('click', function(e) {
              e.stopPropagation();
              if (!Array.isArray(b.data.blocks)) b.data.blocks = [];
              b.data.blocks.push({
                id: uid('blk'),
                type: 'solo-text',
                data: { paragraphs: [{ text: '', align: 'left' }] }
              });
              renderSections();
              triggerAutosave();
              showToast('Added Solo Text to Callout');
            });
          }

          if (calloutBlocksContainer && calloutPanel) {
            calloutBlocksContainer.innerHTML = '';
            var calloutChildBlocks = Array.isArray(b.data.blocks) ? b.data.blocks : [];

            if (calloutChildBlocks.length === 0) {
              var emptyDropzone = document.createElement('div');
              emptyDropzone.className = 'studio-callout-empty-dropzone';
              emptyDropzone.innerHTML =
                '<div class="callout-empty-icon">✧</div>' +
                '<div class="callout-empty-title">Drop Coven blocks here</div>' +
                '<div class="callout-empty-sub">Solo Text, Nested Bullets, Image, Table... Drag from Block Library or existing blocks</div>';
              calloutBlocksContainer.appendChild(emptyDropzone);
            } else {
              calloutChildBlocks.forEach(function(cb, cbIndex) {
                var childCard = createBlockCardElement(sec, cb, cbIndex, calloutChildBlocks.length, {
                  isCalloutChild: true,
                  calloutBlockId: b.id
                });
                calloutBlocksContainer.appendChild(childCard);
              });
            }

            // UNIFIED CALLOUT DRAG & DROP HANDLERS
            calloutPanel.addEventListener('dragover', function(e) {
              e.preventDefault();
              e.stopPropagation();
              bCard.classList.remove('drag-target-above', 'drag-target-below', 'drag-target-forbidden');

              if (isDraggingForbiddenInCallout()) {
                calloutPanel.classList.add('drag-target-forbidden');
                e.dataTransfer.dropEffect = 'none';
                return;
              }

              calloutPanel.classList.add('drag-over');

              var currentChildCards = Array.from(calloutBlocksContainer.querySelectorAll(':scope > .block-editor-card'));
              if (currentChildCards.length === 0) {
                var emptyDz = calloutBlocksContainer.querySelector('.studio-callout-empty-dropzone');
                if (emptyDz) emptyDz.classList.add('drag-over');
                return;
              }

              var mouseY = e.clientY;
              var targetCard = null;
              var insertAbove = true;

              for (var i = 0; i < currentChildCards.length; i++) {
                var r = currentChildCards[i].getBoundingClientRect();
                var mid = r.top + r.height / 2;
                if (mouseY < mid) {
                  targetCard = currentChildCards[i];
                  insertAbove = true;
                  break;
                }
                if (i === currentChildCards.length - 1) {
                  targetCard = currentChildCards[i];
                  insertAbove = false;
                }
              }

              currentChildCards.forEach(function(c) {
                c.classList.remove('drag-target-above', 'drag-target-below');
              });

              if (targetCard) {
                targetCard.classList.add(insertAbove ? 'drag-target-above' : 'drag-target-below');
              }
            });

            calloutPanel.addEventListener('dragleave', function(e) {
              if (e.relatedTarget && calloutPanel.contains(e.relatedTarget)) {
                return;
              }
              calloutPanel.classList.remove('drag-over', 'drag-target-forbidden');
              var emptyDz = calloutBlocksContainer.querySelector('.studio-callout-empty-dropzone');
              if (emptyDz) emptyDz.classList.remove('drag-over', 'drag-target-forbidden');
              calloutBlocksContainer.querySelectorAll(':scope > .block-editor-card').forEach(function(c) {
                c.classList.remove('drag-target-above', 'drag-target-below', 'drag-target-forbidden');
              });
            });

            calloutPanel.addEventListener('drop', function(e) {
              e.preventDefault();
              e.stopPropagation();

              calloutPanel.classList.remove('drag-over', 'drag-target-forbidden');
              var emptyDz = calloutBlocksContainer.querySelector('.studio-callout-empty-dropzone');
              if (emptyDz) emptyDz.classList.remove('drag-over', 'drag-target-forbidden');

              if (isDraggingForbiddenInCallout()) {
                showToast('This block type cannot be nested inside Callout Advisory.', 'error');
                return;
              }

              var currentChildCards = Array.from(calloutBlocksContainer.querySelectorAll(':scope > .block-editor-card'));
              var insertIdx = 0;

              if (currentChildCards.length > 0) {
                var mouseY = e.clientY;
                insertIdx = currentChildCards.length;

                for (var i = 0; i < currentChildCards.length; i++) {
                  var r = currentChildCards[i].getBoundingClientRect();
                  var mid = r.top + r.height / 2;
                  if (mouseY < mid) {
                    insertIdx = i;
                    break;
                  }
                }

                currentChildCards.forEach(function(c) {
                  c.classList.remove('drag-target-above', 'drag-target-below', 'drag-target-forbidden');
                });
              }

              handleBlockDrop(e, {
                type: 'callout',
                secId: sec.id,
                calloutBlockId: b.id,
                insertIdx: insertIdx
              });
            });
          }
        }

        bCard.appendChild(bHeader);
        bCard.appendChild(bBody);
        return bCard;
      }

      function handleBlockDrop(e, target) {
        try {
          var payloadStr = (e.dataTransfer && e.dataTransfer.getData('text/plain')) || '{}';
          var payload = null;
          try { payload = JSON.parse(payloadStr); } catch (pErr) {}
          if (!payload || !payload.source) payload = draggedBlockData;
          if (!payload || !payload.source) return;

          var targetSecId, targetFlexBlockId, targetColId, targetColIdx, targetCalloutBlockId, insertIdx, isFlexTarget, isCalloutTarget;
          if (typeof target === 'object' && target !== null) {
            isFlexTarget = target.type === 'flex-col';
            isCalloutTarget = target.type === 'callout';
            targetSecId = target.secId;
            targetFlexBlockId = target.flexBlockId;
            targetColId = target.colId;
            targetColIdx = target.colIdx;
            targetCalloutBlockId = target.calloutBlockId;
            insertIdx = target.insertIdx;
          } else {
            targetSecId = arguments[1];
            insertIdx = arguments[2];
            isFlexTarget = false;
            isCalloutTarget = false;
          }

          var draggedType = payload.type || payload.blockType || '';
          if (payload.source === 'block' && !draggedType && payload.blockId) {
            var srcB = findBlockById(payload.blockId);
            if (srcB) draggedType = srcB.type;
          }

          // STRICT CHECK: Forbid flex-layout inside flex-col
          if (isFlexTarget) {
            if (!canNestInFlexLayout(draggedType)) {
              showToast('Flexible Layout cannot be nested inside another Flexible Layout.', 'error');
              return;
            }
          }

          // STRICT CHECK: Centralized Callout nesting eligibility
          if (isCalloutTarget) {
            if (!canNestInCallout(draggedType)) {
              showToast('This block type cannot be nested inside Callout Advisory.', 'error');
              return;
            }
          }

          var targetSec = currentDoc.sections.find(function(s) { return s.id === targetSecId; });
          if (!targetSec) return;

          var targetArray;
          if (isFlexTarget) {
            var flexBlock = targetSec.blocks.find(function(b) { return b.id === targetFlexBlockId; });
            if (!flexBlock || flexBlock.type !== 'flex-layout') return;
            var col = (flexBlock.data.columns || []).find(function(c) { return c.id === targetColId; });
            if (!col && typeof targetColIdx === 'number' && flexBlock.data.columns && flexBlock.data.columns[targetColIdx]) {
              col = flexBlock.data.columns[targetColIdx];
            }
            if (!col) return;
            if (!Array.isArray(col.blocks)) col.blocks = [];
            targetArray = col.blocks;
          } else if (isCalloutTarget) {
            var calloutLoc = resolveBlockLocation(targetCalloutBlockId);
            var calloutBlock = calloutLoc ? calloutLoc.block : targetSec.blocks.find(function(b) { return b.id === targetCalloutBlockId; });
            if (!calloutBlock || calloutBlock.type !== 'callout') return;
            if (!Array.isArray(calloutBlock.data.blocks)) calloutBlock.data.blocks = [];
            targetArray = calloutBlock.data.blocks;
          } else {
            targetArray = targetSec.blocks;
          }

          if (payload.source === 'library') {
            var def = window.STUDIO_REGISTRY[payload.type];
            if (!def) return;

            var newBlock = {
              id: uid('blk'),
              type: payload.type,
              data: JSON.parse(JSON.stringify(def.defaultData))
            };
            if ((payload.type === 'text-image' || payload.type === 'image-text') && !newBlock.data.paragraphs) {
              newBlock.data.paragraphs = [{ text: '', align: 'left' }];
            }
            if (payload.type === 'flex-layout') {
              newBlock.data.columns = [
                { id: uid('fcol'), blocks: [] },
                { id: uid('fcol'), blocks: [] }
              ];
            }
            if (payload.type === 'callout') {
              newBlock.data.blocks = [
                {
                  id: uid('blk'),
                  type: 'solo-text',
                  data: { paragraphs: [{ text: '', align: 'left' }] }
                }
              ];
            }
            if (insertIdx !== undefined && insertIdx >= 0 && insertIdx <= targetArray.length) {
              targetArray.splice(insertIdx, 0, newBlock);
            } else {
              targetArray.push(newBlock);
            }
            normalizeDocument(currentDoc);
            activeSectionId = targetSec.id;
            renderSections();
            triggerAutosave();
            showToast('Inserted block: ' + def.label);
          } else if (payload.source === 'block') {
            var srcSec = currentDoc.sections.find(function(s) { return s.id === payload.secId; });
            if (!srcSec) return;

            var movedBlock = null;
            if (payload.calloutBlockId) {
              var srcCalloutLoc = resolveBlockLocation(payload.calloutBlockId);
              var srcCallout = srcCalloutLoc ? srcCalloutLoc.block : srcSec.blocks.find(function(b) { return b.id === payload.calloutBlockId; });
              if (srcCallout && srcCallout.type === 'callout' && srcCallout.data && Array.isArray(srcCallout.data.blocks)) {
                var cbIdx = srcCallout.data.blocks.findIndex(function(b) { return b.id === payload.blockId; });
                if (cbIdx !== -1) {
                  movedBlock = srcCallout.data.blocks.splice(cbIdx, 1)[0];
                  if (targetArray === srcCallout.data.blocks && cbIdx < insertIdx) {
                    insertIdx--;
                  }
                }
              }
            } else if (payload.flexBlockId) {
              var srcFlex = srcSec.blocks.find(function(b) { return b.id === payload.flexBlockId; });
              if (srcFlex && srcFlex.type === 'flex-layout') {
                var srcCol = (srcFlex.data.columns || []).find(function(c) { return c.id === payload.colId; });
                if (!srcCol && typeof payload.colIdx === 'number' && srcFlex.data.columns && srcFlex.data.columns[payload.colIdx]) {
                  srcCol = srcFlex.data.columns[payload.colIdx];
                }
                if (srcCol && Array.isArray(srcCol.blocks)) {
                  var bIdx = srcCol.blocks.findIndex(function(b) { return b.id === payload.blockId; });
                  if (bIdx !== -1) {
                    movedBlock = srcCol.blocks.splice(bIdx, 1)[0];
                    if (targetArray === srcCol.blocks && bIdx < insertIdx) {
                      insertIdx--;
                    }
                  }
                }
              }
            } else {
              var bIdx = srcSec.blocks.findIndex(function(b) { return b.id === payload.blockId; });
              if (bIdx !== -1) {
                movedBlock = srcSec.blocks.splice(bIdx, 1)[0];
                if (targetArray === srcSec.blocks && bIdx < insertIdx) {
                  insertIdx--;
                }
              }
            }

            // Resilient fallback using resolveBlockLocation if not found in primary path
            if (!movedBlock) {
              var loc = resolveBlockLocation(payload.blockId);
              if (loc) {
                if (loc.parentType === 'callout') {
                  var pCalloutLoc = resolveBlockLocation(loc.parentBlockId);
                  var pCallout = pCalloutLoc ? pCalloutLoc.block : null;
                  if (pCallout && pCallout.data && Array.isArray(pCallout.data.blocks)) {
                    var idx = pCallout.data.blocks.findIndex(function(b) { return b.id === payload.blockId; });
                    if (idx !== -1) {
                      movedBlock = pCallout.data.blocks.splice(idx, 1)[0];
                      if (targetArray === pCallout.data.blocks && idx < insertIdx) insertIdx--;
                    }
                  }
                } else if (loc.parentType === 'flex-col') {
                  var sFlex = loc.section.blocks.find(function(b) { return b.id === loc.parentBlockId; });
                  if (sFlex && sFlex.data && Array.isArray(sFlex.data.columns)) {
                    var sCol = sFlex.data.columns.find(function(c) { return c.id === loc.columnId; });
                    if (sCol && Array.isArray(sCol.blocks)) {
                      var idx = sCol.blocks.findIndex(function(b) { return b.id === payload.blockId; });
                      if (idx !== -1) {
                        movedBlock = sCol.blocks.splice(idx, 1)[0];
                        if (targetArray === sCol.blocks && idx < insertIdx) insertIdx--;
                      }
                    }
                  }
                } else if (loc.parentType === 'section') {
                  var idx = loc.section.blocks.findIndex(function(b) { return b.id === payload.blockId; });
                  if (idx !== -1) {
                    movedBlock = loc.section.blocks.splice(idx, 1)[0];
                    if (targetArray === loc.section.blocks && idx < insertIdx) insertIdx--;
                  }
                }
              }
            }

            if (!movedBlock) return;

            if (insertIdx !== undefined && insertIdx >= 0 && insertIdx <= targetArray.length) {
              targetArray.splice(insertIdx, 0, movedBlock);
            } else {
              targetArray.push(movedBlock);
            }

            activeSectionId = targetSec.id;
            renderSections();
            triggerAutosave();
            showToast('Block moved');
          }
        } catch (err) {
          console.error('handleBlockDrop error:', err);
        } finally {
          draggedBlockData = null;
          stopDragAutoScroll();
        }
      }

      // Trailing Add Section Event
      document.getElementById('btn-add-section-trailing').addEventListener('click', function() {
        addSection();
      });

      // ── Settings Sync ───────────────────────────────────
      function syncMetaInputsFromState() {
        var m = currentDoc.meta;
        document.getElementById('meta-title').value = m.title || '';
        document.getElementById('meta-desc').value = m.description || '';
        document.getElementById('meta-author').value = m.author || 'Oracle of Orgs';

        // Category
        var catVal = m.category || 'Salesforce';
        document.getElementById('meta-category').value = catVal;
        document.getElementById('category-trigger-text').textContent = catVal;

        // Difficulty
        var diffVal = m.difficulty || 'Lv. 1 - Incantation';
        document.getElementById('meta-difficulty').value = diffVal;
        var diffGlyph = (window.STUDIO_DIFFICULTY_GLYPHS || {})[diffVal] || '✦';
        document.getElementById('difficulty-trigger-text').textContent = diffGlyph + ' ' + diffVal;

        // Rank & Advanced
        document.getElementById('meta-rank').value = m.rank || 'Mechanic';
        document.getElementById('meta-aether').value = m.aetherReward || 120;
        document.getElementById('meta-featured').checked = Boolean(m.featured);
        document.getElementById('meta-wide').checked = m.wide !== false;

        // Cover Image Setup
        var coverSrc = m.coverImageSrc || m.cover || '';
        var coverAlt = m.coverImageAlt || m.coverCaption || '';
        var showCover = m.showCoverImageOnArticle !== false;
        m.coverImageSrc = coverSrc;
        m.coverImageAlt = coverAlt;
        m.showCoverImageOnArticle = showCover;
        delete m.cover;
        delete m.coverCaption;

        var altInput = document.getElementById('meta-cover-alt');
        if (altInput) altInput.value = coverAlt;
        var showToggle = document.getElementById('meta-show-cover');
        if (showToggle) showToggle.checked = showCover;
        updateCoverUiState(coverSrc);

        // Slug
        var sVal = currentDoc.slug || '';
        var slugInputEl = document.getElementById('meta-slug');
        slugInputEl.value = sVal;
        document.getElementById('slug-url-preview').textContent = '/article/' + (sVal || 'untitled-scroll');

        // Persisted Article Editing Mode & Slug Lock
        var editingIndicator = document.getElementById('editing-source-indicator');
        var editingTitleSpan = document.getElementById('editing-source-title');
        if (currentDoc.sourceArticleSlug) {
          if (editingIndicator) {
            editingIndicator.style.display = 'inline-flex';
            if (editingTitleSpan) {
              editingTitleSpan.textContent = currentDoc.meta.title || currentDoc.sourceArticleSlug;
            }
          }
          if (slugInputEl) {
            slugInputEl.readOnly = true;
            slugInputEl.style.opacity = '0.6';
            slugInputEl.style.cursor = 'not-allowed';
            slugInputEl.title = 'Slug is locked for persisted articles.';
          }
        } else {
          if (editingIndicator) editingIndicator.style.display = 'none';
          if (slugInputEl) {
            slugInputEl.readOnly = false;
            slugInputEl.style.opacity = '1';
            slugInputEl.style.cursor = 'text';
            slugInputEl.title = '';
          }
        }

        if (isExistingPublished && originalPublishedSlug && originalPublishedSlug !== sVal) {
          document.getElementById('slug-published-warning').style.display = 'block';
        } else {
          document.getElementById('slug-published-warning').style.display = 'none';
        }

        // Status Segmented Control
        var segBtns = document.querySelectorAll('#status-segmented .segment-btn');
        segBtns.forEach(function(btn) {
          if (btn.getAttribute('data-status') === m.status) {
            btn.classList.add('active');
          } else {
            btn.classList.remove('active');
          }
        });
        updatePublishButtonState();

        // Tags
        if (typeof window._renderTagChips === 'function') {
          window._renderTagChips();
        }

        // Reading Time
        calculateReadingTime();
      }

      function syncMetaStateFromInputs() {
