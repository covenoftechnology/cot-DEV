        function migrateV1UnitToBlock(u) {
          if (!u || !u.type) return null;
          if (u.type === 'text') {
            var hasHeading = u.heading && ((typeof u.heading === 'string' && u.heading.trim().length > 0) || (u.heading.text && u.heading.text.trim().length > 0));
            if (hasHeading) {
              return {
