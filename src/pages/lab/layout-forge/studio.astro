      // ── Reading Time Auto Calculator ────────────────────
      function calculateReadingTime() {
        var totalWords = 0;

        function addWords(val) {
          if (!val) return;
          var str = (typeof val === 'object' && val !== null) ? (val.text || val.content || '') : val;
          if (!str || typeof str !== 'string') return;
          var clean = str.replace(/<[^>]*>/g, ' ').trim();
          if (clean) {
            totalWords += clean.split(/\s+/).length;
          }
        }

        addWords(currentDoc.meta.title);
        addWords(currentDoc.meta.description);

        (currentDoc.sections || []).forEach(function(sec) {
          addWords(sec.title);
          addWords(sec.kicker);
          addWords(sec.heading);

          (sec.blocks || []).forEach(function(blk) {
            var d = blk.data || {};
            addWords(d.title);
            addWords(d.heading);
            addWords(d.intro);
            if (blk.type !== 'title-text' || d.showText !== false) {
              addWords(d.text);
              addWords(d.paragraph);
            }
            addWords(d.quote);
            addWords(d.author);
            addWords(d.caption);
            addWords(d.solutionTitle);
            addWords(d.solutionText);
            addWords(d.scenario);
            addWords(d.alt);
            addWords(d.col1Title);
            addWords(d.col1Text);
            addWords(d.col2Title);
            addWords(d.col2Text);
            addWords(d.card1Title);
            addWords(d.card1Desc);
            addWords(d.card2Title);
            addWords(d.card2Desc);
            addWords(d.card3Title);
            addWords(d.card3Desc);
            addWords(d.col1Header);
            addWords(d.col2Header);
            addWords(d.stat1Label);
            addWords(d.stat1Sub);
            addWords(d.stat2Label);
            addWords(d.stat2Sub);
            addWords(d.stat3Label);
            addWords(d.stat3Sub);
            addWords(d.img1Caption);
            addWords(d.img2Caption);
            addWords(d.img3Caption);

            if (Array.isArray(d.col1Items)) {
              d.col1Items.forEach(function(it) { addWords(it.text); });
            }
            if (Array.isArray(d.col2Items)) {
              d.col2Items.forEach(function(it) { addWords(it.text); });
            }

            if (Array.isArray(d.paragraphs)) {
              if (blk.type !== 'title-text' || d.showText !== false) {
                d.paragraphs.forEach(function(p) { addWords(typeof p === 'object' ? p.text : p); });
              }
            }

            if (Array.isArray(d.items)) {
              d.items.forEach(function(it) {
                if (typeof it === 'string') addWords(it);
                else {
                  addWords(it.term);
                  addWords(it.desc);
                  addWords(it.text);
                  addWords(it.question);
                  addWords(it.answer);
                  addWords(it.title);
                  function addNestedChildrenWords(childrenArr) {
                    if (!Array.isArray(childrenArr)) return;
                    childrenArr.forEach(function(c) {
                      if (typeof c === 'string') addWords(c);
                      else if (c && typeof c === "object") {
                        addWords(c.text);
                        if (Array.isArray(c.children)) addNestedChildrenWords(c.children);
                      }
                    });
                  }
                  if (Array.isArray(it.children)) {
                    addNestedChildrenWords(it.children);
                  }
                }
              });
            }

            if (Array.isArray(d.steps)) {
              d.steps.forEach(function(s) {
                addWords(s.title);
                addWords(s.text);
              });
            }

            if (Array.isArray(d.columns)) {
              d.columns.forEach(function(c) {
                addWords(c.title);
                addWords(c.text);
                addWords(c.label);
              });
            }

            if (Array.isArray(d.rows)) {
              d.rows.forEach(function(r) {
                if (r.cells) {
                  Object.values(r.cells).forEach(addWords);
                }
              });
            }

            if (Array.isArray(d.questions)) {
              d.questions.forEach(function(q) {
                addWords(q.question);
                addWords(q.explanation);
                if (Array.isArray(q.answers)) {
                  q.answers.forEach(function(a) { addWords(a.text); });
                }
              });
            }

            if (Array.isArray(d.cards)) {
              d.cards.forEach(function(c) {
                addWords(c.caption);
                addWords(c.alt);
              });
            }

            if (Array.isArray(d.blocks)) {
              d.blocks.forEach(function(cb) {
                var cd = cb.data || {};
                addWords(cd.text);
                addWords(cd.heading);
                if (Array.isArray(cd.paragraphs)) {
                  cd.paragraphs.forEach(function(p) { addWords(typeof p === 'object' ? p.text : p); });
                }
                if (Array.isArray(cd.items)) {
                  cd.items.forEach(function(it) {
                    addWords(typeof it === 'object' ? it.text : it);
                    if (it && Array.isArray(it.children)) {
                      it.children.forEach(function(c) { addWords(typeof c === 'object' ? c.text : c); });
                    }
                  });
                }
                if (Array.isArray(cd.rows)) {
                  cd.rows.forEach(function(r) {
                    if (r.cells) Object.values(r.cells).forEach(addWords);
                  });
                }
              });
            }
          });
        });

        var minutes = Math.max(1, Math.round(totalWords / 200));
        var str = minutes + ' min';
        currentDoc.meta.readingTime = str;

        var el = document.getElementById('reading-time-text');
        if (el) el.textContent = '≈ ' + str;

        return str;
      }

      // ── Image Upload & Reusable Image Picker ────────────
      function uploadImageFile(file, callback) {
        var reader = new FileReader();
        reader.onload = function(evt) {
          fetch('/__uat-article-forge/upload', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ studioId: currentDoc.studioId, filename: file.name, data: evt.target.result })
          })
          .then(function(res) { return res.json(); })
          .then(function(data) {
            if (data.ok && data.url) {
              callback(null, data.url);
              showToast('Image uploaded to UAT: ' + (data.filename || file.name), 'success');
              triggerAutosave();
            } else {
              callback(new Error(data.error || 'Upload failed'));
              showToast(data.error || 'Upload failed', 'error');
            }
          })
          .catch(function(err) {
            callback(err);
            showToast('Upload error: ' + err.message, 'error');
          });
        };
        reader.readAsDataURL(file);
      }

      function openImageUploader(onUploaded) {
        var fileInput = document.createElement('input');
        fileInput.type = 'file';
        fileInput.accept = 'image/*';
        fileInput.style.display = 'none';
        document.body.appendChild(fileInput);

        fileInput.addEventListener('change', function(e) {
          var file = e.target.files[0];
          if (!file) {
            fileInput.remove();
            return;
          }
          showToast('Uploading image...', 'saving');
          uploadImageFile(file, function(err, url) {
            fileInput.remove();
            if (err) {
              showToast('Upload failed: ' + err.message, 'error');
            } else {
              showToast('Image uploaded successfully', 'success');
              onUploaded(url, file.name);
            }
          });
        });

        fileInput.click();
      }

