        if (sEl) {
          if (sEl.value) currentDoc.slug = sEl.value;
          else if (currentDoc.slug) sEl.value = currentDoc.slug;
        }
        var dEl = document.getElementById('meta-desc');
        if (dEl) {
          if (dEl.value) m.description = dEl.value;
          else if (m.description) dEl.value = m.description;
        }
        var aEl = document.getElementById('meta-author');
        if (aEl) {
          if (aEl.value) m.author = aEl.value;
          else if (m.author) aEl.value = m.author;
        }
        var cEl = document.getElementById('meta-category');
        if (cEl) {
          if (cEl.value) m.category = cEl.value;
          else if (m.category) cEl.value = m.category;
          else m.category = 'Salesforce';
        }
        var diffEl = document.getElementById('meta-difficulty');
        if (diffEl) {
          if (diffEl.value) m.difficulty = diffEl.value;
