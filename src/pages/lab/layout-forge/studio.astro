      // ── FOCUS EDITOR AUTHORING STATE (25% Block Comfortable Editor) ──
      var activeFocusedBlock = null;
      window.activeFocusedBlock = null;

      function closeBlockFocusEditor() {
        if (!activeFocusedBlock) return;
        var entry = activeFocusedBlock;
        activeFocusedBlock = null;
        window.activeFocusedBlock = null;

        var itemEl = entry.itemEl;
        var anchorEl = entry.anchorEl;
        var btn = itemEl ? itemEl.querySelector('[data-act="toggle-focus"]') : null;

        if (itemEl) {
          itemEl.classList.remove('is-focused-editor');
          itemEl.style.position = '';
          itemEl.style.gridColumn = (entry.item.columnStart || 1) + ' / span ' + (entry.item.columnSpan || 1);
          itemEl.style.gridRow = (entry.item.rowStart || 1) + ' / span 1';
          itemEl.style.top = '';
          itemEl.style.left = '';
          itemEl.style.width = '';
          itemEl.style.zIndex = '';
        }

        if (anchorEl && anchorEl.parentNode) {
          anchorEl.remove();
        }

        if (btn) {
          btn.innerHTML = '⛶ Edit';
          btn.classList.remove('is-active');
          btn.title = 'Expand to comfortable authoring width (640px)';
        }

        if (entry.canvasEl) {
          entry.canvasEl._cachedRowGeometry = null;
          if (entry.sec && entry.sec.visualGrid) {
            computeCanvasRowGeometry(entry.canvasEl, null, entry.sec.visualGrid.rowGap, entry.sec.visualGrid.minRowHeight);
          }
        }
