                    (isTextShown ? '<span>SHOW TEXT</span><span style="color:var(--studio-gold);font-weight:700">✓</span>' : '<span style="color:var(--studio-text-muted)">SHOW TEXT</span><span style="color:var(--studio-text-muted)">○</span>') +
                  '</button>' +
                '</div>';

            if (isTextShown) {
              html += '<div class="studio-repeatable-list">';
