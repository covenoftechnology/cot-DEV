          if (altGroup) altGroup.style.display = 'flex';
          if (toggleWrap) toggleWrap.style.display = 'flex';
        } else {
          if (previewImg) {
            previewImg.removeAttribute('src');
          }
          if (emptyState) emptyState.style.display = 'flex';
          if (filledState) filledState.style.display = 'none';
          if (altGroup) altGroup.style.display = 'none';
          if (toggleWrap) toggleWrap.style.display = 'none';
        }
      }
      window.updateCoverUiState = updateCoverUiState;

      var btnSelectCover = document.getElementById('btn-select-cover');
      var btnReplaceCover = document.getElementById('btn-replace-cover');
      var btnRemoveCover = document.getElementById('btn-remove-cover');
      var coverFileInput = document.getElementById('cover-file-upload');
      var coverAltInput = document.getElementById('meta-cover-alt');
      var coverShowToggle = document.getElementById('meta-show-cover');
      var coverUploadZone = document.getElementById('cover-upload-zone');

      function openCoverFileChooser() {
        if (coverFileInput) coverFileInput.click();
      }

      if (btnSelectCover) btnSelectCover.addEventListener('click', openCoverFileChooser);
      if (btnReplaceCover) btnReplaceCover.addEventListener('click', openCoverFileChooser);

      function handleCoverFile(file) {
        if (!file) return;
        var ext = '.' + file.name.split('.').pop().toLowerCase();
        var allowed = ['.png', '.jpg', '.jpeg', '.webp', '.gif'];
        if (!allowed.includes(ext)) {
          showToast('Only .png, .jpg, .jpeg, .webp, and .gif images are supported.', 'error');
          return;
        }

        var reader = new FileReader();
        reader.onload = function(evt) {
          fetch('/__uat-article-forge/upload', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ studioId: currentDoc.studioId, filename: file.name, data: evt.target.result })
          })
          .then(function(res) { return res.json(); })
          .then(function(data) {
            if (data.ok && data.url) {
              currentDoc.meta.coverImageSrc = data.url;
              delete currentDoc.meta.cover;
              updateCoverUiState(data.url);
              triggerAutosave();
              showToast('Cover image uploaded: ' + (data.filename || file.name), 'success');
            } else {
              showToast(data.error || 'Failed to upload cover image.', 'error');
            }
          })
          .catch(function(err) {
            showToast('Cover upload error: ' + err.message, 'error');
          });
        };
        reader.readAsDataURL(file);
      }

      if (coverFileInput) {
        coverFileInput.addEventListener('change', function(e) {
          var file = e.target.files && e.target.files[0];
          handleCoverFile(file);
        });
      }

      if (coverUploadZone) {
        coverUploadZone.addEventListener('dragover', function(e) {
          e.preventDefault();
          coverUploadZone.classList.add('dragover');
        });
        coverUploadZone.addEventListener('dragleave', function() {
          coverUploadZone.classList.remove('dragover');
        });
        coverUploadZone.addEventListener('drop', function(e) {
          e.preventDefault();
          coverUploadZone.classList.remove('dragover');
          if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]) {
            handleCoverFile(e.dataTransfer.files[0]);
          }
        });
      }

      if (btnRemoveCover) {
        btnRemoveCover.addEventListener('click', function() {
          currentDoc.meta.coverImageSrc = '';
          currentDoc.meta.coverImageAlt = '';
