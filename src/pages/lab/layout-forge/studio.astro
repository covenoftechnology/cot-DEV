      window.closeBlockFocusEditor = closeBlockFocusEditor;

      function openBlockFocusEditor(sec, item, itemEl, canvasEl) {
        if (!sec || !item || !itemEl) return;

        // If clicking on already open block, toggle it off
        if (activeFocusedBlock && activeFocusedBlock.itemId === item.id) {
          closeBlockFocusEditor();
          return;
        }

        // Close any currently focused block before opening a new one
        if (activeFocusedBlock) {
          closeBlockFocusEditor();
        }

        var cEl = canvasEl || itemEl.closest('.grid-composer-canvas');
        if (!cEl) return;

        // Measure item height before removing from flow
        var origHeight = itemEl.offsetHeight;
        var canvasWidth = cEl.clientWidth;
        var targetWidth = 640;

        var blk = item.block;
        var blkDef = blk ? (window.STUDIO_REGISTRY[blk.type] || { label: blk.type }) : { label: 'Block' };
        var glyph = blk ? (BLOCK_GLYPHS[blk.type] || '✦') : '✧';
        var spanCols = clampVal(item.columnSpan || 1, 1, 4);

        // Create visible anchor placeholder in the original cell
        var anchor = document.createElement('div');
        anchor.className = 'grid-block-anchor';
        anchor.setAttribute('data-anchor-for', item.id);
        anchor.setAttribute('data-col-start', item.columnStart);
        anchor.setAttribute('data-row-start', item.rowStart);
        anchor.style.gridColumn = item.columnStart + ' / span ' + spanCols;
        anchor.style.gridRow = item.rowStart + ' / span 1';
        anchor.style.minHeight = Math.max(120, origHeight) + 'px';
        anchor.innerHTML =
          '<div class="grid-block-anchor-inner">' +
            '<span class="grid-block-anchor-glyph">' + glyph + '</span>' +
            '<span class="grid-block-anchor-text">Editing ' + escapeHtml(item.label || blkDef.label) + ' · 25%</span>' +
            '<span class="grid-block-anchor-hint">Esc or ✕ to close</span>' +
          '</div>';

        anchor.addEventListener('click', function(e) {
          e.stopPropagation();
          closeBlockFocusEditor();
        });

        // Insert anchor directly before itemEl in grid flow
        cEl.insertBefore(anchor, itemEl);

        // Measure true anchor cell geometry in grid flow
        var anchorLeft = anchor.offsetLeft;
        var anchorTop = anchor.offsetTop;
        var anchorWidth = anchor.offsetWidth;

        // Intelligent horizontal positioning:
        // Col 1: expands rightward (left aligns with anchorLeft)
        // Col 4: expands leftward (right edges align)
        // Col 2 & 3: center over anchor
        var leftPos = anchorLeft;
        if (item.columnStart === 1) {
          leftPos = anchorLeft;
        } else if (item.columnStart === 4) {
          leftPos = (anchorLeft + anchorWidth) - targetWidth;
        } else {
          leftPos = anchorLeft + (anchorWidth / 2) - (targetWidth / 2);
        }

        // Clamp inside canvas bounds (16px padding on left and right)
        var minLeft = 16;
        var maxLeft = Math.max(16, canvasWidth - targetWidth - 16);
