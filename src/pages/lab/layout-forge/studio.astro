// ── Phase 5 Modals & Recovery UI ──
      var pendingUnsavedAction = null;
      function checkUnsavedThen(action) {
        if (!isDirty) {
          action();
          return;
        }
        showUnsavedChangesModal(action);
      }

      function showUnsavedChangesModal(action) {
        pendingUnsavedAction = action;
        var modal = document.getElementById('uat-unsaved-modal');
        if (!modal) {
          if (confirm('You have unsaved changes. Discard and proceed?')) action();
          return;
        }
        modal.style.display = 'flex';
      }

      var cancelUnsavedBtn = document.getElementById('btn-cancel-unsaved');
      if (cancelUnsavedBtn) {
        cancelUnsavedBtn.onclick = function() {
          var modal = document.getElementById('uat-unsaved-modal');
          if (modal) modal.style.display = 'none';
          pendingUnsavedAction = null;
        };
      }

      var discardUnsavedBtn = document.getElementById('btn-discard-unsaved');
      if (discardUnsavedBtn) {
        discardUnsavedBtn.onclick = function() {
          var modal = document.getElementById('uat-unsaved-modal');
          if (modal) modal.style.display = 'none';
          if (pendingUnsavedAction) {
            var act = pendingUnsavedAction;
            pendingUnsavedAction = null;
            act();
          }
        };
      }

      function showConflictModal(conflictData) {
        var modal = document.getElementById('uat-conflict-modal');
        if (!modal) {
          alert('Conflict: This draft was updated in another tab.');
          return;
        }
        modal.style.display = 'flex';
        var reloadBtn = document.getElementById('btn-conflict-reload');
        var forceBtn = document.getElementById('btn-conflict-force');
        if (reloadBtn) {
          reloadBtn.onclick = function() {
            modal.style.display = 'none';
            openDraft(currentDoc.studioId);
          };
        }
        if (forceBtn) {
          forceBtn.onclick = function() {
            modal.style.display = 'none';
            currentDoc.revision = conflictData.currentRevision || currentDoc.revision;
            saveDraft(false);
          };
        }
      }

      function showRecoveryBanner(recDoc) {
        var banner = document.getElementById('uat-recovery-banner');
        if (!banner) return;
        banner.style.display = 'flex';
        var titleSpan = document.getElementById('recovery-doc-title');
        if (titleSpan) titleSpan.textContent = recDoc.meta?.title || 'Untitled Scroll';

        var recBtn = document.getElementById('btn-recover-buffer');
        var discBtn = document.getElementById('btn-discard-buffer');
        if (recBtn) {
          recBtn.onclick = function() {
            banner.style.display = 'none';
            normalizeDocument(recDoc);
            currentDoc = recDoc;
            activeSectionId = currentDoc.sections.length > 0 ? currentDoc.sections[0].id : null;
            isDirty = true;
            renderSections();
            syncMetaInputsFromState();
            setStatus('Unsaved', 'dirty');
            showToast('Recovery buffer restored into editor', 'info');
          };
        }
        if (discBtn) {
          discBtn.onclick = function() {
            banner.style.display = 'none';
            sessionStorage.removeItem('covenUatArticleForge:recovery');
            showToast('Recovery buffer discarded', 'info');
          };
        }
      }

      window.addEventListener('beforeunload', function(e) {
        if (isDirty) {
          e.preventDefault();
          e.returnValue = '';
        }
      });

            function removeBlockFromSlot(sec, id) { if (sec && id) deleteGridItem(sec, id, true); }
