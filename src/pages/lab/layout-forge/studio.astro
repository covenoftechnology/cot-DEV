                    '<button type="button" class="studio-btn studio-btn--sm' + (curLayout === 'vertical' ? ' is-active' : '') + '" data-act="set-nested-layout" data-layout="vertical">Vertical</button>' +
                    '<button type="button" class="studio-btn studio-btn--sm' + (curLayout === 'horizontal' ? ' is-active' : '') + '" data-act="set-nested-layout" data-layout="horizontal">Horizontal</button>' +
                  '</div>' +
                '</div>' +
              '</div>' +
              '<div class="studio-form-group"><label class="studio-label">Hierarchical Items</label><div style="display:flex;flex-direction:column;gap:12px">';
            function renderNestedSubItemsRecursive(children, parentId, depth) {
              if (!Array.isArray(children) || depth > MAX_NESTED_LIST_DEPTH) return '';
              var subHtml = '';
              var canAddDeeper = canAddNestedListChild(depth);
              var badgeColor = depth === 2 ? 'var(--studio-purple)' : (depth === 3 ? 'var(--studio-gold-dim)' : 'var(--studio-purple)');
              children.forEach(function(sub) {
                var maxDepthBadge = !canAddDeeper ? '<span class="nested-max-depth-pill" title="Maximum nesting depth (' + MAX_NESTED_LIST_DEPTH + ' levels)">Max depth</span>' : '';
                var subLabel = '<span style="font-family:var(--font-mono);font-size:10px;color:' + badgeColor + '">↳ LEVEL ' + depth + ' · SUB-ITEM</span>' + maxDepthBadge;
                var subRemove = '<button type="button" class="studio-btn studio-btn--icon studio-btn--danger" data-act="del-nested-sub" data-parent-id="' + parentId + '" data-sub-id="' + sub.id + '" data-depth="' + depth + '" title="Delete sub-item">✕</button>';
                var grandChildren = Array.isArray(sub.children) ? sub.children : [];
                subHtml +=
                  '<div class="nested-sub-item-card" data-depth="' + depth + '" data-sub-id="' + sub.id + '" style="margin-bottom:6px">' +
                    renderRichTextFieldHtml(subLabel, 'data-rich-nested-sub="true" data-rich-parent-id="' + parentId + '" data-rich-sub-id="' + sub.id + '" data-nested-depth="' + depth + '"', sub.text, 'Level ' + depth + ' sub-item detail...', subRemove) +
                    (canAddDeeper ? (
