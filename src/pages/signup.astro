---
import BaseLayout from '../layouts/BaseLayout.astro';

const signupHtml = `<!-- ═══════════════════════════════════════════════════════════════
  SIGNUP  —  edit form copy and path options directly below
════════════════════════════════════════════════════════════════ -->
<sc-if value="{{ isSignup }}" hint-placeholder-val="{{ true }}">
<div class="cov-signup-container" style="display:flex;overflow:hidden;background:#0b0a0e;min-height:680px">
  <div class="cov-signup-left" style="width:46%;padding:52px 46px;position:relative;background:radial-gradient(800px 600px at 30% 16%,rgba(124,77,196,.42),transparent 60%),radial-gradient(520px 440px at 78% 88%,rgba(170,128,224,.18),transparent 60%),radial-gradient(440px 380px at 60% 48%,rgba(86,58,150,.26),transparent 62%),#0c0817;border-right:1px solid rgba(216,181,107,.12);display:flex;flex-direction:column;justify-content:space-between">
    <div style="position:absolute;top:64px;right:48px;width:54px;height:54px;border-radius:50%;background:radial-gradient(circle at 38% 36%,#efe7d2,#cdbfae 58%,#6f6450);box-shadow:0 0 44px rgba(214,208,236,.4),inset -8px -6px 14px rgba(40,30,60,.55);opacity:.5;animation:covFloat 9s ease-in-out infinite"></div>
    <div style="position:absolute;top:150px;right:70px;width:4px;height:4px;border-radius:50%;background:#e8cf95;box-shadow:0 0 12px 2px rgba(232,207,149,.6);animation:covTwinkle 3s infinite"></div>
    <div style="position:absolute;top:210px;left:70px;width:3px;height:3px;border-radius:50%;background:#b98fd8;box-shadow:0 0 12px 2px rgba(185,143,216,.6);animation:covTwinkle 4s .6s infinite"></div>
    <div onclick="{{ toLanding }}" style="display:flex;align-items:center;gap:13px;cursor:pointer;margin-bottom:28px">
      <div style="width:40px;height:40px;border-radius:50%;border:1px solid #d8b56b;display:flex;align-items:center;justify-content:center;color:#d8b56b;font-size:18px;background:#0b0a0e;box-shadow:inset 0 0 12px rgba(216,181,107,.2)">✶</div>
      <div style="font-family:Cinzel,serif;font-size:14px;font-weight:600;letter-spacing:2px;color:#ece6dd">{{ brand.name }}</div>
    </div>
    <div style="margin-bottom:28px">
      <h2 style="font-family:Cinzel,serif;font-weight:700;font-size:clamp(26px, 5vw, 38px);line-height:1.15;color:#f3ecdf;margin:0 0 18px;text-shadow:0 0 38px rgba(139,92,196,.28)">Take your place in the circle.</h2>
      <p style="font-family:'EB Garamond',serif;font-size:18px;line-height:1.6;color:#b3a99d;margin:0 0 30px">Every scroll you complete and every trial you pass earns Aether — climb from Novice to Archmage alongside the coven.</p>
      <div style="flex-direction:column;gap:14px;display:flex">
        <div style="display:flex;align-items:center;gap:14px;font-family:'EB Garamond',serif;font-size:16px;color:#cdc3b6"><span style="color:#d8b56b;font-size:18px">✧</span> 128 scrolls on Salesforce, mentorship &amp; BA</div>
        <div style="display:flex;align-items:center;gap:14px;font-family:'EB Garamond',serif;font-size:16px;color:#cdc3b6"><span style="color:#d8b56b;font-size:18px">✦</span> Earn Aether, ranks &amp; roles as you learn</div>
        <div style="display:flex;align-items:center;gap:14px;font-family:'EB Garamond',serif;font-size:16px;color:#cdc3b6"><span style="color:#d8b56b;font-size:18px">★</span> Climb the coven leaderboard</div>
      </div>
    </div>
    <div style="font-family:'EB Garamond',serif;font-style:italic;font-size:15px;color:#8f857a">"I came to learn Apex and stayed for the coven." — Lyra, Witch</div>
  </div>
  <div class="cov-signup-right" style="flex:1;padding:56px 56px;display:flex;flex-direction:column;justify-content:center">
    <div style="font-family:'EB Garamond',serif;letter-spacing:4px;text-transform:uppercase;font-size:12px;color:#b98fd8;margin-bottom:12px">☽ Begin your initiation</div>
    <h1 style="font-family:Cinzel,serif;font-weight:700;font-size:clamp(26px, 5vw, 34px);color:#f3ecdf;margin:0 0 30px">Join the Coven</h1>
    <label style="font-family:'EB Garamond',serif;font-size:14px;color:#9b9189;letter-spacing:.5px;display:block;margin-bottom:7px">Your coven name</label>
    <div style="border:1px solid rgba(216,181,107,.24);border-radius:6px;padding:14px 16px;margin-bottom:20px;font-family:'EB Garamond',serif;font-size:16px;color:#6b6258;background:#100d15;max-width:100%;box-sizing:border-box">Morgaine the Curious</div>
    <label style="font-family:'EB Garamond',serif;font-size:14px;color:#9b9189;letter-spacing:.5px;display:block;margin-bottom:7px">Email</label>
    <div style="border:1px solid rgba(216,181,107,.24);border-radius:6px;padding:14px 16px;margin-bottom:20px;font-family:'EB Garamond',serif;font-size:16px;color:#6b6258;background:#100d15;max-width:100%;box-sizing:border-box">you@example.com</div>
    <label style="font-family:'EB Garamond',serif;font-size:14px;color:#9b9189;letter-spacing:.5px;display:block;margin-bottom:7px">Password</label>
    <div style="border:1px solid rgba(216,181,107,.24);border-radius:6px;padding:14px 16px;margin-bottom:24px;font-family:'EB Garamond',serif;font-size:16px;color:#6b6258;background:#100d15;display:flex;justify-content:space-between;max-width:100%;box-sizing:border-box"><span>••••••••••</span><span style="color:#8f857a">◡</span></div>
    <label style="font-family:'EB Garamond',serif;font-size:14px;color:#9b9189;letter-spacing:.5px;display:block;margin-bottom:10px">Choose your first path</label>
    <div style="display:flex;gap:10px;margin-bottom:30px;flex-wrap:wrap">
      <div style="flex:1;min-width:90px;text-align:center;padding:14px 8px;border-radius:6px;border:1px solid #d8b56b;background:linear-gradient(180deg,rgba(216,181,107,.14),rgba(139,92,196,.08));font-family:'EB Garamond',serif;font-size:14px;color:#f3ecdf;cursor:pointer">⚡ Salesforce</div>
      <div style="flex:1;min-width:90px;text-align:center;padding:14px 8px;border-radius:6px;border:1px solid rgba(216,181,107,.2);font-family:'EB Garamond',serif;font-size:14px;color:#c5b9a8;cursor:pointer">☽ Mentorship</div>
      <div style="flex:1;min-width:90px;text-align:center;padding:14px 8px;border-radius:6px;border:1px solid rgba(216,181,107,.2);font-family:'EB Garamond',serif;font-size:14px;color:#c5b9a8;cursor:pointer">✷ Analysis</div>
    </div>
    <div onclick="{{ login }}" style="text-align:center;padding:15px;border-radius:4px;background:linear-gradient(180deg,#e3c47e,#c49a4e);color:#221809;font-family:Cinzel,serif;font-weight:600;font-size:14px;letter-spacing:1.5px;box-shadow:0 0 30px rgba(216,181,107,.32);margin-bottom:18px;cursor:pointer">SPEAK THE OATH — JOIN FREE</div>
    <div style="text-align:center;font-family:'EB Garamond',serif;font-size:15px;color:#8f857a">Already of the coven? <span onclick="{{ login }}" style="color:#e8cf95;cursor:pointer">Sign in</span></div>
  </div>
</div>
</sc-if>`;
---

<BaseLayout title="Coven of Technology — Join the Coven">
  <Fragment set:html={signupHtml} />
</BaseLayout>
