---
import { getCollection } from 'astro:content';
import '../styles/styles.css';

interface Props {
  title?: string;
}

const { title = "Coven of Technology" } = Astro.props;

const allBlogPosts = await getCollection('blog', ({ data }) => data.status === 'published');
const blogArticlesMeta = Object.fromEntries(allBlogPosts.map(p => [p.id, {
  id: p.id,
  title: p.data.title,
  tag: (p.data.tags && p.data.tags.length > 0) ? p.data.tags[0].toUpperCase() : (p.data.category || '').toUpperCase(),
  thumbBg: p.data.thumbBg || 'repeating-linear-gradient(135deg,rgba(216,181,107,.08) 0 10px,rgba(216,181,107,.02) 10px 20px)'
}]));
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>

  <!-- Google Fonts prefetch -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />

  <!-- Articles metadata index from Content Collections -->
  <script is:inline define:vars={{ blogArticlesMeta }}>
    window.COVEN_ARTICLES_INDEX = blogArticlesMeta;
  </script>

  <!-- Design Component runtime (framework) -->
  <script is:inline src="/js/support.js"></script>
  <!-- Site content data -->
  <script is:inline src="/js/content.js"></script>
  <!-- Application logic -->
  <script is:inline src="/js/app.js"></script>
</head>
<body>
  <x-dc>
    <div style="min-height:100vh;background:#08060e;font-family:'EB Garamond',serif">
      <slot />
    </div>
  </x-dc>

  <script is:inline type="text/x-dc" data-dc-script="">
    // The runtime evaluates this block with DCLogic, StreamableLogic and React injected
    const Component = window.CovenComponentFactory(DCLogic, StreamableLogic, React);
  </script>
</body>
</html>
