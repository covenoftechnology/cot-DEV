---
import { getPublishedArticles } from '../lib/articles';
import Footer from '../components/Footer.astro';
import '../styles/styles.css';

interface Props {
  title?: string;
}

const { title = "Coven of Technology" } = Astro.props;

const publishedArticles = getPublishedArticles();
const blogArticlesMeta = Object.fromEntries(publishedArticles.map(a => [a.slug, {
  id: a.slug,
  title: a.meta.title,
  tag: (a.meta.tags && a.meta.tags.length > 0) ? a.meta.tags[0].toUpperCase() : (a.meta.category || '').toUpperCase(),
  thumbBg: a.meta.thumbBg || 'repeating-linear-gradient(135deg,rgba(216,181,107,.08) 0 10px,rgba(216,181,107,.02) 10px 20px)'
}]));
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>

  <!-- Google Fonts prefetch -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />

  <!-- Articles metadata index from Content Collections -->
  <script is:inline define:vars={{ blogArticlesMeta }}>
    window.COVEN_ARTICLES_INDEX = blogArticlesMeta;
  </script>

  <!-- Design Component runtime (framework) -->
  <script is:inline src="/js/support.js"></script>
  <!-- Site content data -->
  <script is:inline src="/js/content.js"></script>
  <!-- Application logic -->
  <script is:inline src="/js/app.js"></script>
</head>
<body>
  <x-dc>
    <div style="min-height:100vh;background:#08060e;font-family:'EB Garamond',serif;display:flex;flex-direction:column">
      <div style="flex:1">
        <slot />
      </div>
      <Footer />
    </div>
  </x-dc>

  <script is:inline type="text/x-dc" data-dc-script="">
    // The runtime evaluates this block with DCLogic, StreamableLogic and React injected
    const Component = window.CovenComponentFactory(DCLogic, StreamableLogic, React);
  </script>

  <script is:inline>
    // Global mobile navigation drawer handler
    document.addEventListener('click', function(e) {
      var btn = e.target.closest('.cov-mobile-toggle');
      if (btn) {
        var header = btn.closest('.cov-header') || document.querySelector('.cov-header');
        if (header) {
          var drawer = header.querySelector('.cov-mobile-drawer');
          if (drawer) {
            drawer.classList.toggle('cov-open');
          }
        }
        return;
      }
      var drawerItem = e.target.closest('.cov-mobile-drawer span, .cov-mobile-drawer div');
      if (drawerItem) {
        var drawer = drawerItem.closest('.cov-mobile-drawer');
        if (drawer) {
          drawer.classList.remove('cov-open');
        }
      }
    });
  </script>
</body>
</html>
