---
import BaseLayout from './BaseLayout.astro';
import type { Article, ArticleMeta } from '../types/article';

interface Props {
  article?: {
    slug: string;
    meta: ArticleMeta;
  };
  meta?: ArticleMeta;
  previousArticle?: Article | null;
  nextArticle?: Article | null;
  relatedArticles?: Article[];
  wide?: boolean;
  isPreview?: boolean;
}

const {
  article,
  previousArticle = null,
  nextArticle = null,
  relatedArticles = [],
  wide = false,
  isPreview = false,
} = Astro.props;

// Support both article object and standalone meta prop
const meta = article?.meta || Astro.props.meta;
if (!meta) {
  throw new Error('[ArticleLayout Error] ArticleLayout requires an "article" or "meta" prop.');
}

const slug = article?.slug || '';
const authorInitial = (meta.author || 'O').charAt(0).toUpperCase();
const tagDisplay = (meta.tags && meta.tags.length > 0)
  ? meta.tags.join(' · ').toUpperCase()
  : (meta.category || '').toUpperCase();

// Single source of truth for Aether Reward
let aetherReward = meta.aetherReward;
if (aetherReward === undefined) {
  const match = meta.meta?.match(/✦\s*(\d+)\s*Aether/i);
  aetherReward = match ? parseInt(match[1], 10) : 120;
}

// Single source of truth for Reading Time
let readingTime = meta.readingTime;
if (!readingTime) {
  if (meta.meta) {
    const parts = meta.meta.split('·');
    readingTime = parts[0]?.trim();
  } else {
    readingTime = '12 min';
  }
}

// Format publication dates cleanly
function formatDate(dateVal?: Date | string): string {
  if (!dateVal) return '';
  const d = typeof dateVal === 'string' ? new Date(dateVal.includes('T') ? dateVal : `${dateVal}T00:00:00`) : dateVal;
  if (isNaN(d.getTime())) return String(dateVal);
  return d.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric'
  });
}

const formattedPublishedDate = formatDate(meta.publishedDate);
const formattedUpdatedDate = formatDate(meta.updatedDate);

const isWide = Boolean(wide || meta.wide);
const containerMaxWidth = isWide ? '1220px' : '820px';
const canonicalUrl = slug ? `https://covenoftechnology.cloud/article/${slug}` : undefined;
---

<BaseLayout
  title={`Coven of Technology — ${meta.title}`}
  description={meta.description}
  canonical={canonicalUrl}
  ogImage={meta.cover}
  ogType="article"
>
  <div style="position:relative;background:radial-gradient(1100px 640px at 50% -14%,rgba(124,77,196,.40),transparent 58%),radial-gradient(720px 520px at 16% 2%,rgba(86,58,150,.32),transparent 60%),radial-gradient(640px 460px at 86% 10%,rgba(170,128,224,.24),transparent 62%),#08060e">
    <div style="position:absolute;top:64px;left:0;right:0;height:300px;overflow:hidden;z-index:0;pointer-events:none">
      <div style="position:absolute;top:60px;right:7%;width:50px;height:50px;border-radius:50%;background:radial-gradient(circle at 38% 36%,#efe7d2,#cdbfae 58%,#6f6450);box-shadow:0 0 40px rgba(214,208,236,.38),inset -7px -5px 12px rgba(40,30,60,.55);opacity:.4;animation:covFloat 9s ease-in-out infinite"></div>
      <div style="position:absolute;top:44px;left:9%;width:3px;height:3px;border-radius:50%;background:#c9b8ff;box-shadow:0 0 10px 2px rgba(201,184,255,.7);animation:covTwinkle 4s infinite"></div>
      <div style="position:absolute;top:120px;left:13%;width:2px;height:2px;border-radius:50%;background:#e8cf95;box-shadow:0 0 8px 2px rgba(232,207,149,.5);animation:covTwinkle 3.4s .6s infinite"></div>
      <div style="position:absolute;top:170px;right:11%;width:3px;height:3px;border-radius:50%;background:#d6d0ec;box-shadow:0 0 9px 2px rgba(214,208,236,.6);animation:covTwinkle 5s .3s infinite"></div>
    </div>

    <!-- STICKY ARTICLE TOP ZONE (Header + Reading Progress Bar) -->
    <div class="article-sticky-top-zone">
      <header class="cov-header cov-section-pad article-top-header">
        <div onclick="{{ toLanding }}" class="cov-brand" style="display:flex;align-items:center;gap:13px;cursor:pointer">
          <div class="cov-brand-logo" style="width:36px;height:36px;border-radius:50%;border:1px solid #d8b56b;display:flex;align-items:center;justify-content:center;color:#d8b56b;font-size:16px;background:#0b0a0e;box-shadow:inset 0 0 12px rgba(216,181,107,.18)">✶</div>
          <div class="cov-brand-text" style="font-family:var(--font-display, 'Metamorphous', serif);font-size:14px;font-weight:600;letter-spacing:2px;color:#ece6dd">COVEN · OF · TECHNOLOGY</div>
        </div>

        <!-- Automatic Breadcrumb -->
        <div style="font-family:var(--font-body, 'Helvetica Neue Roman', serif);font-size:13px;color:#8f857a;max-width:100%">
          <a href="/library" style="color:inherit;text-decoration:none;cursor:pointer">The Grimoire</a>
          <span> / </span>
          <span style="color:#b3a99d">{meta.category}</span>
          <span> / </span>
          <span style="color:#c5b9a8">{meta.title}</span>
        </div>

        <div style="font-family:var(--font-body, 'Helvetica Neue Roman', serif);font-size:13px;color:#e8cf95;border:1px solid rgba(216,181,107,.3);padding:7px 14px;border-radius:4px;white-space:nowrap">✦ {aetherReward} Aether on completion</div>
      </header>

      <!-- Sticky Reading Progress Bar (pins to viewport top during scroll) -->
      <div id="article-progress-track" class="cov-reading-progress-track">
        <div id="article-progress-bar" class="cov-reading-progress-bar"></div>
      </div>
    </div>

    <!-- ARTICLE WRAPPER -->
    <article id="coven-article-container" class="cov-section-pad article-template" style={`max-width:${containerMaxWidth};margin:0 auto;padding:56px 48px 64px;position:relative;z-index:1`}>
      <div style="display:inline-block;font-family:var(--font-mono, Consolas, monospace);font-size:11px;letter-spacing:1.5px;color:#b98fd8;border:1px solid rgba(185,143,216,.32);border-radius:2px;padding:5px 10px;margin-bottom:22px">{tagDisplay}</div>
      <h1 style="font-family:var(--font-display, 'Metamorphous', serif);font-weight:700;font-size:clamp(28px,6.5vw,46px);line-height:1.12;color:#f3ecdf;margin:0 0 22px;text-shadow:0 0 40px rgba(139,92,196,.2);word-break:break-word">{meta.title}</h1>
      <div style="display:flex;align-items:center;gap:14px;margin-bottom:34px;padding-bottom:26px;border-bottom:1px solid rgba(216,181,107,.12);flex-wrap:wrap">
        <div style="width:42px;height:42px;border-radius:50%;background:radial-gradient(circle,#3a2a52,#1a1326);border:1px solid rgba(216,181,107,.4);display:flex;align-items:center;justify-content:center;color:#e8cf95;font-family:var(--font-display, 'Metamorphous', serif);flex-shrink:0">{authorInitial}</div>
        <div>
          <div style="font-family:var(--font-body, 'Helvetica Neue Roman', serif);font-size:16px;color:#ece6dd">Inscribed by the {meta.author}</div>
          <div style="font-family:var(--font-body, 'Helvetica Neue Roman', serif);font-size:13px;color:#8f857a;display:flex;align-items:center;gap:8px;flex-wrap:wrap">
            <span>{readingTime}</span>
            {formattedPublishedDate && (
              <>
                <span>·</span>
                <span>{formattedPublishedDate}</span>
              </>
            )}
            {formattedUpdatedDate && formattedUpdatedDate !== formattedPublishedDate && (
              <>
                <span>·</span>
                <span style="font-style:italic;color:#7b6f63">(Updated {formattedUpdatedDate})</span>
              </>
            )}
            <span>·</span>
            <span style="color:#d8b56b">✦ {aetherReward} Aether</span>
          </div>
        </div>
      </div>

      <!-- Hero Lead from meta.description -->
      {meta.description && (
        <p class="hero-lead">
          {meta.description}
        </p>
      )}

      <!-- Hero Cover from meta.cover -->
      {meta.cover && (
        <figure class="hero-cover">
          <img src={meta.cover} alt={meta.title} width="1200" height="560" loading="eager" />
          {meta.coverCaption && <figcaption>{meta.coverCaption}</figcaption>}
        </figure>
      )}

      <!-- Mobile Table of Contents (visible on <= 980px when sections exist) -->
      <details class="mobile-toc" id="article-mobile-toc">
        <summary class="mobile-toc-summary">
          <span>☰ ON THIS SCROLL</span>
          <span style="font-size: 11px; opacity: 0.7;">EXPLORE</span>
        </summary>
        <div class="mobile-toc-content">
          <ul class="toc-nav-list" id="mobile-toc-list">
            <!-- Populated dynamically by client-side script from .article-section[data-toc-title] -->
          </ul>
        </div>
      </details>

      <!-- Editorial Layout: Content + Sticky Sidebar -->
      <div class="editorial-layout" id="article-editorial-layout">

        <!-- Main content column -->
        <div class="main-content">
          <div class="article-body article-content article-markdown-body">
            <slot />
          </div>

          <!-- BLOCK: Next Article / Navigation -->
          <div class="article-nav-block">
            <a href="/library" class="nav-back-link">
              <span>← BACK TO THE GRIMOIRE</span>
            </a>

            {nextArticle && (
              <a href={`/article/${nextArticle.slug}`} class="nav-next-card">
                <div>
                  <div class="nav-next-label">NEXT SCROLL · {nextArticle.meta.category.toUpperCase()}</div>
                  <div class="nav-next-title">{nextArticle.meta.title}</div>
                </div>
                <span class="nav-next-arrow">→</span>
              </a>
            )}
          </div>
        </div>

        <!-- Sticky Sidebar: ON THIS SCROLL (Desktop) -->
        <aside class="article-sidebar" id="article-desktop-sidebar" aria-label="Table of contents and scroll progress">
          <div class="toc-panel">
            <div class="toc-header">
              <span class="toc-title">
                <span>✦</span>
                <span>ON THIS SCROLL</span>
              </span>
              <span class="toc-progress-indicator" id="reading-pct">0%</span>
            </div>

            <div class="toc-progress-bar-wrap" aria-hidden="true">
              <div class="toc-progress-bar-fill" id="reading-bar"></div>
            </div>

            <div class="toc-scroll-area">
              <nav aria-label="Table of contents">
                <ul class="toc-nav-list" id="desktop-toc-list">
                  <!-- Populated dynamically by client-side script from .article-section[data-toc-title] -->
                </ul>
              </nav>
            </div>
          </div>
        </aside>

      </div>
    </article>

    {!meta.hideTrial && (
      <div class="cov-banner" style={`margin:0 auto 48px;max-width:${containerMaxWidth};border:1px solid rgba(216,181,107,.18);border-radius:8px;padding:36px;text-align:center;background:radial-gradient(500px 200px at 50% 0%,rgba(139,92,196,.18),transparent 65%),#100d16;position:relative;z-index:1`}>
        <h3 style="font-family:var(--font-display, 'Metamorphous', serif);font-weight:600;font-size:26px;color:#f3ecdf;margin:0 0 8px">You've reached the trial</h3>
        <p style="font-family:var(--font-body, 'Helvetica Neue Roman', serif);font-size:16px;color:#b3a99d;margin:0 0 24px">Prove your mastery to claim ✦ {aetherReward} Aether and advance toward {meta.rank || 'Mechanic'}.</p>
        <div onclick="{{ startTrial }}" style="display:inline-block;padding:14px 32px;border-radius:3px;background:linear-gradient(180deg,#e3c47e,#c49a4e);color:#221809;font-family:var(--font-display, 'Metamorphous', serif);font-weight:600;font-size:14px;letter-spacing:1.5px;box-shadow:0 0 30px rgba(216,181,107,.34);cursor:pointer;max-width:100%">BEGIN THE TRIAL</div>
      </div>
    )}
  </div>

  <script is:inline>
    // Unified Reading Progress for Article (top sticky bar, sidebar bar, and sidebar percentage)
    function updateUnifiedReadingProgress() {
      var articleEl = document.getElementById('coven-article-container') || document.querySelector('article');
      if (!articleEl) return;

      var rect = articleEl.getBoundingClientRect();
      var scrollTop = window.scrollY || document.documentElement.scrollTop;
      var articleTop = rect.top + scrollTop;
      var articleHeight = rect.height;
      var viewportHeight = window.innerHeight;

      // Distance from top of article until the bottom of the article enters the viewport
      var totalDistance = articleHeight - viewportHeight;
      var progress = 0;

      if (totalDistance <= 0) {
        progress = 100;
      } else {
        var scrolled = scrollTop - articleTop;
        progress = Math.min(100, Math.max(0, Math.round((scrolled / totalDistance) * 100)));
      }

      // 1. Sticky top reading progress bar
      var topBar = document.getElementById('article-progress-bar');
      if (topBar) topBar.style.width = progress + '%';

      // 2. Sidebar reading progress bar
      var sidebarBar = document.getElementById('reading-bar');
      if (sidebarBar) sidebarBar.style.width = progress + '%';

      // 3. Sidebar percentage indicator
      var sidebarPct = document.getElementById('reading-pct');
      if (sidebarPct) sidebarPct.textContent = progress + '%';
    }

    window.addEventListener('scroll', updateUnifiedReadingProgress, { passive: true });
    window.addEventListener('resize', updateUnifiedReadingProgress, { passive: true });
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      updateUnifiedReadingProgress();
    } else {
      document.addEventListener('DOMContentLoaded', updateUnifiedReadingProgress);
    }

    // Dynamic TOC builder and spy
    (function () {
      function buildToc(container, sections) {
        if (!container) return;
        container.innerHTML = '';
        sections.forEach(function (sec, idx) {
          var id = sec.id;
          var title = sec.getAttribute('data-toc-title') || ('Section ' + (idx + 1));
          var numStr = String(idx + 1).padStart(2, '0');
          var li = document.createElement('li');
          var a = document.createElement('a');
          a.href = '#' + id;
          a.className = 'toc-link';
          a.setAttribute('data-toc-target', id);
          a.innerHTML = '<span class="toc-num">' + numStr + '</span><span>' + title + '</span>';
          li.appendChild(a);
          container.appendChild(li);
        });
      }

      var observerInstance = null;

      function setupToc() {
        var sections = Array.from(document.querySelectorAll('.article-section[data-toc-title]'));
        var desktopTocList = document.getElementById('desktop-toc-list');
        var mobileTocList = document.getElementById('mobile-toc-list');
        var mobileTocDetails = document.getElementById('article-mobile-toc');
        var desktopSidebar = document.getElementById('article-desktop-sidebar');
        var layoutGrid = document.getElementById('article-editorial-layout');

        // If no sections exist, collapse TOC gracefully
        if (sections.length === 0) {
          if (mobileTocDetails) mobileTocDetails.style.display = 'none';
          if (desktopSidebar) desktopSidebar.style.display = 'none';
          if (layoutGrid) layoutGrid.style.gridTemplateColumns = '1fr';
          return;
        }

        if (mobileTocDetails) mobileTocDetails.style.display = '';
        if (desktopSidebar) desktopSidebar.style.display = '';
        if (layoutGrid && window.innerWidth > 980) {
          layoutGrid.style.gridTemplateColumns = 'minmax(0, 1fr) 280px';
        }

        // Build lists
        if (desktopTocList) buildToc(desktopTocList, sections);
        if (mobileTocList) buildToc(mobileTocList, sections);

        var allTocLinks = document.querySelectorAll('.toc-link');

        function scrollLinkIntoTocView(link) {
          var container = link.closest('.toc-scroll-area');
          if (!container) return;
          var containerRect = container.getBoundingClientRect();
          var linkRect = link.getBoundingClientRect();

          if (linkRect.top < containerRect.top) {
            container.scrollTo({
              top: container.scrollTop + (linkRect.top - containerRect.top) - 10,
              behavior: 'smooth'
            });
          } else if (linkRect.bottom > containerRect.bottom) {
            container.scrollTo({
              top: container.scrollTop + (linkRect.bottom - containerRect.bottom) + 10,
              behavior: 'smooth'
            });
          }
        }

        if (observerInstance) observerInstance.disconnect();

        if ('IntersectionObserver' in window && sections.length > 0) {
          observerInstance = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                var activeId = entry.target.id;
                allTocLinks.forEach(function (link) {
                  if (link.getAttribute('data-toc-target') === activeId) {
                    link.classList.add('active');
                    scrollLinkIntoTocView(link);
                  } else {
                    link.classList.remove('active');
                  }
                });
              }
            });
          }, {
            rootMargin: '-10% 0px -70% 0px',
            threshold: 0
          });

          sections.forEach(function (s) {
            observerInstance.observe(s);
          });
        }
      }

      setupToc();

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupToc);
      }
      window.addEventListener('load', setupToc);

      var checkInterval = setInterval(function () {
        var dt = document.getElementById('desktop-toc-list');
        var secs = document.querySelectorAll('.article-section[data-toc-title]');
        if (dt && secs.length > 0 && dt.children.length === 0) {
          setupToc();
        }
      }, 100);

      setTimeout(function () {
        clearInterval(checkInterval);
        setupToc();
      }, 4000);

      // Exercise reveal buttons
      document.addEventListener('click', function (e) {
        var btn = e.target.closest('.reveal-btn');
        if (!btn) return;
        var targetId = btn.getAttribute('data-target');
        if (!targetId) return;
        var ans = document.getElementById(targetId);
        if (!ans) return;

        var isExpanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', !isExpanded);
        if (!isExpanded) {
          ans.classList.add('visible');
          btn.querySelector('span').textContent = 'Hide Answer';
        } else {
          ans.classList.remove('visible');
          btn.querySelector('span').textContent = '✦ Reveal Answer';
        }
      });

      // Mobile TOC auto-close
      document.addEventListener('click', function (e) {
        var mobileLink = e.target.closest('.mobile-toc a');
        if (mobileLink) {
          var mobileToc = mobileLink.closest('.mobile-toc');
          if (mobileToc) mobileToc.removeAttribute('open');
        }
      });
    })();
  </script>
</BaseLayout>

<style is:global>
  :root {
    --article-header-height: 72px;
    --article-progress-height: 3px;
    --article-sticky-height: calc(var(--article-header-height) + var(--article-progress-height));
    --article-mobile-toc-height: 48px;
  }

  @media (max-width: 980px) {
    :root {
      --article-header-height: 64px;
      --article-mobile-toc-height: 46px;
    }
  }

  .article-sticky-top-zone {
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
    background: rgba(8, 6, 14, 0.94);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(216, 181, 107, 0.15);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.45);
  }

  .article-top-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 48px;
    flex-wrap: wrap;
    gap: 12px;
    min-height: var(--article-header-height);
    box-sizing: border-box;
  }

  @media (max-width: 980px) {
    .article-top-header {
      padding: 12px 20px;
    }
  }

  .cov-reading-progress-track {
    height: var(--article-progress-height);
    background: rgba(216, 181, 107, 0.12);
    width: 100%;
    overflow: hidden;
  }

  .cov-reading-progress-bar {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #c49a4e, #e3c47e);
    transition: width 0.08s linear;
  }

  /* ── Hero Lead & Cover ────────────────────────────────────────── */
  .hero-lead {
    font-family: var(--font-body, 'Helvetica Neue Roman', serif);
    font-size: clamp(19px, 2.5vw, 22px);
    line-height: 1.6;
    color: #cdc3b6;
    margin: 0 0 32px;
    font-style: italic;
    border-left: 2px solid rgba(216, 181, 107, 0.4);
    padding-left: 20px;
  }

  .hero-cover {
    margin: 0 0 44px;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(216, 181, 107, 0.2);
    background: #110d1a;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
  }

  .hero-cover img {
    width: 100%;
    height: auto;
    display: block;
  }

  .hero-cover figcaption {
    font-family: var(--font-body, 'Helvetica Neue Roman', serif);
    font-size: 13px;
    color: #8f857a;
    text-align: center;
    padding: 10px 16px;
    background: rgba(16, 13, 22, 0.8);
    border-top: 1px solid rgba(216, 181, 107, 0.1);
    font-style: italic;
  }

  /* ── Mobile TOC ──────────────────────────────────────────────── */
  .mobile-toc {
    display: none;
    margin-bottom: 24px;
    background: #151121;
    border: 1px solid rgba(216, 181, 107, 0.25);
    border-radius: 6px;
    overflow: hidden;
  }

  .mobile-toc-summary {
    padding: 12px 16px;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-display, 'Metamorphous', serif);
    font-size: 12px;
    letter-spacing: 1.5px;
    color: #e8cf95;
    user-select: none;
    background: rgba(216, 181, 107, 0.05);
  }

  .mobile-toc-summary::-webkit-details-marker {
    display: none;
  }

  .mobile-toc-content {
    padding: 12px 16px;
    border-top: 1px solid rgba(216, 181, 107, 0.15);
    max-height: 280px;
    overflow-y: auto;
  }

  @media (max-width: 980px) {
    .mobile-toc {
      display: block;
      position: sticky;
      top: var(--article-sticky-height, 67px);
      z-index: 998;
    }
  }

  /* ── Editorial Two-Column Layout ──────────────────────────────── */
  .editorial-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 48px;
    align-items: start;
    position: relative;
  }

  .main-content {
    min-width: 0;
  }

  .article-sidebar {
    position: sticky;
    top: calc(var(--article-sticky-height, 75px) + 24px);
    align-self: start;
    display: flex;
    flex-direction: column;
    max-height: calc(100vh - var(--article-sticky-height, 75px) - 48px);
  }

  @media (max-width: 980px) {
    .editorial-layout {
      grid-template-columns: 1fr !important;
      gap: 0;
    }
    .article-sidebar {
      display: none !important;
    }
  }

  /* ── Sidebar: Table of Contents ──────────────────────────────── */
  .toc-panel {
    background: #151121;
    border: 1px solid rgba(216, 181, 107, 0.18);
    border-radius: 8px;
    padding: 18px 16px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
    display: flex;
    flex-direction: column;
    height: auto;
    max-height: inherit;
    box-sizing: border-box;
    overflow: hidden;
  }

  .toc-header {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
    padding-bottom: 10px;
    border-bottom: 1px solid rgba(216, 181, 107, 0.14);
  }

  .toc-title {
    font-family: var(--font-display, 'Metamorphous', serif);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 2px;
    color: #e8cf95;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 8px;
  }

