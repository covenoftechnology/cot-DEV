---
// src/components/Footer.astro
// Global footer component for Coven of Technology
---

<footer class="cov-footer" style="border-top:1px solid rgba(216,181,107,.12);padding:34px 56px;display:flex;justify-content:space-between;align-items:center;font-family:var(--font-body);font-size:14px;color:#8f857a;background:#08060e;position:relative;z-index:10;width:100%;box-sizing:border-box">
  <div style="display:flex;align-items:center;gap:12px">
    <div style="width:28px;height:28px;border-radius:50%;border:1px solid rgba(216,181,107,.5);display:flex;align-items:center;justify-content:center;color:#d8b56b;font-size:13px">✦</div>
    <span style="color:#c5b9a8;letter-spacing:1px">COVEN OF TECHNOLOGY</span>
  </div>
  <div class="cov-footer-right" style="text-align:right;line-height:1.7">
    <div style="color:#b3a99d">Crafted with 💜 by former <a class="cov-footer-author-link" href="https://www.linkedin.com/posts/mich-alvarez_marketingchampions-activity-7391155628083417090-US1j" target="_blank" rel="noopener noreferrer">Salesforce Marketing Champion ’25, Mich Alvarez</a></div>
    <div style="color:#6b6258">© Coven of Technology, 2024</div>
  </div>
</footer>

<style>
  .cov-footer-author-link {
    color: #e8cf95;
    text-decoration: underline;
    text-decoration-color: rgba(216, 181, 107, 0.55);
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    transition: color 0.18s ease, text-decoration-color 0.18s ease;
  }

  .cov-footer-author-link:hover {
    color: #f6eedc;
    text-decoration-color: rgba(232, 207, 149, 0.95);
  }

  .cov-footer-author-link:focus-visible {
    outline: 1px solid #d8b56b;
    outline-offset: 2px;
    border-radius: 2px;
  }
</style>
