    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(216, 181, 107, 0.18);
    border-radius: 3px;
    padding: 2px 5px;
    display: inline;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  .article-template .article-text-bg-purple {
    background: rgba(185, 143, 216, 0.18);
    border: 1px solid rgba(185, 143, 216, 0.35);
    border-radius: 3px;
    padding: 2px 5px;
    display: inline;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  .article-template .article-text-bg-gold {
    background: rgba(216, 181, 107, 0.16);
    border: 1px solid rgba(216, 181, 107, 0.38);
    border-radius: 3px;
    padding: 2px 5px;
    display: inline;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  .article-template .article-text-bg-green {
    background: rgba(129, 199, 132, 0.16);
    border: 1px solid rgba(129, 199, 132, 0.35);
    border-radius: 3px;
    padding: 2px 5px;
    display: inline;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  .article-template .article-text-bg-red {
    background: rgba(229, 115, 115, 0.18);
    border: 1px solid rgba(229, 115, 115, 0.38);
    border-radius: 3px;
    padding: 2px 5px;
    display: inline;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  .article-template .article-text-custom-bg {
    background: var(--coven-custom-bg, transparent);
    border-radius: 3px;
    padding: 2px 5px;
    display: inline;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  /* ── Canonical 4-Column Grid Reader — Canonical Article Lane Containment ── */
  .article-template .article-section--grid {
    position: relative;
    width: 100%;
    max-width: 100%;
  }

  /* The Grid occupies the SAME canonical editorial content lane as the section heading.
     Zero breakout beyond main content lane; strictly stops before the right TOC sidebar. */
  .article-template .section-reader-grid-breakout {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    position: relative;
    left: auto;
    transform: none;
  }

  .article-template .section-reader-grid {
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    position: relative;
    margin: 24px 0;
  }

  .article-template .section-reader-grid .reader-grid-item {
    box-sizing: border-box;
    min-width: 0;
    max-width: 100%;
    position: relative;
    display: flex;
    flex-direction: column;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  /* Scoped margin normalization: only direct children of Grid items */
  .article-template .section-reader-grid .reader-grid-item > * {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    max-width: 100%;
    box-sizing: border-box;
  }

  /* Safe typography text wrapping in Grid */
  .article-template .section-reader-grid .reader-grid-item p,
  .article-template .section-reader-grid .reader-grid-item h1,
  .article-template .section-reader-grid .reader-grid-item h2,
  .article-template .section-reader-grid .reader-grid-item h3,
  .article-template .section-reader-grid .reader-grid-item h4,
  .article-template .section-reader-grid .reader-grid-item li {
    overflow-wrap: break-word;
    word-break: break-word;
  }

  /* Safe media containment in Grid */
  .article-template .section-reader-grid .reader-grid-item img,
  .article-template .section-reader-grid .reader-grid-item iframe,
  .article-template .section-reader-grid .reader-grid-item video {
    max-width: 100%;
  }

  /* Controlled internal horizontal scrolling exceptions */
  .article-template .section-reader-grid .reader-grid-item .tech-table-wrap,
  .article-template .section-reader-grid .reader-grid-item pre,
  .article-template .section-reader-grid .reader-grid-item .code-block-wrap {
    max-width: 100%;
    overflow-x: auto;
  }

  /* Mobile Responsive Stacking (<= 768px): clean 1-column stack */
  @media (max-width: 768px) {
    .article-template .section-reader-grid {
      grid-template-columns: 1fr !important;
      row-gap: 20px !important;
      column-gap: 0 !important;
    }

    .article-template .section-reader-grid .reader-grid-item {
      grid-column: 1 / -1 !important;
      grid-row: auto !important;
      width: 100% !important;
    }
  }

  /* ── Single Card Reader Style ── */
  .article-template .single-card.pattern-card {
    height: 100%;
    box-sizing: border-box;
  }

  /* ── Comparison Fix ── */
  .article-template .comparison-split {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    width: 100%;
    box-sizing: border-box;
  }

  .article-template .comparison-split.is-single-side {
    grid-template-columns: minmax(0, 1fr);
  }

  .article-template .comparison-split.is-single-side .comparison-column:first-child {
    border-right: none;
  }

  .article-template .comparison-column {
    min-width: 0;
    box-sizing: border-box;
  }

