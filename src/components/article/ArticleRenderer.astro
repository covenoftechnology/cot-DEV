---
import '../../articles/_template/article.css';
import Callout from './Callout.astro';
import CodeBlock from './CodeBlock.astro';
import ArticleTrial from './ArticleTrial.astro';
import type { ArticleDocument, ArticleSection, ArticleBlock } from '../../types/article-document';

interface Props {
  document: ArticleDocument;
}

const { document: doc } = Astro.props;

if (!doc || !doc.sections) {
  throw new Error('[ArticleRenderer Error] Invalid ArticleDocument provided.');
}

function slugify(text: string): string {
  return (text || '')
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
}

function cleanHtml(input: string): string {
  if (!input || typeof input !== 'string') return '';
  let sanitized = input
    .replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, '')
    .replace(/<style\b[^<]*(?:(?!<\/style>)<[^<]*)*<\/style>/gi, '')
    .replace(/\son\w+="[^"]*"/gi, '')
    .replace(/\son\w+='[^']*'/gi, '')
    .replace(/\sstyle="[^"]*"/gi, '')
    .replace(/javascript:/gi, '')
    .replace(/vbscript:/gi, '')
    .replace(/data:/gi, '');

  // Strip unsafe anchors and sanitize allowed anchors
  sanitized = sanitized.replace(/<a\b([^>]*)>([\s\S]*?)<\/a>/gi, (_match, attrs, content) => {
    const hrefMatch = attrs.match(/href="([^"]*)"/i) || attrs.match(/href='([^']*)'/i);
    if (!hrefMatch) return content;
    const href = hrefMatch[1].trim();
    const isExternal = /^https?:\/\//i.test(href);
    const isInternal = href.startsWith('/') && !href.startsWith('//') && !href.includes('\\') && !href.includes('/../') && !href.includes('/./');
    if (!isExternal && !isInternal) {
      return content;
    }
    let safeClass = 'article-rich-link';
    const classMatch = attrs.match(/class="([^"]*)"/i) || attrs.match(/class='([^']*)'/i);
    if (classMatch) {
      const cls = classMatch[1];
      if (cls.includes('article-rich-link--gold')) safeClass += ' article-rich-link--gold';
      else if (cls.includes('article-rich-link--purple')) safeClass += ' article-rich-link--purple';
      else if (cls.includes('article-rich-link--parchment')) safeClass += ' article-rich-link--parchment';
      else if (cls.includes('article-rich-link--muted')) safeClass += ' article-rich-link--muted';
    }
    const targetRel = isExternal ? ' target="_blank" rel="noopener noreferrer"' : '';
    return `<a href="${href}" class="${safeClass}"${targetRel}>${content}</a>`;
  });

  // Sanitize spans to allow only approved article-text-* and article-text-bg-* classes and custom colors
  sanitized = sanitized.replace(/<span\b([^>]*)>([\s\S]*?)<\/span>/gi, (_match, attrs, content) => {
    const classMatch = attrs.match(/class="([^"]*)"/i) || attrs.match(/class='([^']*)'/i);
    if (!classMatch) return content;
    const allowed = [
      'article-text-gold',
      'article-text-purple',
      'article-text-muted',
      'article-text-default',
      'article-text-bg-neutral',
      'article-text-bg-purple',
      'article-text-bg-gold',
      'article-text-bg-green',
      'article-text-bg-red',
      'article-text-custom-color',
      'article-text-custom-bg'
    ];
    const rawClasses = classMatch[1].split(/\s+/).filter((c: string) => allowed.includes(c));
    if (rawClasses.length === 0) return content;

    const styleMatch = attrs.match(/style="([^"]*)"/i) || attrs.match(/style='([^']*)'/i);
    const styleAttr = styleMatch ? styleMatch[1] : '';

    const validStyles: string[] = [];
    const validClasses: string[] = [];

    rawClasses.forEach((cls: string) => {
      if (cls === 'article-text-custom-color') {
        const m = styleAttr.match(/--coven-custom-text-color:\s*(#[0-9a-fA-F]{3,6})/i);
        if (m && /^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/.test(m[1])) {
          let hex = m[1].toUpperCase();
          if (hex.length === 4) hex = '#' + hex[1] + hex[1] + hex[2] + hex[2] + hex[3] + hex[3];
          validClasses.push(cls);
          validStyles.push(`--coven-custom-text-color:${hex}`);
        }
      } else if (cls === 'article-text-custom-bg') {
        const m = styleAttr.match(/--coven-custom-bg:\s*(#[0-9a-fA-F]{3,6})/i);
        if (m && /^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/.test(m[1])) {
          let hex = m[1].toUpperCase();
          if (hex.length === 4) hex = '#' + hex[1] + hex[1] + hex[2] + hex[2] + hex[3] + hex[3];
          validClasses.push(cls);
          validStyles.push(`--coven-custom-bg:${hex}`);
        }
      } else {
        validClasses.push(cls);
      }
    });

    if (validClasses.length === 0) return content;
    const styleStr = validStyles.length > 0 ? ` style="${validStyles.join(';')}"` : '';
    return `<span class="${validClasses.join(' ')}"${styleStr}>${content}</span>`;
  });

  return sanitized;
}

function getPlainHeadingText(input: any): string {
  if (!input) return '';
  let str = '';
  if (typeof input === 'string') {
    str = input;
  } else if (typeof input === 'object' && input !== null) {
    str = input.text || input.content || '';
  }
  if (!str || typeof str !== 'string') return '';
  let clean = str.replace(/<[^>]+>/g, '').trim();
  clean = clean
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/&nbsp;/g, ' ');
  return clean.trim();
}

function getRich(input: any): { text: string; align: string } {
  if (input && typeof input === 'object') {
    return {
      text: typeof input.text === 'string' ? input.text : (typeof input.content === 'string' ? input.content : ''),
      align: input.align === 'center' || input.align === 'right' ? input.align : 'left',
    };
  }
  return {
    text: typeof input === 'string' ? input : '',
    align: 'left',
  };
}
---

<div class="article-template">
  {doc.sections.map((section: ArticleSection, sIndex: number) => {
    const sectionId = slugify(section.title) || `section-${sIndex + 1}`;
    const sectionTitle = (typeof section.title === 'string' ? section.title.trim() : '') ||
                         (typeof section.heading === 'string' ? section.heading.trim() : '');
    return (
      <section id={sectionId} class="article-section" data-toc-title={section.title}>
        {section.kicker && <div class="section-kicker">{section.kicker}</div>}
        {sectionTitle && <h2 class="article-section-title">{sectionTitle}</h2>}

        {section.blocks.map((block: ArticleBlock, bIndex: number) => {
          const d = block.data || {};

          switch (block.type) {
            case 'title-text': {
              const headingData = typeof d.heading === 'object' && d.heading !== null
                ? { text: d.heading.text || d.heading.content || '', align: d.heading.align || 'left' }
                : { text: typeof d.heading === 'string' ? d.heading : '', align: d.headingAlign || 'left' };
              const headingAlignClass = headingData.align && headingData.align !== 'left' ? `rich-align-${headingData.align}` : '';

              const paragraphs = Array.isArray(d.paragraphs)
                ? d.paragraphs.map((p: any) => {
                    if (typeof p === 'object' && p !== null) {
                      return { text: p.text || p.content || '', align: p.align || 'left' };
                    }
                    return { text: typeof p === 'string' ? p : '', align: 'left' };
                  })
                : (d.paragraph || d.text ? [{ text: d.paragraph || d.text, align: 'left' }] : []);

              const plainHeading = getPlainHeadingText(headingData.text);
              const isTocSub = plainHeading.length > 0;
              const subId = `sub-${block.id || `${sIndex}-${bIndex}`}`;

              return (
                <div class="block-typography-title-text">
                  {d.kicker && <div class="section-kicker">{d.kicker}</div>}
                  {headingData.text && (
                    <h3
                      id={subId}
                      data-toc-sub={isTocSub ? 'true' : undefined}
                      data-toc-subtitle={isTocSub ? plainHeading : undefined}
                      class={headingAlignClass || undefined}
                    >
                      <Fragment set:html={cleanHtml(headingData.text)} />
                    </h3>
                  )}
                  {paragraphs.map((p: { text: string; align: string }) => (
                    p.text ? <p class={p.align && p.align !== 'left' ? `rich-align-${p.align}` : undefined}><Fragment set:html={cleanHtml(p.text)} /></p> : null
                  ))}
                </div>
              );
            }

            case 'text-title': {
              const introData = typeof d.intro === 'object' && d.intro !== null
                ? { text: d.intro.text || d.intro.content || '', align: d.intro.align || 'left' }
                : { text: typeof d.intro === 'string' ? d.intro : '', align: d.introAlign || 'left' };
              const introAlignClass = introData.align && introData.align !== 'left' ? ` rich-align-${introData.align}` : '';

              const headingData = typeof d.heading === 'object' && d.heading !== null
                ? { text: d.heading.text || d.heading.content || '', align: d.heading.align || 'left' }
                : { text: typeof d.heading === 'string' ? d.heading : '', align: d.headingAlign || 'left' };
              const headingAlignClass = headingData.align && headingData.align !== 'left' ? ` rich-align-${headingData.align}` : '';

              const paraRaw = d.paragraph || d.text;
              const paraData = typeof paraRaw === 'object' && paraRaw !== null
                ? { text: paraRaw.text || paraRaw.content || '', align: paraRaw.align || 'left' }
                : { text: typeof paraRaw === 'string' ? paraRaw : '', align: d.paragraphAlign || 'left' };
              const paraAlignClass = paraData.align && paraData.align !== 'left' ? `rich-align-${paraData.align}` : '';

              const plainHeading = getPlainHeadingText(headingData.text);
              const isTocSub = plainHeading.length > 0;
              const subId = `sub-${block.id || `${sIndex}-${bIndex}`}`;

              return (
                <div class="block-typography-text-title">
                  {d.kicker && <div class="section-kicker">{d.kicker}</div>}
                  {introData.text && <p class={`text-intro${introAlignClass}`}><Fragment set:html={cleanHtml(introData.text)} /></p>}
                  {headingData.text && (
                    <h3
                      id={subId}
                      data-toc-sub={isTocSub ? 'true' : undefined}
                      data-toc-subtitle={isTocSub ? plainHeading : undefined}
                      class={`heading-subsequent${headingAlignClass}`}
                    >
                      <Fragment set:html={cleanHtml(headingData.text)} />
                    </h3>
                  )}
                  {paraData.text && <p class={paraAlignClass || undefined}><Fragment set:html={cleanHtml(paraData.text)} /></p>}
                </div>
              );
            }

            case 'solo-text': {
              const paragraphs = Array.isArray(d.paragraphs)
                ? d.paragraphs.map((p: any) => {
                    if (typeof p === 'object' && p !== null) {
                      return { text: p.text || p.content || '', align: p.align || 'left' };
                    }
                    return { text: typeof p === 'string' ? p : '', align: 'left' };
                  })
                : (d.paragraph || d.text ? [{ text: d.paragraph || d.text, align: 'left' }] : []);

              return (
                <div class="block-solo-text">
                  {paragraphs.map((p: { text: string; align: string }) => (
                    p.text ? <p class={p.align && p.align !== 'left' ? `rich-align-${p.align}` : undefined}><Fragment set:html={cleanHtml(p.text)} /></p> : null
                  ))}
                </div>
              );
            }

            case 'bullet-list': {
              const items = (Array.isArray(d.items) ? d.items : [])
                .map((it: any) => (typeof it === 'object' && it !== null ? it.text : it))
                .filter(Boolean);
              return (
                <div class="block-bullet-list">
                  {d.title && <h3 class="list-title">{d.title}</h3>}
                  <ul class="bullets-list">
                    {items.map((item: string) => (
                      <li><Fragment set:html={cleanHtml(item)} /></li>
                    ))}
                  </ul>
                </div>
              );
            }

            case 'nested-bullets': {
              const items = Array.isArray(d.items) ? d.items : [];
              const markerStyle = d.markerStyle || 'coven';
              const titleData = typeof d.title === 'object' && d.title !== null
                ? { text: d.title.text || d.title.content || '', align: d.title.align || 'left' }
                : { text: typeof d.title === 'string' ? d.title : '', align: 'left' };
              return (
                <div class="block-nested-bullets" data-marker-style={markerStyle}>
                  {titleData.text && (
                    <h3 class={`list-title${titleData.align && titleData.align !== 'left' ? ` rich-align-${titleData.align}` : ''}`}>
                      <Fragment set:html={cleanHtml(titleData.text)} />
                    </h3>
                  )}
                  <ul class="nested-bullets-list">
                    {items.map((mainItem: any) => {
                      const mainData = typeof mainItem.text === 'object' && mainItem.text !== null
                        ? { text: mainItem.text.text || mainItem.text.content || '', align: mainItem.text.align || 'left' }
                        : { text: typeof mainItem.text === 'string' ? mainItem.text : '', align: 'left' };
                      const subItems = mainItem.children || mainItem.subItems || [];
                      return (
                        <li class="nested-bullet-main">
                          <span class={`bullet-text${mainData.align && mainData.align !== 'left' ? ` rich-align-${mainData.align}` : ''}`}>
                            <span class="bullet-inner-text" style={mainData.align && mainData.align !== 'left' ? `text-align: ${mainData.align}; width: 100%;` : undefined}>
                              <Fragment set:html={cleanHtml(mainData.text || '')} />
                            </span>
                          </span>
                          {Array.isArray(subItems) && subItems.length > 0 && (
                            <ul class="sub-bullets-list">
                              {subItems.map((sub: any) => {
                                const subRaw = typeof sub === 'object' && sub !== null ? (sub.text !== undefined ? sub.text : sub) : sub;
                                const subData = typeof subRaw === 'object' && subRaw !== null
                                  ? { text: subRaw.text || subRaw.content || '', align: subRaw.align || 'left' }
                                  : { text: typeof subRaw === 'string' ? subRaw : '', align: 'left' };
                                return (
                                  <li class={`sub-bullet-item${subData.align && subData.align !== 'left' ? ` rich-align-${subData.align}` : ''}`}>
                                    <span class="sub-bullet-inner-text" style={subData.align && subData.align !== 'left' ? `text-align: ${subData.align}; width: 100%;` : undefined}>
                                      <Fragment set:html={cleanHtml(subData.text)} />
                                    </span>
                                  </li>
                                );
                              })}
                            </ul>
                          )}
                        </li>
                      );
                    })}
                  </ul>
                </div>
              );
            }

            case 'numbered-steps': {
              const steps = Array.isArray(d.steps) ? d.steps : [];
              const titleData = typeof d.title === 'object' && d.title !== null
                ? { text: d.title.text || d.title.content || '', align: d.title.align || 'left' }
                : { text: typeof d.title === 'string' ? d.title : '', align: 'left' };
              return (
                <div class="block-numbered-steps">
                  {titleData.text && (
                    <h3 class={`list-title${titleData.align && titleData.align !== 'left' ? ` rich-align-${titleData.align}` : ''}`}>
                      <Fragment set:html={cleanHtml(titleData.text)} />
                    </h3>
                  )}
                  <ol class="steps-list">
                    {steps.map((step: any, idx: number) => {
                      const stepTitle = typeof step.title === 'object' && step.title !== null
                        ? { text: step.title.text || step.title.content || '', align: step.title.align || 'left' }
                        : { text: typeof step.title === 'string' ? step.title : '', align: 'left' };
                      const stepText = typeof step.text === 'object' && step.text !== null
                        ? { text: step.text.text || step.text.content || '', align: step.text.align || 'left' }
                        : { text: typeof step.text === 'string' ? step.text : '', align: 'left' };
                      return (
                        <li class="step-item">
                          <div class="step-badge">{step.badge || String(idx + 1).padStart(2, '0')}</div>
                          <div class="step-content" style="flex:1">
                            {stepTitle.text && (
                              <h4 class={stepTitle.align && stepTitle.align !== 'left' ? `rich-align-${stepTitle.align}` : undefined}>
                                <Fragment set:html={cleanHtml(stepTitle.text)} />
                              </h4>
                            )}
                            {stepText.text && (
                              <p class={stepText.align && stepText.align !== 'left' ? `rich-align-${stepText.align}` : undefined}>
                                <Fragment set:html={cleanHtml(stepText.text)} />
                              </p>
                            )}
                          </div>
                        </li>
                      );
                    })}
                  </ol>
                </div>
              );
            }

            case 'text-image': {
              const headingData = getRich(d.heading);
              const textData = getRich(d.text);
              const captionData = getRich(d.caption);
              const plainHeading = getPlainHeadingText(headingData.text);
              const isTocSub = plainHeading.length > 0;
              const subId = `sub-${block.id || `${sIndex}-${bIndex}`}`;

              return (
                <div class="layout-text-media">
                  <div class="layout-copy">
                    {headingData.text && (
                      <h3
                        id={subId}
                        data-toc-sub={isTocSub ? 'true' : undefined}
                        data-toc-subtitle={isTocSub ? plainHeading : undefined}
                        class={headingData.align !== 'left' ? `rich-align-${headingData.align}` : undefined}
                      >
                        <Fragment set:html={cleanHtml(headingData.text)} />
                      </h3>
                    )}
                    {textData.text && (
                      <p class={textData.align !== 'left' ? `rich-align-${textData.align}` : undefined}>
                        <Fragment set:html={cleanHtml(textData.text)} />
                      </p>
                    )}
                  </div>
                  {d.imageSrc && (
                    <figure class="layout-media">
                      <img src={d.imageSrc} alt={d.alt || ''} loading="lazy" />
                      {captionData.text && (
                        <figcaption class={captionData.align !== 'left' ? `rich-align-${captionData.align}` : undefined}>
                          <Fragment set:html={cleanHtml(captionData.text)} />
                        </figcaption>
                      )}
                    </figure>
                  )}
                </div>
              );
            }

            case 'image-text': {
              const headingData = getRich(d.heading);
              const textData = getRich(d.text);
              const captionData = getRich(d.caption);
              const plainHeading = getPlainHeadingText(headingData.text);
              const isTocSub = plainHeading.length > 0;
              const subId = `sub-${block.id || `${sIndex}-${bIndex}`}`;

              return (
                <div class="layout-media-text">
                  {d.imageSrc && (
                    <figure class="layout-media">
                      <img src={d.imageSrc} alt={d.alt || ''} loading="lazy" />
                      {captionData.text && (
                        <figcaption class={captionData.align !== 'left' ? `rich-align-${captionData.align}` : undefined}>
                          <Fragment set:html={cleanHtml(captionData.text)} />
                        </figcaption>
                      )}
                    </figure>
                  )}
                  <div class="layout-copy">
                    {headingData.text && (
                      <h3
                        id={subId}
                        data-toc-sub={isTocSub ? 'true' : undefined}
                        data-toc-subtitle={isTocSub ? plainHeading : undefined}
                        class={headingData.align !== 'left' ? `rich-align-${headingData.align}` : undefined}
                      >
                        <Fragment set:html={cleanHtml(headingData.text)} />
                      </h3>
                    )}
                    {textData.text && (
                      <p class={textData.align !== 'left' ? `rich-align-${textData.align}` : undefined}>
                        <Fragment set:html={cleanHtml(textData.text)} />
                      </p>
                    )}
                  </div>
                </div>
              );
            }

            case 'two-columns': {
              const c1Title = getRich(d.col1Title);
              const c1Text = getRich(d.col1Text);
              const c2Title = getRich(d.col2Title);
              const c2Text = getRich(d.col2Text);
              return (
                <div class="layout-2col">
                  <div class="col-box">
                    {c1Title.text && <h3 class={c1Title.align !== 'left' ? `rich-align-${c1Title.align}` : undefined}><Fragment set:html={cleanHtml(c1Title.text)} /></h3>}
                    {c1Text.text && <p class={c1Text.align !== 'left' ? `rich-align-${c1Text.align}` : undefined}><Fragment set:html={cleanHtml(c1Text.text)} /></p>}
                    {Array.isArray(d.col1List) && d.col1List.length > 0 && (
                      <ul class="col-list">
                        {d.col1List.map((li: string) => <li><Fragment set:html={cleanHtml(li)} /></li>)}
                      </ul>
                    )}
                  </div>
                  <div class="col-box">
                    {c2Title.text && <h3 class={c2Title.align !== 'left' ? `rich-align-${c2Title.align}` : undefined}><Fragment set:html={cleanHtml(c2Title.text)} /></h3>}
                    {c2Text.text && <p class={c2Text.align !== 'left' ? `rich-align-${c2Text.align}` : undefined}><Fragment set:html={cleanHtml(c2Text.text)} /></p>}
                    {Array.isArray(d.col2List) && d.col2List.length > 0 && (
                      <ul class="col-list">
                        {d.col2List.map((li: string) => <li><Fragment set:html={cleanHtml(li)} /></li>)}
                      </ul>
                    )}
                  </div>
                </div>
              );
            }

            case 'three-columns':
              return (
                <div class="layout-3col">
                  {(Array.isArray(d.columns) ? d.columns : []).map((col: any) => {
                    const colTitle = getRich(col.title);
                    const colText = getRich(col.text);
                    return (
                      <div class="col-box">
                        {col.kicker && <div class="col-kicker">{col.kicker}</div>}
                        {colTitle.text && <h3 class={colTitle.align !== 'left' ? `rich-align-${colTitle.align}` : undefined}><Fragment set:html={cleanHtml(colTitle.text)} /></h3>}
                        {colText.text && <p class={colText.align !== 'left' ? `rich-align-${colText.align}` : undefined}><Fragment set:html={cleanHtml(colText.text)} /></p>}
                      </div>
                    );
                  })}
                </div>
              );

            case 'single-image': {
              const captionData = getRich(d.caption);
              return d.src ? (
                <figure class="figure-single">
                  <img src={d.src} alt={d.alt || ''} loading="lazy" />
                  {captionData.text && <figcaption class={captionData.align !== 'left' ? `rich-align-${captionData.align}` : undefined}><Fragment set:html={cleanHtml(captionData.text)} /></figcaption>}
                </figure>
              ) : null;
            }

            case 'full-image': {
              const captionData = getRich(d.caption);
              return d.src ? (
                <figure class="figure-full">
                  <img src={d.src} alt={d.alt || ''} loading="lazy" />
                  {captionData.text && <figcaption class={captionData.align !== 'left' ? `rich-align-${captionData.align}` : undefined}><Fragment set:html={cleanHtml(captionData.text)} /></figcaption>}
                </figure>
              ) : null;
            }

            case 'two-images': {
              const cap1 = getRich(d.img1Caption);
              const cap2 = getRich(d.img2Caption);
              return (
                <div class="image-grid-2">
                  {d.img1Src && (
                    <figure class="figure-item">
                      <img src={d.img1Src} alt={d.img1Alt || ''} loading="lazy" />
                      {cap1.text && <figcaption class={cap1.align !== 'left' ? `rich-align-${cap1.align}` : undefined}><Fragment set:html={cleanHtml(cap1.text)} /></figcaption>}
                    </figure>
                  )}
                  {d.img2Src && (
                    <figure class="figure-item">
                      <img src={d.img2Src} alt={d.img2Alt || ''} loading="lazy" />
                      {cap2.text && <figcaption class={cap2.align !== 'left' ? `rich-align-${cap2.align}` : undefined}><Fragment set:html={cleanHtml(cap2.text)} /></figcaption>}
                    </figure>
                  )}
                </div>
              );
            }

            case 'three-images': {
              const cap1 = getRich(d.img1Caption);
              const cap2 = getRich(d.img2Caption);
              const cap3 = getRich(d.img3Caption);
              return (
                <div class="image-grid-3">
                  {d.img1Src && (
                    <figure class="figure-item">
                      <img src={d.img1Src} alt={d.img1Alt || ''} loading="lazy" />
                      {cap1.text && <figcaption class={cap1.align !== 'left' ? `rich-align-${cap1.align}` : undefined}><Fragment set:html={cleanHtml(cap1.text)} /></figcaption>}
                    </figure>
                  )}
                  {d.img2Src && (
                    <figure class="figure-item">
                      <img src={d.img2Src} alt={d.img2Alt || ''} loading="lazy" />
                      {cap2.text && <figcaption class={cap2.align !== 'left' ? `rich-align-${cap2.align}` : undefined}><Fragment set:html={cleanHtml(cap2.text)} /></figcaption>}
                    </figure>
                  )}
                  {d.img3Src && (
                    <figure class="figure-item">
                      <img src={d.img3Src} alt={d.img3Alt || ''} loading="lazy" />
                      {cap3.text && <figcaption class={cap3.align !== 'left' ? `rich-align-${cap3.align}` : undefined}><Fragment set:html={cleanHtml(cap3.text)} /></figcaption>}
                    </figure>
                  )}
                </div>
              );
            }

            case 'gallery-scroll':
              return (
                <div class="horizontal-scroll-wrap">
                  <div class="horizontal-scroll" role="region" aria-label="Horizontal image gallery" tabindex="0">
                    {(Array.isArray(d.cards) ? d.cards : []).map((card: any) => {
                      const cardCap = getRich(card.caption);
                      return card.src ? (
                        <figure class="gallery-card">
                          <img src={card.src} alt={card.alt || ''} loading="lazy" />
                          {cardCap.text && <figcaption class={cardCap.align !== 'left' ? `rich-align-${cardCap.align}` : undefined}><Fragment set:html={cleanHtml(cardCap.text)} /></figcaption>}
                        </figure>
                      ) : null;
                    })}
                  </div>
                  {d.hint && <div class="gallery-scroll-hint">{d.hint}</div>}
                </div>
              );

            case 'card-grid-2': {
              const c1Title = getRich(d.card1Title);
              const c1Desc = getRich(d.card1Desc);
              const c2Title = getRich(d.card2Title);
              const c2Desc = getRich(d.card2Desc);
              return (
                <div class="card-grid-2">
                  <div class="pattern-card">
                    {d.card1Icon && <div class="pattern-card-icon">{d.card1Icon}</div>}
                    {c1Title.text && <h3 class={`pattern-card-title${c1Title.align !== 'left' ? ` rich-align-${c1Title.align}` : ''}`}><Fragment set:html={cleanHtml(c1Title.text)} /></h3>}
                    {c1Desc.text && <p class={`pattern-card-desc${c1Desc.align !== 'left' ? ` rich-align-${c1Desc.align}` : ''}`}><Fragment set:html={cleanHtml(c1Desc.text)} /></p>}
                  </div>
                  <div class="pattern-card">
                    {d.card2Icon && <div class="pattern-card-icon">{d.card2Icon}</div>}
                    {c2Title.text && <h3 class={`pattern-card-title${c2Title.align !== 'left' ? ` rich-align-${c2Title.align}` : ''}`}><Fragment set:html={cleanHtml(c2Title.text)} /></h3>}
                    {c2Desc.text && <p class={`pattern-card-desc${c2Desc.align !== 'left' ? ` rich-align-${c2Desc.align}` : ''}`}><Fragment set:html={cleanHtml(c2Desc.text)} /></p>}
                  </div>
                </div>
              );
            }

            case 'card-grid-3': {
              const c1Title = getRich(d.card1Title);
              const c1Desc = getRich(d.card1Desc);
              const c2Title = getRich(d.card2Title);
              const c2Desc = getRich(d.card2Desc);
              const c3Title = getRich(d.card3Title);
              const c3Desc = getRich(d.card3Desc);
              return (
                <div class="card-grid-3">
                  <div class="pattern-card">
                    {d.card1Icon && <div class="pattern-card-icon">{d.card1Icon}</div>}
                    {c1Title.text && <h3 class={`pattern-card-title${c1Title.align !== 'left' ? ` rich-align-${c1Title.align}` : ''}`}><Fragment set:html={cleanHtml(c1Title.text)} /></h3>}
                    {c1Desc.text && <p class={`pattern-card-desc${c1Desc.align !== 'left' ? ` rich-align-${c1Desc.align}` : ''}`}><Fragment set:html={cleanHtml(c1Desc.text)} /></p>}
                  </div>
                  <div class="pattern-card">
                    {d.card2Icon && <div class="pattern-card-icon">{d.card2Icon}</div>}
                    {c2Title.text && <h3 class={`pattern-card-title${c2Title.align !== 'left' ? ` rich-align-${c2Title.align}` : ''}`}><Fragment set:html={cleanHtml(c2Title.text)} /></h3>}
                    {c2Desc.text && <p class={`pattern-card-desc${c2Desc.align !== 'left' ? ` rich-align-${c2Desc.align}` : ''}`}><Fragment set:html={cleanHtml(c2Desc.text)} /></p>}
                  </div>
                  <div class="pattern-card">
                    {d.card3Icon && <div class="pattern-card-icon">{d.card3Icon}</div>}
                    {c3Title.text && <h3 class={`pattern-card-title${c3Title.align !== 'left' ? ` rich-align-${c3Title.align}` : ''}`}><Fragment set:html={cleanHtml(c3Title.text)} /></h3>}
                    {c3Desc.text && <p class={`pattern-card-desc${c3Desc.align !== 'left' ? ` rich-align-${c3Desc.align}` : ''}`}><Fragment set:html={cleanHtml(c3Desc.text)} /></p>}
                  </div>
                </div>
              );
            }

            case 'comparison': {
              const h1 = getRich(d.col1Header);
              const h2 = getRich(d.col2Header);
              const col1Items = (Array.isArray(d.col1Items) ? d.col1Items : [])
                .map((it: any) => getRich(it))
                .filter(it => it.text);
              const col2Items = (Array.isArray(d.col2Items) ? d.col2Items : [])
                .map((it: any) => getRich(it))
                .filter(it => it.text);
              return (
                <div class="comparison-split">
                  <div class="comparison-column">
                    <div class="comparison-col-header">
                      {d.col1Icon && <span class="comparison-col-icon">{d.col1Icon}</span>}
                      <span class={h1.align !== 'left' ? `rich-align-${h1.align}` : undefined}><Fragment set:html={cleanHtml(h1.text)} /></span>
                    </div>
                    <ul class="comparison-list">
                      {col1Items.map((item: any) => (
                        <li class={item.align !== 'left' ? `rich-align-${item.align}` : undefined}><Fragment set:html={cleanHtml(item.text)} /></li>
                      ))}
                    </ul>
                  </div>
                  <div class="comparison-column">
                    <div class="comparison-col-header">
                      {d.col2Icon && <span class="comparison-col-icon">{d.col2Icon}</span>}
                      <span class={h2.align !== 'left' ? `rich-align-${h2.align}` : undefined}><Fragment set:html={cleanHtml(h2.text)} /></span>
                    </div>
                    <ul class="comparison-list">
                      {col2Items.map((item: any) => (
                        <li class={item.align !== 'left' ? `rich-align-${item.align}` : undefined}><Fragment set:html={cleanHtml(item.text)} /></li>
                      ))}
                    </ul>
                  </div>
                </div>
              );
            }

            case 'stats-metrics': {
              const s1Label = getRich(d.stat1Label);
              const s1Sub = getRich(d.stat1Sub);
              const s2Label = getRich(d.stat2Label);
              const s2Sub = getRich(d.stat2Sub);
              const s3Label = getRich(d.stat3Label);
              const s3Sub = getRich(d.stat3Sub);
              return (
                <div class="stats-grid">
                  <div class="stat-card">
                    <div class="stat-number">{d.stat1Num}</div>
                    <div class={`stat-label${s1Label.align !== 'left' ? ` rich-align-${s1Label.align}` : ''}`}><Fragment set:html={cleanHtml(s1Label.text)} /></div>
                    {s1Sub.text && <div class={`stat-sub${s1Sub.align !== 'left' ? ` rich-align-${s1Sub.align}` : ''}`}><Fragment set:html={cleanHtml(s1Sub.text)} /></div>}
                  </div>
                  <div class="stat-card">
                    <div class="stat-number">{d.stat2Num}</div>
                    <div class={`stat-label${s2Label.align !== 'left' ? ` rich-align-${s2Label.align}` : ''}`}><Fragment set:html={cleanHtml(s2Label.text)} /></div>
                    {s2Sub.text && <div class={`stat-sub${s2Sub.align !== 'left' ? ` rich-align-${s2Sub.align}` : ''}`}><Fragment set:html={cleanHtml(s2Sub.text)} /></div>}
                  </div>
                  <div class="stat-card">
                    <div class="stat-number">{d.stat3Num}</div>
                    <div class={`stat-label${s3Label.align !== 'left' ? ` rich-align-${s3Label.align}` : ''}`}><Fragment set:html={cleanHtml(s3Label.text)} /></div>
                    {s3Sub.text && <div class={`stat-sub${s3Sub.align !== 'left' ? ` rich-align-${s3Sub.align}` : ''}`}><Fragment set:html={cleanHtml(s3Sub.text)} /></div>}
                  </div>
                </div>
              );
            }

            case 'technical-table': {
              const hasStructuredCols = Array.isArray(d.columns) && d.columns.length > 0;
              const columns = hasStructuredCols
                ? d.columns
                : (Array.isArray(d.headers) ? d.headers.map((h: string, i: number) => ({ id: `col_${i}`, label: h })) : []);
              const rows = Array.isArray(d.rows) ? d.rows : [];

              return (
                <div class="table-wrap">
                  <table class="coven-table">
                    <thead>
                      <tr>
                        {columns.map((col: any) => {
                          const colData = getRich(col.label);
                          return (
                            <th class={colData.align !== 'left' ? `rich-align-${colData.align}` : undefined}>
                              <Fragment set:html={cleanHtml(colData.text)} />
                            </th>
                          );
                        })}
                      </tr>
                    </thead>
                    <tbody>
                      {rows.map((row: any) => (
                        <tr>
                          {columns.map((col: any, cIdx: number) => {
                            let cellVal = '';
                            if (row.cells && row.cells[col.id] !== undefined) {
                              cellVal = row.cells[col.id];
                            } else if (row[`col${cIdx + 1}`] !== undefined) {
                              cellVal = row[`col${cIdx + 1}`];
                            } else if (Array.isArray(row)) {
                              cellVal = row[cIdx] || '';
                            }
                            const cellData = getRich(cellVal);
                            return (
                              <td class={cellData.align !== 'left' ? `rich-align-${cellData.align}` : undefined}>
                                <Fragment set:html={cleanHtml(cellData.text)} />
                              </td>
                            );
                          })}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              );
            }

            case 'callout': {
              const showTitle = d.showTitle !== false && d.titleMode !== 'hidden';
              const isCustom = d.titleMode === 'custom' && d.title;
              const cTitle = isCustom ? getRich(d.title) : null;
              const cText = getRich(d.text);
              return (
                <Callout
                  type={d.calloutType || 'info'}
                  showTitle={showTitle}
                  title={cTitle && cTitle.text ? cleanHtml(cTitle.text) : undefined}
                  accentColor={d.accentColor}
                >
                  <p class={cText.align !== 'left' ? `rich-align-${cText.align}` : undefined}><Fragment set:html={cleanHtml(cText.text || '')} /></p>
                </Callout>
              );
            }

            case 'pullquote': {
              const qRich = getRich(d.quote);
              const aRich = getRich(d.author);
              const rawCleanedQuote = cleanHtml(qRich.text || '');
              const plainQuote = rawCleanedQuote.replace(/<[^>]+>/g, '').trim();
              const hasStartQuote = /^["“'«]/.test(plainQuote);
              const hasEndQuote = /["”'»]$/.test(plainQuote);
              const needsQuotes = plainQuote.length > 0 && !(hasStartQuote && hasEndQuote);

              return (
                <div class="pullquote">
                  <p class={`pullquote-text${qRich.align !== 'left' ? ` rich-align-${qRich.align}` : ''}`}>
                    {needsQuotes ? '"' : ''}<Fragment set:html={rawCleanedQuote} />{needsQuotes ? '"' : ''}
                  </p>
                  {aRich.text && (
                    <span class={`pullquote-author${aRich.align !== 'left' ? ` rich-align-${aRich.align}` : ''}`}>
                      <Fragment set:html={cleanHtml(aRich.text)} />
                    </span>
                  )}
                </div>
              );
            }

            case 'code-block': {
              const codeTitle = getRich(d.title);
              return (
                <CodeBlock title={codeTitle.text ? cleanHtml(codeTitle.text) : undefined} language={d.language || 'typescript'} code={d.code || ''} />
              );
            }

            case 'faq':
              return (
                <div class="faq-list">
                  {(Array.isArray(d.items) ? d.items : []).map((item: any) => {
                    const qRich = getRich(item.question);
                    const aRich = getRich(item.answer);
                    return (
                      <details class="faq-item">
                        <summary class={qRich.align !== 'left' ? `rich-align-${qRich.align}` : undefined}><Fragment set:html={cleanHtml(qRich.text)} /></summary>
                        <div class="faq-body">
                          <p class={aRich.align !== 'left' ? `rich-align-${aRich.align}` : undefined}><Fragment set:html={cleanHtml(aRich.text)} /></p>
                        </div>
                      </details>
                    );
                  })}
                </div>
              );

            case 'exercise': {
              const targetId = `ans-${sIndex}-${bIndex}`;
              const scRich = getRich(d.scenario);
              const stRich = getRich(d.solutionTitle);
              const sxRich = getRich(d.solutionText);
              return (
                <div class="exercise-group">
                  <div class="exercise-card">
                    {d.badge && <span class="exercise-badge">{d.badge}</span>}
                    <p class={`exercise-scenario${scRich.align !== 'left' ? ` rich-align-${scRich.align}` : ''}`}>
                      <strong>Scenario:</strong> <Fragment set:html={cleanHtml(scRich.text || '')} />
                    </p>
                    <button type="button" class="reveal-btn" aria-expanded="false" data-target={targetId}>
                      <span>{d.buttonText || '✦ Reveal Answer'}</span>
                    </button>
                    <div id={targetId} class="reveal-answer">
                      {stRich.text && <strong class={stRich.align !== 'left' ? `rich-align-${stRich.align}` : undefined}><Fragment set:html={cleanHtml(stRich.text)} /></strong>}
                      <p class={sxRich.align !== 'left' ? `rich-align-${sxRich.align}` : undefined}><Fragment set:html={cleanHtml(sxRich.text || '')} /></p>
                    </div>
                  </div>
                </div>
              );
            }

            case 'key-takeaways': {
              const tTitle = getRich(d.title);
              return (
                <div class="takeaways-box">
                  {tTitle.text && (
                    <h3 class={`takeaways-title${tTitle.align !== 'left' ? ` rich-align-${tTitle.align}` : ''}`}>
                      <span>✦</span>
                      <span><Fragment set:html={cleanHtml(tTitle.text)} /></span>
                    </h3>
                  )}
                  <div class="takeaways-table" role="list">
                    {(Array.isArray(d.items) ? d.items : []).map((item: any) => {
                      const itTerm = getRich(item.term);
                      const itDesc = getRich(item.desc);
                      return (
                        <div class="takeaway-row" role="listitem">
                          <span class="takeaway-glyph" aria-hidden="true">✦</span>
                          <span class={`takeaway-term${itTerm.align !== 'left' ? ` rich-align-${itTerm.align}` : ''}`}><Fragment set:html={cleanHtml(itTerm.text)} /></span>
                          <span class={`takeaway-desc${itDesc.align !== 'left' ? ` rich-align-${itDesc.align}` : ''}`}><Fragment set:html={cleanHtml(itDesc.text)} /></span>
                        </div>
                      );
                    })}
                  </div>
                </div>
              );
            }

            case 'related-docs':
              return (
                <div class="related-grid">
                  {(Array.isArray(d.items) ? d.items : []).map((item: any) => {
                    const href = item.url || (item.slug ? `/article/${item.slug}` : '#');
                    const isExt = item.type === 'external' || href.startsWith('http');
                    const typeLabel = item.type === 'internal'
                      ? 'COVEN SCROLL'
                      : (item.type === 'external' ? 'EXTERNAL DOCUMENTATION' : (item.type || 'DOCUMENTATION'));
                    const arrow = item.ctaArrow || (isExt ? '↗' : '→');
                    const itTitle = getRich(item.title);

                    return (
                      <a href={href} class="related-card" target={isExt ? '_blank' : undefined} rel={isExt ? 'noopener noreferrer' : undefined}>
                        <div>
                          <div class="related-type">{typeLabel}</div>
                          <h4 class={`related-title${itTitle.align !== 'left' ? ` rich-align-${itTitle.align}` : ''}`}><Fragment set:html={cleanHtml(itTitle.text)} /></h4>
                        </div>
                        <div class="related-cta">
                          <span>{item.ctaText || (isExt ? 'Official documentation' : 'Study scroll')}</span>
                          <span>{arrow}</span>
                        </div>
                      </a>
                    );
                  })}
                </div>
              );

            case 'article-trial':
              return (
                <ArticleTrial
                  aetherReward={d.aetherReward ?? doc.meta.aetherReward ?? 120}
                  rank={d.rank ?? doc.meta.rank ?? 'Mechanic'}
                  title={d.title || "You've reached the trial"}
                  description={d.description}
                  intro={d.intro}
                  buttonText={d.buttonText || 'BEGIN THE TRIAL'}
                  quizUrl={d.quizUrl || '/quiz'}
                  questions={d.questions}
                  slug={doc.slug}
                />
              );

            default:
              return null;
          }
        })}
      </section>
    );
  })}
</div>

<style is:global>
  .article-template .rich-align-left { text-align: left; }
  .article-template .rich-align-center { text-align: center; }
  .article-template .rich-align-right { text-align: right; }
  .article-template .bullet-text.rich-align-center,
  .article-template .sub-bullet-item.rich-align-center { justify-content: center; }
  .article-template .bullet-text.rich-align-right,
  .article-template .sub-bullet-item.rich-align-right { justify-content: flex-end; }
  .article-template .article-text-gold { color: #e8cf95; }
  .article-template .article-text-purple { color: #b98fd8; }
  .article-template .article-text-muted { color: #8f857a; }
  .article-template .article-text-default { color: inherit; }

  /* ── Inline Text Highlight / Background Classes ── */
  .article-template .article-text-bg-neutral,
  .article-template .article-text-bg-purple,
  .article-template .article-text-bg-gold,
  .article-template .article-text-bg-green,
  .article-template .article-text-bg-red {
    display: inline;
    padding: 2px 5px;
    border-radius: 3px;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    color: inherit;
  }

  .article-template .article-text-bg-neutral {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(216, 181, 107, 0.18);
  }

  .article-template .article-text-bg-purple {
    background: rgba(185, 143, 216, 0.18);
    border: 1px solid rgba(185, 143, 216, 0.35);
  }

  .article-template .article-text-bg-gold {
    background: rgba(216, 181, 107, 0.16);
    border: 1px solid rgba(216, 181, 107, 0.38);
  }

  .article-template .article-text-bg-green {
    background: rgba(129, 199, 132, 0.16);
    border: 1px solid rgba(129, 199, 132, 0.35);
  }

  .article-template .article-text-bg-red {
    background: rgba(229, 115, 115, 0.18);
    border: 1px solid rgba(229, 115, 115, 0.38);
  }

  /* ── Rich Text Hyperlinks ── */
  .article-template .article-rich-link {
    color: #e8cf95;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
    transition: color 0.15s ease;
  }
  .article-template .article-rich-link:hover {
    color: #f3ecdf;
  }
  .article-template .article-rich-link--gold {
    color: #e8cf95;
  }
  .article-template .article-rich-link--gold:hover {
    color: #f3ecdf;
  }
  .article-template .article-rich-link--purple {
    color: #b98fd8;
  }
  .article-template .article-rich-link--purple:hover {
    color: #d5b2ee;
  }
  .article-template .article-rich-link--parchment {
    color: #ece6dd;
  }
  .article-template .article-rich-link--parchment:hover {
    color: #ffffff;
  }
  .article-template .article-rich-link--muted {
    color: #8f857a;
  }
  .article-template .article-rich-link--muted:hover {
    color: #cdc3b6;
  }
  .article-template .article-rich-link u {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
