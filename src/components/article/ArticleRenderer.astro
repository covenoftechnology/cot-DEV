    width: 100%;
    box-sizing: border-box;
  }

  .article-template .stats-grid.is-single-metric {
    grid-template-columns: minmax(0, 1fr);
  }

  .article-template .stats-grid.is-two-metrics {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .article-template .stat-card {
    min-width: 0;
    box-sizing: border-box;
  }

