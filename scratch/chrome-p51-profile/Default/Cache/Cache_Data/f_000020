    function createProceduralLunarTextures() {
      var w = 1024;
      var h = 512;

      var albedoCanvas = document.createElement('canvas');
      albedoCanvas.width = w;
      albedoCanvas.height = h;
      var aCtx = albedoCanvas.getContext('2d');

      var bumpCanvas = document.createElement('canvas');
      bumpCanvas.width = w;
      bumpCanvas.height = h;
      var bCtx = bumpCanvas.getContext('2d');

      aCtx.fillStyle = '#c4bfca';
      aCtx.fillRect(0, 0, w, h);

      bCtx.fillStyle = '#808080';
      bCtx.fillRect(0, 0, w, h);

      var seed = 90210;
      function rand() {
        seed = (seed * 1664525 + 1013904223) % 4294967296;
        return seed / 4294967296;
      }

      for (var i = 0; i < 320; i++) {
        var x = rand() * w;
        var y = rand() * h;
        var r = 18 + rand() * 75;
        var shade = Math.floor(175 + rand() * 45);
        var grad = aCtx.createRadialGradient(x, y, 0, x, y, r);
        grad.addColorStop(0, 'rgba(' + shade + ',' + (shade - 3) + ',' + (shade + 4) + ', 0.14)');
