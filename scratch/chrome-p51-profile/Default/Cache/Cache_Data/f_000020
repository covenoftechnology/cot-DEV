/* ============================================================
   COVEN OF TECHNOLOGY — DESIGN TOKENS
   Centralized custom properties for colors, typography, spacing
   ============================================================ */
:root {
  /* Color System */
  --cov-bg: #08060e;
  --cov-surface-1: #151121;
  --cov-surface-2: #100d16;
  --cov-surface-hover: #181326;
  --cov-gold: #d8b56b;
  --cov-gold-bright: #e8cf95;
  --cov-gold-deep: #c49a4e;
  --cov-gold-soft: #e3c47e;
  --cov-purple: #b98fd8;
  --cov-purple-glow: #7c4dc4;
  --cov-text-primary: #f3ecdf;
  --cov-text-body: #cdc3b6;
  --cov-text-subtle: #ece6dd;
  --cov-text-muted: #8f857a;
  --cov-text-dim: #9b9189;
  --cov-border: rgba(216, 181, 107, 0.18);
  --cov-border-accent: rgba(216, 181, 107, 0.32);
  --cov-border-purple: rgba(185, 143, 216, 0.28);
  --cov-status-success: #a9e09a;
  --cov-status-warning: #e8cf95;
  --cov-status-disabled: #8f857a;

  /* Typography Families */
  --font-display: 'Metamorphous', serif;
  --font-body: 'Helvetica Neue Roman', serif;
  --font-mono: 'Consolas', monospace;

  /* Harmonic Spacing Scale */
  --space-3xs: 2px;
  --space-2xs: 4px;
  --space-xs: 8px;
  --space-sm: 12px;
  --space-md: 16px;
  --space-lg: 20px;
  --space-xl: 24px;
  --space-2xl: 32px;
  --space-3xl: 40px;
  --space-4xl: 48px;
  --space-5xl: 64px;

  /* Border Radii */
  --radius-xs: 2px;
  --radius-sm: 4px;
  --radius-md: 6px;
  --radius-lg: 8px;
  --radius-full: 9999px;

  /* Transitions */
  --transition-fast: 0.15s ease;
  --transition-normal: 0.2s ease;
}

/* ---- base reset + keyframes ---- */
*, *::before, *::after {
  box-sizing: border-box;
}

:focus-visible {
  outline: 2px solid var(--cov-gold-bright);
  outline-offset: 2px;
}

html, body {
  margin: 0;
  padding: 0;
  width: 100%;
  max-width: 100%;
  background: #040208;
  -webkit-text-size-adjust: 100%;
}

img, svg, video {
  max-width: 100%;
  height: auto;
}

pre, code {
  max-width: 100%;
  overflow-x: auto;
  word-break: normal;
}

h1, h2, h3, h4, h5, h6 {
  overflow-wrap: break-word;
  word-wrap: break-word;
}

/* Animations */
@keyframes covGlow   { 0%,100%{opacity:.55} 50%{opacity:1} }
@keyframes covFloat  { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-8px)} }
@keyframes covTwinkle{ 0%,100%{opacity:.25} 50%{opacity:.9} }
@keyframes covPop    { 0%{transform:scale(.96);opacity:0} 100%{transform:scale(1);opacity:1} }

