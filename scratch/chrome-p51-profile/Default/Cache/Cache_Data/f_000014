      }

      // ── Attach Event Listeners to Block Fields ──────────
      function attachBlockListeners(bBody, sec, block) {
        var d = block.data;

        // Rich text listeners for any block with rich-text-field-wrap
        if (bBody.querySelector('.rich-text-field-wrap')) {
          attachRichTextListeners(bBody, sec, block);
        }

        // Table rich text listeners for technical-table
        if (block.type === 'technical-table') {
          attachTableRichTextListeners(bBody, sec, block);
        }

        // 1. Direct field inputs
        bBody.querySelectorAll('[data-field]').forEach(function(input) {
          var field = input.getAttribute('data-field');
          input.addEventListener('input', function(e) {
            d[field] = e.target.value;
            calculateReadingTime();
            triggerAutosave();
          });
        });

        // 2. Array primitive fields (e.g. paragraphs)
        bBody.querySelectorAll('[data-array-field]').forEach(function(input) {
          var field = input.getAttribute('data-array-field');
          var idx = parseInt(input.getAttribute('data-array-idx'), 10);
          input.addEventListener('input', function(e) {
            if (Array.isArray(d[field])) {
              d[field][idx] = e.target.value;
              calculateReadingTime();
              triggerAutosave();
            }
          });
        });

        // 3. Array of objects fields (e.g. steps, items, columns)
        bBody.querySelectorAll('[data-array-obj]').forEach(function(input) {
          var arrayName = input.getAttribute('data-array-obj');
          var itemId = input.getAttribute('data-item-id');
          var prop = input.getAttribute('data-prop');
          input.addEventListener('input', function(e) {
            var arr = d[arrayName];
            if (Array.isArray(arr)) {
              var target = arr.find(function(it) { return it.id === itemId; });
              if (target) {
                target[prop] = e.target.value;
                calculateReadingTime();
                triggerAutosave();
              }
            }
          });
        });

        // 4. Nested sub-items
        bBody.querySelectorAll('[data-nested-sub="true"]').forEach(function(input) {
          var subId = input.getAttribute('data-sub-id');
          input.addEventListener('input', function(e) {
            var foundSub = findNestedBulletNodeById(d.items || [], subId);
            if (foundSub && foundSub.node) {
              foundSub.node.text = e.target.value;
              calculateReadingTime();
              triggerAutosave();
            }
          });
        });

        // 5. Image sub-fields (alt, caption)
        bBody.querySelectorAll('[data-img-subfield]').forEach(function(input) {
          var sub = input.getAttribute('data-img-subfield');
          var propPrefix = input.getAttribute('data-img-prop');
          input.addEventListener('input', function(e) {
            if (propPrefix === 'imageSrc' || propPrefix === 'src') {
              d[sub] = e.target.value;
            } else if (propPrefix.startsWith('img') && propPrefix.length === 4) {
              // e.g. img1, img2, img3
              d[propPrefix + (sub === 'alt' ? 'Alt' : 'Caption')] = e.target.value;
            } else if (propPrefix.startsWith('gcard_')) {
              var cardId = propPrefix.replace('gcard_', '');
              var card = (d.cards || []).find(function(c) { return c.id === cardId; });
              if (card) card[sub] = e.target.value;
            }
            calculateReadingTime();
            triggerAutosave();
          });
        });

        // 6. External URL input for images
        bBody.querySelectorAll('[data-ext-url-input]').forEach(function(input) {
          var propPrefix = input.getAttribute('data-img-prop');
          input.addEventListener('change', function(e) {
            var url = (e.target.value || '').trim();
            if (!url) return;
            applyImageUrl(d, propPrefix, url);
            renderSections();
            triggerAutosave();
          });
        });

        // 7. Table Builder cell inputs
        bBody.querySelectorAll('[data-table-header]').forEach(function(input) {
          var colId = input.getAttribute('data-table-header');
          input.addEventListener('input', function(e) {
            var col = (d.columns || []).find(function(c) { return c.id === colId; });
            if (col) {
              col.label = e.target.value;
              triggerAutosave();
            }
          });
        });

        bBody.querySelectorAll('[data-table-row]').forEach(function(input) {
          var rowId = input.getAttribute('data-table-row');
          var colId = input.getAttribute('data-table-col');
          input.addEventListener('input', function(e) {
            var row = (d.rows || []).find(function(r) { return r.id === rowId; });
            if (row) {
              row.cells = row.cells || {};
              row.cells[colId] = e.target.value;
              calculateReadingTime();
              triggerAutosave();
            }
          });
        });

        // 8. Trial Builder inputs
        bBody.querySelectorAll('[data-trial-q]').forEach(function(input) {
          var qId = input.getAttribute('data-q-id');
          var prop = input.getAttribute('data-trial-q');
          input.addEventListener('input', function(e) {
            var q = (d.questions || []).find(function(it) { return it.id === qId; });
            if (q) {
              q[prop === 'text' ? 'question' : prop] = e.target.value;
              calculateReadingTime();
              triggerAutosave();
            }
          });
        });

        bBody.querySelectorAll('[data-trial-ans]').forEach(function(input) {
          var qId = input.getAttribute('data-q-id');
          var ansId = input.getAttribute('data-ans-id');
          input.addEventListener('input', function(e) {
            var q = (d.questions || []).find(function(it) { return it.id === qId; });
            if (q && Array.isArray(q.answers)) {
              var ans = q.answers.find(function(a) { return a.id === ansId; });
              if (ans) {
                ans.text = e.target.value;
                calculateReadingTime();
                triggerAutosave();
              }
            }
          });
        });

        // 9. Related Docs Select dropdown
        bBody.querySelectorAll('[data-doc-select-slug]').forEach(function(select) {
          var docId = select.getAttribute('data-doc-select-slug');
          select.addEventListener('change', function(e) {
            var slug = e.target.value;
            var docItem = (d.items || []).find(function(it) { return it.id === docId; });
            if (docItem) {
              var found = (window.STUDIO_PUBLISHED_ARTICLES || []).find(function(a) { return a.slug === slug; });
              if (found) {
                docItem.title = found.title;
                docItem.slug = found.slug;
                docItem.url = '/article/' + found.slug;
                docItem.ctaText = 'Study scroll';
              }
              renderSections();
              triggerAutosave();
            }
          });
        });

        // 10. Drag & Drop support for image dropzones inside block
        bBody.querySelectorAll('.studio-img-dropzone').forEach(function(dz) {
          var propPrefix = dz.getAttribute('data-img-prop');
          dz.addEventListener('dragover', function(e) {
            e.preventDefault();
            e.stopPropagation();
            dz.style.borderColor = 'var(--studio-gold)';
          });
          dz.addEventListener('dragleave', function(e) {
            e.stopPropagation();
            dz.style.borderColor = '';
          });
          dz.addEventListener('drop', function(e) {
            e.preventDefault();
            e.stopPropagation();
            dz.style.borderColor = '';
            var file = e.dataTransfer.files && e.dataTransfer.files[0];
            if (file && file.type.startsWith('image/')) {
              showToast('Uploading image...', 'saving');
              uploadImageFile(file, function(err, url) {
                if (err) {
                  showToast('Upload failed: ' + err.message, 'error');
                } else {
                  showToast('Image uploaded: ' + file.name, 'success');
                  applyImageUrl(d, propPrefix, url);
                  renderSections();
                  triggerAutosave();
                }
              });
            }
          });
        });

        // Callout Show Heading Toggle
        bBody.querySelectorAll('.callout-toggle-heading').forEach(function(cb) {
          cb.addEventListener('change', function(e) {
            d.showTitle = e.target.checked;
            renderSections();
            triggerAutosave();
          });
        });

        // 11. Unified Action Delegator for buttons
        bBody.addEventListener('click', function(e) {
          if (e.target.closest('.block-editor-body') !== bBody) return;
          if (activeSectionId !== sec.id) {
            setActiveSection(sec.id);
          }
          var actBtn = e.target.closest('[data-act]');
          if (!actBtn) return;
          var act = actBtn.getAttribute('data-act');

          switch (act) {
            // Optional Fields
            case 'add-field':
              var optField = actBtn.getAttribute('data-opt-field');
              d[optField] = '';
              renderSections();
              triggerAutosave();
              var blockEl = document.querySelector('[data-block-id="' + block.id + '"]');
              if (blockEl) {
                var newInput = blockEl.querySelector('[data-field="' + optField + '"]');
                if (newInput) newInput.focus();
              }
              break;

            case 'remove-field':
              var remField = actBtn.getAttribute('data-opt-field');
              delete d[remField];
              renderSections();
              triggerAutosave();
              break;

            // Toggle Show Text
            case 'toggle-show-text':
              d.showText = d.showText === false ? true : false;
              renderSections();
              triggerAutosave();
              calculateReadingTime();
              showToast(d.showText ? 'Paragraphs visible' : 'Paragraphs hidden');
              break;

            // Paragraphs
            case 'add-paragraph':
              d.paragraphs = d.paragraphs || [];
              d.paragraphs.push({ text: '', align: 'left' });
              renderSections();
              triggerAutosave();
              break;

            case 'del-paragraph':
              var pIdx = parseInt(actBtn.getAttribute('data-idx'), 10);
              if (d.paragraphs && d.paragraphs.length > 1) {
                d.paragraphs.splice(pIdx, 1);
                renderSections();
                triggerAutosave();
              }
              break;

            // Bullets
            case 'add-bullet':
              d.items = d.items || [];
              d.items.push({ id: uid('item'), text: '' });
              renderSections();
              triggerAutosave();
              break;

            case 'del-bullet':
              var bId = actBtn.getAttribute('data-item-id');
              if (d.items && d.items.length > 1) {
                d.items = d.items.filter(function(it) { return it.id !== bId; });
                renderSections();
                triggerAutosave();
              }
              break;

            // Nested Bullets
            case 'toggle-marker-dropdown':
              e.stopPropagation();
              var markerWrap = actBtn.closest('.nested-marker-dropdown-wrap');
              if (markerWrap) {
                var dd = markerWrap.querySelector('.nested-marker-dropdown');
                if (dd) {
                  var isDdOpen = dd.style.display === 'flex';
                  closeAllPopovers(dd);
                  if (isDdOpen) {
                    dd.style.display = 'none';
                  } else {
                    openAnchoredPopover(dd, actBtn);
                  }
                }
              }
              break;

            case 'select-marker':
              e.stopPropagation();
              var markerVal = actBtn.getAttribute('data-val') || 'coven';
              var blkCard = actBtn.closest('.block-card, .block-editor-card');
              var blkId = blkCard ? blkCard.getAttribute('data-block-id') : block.id;
              var loc = resolveBlockLocation(blkId);
              var targetBlock = loc ? loc.block : block;
              if (targetBlock && targetBlock.data) {
                targetBlock.data.markerStyle = markerVal;
              } else {
                d.markerStyle = markerVal;
              }
              closeAllPopovers();
              renderSections();
              triggerAutosave();
              break;

            case 'set-nested-layout':
              e.stopPropagation();
              var layoutVal = actBtn.getAttribute('data-layout') || 'vertical';
              var blkCard = actBtn.closest('.block-card, .block-editor-card');
              var blkId = blkCard ? blkCard.getAttribute('data-block-id') : block.id;
              var loc = resolveBlockLocation(blkId);
              var targetBlock = loc ? loc.block : block;
              if (targetBlock && targetBlock.data) {
                targetBlock.data.layout = layoutVal;
              } else {
                d.layout = layoutVal;
              }
              renderSections();
              triggerAutosave();
              break;

            case 'add-nested-main':
              d.items = d.items || [];
              d.items.push({ id: uid('main'), text: { text: '', align: 'left' }, children: [] });
              renderSections();
              triggerAutosave();
              break;

            case 'del-nested-main':
              var mId = actBtn.getAttribute('data-item-id');
              if (d.items && d.items.length > 1) {
                d.items = d.items.filter(function(m) { return m.id !== mId; });
                renderSections();
                triggerAutosave();
              }
              break;

            case 'add-nested-sub':
              var pId = actBtn.getAttribute('data-parent-id');
              var foundParent = findNestedBulletNodeById(d.items || [], pId);
              if (foundParent && foundParent.node && canAddNestedListChild(foundParent.depth)) {
                var nextDepth = foundParent.depth + 1;
                foundParent.node.children = Array.isArray(foundParent.node.children) ? foundParent.node.children : [];
                foundParent.node.children.push({
                  id: uid('sub_l' + nextDepth),
                  text: { text: '', align: 'left' },
                  children: []
                });
                renderSections();
                triggerAutosave();
              }
              break;

            case 'del-nested-sub':
              var subId = actBtn.getAttribute('data-sub-id');
              var foundTarget = findNestedBulletNodeById(d.items || [], subId);
              if (foundTarget && foundTarget.parentArray && foundTarget.index !== -1) {
                foundTarget.parentArray.splice(foundTarget.index, 1);
                renderSections();
                triggerAutosave();
              }
              break;

            // Numbered Steps
            case 'add-step':
              d.steps = d.steps || [];
              d.steps.push({ id: uid('step'), badge: String(d.steps.length + 1).padStart(2, '0'), title: { text: '', align: 'left' }, text: { text: '', align: 'left' } });
              renderSections();
              triggerAutosave();
              break;

            case 'del-step':
              var sId = actBtn.getAttribute('data-step-id');
              if (d.steps && d.steps.length > 1) {
                d.steps = d.steps.filter(function(s) { return s.id !== sId; });
                renderSections();
                triggerAutosave();
              }
              break;

            case 'dup-step':
              var stId = actBtn.getAttribute('data-step-id');
              var sIdx = (d.steps || []).findIndex(function(s) { return s.id === stId; });
              if (sIdx !== -1) {
                var copyS = JSON.parse(JSON.stringify(d.steps[sIdx]));
                copyS.id = uid('step');
                d.steps.splice(sIdx + 1, 0, copyS);
                renderSections();
                triggerAutosave();
              }
              break;

            case 'move-step':
              var mvId = actBtn.getAttribute('data-step-id');
              var dir = parseInt(actBtn.getAttribute('data-dir'), 10);
              var curIdx = (d.steps || []).findIndex(function(s) { return s.id === mvId; });
              if (curIdx !== -1) {
                var tgtIdx = curIdx + dir;
                if (tgtIdx >= 0 && tgtIdx < d.steps.length) {
                  var tmp = d.steps[curIdx];
                  d.steps[curIdx] = d.steps[tgtIdx];
                  d.steps[tgtIdx] = tmp;
                  renderSections();
                  triggerAutosave();
                }
              }
              break;

            // ── FLEXIBLE LAYOUT COMPOSER ACTIONS ──
            case 'set-flex-col-count':
              var targetCount = parseInt(actBtn.getAttribute('data-count'), 10);
              d.columnCount = targetCount;
              if (targetCount === 3 && d.columns.length < 3) {
                d.columns.push({ id: uid('fcol'), blocks: [] });
              }
              renderSections();
              triggerAutosave();
              break;

            case 'set-flex-ratio':
              var rVal = actBtn.getAttribute('data-ratio');
              d.ratio = rVal;
              renderSections();
              triggerAutosave();
              break;

            // Image Upload & Removal
            case 'trigger-upload':
              var prop = actBtn.getAttribute('data-img-prop');
              openImageUploader(function(url, filename) {
                applyImageUrl(d, prop, url);
                renderSections();
                triggerAutosave();
              });
              break;

            case 'remove-image':
              var remProp = actBtn.getAttribute('data-img-prop');
              applyImageUrl(d, remProp, '');
              renderSections();
              triggerAutosave();
              break;

            case 'toggle-ext-url':
              var wrap = actBtn.parentElement.querySelector('.ext-url-input-wrap');
              if (wrap) {
                wrap.style.display = wrap.style.display === 'none' ? 'block' : 'none';
              }
              break;

            // Gallery Scroll Cards
            case 'add-gallery-card':
              d.cards = d.cards || [];
              d.cards.push({ id: uid('gcard'), src: '', alt: '', caption: { text: '', align: 'left' } });
              renderSections();
              triggerAutosave();
              break;

            case 'del-gallery-card':
              var gcId = actBtn.getAttribute('data-card-id');
              d.cards = (d.cards || []).filter(function(c) { return c.id !== gcId; });
              renderSections();
              triggerAutosave();
              break;

            case 'dup-gallery-card':
              var gcDupId = actBtn.getAttribute('data-card-id');
              var cIdx = (d.cards || []).findIndex(function(c) { return c.id === gcDupId; });
              if (cIdx !== -1) {
                var copyCard = JSON.parse(JSON.stringify(d.cards[cIdx]));
                copyCard.id = uid('gcard');
                d.cards.splice(cIdx + 1, 0, copyCard);
                renderSections();
                triggerAutosave();
              }
              break;

            // Comparison Items
            case 'add-col-item':
              var side = actBtn.getAttribute('data-side');
              var key = side === '1' ? 'col1Items' : 'col2Items';
              d[key] = d[key] || [];
              d[key].push({ id: uid('cmp'), text: { text: '', align: 'left' } });
              renderSections();
              triggerAutosave();
              break;

            case 'del-col-item':
              var dSide = actBtn.getAttribute('data-side');
              var dKey = dSide === '1' ? 'col1Items' : 'col2Items';
              var cItemId = actBtn.getAttribute('data-item-id');
              d[dKey] = (d[dKey] || []).filter(function(it) { return it.id !== cItemId; });
              renderSections();
              triggerAutosave();
              break;

            // Table Builder
            case 'add-table-col':
              d.columns = d.columns || [];
              var newColId = uid('col');
              d.columns.push({ id: newColId, label: { text: 'Column ' + (d.columns.length + 1), align: 'left' } });
              (d.rows || []).forEach(function(r) {
                r.cells = r.cells || {};
                r.cells[newColId] = { text: '', align: 'left' };
              });
              renderSections();
              triggerAutosave();
              break;

            case 'del-table-col':
              var delColId = actBtn.getAttribute('data-col-id');
              if (d.columns && d.columns.length > 1) {
                d.columns = d.columns.filter(function(c) { return c.id !== delColId; });
                (d.rows || []).forEach(function(r) {
                  if (r.cells) delete r.cells[delColId];
                });
                renderSections();
                triggerAutosave();
              }
              break;

            case 'add-table-row':
              d.rows = d.rows || [];
              var newCells = {};
              (d.columns || []).forEach(function(c) { newCells[c.id] = { text: '', align: 'left' }; });
              d.rows.push({ id: uid('row'), cells: newCells });
              renderSections();
              triggerAutosave();
              break;

            case 'del-table-row':
              var delRowId = actBtn.getAttribute('data-row-id');
              if (d.rows && d.rows.length > 1) {
                d.rows = d.rows.filter(function(r) { return r.id !== delRowId; });
                renderSections();
                triggerAutosave();
              }
              break;

            // Callout Swatch Select
            case 'select-callout':
              d.calloutType = actBtn.getAttribute('data-val');
              renderSections();
              triggerAutosave();
              break;

            case 'callout-use-default':
              d.titleMode = 'default';
              delete d.title;
              renderSections();
              triggerAutosave();
              break;

            case 'callout-accent-default':
              delete d.accentColor;
              renderSections();
              triggerAutosave();
              break;

            case 'callout-accent-swatch':
              var hexVal = actBtn.getAttribute('data-hex');
              if (hexVal) {
                d.accentColor = normalizeHex(hexVal);
                renderSections();
                triggerAutosave();
              }
              break;

            case 'callout-accent-custom':
              openCustomColorPicker(actBtn, d.accentColor || '#C45AFF', function(chosenHex) {
                d.accentColor = chosenHex;
                renderSections();
                triggerAutosave();
              }, function(savedHex) {
                d.accentColor = savedHex;
                renderSections();
                triggerAutosave();
              });
              break;

            // FAQ
            case 'add-faq':
              d.items = d.items || [];
              d.items.push({ id: uid('faq'), question: { text: '', align: 'left' }, answer: { text: '', align: 'left' } });
              renderSections();
              triggerAutosave();
              break;

            case 'del-faq':
              var fId = actBtn.getAttribute('data-item-id');
              if (d.items && d.items.length > 1) {
                d.items = d.items.filter(function(it) { return it.id !== fId; });
                renderSections();
                triggerAutosave();
              }
              break;

            case 'dup-faq':
              var fDupId = actBtn.getAttribute('data-item-id');
              var fIdx = (d.items || []).findIndex(function(it) { return it.id === fDupId; });
              if (fIdx !== -1) {
                var copyFaq = JSON.parse(JSON.stringify(d.items[fIdx]));
                copyFaq.id = uid('faq');
                d.items.splice(fIdx + 1, 0, copyFaq);
                renderSections();
                triggerAutosave();
              }
              break;

            // Article Trial
            case 'add-trial-q':
              d.questions = d.questions || [];
              d.questions.push({
                id: uid('q'),
                question: { text: '', align: 'left' },
                answers: [
                  { id: uid('ans'), text: { text: '', align: 'left' }, correct: true },
                  { id: uid('ans'), text: { text: '', align: 'left' }, correct: false }
                ],
                explanation: { text: '', align: 'left' }
              });
              renderSections();
              triggerAutosave();
              break;

            case 'del-trial-q':
              var tqId = actBtn.getAttribute('data-q-id');
              if (d.questions && d.questions.length > 1) {
                d.questions = d.questions.filter(function(q) { return q.id !== tqId; });
                renderSections();
                triggerAutosave();
              }
              break;

            case 'dup-trial-q':
              var tqDupId = actBtn.getAttribute('data-q-id');
              var qIdx = (d.questions || []).findIndex(function(q) { return q.id === tqDupId; });
              if (qIdx !== -1) {
                var copyQ = JSON.parse(JSON.stringify(d.questions[qIdx]));
                copyQ.id = uid('q');
                (copyQ.answers || []).forEach(function(a) { a.id = uid('ans'); });
                d.questions.splice(qIdx + 1, 0, copyQ);
                renderSections();
                triggerAutosave();
              }
              break;

            case 'add-trial-ans':
              var aQId = actBtn.getAttribute('data-q-id');
              var targetQ = (d.questions || []).find(function(q) { return q.id === aQId; });
              if (targetQ) {
                targetQ.answers = targetQ.answers || [];
                targetQ.answers.push({ id: uid('ans'), text: { text: '', align: 'left' }, correct: false });
                renderSections();
                triggerAutosave();
              }
              break;

            case 'del-trial-ans':
              var dQId = actBtn.getAttribute('data-q-id');
              var dAnsId = actBtn.getAttribute('data-ans-id');
              var qItem = (d.questions || []).find(function(q) { return q.id === dQId; });
              if (qItem && qItem.answers && qItem.answers.length > 2) {
                qItem.answers = qItem.answers.filter(function(a) { return a.id !== dAnsId; });
                if (!qItem.answers.some(function(a) { return a.correct; })) {
                  qItem.answers[0].correct = true;
                }
                renderSections();
                triggerAutosave();
              }
              break;

            case 'mark-correct':
              var cQId = actBtn.getAttribute('data-q-id');
              var cAnsId = actBtn.getAttribute('data-ans-id');
              var qObj = (d.questions || []).find(function(q) { return q.id === cQId; });
              if (qObj && Array.isArray(qObj.answers)) {
                qObj.answers.forEach(function(a) {
                  a.correct = (a.id === cAnsId);
                });
                renderSections();
                triggerAutosave();
              }
              break;

            // Key Takeaways
            case 'add-takeaway':
              d.items = d.items || [];
              d.items.push({ id: uid('t'), term: { text: '', align: 'left' }, desc: { text: '', align: 'left' } });
              renderSections();
              triggerAutosave();
              break;

            case 'del-takeaway':
              var tId = actBtn.getAttribute('data-item-id');
              if (d.items && d.items.length > 1) {
                d.items = d.items.filter(function(it) { return it.id !== tId; });
                renderSections();
                triggerAutosave();
              }
              break;

            case 'dup-takeaway':
              var tDupId = actBtn.getAttribute('data-item-id');
              var tkIdx = (d.items || []).findIndex(function(it) { return it.id === tDupId; });
              if (tkIdx !== -1) {
                var copyTk = JSON.parse(JSON.stringify(d.items[tkIdx]));
                copyTk.id = uid('t');
                d.items.splice(tkIdx + 1, 0, copyTk);
                renderSections();
                triggerAutosave();
              }
              break;

            // Related Docs
            case 'add-doc':
              d.items = d.items || [];
              d.items.push({ id: uid('rd'), type: 'internal', title: { text: '', align: 'left' }, slug: '', url: '', ctaText: 'Study scroll' });
              renderSections();
              triggerAutosave();
              break;

            case 'del-doc':
              var rdId = actBtn.getAttribute('data-item-id');
              d.items = (d.items || []).filter(function(it) { return it.id !== rdId; });
              renderSections();
              triggerAutosave();
              break;

            case 'dup-doc':
              var rdDupId = actBtn.getAttribute('data-item-id');
              var rdIdx = (d.items || []).findIndex(function(it) { return it.id === rdDupId; });
              if (rdIdx !== -1) {
                var copyDoc = JSON.parse(JSON.stringify(d.items[rdIdx]));
                copyDoc.id = uid('rd');
                d.items.splice(rdIdx + 1, 0, copyDoc);
                renderSections();
                triggerAutosave();
              }
              break;

            case 'toggle-doc-type':
              var tDocId = actBtn.getAttribute('data-doc-id');
              var tVal = actBtn.getAttribute('data-val');
              var docIt = (d.items || []).find(function(it) { return it.id === tDocId; });
              if (docIt) {
                docItemToggleType(docIt, tVal);
                renderSections();
                triggerAutosave();
              }
              break;
          }
        });
      }

      function docItemToggleType(docItem, typeVal) {
        docItem.type = typeVal;
        if (typeVal === 'internal') {
          docItem.url = docItem.slug ? ('/article/' + docItem.slug) : '';
          docItem.ctaText = 'Study scroll';
        } else {
          docItem.ctaText = 'Official documentation';
        }
      }

      function applyImageUrl(dataObj, propPrefix, url) {
        if (propPrefix === 'imageSrc') {
          dataObj.imageSrc = url;
        } else if (propPrefix === 'src') {
          dataObj.src = url;
        } else if (propPrefix === 'img1') {
          dataObj.img1Src = url;
        } else if (propPrefix === 'img2') {
          dataObj.img2Src = url;
        } else if (propPrefix === 'img3') {
          dataObj.img3Src = url;
        } else if (propPrefix.startsWith('gcard_')) {
          var cardId = propPrefix.replace('gcard_', '');
          var card = (dataObj.cards || []).find(function(c) { return c.id === cardId; });
          if (card) card.src = url;
        }
      }

      // ── Safe Section Activation (No DOM destruction) ─────
      function setActiveSection(secId) {
        if (activeSectionId === secId) return;
        activeSectionId = secId;
        var cards = document.querySelectorAll('.section-card');
        for (var i = 0; i < cards.length; i++) {
          var c = cards[i];
          var isCardActive = c.getAttribute('data-sec-id') === secId;
          c.classList.toggle('active-section', isCardActive);
          var leftHeader = c.querySelector('.section-header-left');
          if (leftHeader) {
            var existingBadge = leftHeader.querySelector('.section-toc-badge');
            if (isCardActive && !existingBadge) {
              var badge = document.createElement('span');
              badge.className = 'section-toc-badge';
              badge.textContent = 'TOC ACTIVE';
              leftHeader.appendChild(badge);
            } else if (!isCardActive && existingBadge) {
              existingBadge.remove();
            }
          }
        }
      }

      // ── Render Sections & Blocks (Center Column) ────────
      function renderSections() {
        var container = document.getElementById('sections-container');
        var trailingZone = document.getElementById('trailing-add-section-zone');
        var counterBadge = document.getElementById('section-counter-badge');

        if (!container) return;
        container.innerHTML = '';

        var totalSections = currentDoc.sections.length;
        if (counterBadge) counterBadge.textContent = totalSections + (totalSections === 1 ? ' Section' : ' Sections');

        // ZERO SECTIONS: render ONLY empty state, no trailing button
        if (totalSections === 0) {
          if (trailingZone) trailingZone.style.display = 'none';

          var emptyState = document.createElement('div');
          emptyState.className = 'empty-scroll-state';
          emptyState.innerHTML =
            '<div class="empty-scroll-icon">✦</div>' +
            '<h3 class="empty-scroll-title">BEGIN YOUR SCROLL</h3>' +
            '<p class="empty-scroll-desc">Add your first section to start building the article structure.</p>' +
            '<button type="button" class="studio-btn studio-btn--primary" id="btn-add-first-section">✦ Add First Section</button>';

          emptyState.querySelector('#btn-add-first-section').addEventListener('click', function() {
            addSection('Primary Section');
          });

          container.appendChild(emptyState);
          return;
        }

        // 1+ SECTIONS: show single trailing button, hide empty state
        if (trailingZone) trailingZone.style.display = 'flex';

        currentDoc.sections.forEach(function(sec, sIndex) {
          var isFirst = sIndex === 0;
          var isLast = sIndex === totalSections - 1;
          var isActive = sec.id === activeSectionId;
          var formattedNum = String(sIndex + 1).padStart(2, '0');

          var card = document.createElement('div');
          card.className = 'section-card' + (isActive ? ' active-section' : '');
          card.id = 'section-card-' + sec.id;
          card.setAttribute('data-sec-id', sec.id);

          // Section Card Header
          var header = document.createElement('div');
          header.className = 'section-card-header';

          header.innerHTML =
            '<div class="section-card-topbar">' +
              '<div class="section-header-left">' +
                '<span class="section-drag-handle" title="Drag to reorder section" draggable="true">⋮⋮</span>' +
                '<span class="section-number">SECTION ' + formattedNum + '</span>' +
                (isActive ? '<span class="section-toc-badge">TOC ACTIVE</span>' : '') +
              '</div>' +
              '<div class="section-header-actions">' +
                '<button type="button" class="studio-btn studio-btn--sm" data-action="dup" title="Duplicate section">Duplicate</button>' +
                '<button type="button" class="studio-btn studio-btn--sm" data-action="up" title="Move section up" ' + (isFirst ? 'disabled' : '') + '>↑ Move</button>' +
                '<button type="button" class="studio-btn studio-btn--sm" data-action="down" title="Move section down" ' + (isLast ? 'disabled' : '') + '>↓ Move</button>' +
                '<button type="button" class="studio-btn studio-btn--sm studio-btn--danger" data-action="del" title="Delete section">Delete</button>' +
              '</div>' +
            '</div>' +
            '<div class="section-card-body-header">' +
              '<div class="studio-form-group" style="margin-bottom:0">' +
                '<label class="studio-label" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">' +
                  '<span>SECTION TITLE</span>' +
                  '<span class="section-anchor-chip">#' + (slugify(sec.title) || 'section') + '</span>' +
                '</label>' +
                '<input type="text" class="studio-input section-title-input" value="' + escapeHtml(sec.title) + '" placeholder="Section title..." />' +
              '</div>' +
            '</div>';

          // Active Section Selection (Safe Activation - No DOM destruction)
          card.addEventListener('click', function() {
            if (activeSectionId !== sec.id) {
              setActiveSection(sec.id);
            }
          });

          card.addEventListener('focusin', function() {
            if (activeSectionId !== sec.id) {
              setActiveSection(sec.id);
            }
          });

          // Title input
          var titleInput = header.querySelector('.section-title-input');
          titleInput.addEventListener('input', function(e) {
            sec.title = e.target.value;
            var anchorChip = header.querySelector('.section-anchor-chip');
            if (anchorChip) anchorChip.textContent = '#' + (slugify(sec.title) || 'section');
            triggerAutosave();
          });

          // Header action buttons
          header.querySelector('[data-action="dup"]').addEventListener('click', function(e) {
            e.stopPropagation();
            duplicateSection(sec.id);
          });
          header.querySelector('[data-action="up"]').addEventListener('click', function(e) {
            e.stopPropagation();
            moveSection(sec.id, -1);
          });
          header.querySelector('[data-action="down"]').addEventListener('click', function(e) {
            e.stopPropagation();
            moveSection(sec.id, 1);
          });
          header.querySelector('[data-action="del"]').addEventListener('click', function(e) {
            e.stopPropagation();
            deleteSection(sec.id, e.currentTarget);
          });

          // Section Drag and Drop Reordering
          var secHandle = header.querySelector('.section-drag-handle');
          secHandle.addEventListener('dragstart', function(e) {
            card.classList.add('dragging');
            e.dataTransfer.setData('text/plain', JSON.stringify({ source: 'section', secId: sec.id }));
            e.dataTransfer.effectAllowed = 'move';
            startDragAutoScroll();
          });
          secHandle.addEventListener('dragend', function() {
            card.classList.remove('dragging');
            stopDragAutoScroll();
          });

          card.addEventListener('dragover', function(e) {
            e.preventDefault();
            card.classList.add('drag-over');
          });

          card.addEventListener('dragleave', function() {
            card.classList.remove('drag-over');
          });

          card.addEventListener('drop', function(e) {
            e.preventDefault();
            card.classList.remove('drag-over');
            try {
              var payload = JSON.parse(e.dataTransfer.getData('text/plain'));
              if (payload.source === 'section' && payload.secId !== sec.id) {
                var srcIdx = currentDoc.sections.findIndex(function(s) { return s.id === payload.secId; });
                var dstIdx = currentDoc.sections.findIndex(function(s) { return s.id === sec.id; });
                if (srcIdx !== -1 && dstIdx !== -1) {
                  var [moved] = currentDoc.sections.splice(srcIdx, 1);
                  currentDoc.sections.splice(dstIdx, 0, moved);
                  renderSections();
                  triggerAutosave();
                  showToast('Sections reordered');
                }
              }
            } catch (err) {}
          });

          card.appendChild(header);

          // Blocks Container
          var blocksWrap = document.createElement('div');
          blocksWrap.className = 'section-blocks-wrap';

          if (sec.blocks.length === 0) {
            // Empty Dropzone
            var dropzone = document.createElement('div');
            dropzone.className = 'section-empty-dropzone';
            dropzone.innerHTML =
              '<div class="dropzone-icon">✧</div>' +
              '<div class="dropzone-text">+ DROP BLOCK HERE</div>' +
              '<div class="dropzone-sub">or choose one from Block Library</div>';

            dropzone.addEventListener('dragover', function(e) {
              e.preventDefault();
              e.stopPropagation();
              dropzone.classList.add('drag-over');
            });
            dropzone.addEventListener('dragleave', function(e) {
              e.stopPropagation();
              dropzone.classList.remove('drag-over');
            });
            dropzone.addEventListener('drop', function(e) {
              e.preventDefault();
              e.stopPropagation();
              dropzone.classList.remove('drag-over');
              handleBlockDrop(e, { type: 'section', secId: sec.id, insertIdx: 0 });
            });

            blocksWrap.appendChild(dropzone);
          } else {
            // Render Block Cards
            sec.blocks.forEach(function(b, bIndex) {
              var bCard = createBlockCardElement(sec, b, bIndex, sec.blocks.length, null);
              blocksWrap.appendChild(bCard);
            });

            // Container-level drop listener to append at end
            blocksWrap.addEventListener('dragover', function(e) {
              e.preventDefault();
            });
            blocksWrap.addEventListener('drop', function(e) {
              if (e.target === blocksWrap) {
                e.preventDefault();
                handleBlockDrop(e, { type: 'section', secId: sec.id, insertIdx: sec.blocks.length });
              }
            });
          }

          card.appendChild(blocksWrap);
          container.appendChild(card);
        });
        updateAllSavedSwatchesUI();
      }

      function createBlockCardElement(sec, b, bIndex, totalCount, context) {
        var isFlexChild = context && context.isFlexChild;
        var isCalloutChild = context && context.isCalloutChild;
        var isFirstBlock = bIndex === 0;
        var isLastBlock = bIndex === totalCount - 1;
        var blkDef = window.STUDIO_REGISTRY[b.type] || { label: b.type };
        var glyph = BLOCK_GLYPHS[b.type] || '✦';

        var bCard = document.createElement('div');
        bCard.className = 'block-editor-card' + (isFlexChild ? ' is-flex-child' : '') + (isCalloutChild ? ' is-callout-child' : '');
        bCard.setAttribute('draggable', 'true');
        bCard.setAttribute('data-sec-id', sec.id);
        bCard.setAttribute('data-block-id', b.id);
        bCard.setAttribute('data-block-type', b.type);
        if (isFlexChild) {
          bCard.setAttribute('data-flex-id', context.flexBlockId);
          bCard.setAttribute('data-col-id', context.colId);
        }
        if (isCalloutChild) {
          bCard.setAttribute('data-callout-id', context.calloutBlockId);
        }

        var bHeader = document.createElement('div');
        bHeader.className = 'block-editor-header';
        bHeader.innerHTML =
          '<div class="block-header-title">' +
            '<span class="block-drag-handle" title="Drag to reorder or move across sections">⋮⋮</span>' +
            '<span style="font-family:var(--font-mono);font-size:12px;color:var(--studio-gold);opacity:0.9">' + glyph + '</span>' +
            '<span class="block-type-badge">' + escapeHtml(blkDef.label) + '</span>' +
          '</div>' +
          '<div class="block-header-actions">' +
            '<button type="button" class="studio-btn studio-btn--icon" data-action="dup" title="Duplicate block">⧉</button>' +
            '<button type="button" class="studio-btn studio-btn--icon" data-action="up" title="Move up" ' + (isFirstBlock ? 'disabled' : '') + '>▲</button>' +
            '<button type="button" class="studio-btn studio-btn--icon" data-action="down" title="Move down" ' + (isLastBlock ? 'disabled' : '') + '>▼</button>' +
            '<button type="button" class="studio-btn studio-btn--icon studio-btn--danger" data-action="del" title="Delete block">×</button>' +
          '</div>';

        bHeader.querySelector('[data-action="dup"]').addEventListener('click', function(e) {
          e.stopPropagation();
          if (isFlexChild) {
            duplicateFlexChild(sec.id, context.flexBlockId, context.colId, b.id);
          } else if (isCalloutChild) {
            duplicateCalloutChild(sec.id, context.calloutBlockId, b.id);
          } else {
            duplicateBlock(sec.id, b.id);
          }
        });
        bHeader.querySelector('[data-action="up"]').addEventListener('click', function(e) {
          e.stopPropagation();
          if (isFlexChild) {
            moveFlexChild(sec.id, context.flexBlockId, context.colId, b.id, -1);
          } else if (isCalloutChild) {
            moveCalloutChild(sec.id, context.calloutBlockId, b.id, -1);
          } else {
            moveBlock(sec.id, b.id, -1);
          }
        });
        bHeader.querySelector('[data-action="down"]').addEventListener('click', function(e) {
          e.stopPropagation();
          if (isFlexChild) {
            moveFlexChild(sec.id, context.flexBlockId, context.colId, b.id, 1);
          } else if (isCalloutChild) {
            moveCalloutChild(sec.id, context.calloutBlockId, b.id, 1);
          } else {
            moveBlock(sec.id, b.id, 1);
          }
        });
        bHeader.querySelector('[data-action="del"]').addEventListener('click', function(e) {
          e.stopPropagation();
          if (isFlexChild) {
            deleteFlexChild(sec.id, context.flexBlockId, context.colId, b.id, e.currentTarget);
          } else if (isCalloutChild) {
            deleteCalloutChild(sec.id, context.calloutBlockId, b.id, e.currentTarget);
          } else {
            deleteBlock(sec.id, b.id, e.currentTarget);
          }
        });

        // Block Drag & Drop
        bCard.addEventListener('dragstart', function(e) {
          if (e.target && e.target.closest('input, textarea, select, [contenteditable="true"]')) {
            return;
          }
          e.stopPropagation();
          bCard.classList.add('dragging');
          if (isFlexChild) {
            draggedBlockData = { source: 'block', type: b.type, blockType: b.type, secId: sec.id, flexBlockId: context.flexBlockId, colId: context.colId, colIdx: context.colIdx, blockId: b.id };
          } else if (isCalloutChild) {
            draggedBlockData = { source: 'block', type: b.type, blockType: b.type, secId: sec.id, calloutBlockId: context.calloutBlockId, blockId: b.id };
          } else {
            draggedBlockData = { source: 'block', type: b.type, blockType: b.type, secId: sec.id, blockId: b.id };
