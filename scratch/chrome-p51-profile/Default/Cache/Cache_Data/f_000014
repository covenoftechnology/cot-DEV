                '<div class="callout-empty-icon">✧</div>' +
                '<div class="callout-empty-title">Drop Coven blocks here</div>' +
                '<div class="callout-empty-sub">Solo Text, Nested Bullets, Image, Table... Drag from Block Library or existing blocks</div>';
              calloutBlocksContainer.appendChild(emptyDropzone);
            } else {
              calloutChildBlocks.forEach(function(cb, cbIndex) {
                var childCard = createBlockCardElement(sec, cb, cbIndex, calloutChildBlocks.length, {
                  isCalloutChild: true,
                  calloutBlockId: b.id
                });
                calloutBlocksContainer.appendChild(childCard);
              });
            }

            // UNIFIED CALLOUT DRAG & DROP HANDLERS
            calloutPanel.addEventListener('dragover', function(e) {
              e.preventDefault();
              e.stopPropagation();
              bCard.classList.remove('drag-target-above', 'drag-target-below', 'drag-target-forbidden');

              if (isDraggingForbiddenInCallout()) {
                calloutPanel.classList.add('drag-target-forbidden');
                e.dataTransfer.dropEffect = 'none';
                return;
              }

              calloutPanel.classList.add('drag-over');

              var currentChildCards = Array.from(calloutBlocksContainer.querySelectorAll(':scope > .block-editor-card'));
              if (currentChildCards.length === 0) {
                var emptyDz = calloutBlocksContainer.querySelector('.studio-callout-empty-dropzone');
                if (emptyDz) emptyDz.classList.add('drag-over');
                return;
              }

              var mouseY = e.clientY;
              var targetCard = null;
              var insertAbove = true;

              for (var i = 0; i < currentChildCards.length; i++) {
                var r = currentChildCards[i].getBoundingClientRect();
                var mid = r.top + r.height / 2;
                if (mouseY < mid) {
                  targetCard = currentChildCards[i];
                  insertAbove = true;
                  break;
                }
                if (i === currentChildCards.length - 1) {
                  targetCard = currentChildCards[i];
                  insertAbove = false;
                }
              }

              currentChildCards.forEach(function(c) {
                c.classList.remove('drag-target-above', 'drag-target-below');
              });

              if (targetCard) {
                targetCard.classList.add(insertAbove ? 'drag-target-above' : 'drag-target-below');
              }
            });

            calloutPanel.addEventListener('dragleave', function(e) {
              if (e.relatedTarget && calloutPanel.contains(e.relatedTarget)) {
                return;
              }
