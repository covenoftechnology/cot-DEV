        var popover = document.getElementById('coven-custom-color-popover');
        if (!popover) return;

        var triggerBtn = document.getElementById('coven-custom-color-trigger-btn');
        var triggerSwatch = document.getElementById('coven-custom-color-trigger-swatch');
