      function attachTableRichTextListeners(bBody, sec, block) {
        var d = block.data;
        var tableBar = bBody.querySelector('.table-contextual-bar');
        if (!tableBar) return;

        var toolbar = tableBar.querySelector('.rich-text-toolbar');
        var indicator = tableBar.querySelector('.table-active-cell-indicator');
        var colorMenu = tableBar.querySelector('.rich-color-menu');
        var colorTrigger = tableBar.querySelector('.rich-btn-color');
        var highlightMenu = tableBar.querySelector('.rich-highlight-menu');
        var highlightTrigger = tableBar.querySelector('.rich-btn-highlight');
        var linkBtn = tableBar.querySelector('.rich-btn-link');
        var linkPopover = tableBar.querySelector('.rich-link-popover');
        var urlInput = linkPopover ? linkPopover.querySelector('.rich-link-popover__input') : null;
        var urlError = linkPopover ? linkPopover.querySelector('.rich-link-popover__error') : null;
        var popoverMsg = linkPopover ? linkPopover.querySelector('.rich-link-popover__msg') : null;
        var colorSection = linkPopover ? linkPopover.querySelector('.rich-link-popover__color-section') : null;
        var removeBtn = linkPopover ? linkPopover.querySelector('.rich-link-btn--remove') : null;
        var cancelBtn = linkPopover ? linkPopover.querySelector('.rich-link-btn--cancel') : null;
        var applyBtn = linkPopover ? linkPopover.querySelector('.rich-link-btn--apply') : null;
        var swatchBtns = linkPopover ? linkPopover.querySelectorAll('.rich-link-swatch') : [];

        var activeSurface = null;
        var savedRange = null;
        var activeAnchor = null;
        var selectedLinkColor = 'default';

        function getActiveData() {
          if (!activeSurface) return { text: '', align: 'left' };
          var colId = activeSurface.getAttribute('data-table-header');
          if (colId) {
            var col = (d.columns || []).find(function(c) { return c.id === colId; });
            return col ? getRichData(col.label) : { text: '', align: 'left' };
          }
          var rowId = activeSurface.getAttribute('data-table-row');
          var cellColId = activeSurface.getAttribute('data-table-col');
          if (rowId && cellColId) {
            var row = (d.rows || []).find(function(r) { return r.id === rowId; });
            if (row && row.cells) {
              return getRichData(row.cells[cellColId]);
            }
          }
          return { text: '', align: 'left' };
        }

        function setActiveData(richObj) {
          if (!activeSurface) return;
          var colId = activeSurface.getAttribute('data-table-header');
          if (colId) {
            var col = (d.columns || []).find(function(c) { return c.id === colId; });
            if (col) col.label = richObj;
          }
          var rowId = activeSurface.getAttribute('data-table-row');
          var cellColId = activeSurface.getAttribute('data-table-col');
          if (rowId && cellColId) {
            var row = (d.rows || []).find(function(r) { return r.id === rowId; });
            if (row) {
              row.cells = row.cells || {};
              row.cells[cellColId] = richObj;
            }
          }
          calculateReadingTime();
          triggerAutosave();
        }

        function updateToolbarActiveStates() {
          if (!activeSurface) {
            if (indicator) indicator.textContent = 'Select header or cell';
            return;
          }

          var colId = activeSurface.getAttribute('data-table-header');
          if (colId) {
            var cObj = (d.columns || []).find(function(c) { return c.id === colId; });
            var cText = cObj ? (typeof cObj.label === 'object' ? cObj.label.text : cObj.label) : '';
            if (indicator) indicator.textContent = 'Header: ' + (cText.replace(/<[^>]*>/g, '').trim() || 'Column');
          } else {
            var rowId = activeSurface.getAttribute('data-table-row');
            var rIdx = (d.rows || []).findIndex(function(r) { return r.id === rowId; });
            if (indicator) indicator.textContent = 'Cell: Row ' + (rIdx + 1);
          }

          var boldBtn = toolbar.querySelector('[data-cmd="bold"]');
          var italicBtn = toolbar.querySelector('[data-cmd="italic"]');
          var underlineBtn = toolbar.querySelector('[data-cmd="underline"]');

          if (boldBtn) boldBtn.classList.toggle('is-active', document.queryCommandState('bold'));
          if (italicBtn) italicBtn.classList.toggle('is-active', document.queryCommandState('italic'));
          if (underlineBtn) underlineBtn.classList.toggle('is-active', document.queryCommandState('underline'));

          var cur = getActiveData();
          toolbar.querySelectorAll('.rich-btn-align').forEach(function(btn) {
            btn.classList.toggle('is-active', btn.getAttribute('data-align') === cur.align);
          });

          // Active Highlight & Color states in table toolbar
          var activeBgClass = 'default';
          var activeColorClass = 'default';
          var currentTableSel = window.getSelection();
          if (currentTableSel && currentTableSel.rangeCount) {
            var tRange = currentTableSel.getRangeAt(0);
            if (activeSurface.contains(tRange.commonAncestorContainer)) {
              var tNode = tRange.commonAncestorContainer;
              if (tNode.nodeType === 3) tNode = tNode.parentNode;
              var bSpan = tNode ? tNode.closest('.article-text-bg-neutral, .article-text-bg-purple, .article-text-bg-gold, .article-text-bg-green, .article-text-bg-red') : null;
              if (bSpan && activeSurface.contains(bSpan)) {
                var ALL_BGS = ['article-text-bg-neutral', 'article-text-bg-purple', 'article-text-bg-gold', 'article-text-bg-green', 'article-text-bg-red'];
                for (var bi = 0; bi < ALL_BGS.length; bi++) {
                  if (bSpan.classList.contains(ALL_BGS[bi])) {
                    activeBgClass = ALL_BGS[bi];
                    break;
                  }
                }
              }
              var colSpan = tNode ? tNode.closest('.article-text-gold, .article-text-purple, .article-text-muted') : null;
              if (colSpan && activeSurface.contains(colSpan)) {
                var ALL_COLS = ['article-text-gold', 'article-text-purple', 'article-text-muted'];
                for (var ci = 0; ci < ALL_COLS.length; ci++) {
                  if (colSpan.classList.contains(ALL_COLS[ci])) {
                    activeColorClass = ALL_COLS[ci];
                    break;
                  }
                }
              }
            }
          }

          if (highlightTrigger) {
            highlightTrigger.classList.toggle('is-active', activeBgClass !== 'default');
          }
          if (highlightMenu) {
            highlightMenu.querySelectorAll('.rich-highlight-item').forEach(function(item) {
              item.classList.toggle('is-active', item.getAttribute('data-bg') === activeBgClass);
            });
          }
          if (colorTrigger) {
            colorTrigger.classList.toggle('is-active', activeColorClass !== 'default');
          }
          if (colorMenu) {
            colorMenu.querySelectorAll('.rich-color-item').forEach(function(item) {
              item.classList.toggle('is-active', item.getAttribute('data-color') === activeColorClass);
            });
          }

          var sel = window.getSelection();
          var anchor = null;
          var hasText = false;
          if (sel && sel.rangeCount) {
            var range = sel.getRangeAt(0);
            if (activeSurface.contains(range.commonAncestorContainer)) {
              var node = range.commonAncestorContainer;
              if (node.nodeType === 3) node = node.parentNode;
              anchor = (node && node.closest) ? node.closest('a') : null;
              hasText = !range.collapsed && range.toString().trim().length > 0;
            }
          }

          if (linkBtn) {
            if (anchor) {
              linkBtn.classList.add('is-active');
              linkBtn.style.opacity = '1';
              linkBtn.title = 'Edit link';
            } else if (hasText) {
              linkBtn.classList.remove('is-active');
              linkBtn.style.opacity = '1';
              linkBtn.title = 'Add link';
            } else {
              linkBtn.classList.remove('is-active');
              linkBtn.style.opacity = '0.5';
              linkBtn.title = 'Select text before creating a link';
            }
          }
        }

        function updateSwatchActive() {
          swatchBtns.forEach(function(sb) {
            sb.classList.toggle('is-active', sb.getAttribute('data-link-color') === selectedLinkColor);
          });
        }

        function closeLinkPopover() {
          if (linkPopover) {
            linkPopover.style.display = 'none';
            linkPopover.style.position = '';
            linkPopover.style.zIndex = '';
            linkPopover.style.top = '';
            linkPopover.style.left = '';
            linkPopover.style.visibility = '';
            linkPopover.classList.remove('is-flipped-above');
          }
          if (applyBtn) applyBtn.style.display = 'inline-block';
          savedRange = null;
          activeAnchor = null;
        }

        toolbar.querySelectorAll('button').forEach(function(btn) {
          btn.addEventListener('mousedown', function(e) {
            e.preventDefault();
          });
        });

        toolbar.querySelectorAll('[data-cmd="bold"], [data-cmd="italic"], [data-cmd="underline"]').forEach(function(btn) {
          btn.addEventListener('click', function(e) {
            e.preventDefault();
            if (!activeSurface) return;
            var cmd = btn.getAttribute('data-cmd');
            activeSurface.focus();
            var range = resolveSmartRange(activeSurface, cmd);
            if (range) {
              document.execCommand(cmd, false, null);
              updateToolbarActiveStates();
              var cur = getActiveData();
              cur.text = sanitizeRichText(activeSurface.innerHTML);
              setActiveData(cur);
            }
          });
        });

        if (colorTrigger && colorMenu) {
          colorTrigger.addEventListener('click', function(e) {
            e.preventDefault();
            if (!activeSurface) return;
            var isOpen = colorMenu.style.display === 'flex';
            closeAllPopovers(colorMenu);
            if (isOpen) {
              colorMenu.style.display = 'none';
            } else {
              updateAllSavedSwatchesUI();
              openAnchoredPopover(colorMenu, colorTrigger);
            }
          });

          colorMenu.querySelectorAll('.rich-color-item').forEach(function(item) {
            item.addEventListener('click', function(e) {
              e.preventDefault();
              if (!activeSurface) return;
              var colorClass = item.getAttribute('data-color');
              activeSurface.focus();
              applyColorClass(activeSurface, colorClass);
              colorMenu.style.display = 'none';
              updateToolbarActiveStates();
              var cur = getActiveData();
              cur.text = sanitizeRichText(activeSurface.innerHTML);
              setActiveData(cur);
            });
          });

          colorMenu.addEventListener('click', function(e) {
            if (!activeSurface) return;
            var delBtn = e.target.closest('.saved-swatch-del');
            if (delBtn) {
              e.preventDefault();
              e.stopPropagation();
              var hex = delBtn.getAttribute('data-del-hex');
              if (hex) {
                removeColorFromPalette(hex);
                updateAllSavedSwatchesUI();
              }
              return;
            }
            var chip = e.target.closest('.saved-swatch-chip');
            if (chip) {
              e.preventDefault();
              var hex = chip.getAttribute('data-hex');
              if (hex) {
                activeSurface.focus();
                applyColorClass(activeSurface, hex);
                colorMenu.style.display = 'none';
                updateToolbarActiveStates();
                var cur = getActiveData();
                cur.text = sanitizeRichText(activeSurface.innerHTML);
                setActiveData(cur);
              }
              return;
            }
            var customBtn = e.target.closest('.rich-btn-custom-color');
            if (customBtn) {
              e.preventDefault();
              colorMenu.style.display = 'none';
              openCustomColorPicker(colorTrigger, '#C45AFF', function(chosenHex) {
                if (!activeSurface) return;
                activeSurface.focus();
                applyColorClass(activeSurface, chosenHex);
