      function openAnchoredPopover(popoverEl, triggerEl) {
        closeAllPopovers(popoverEl);

        popoverEl.style.display = 'flex';
        popoverEl.style.position = 'fixed';
        popoverEl.style.zIndex = '99999';
        popoverEl.style.visibility = 'hidden';

        var trigRect = triggerEl.getBoundingClientRect();

        if (popoverEl.classList.contains('nested-marker-dropdown')) {
          var targetWidth = Math.max(180, Math.round(trigRect.width));
          popoverEl.style.width = targetWidth + 'px';
          popoverEl.style.right = 'auto';
        }

        var popRect = popoverEl.getBoundingClientRect();
        var popHeight = popRect.height || 220;
        var popWidth = popRect.width || (popoverEl.classList.contains('rich-link-popover') ? 290 : 170);

        var spaceBelow = window.innerHeight - trigRect.bottom;
        var spaceAbove = trigRect.top;

        var top;
        if (spaceBelow < (popHeight + 12) && spaceAbove > spaceBelow) {
          top = Math.max(8, trigRect.top - popHeight - 4);
          popoverEl.classList.add('is-flipped-above');
        } else {
          top = Math.min(window.innerHeight - popHeight - 8, trigRect.bottom + 4);
          popoverEl.classList.remove('is-flipped-above');
        }

        var left = trigRect.left;
        if (left + popWidth > window.innerWidth - 8) {
          left = Math.max(8, window.innerWidth - popWidth - 8);
        }
        if (left < 8) left = 8;

        popoverEl.style.top = Math.round(top) + 'px';
        popoverEl.style.left = Math.round(left) + 'px';
        popoverEl.style.visibility = 'visible';
      }

      function closeAllPopovers(exceptEl) {
        document.querySelectorAll('.rich-color-menu, .rich-highlight-menu, .rich-link-popover, .coven-custom-color-popover, .nested-marker-dropdown').forEach(function(m) {
          if (m !== exceptEl) {
            m.style.display = 'none';
            m.classList.remove('is-flipped-above');
            m.style.top = '';
            m.style.left = '';
            m.style.width = '';
            m.style.right = '';
            m.style.position = '';
            m.style.zIndex = '';
            m.style.visibility = '';
          }
        });
      }

