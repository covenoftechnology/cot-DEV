.article-template {
  --font-display: 'Metamorphous', serif;
  --font-body: 'Helvetica Neue Roman', serif;
  --font-mono: 'Consolas', monospace;
  position: relative;
  width: 100%;
  font-family: var(--font-body);
}

/* ── Explicit Heading & Body Hierarchy ───────────────────────── */
.article-template h2 {
  font-family: var(--font-display, 'Metamorphous', serif);
  font-weight: 600;
  font-size: clamp(22px, 5vw, 26px);
  line-height: 1.25;
  color: #ece6dd;
  margin: 38px 0 16px;
}

.article-template h3 {
  font-family: var(--font-display, 'Metamorphous', serif);
  font-weight: 600;
  font-size: clamp(18px, 4.5vw, 22px);
  line-height: 1.3;
  color: #ece6dd;
  margin: 30px 0 14px;
}

.article-template h4 {
  font-family: var(--font-display, 'Metamorphous', serif);
  font-weight: 600;
  font-size: 16px;
  line-height: 1.35;
  color: #ece6dd;
  margin: 24px 0 10px;
}

.article-template p {
  font-family: var(--font-body, 'Helvetica Neue Roman', serif);
  font-size: 18px;
  font-weight: 400;
  line-height: 1.75;
  color: #cdc3b6;
  margin: 0 0 24px;
}

/* ── Hero Lead & Cover ────────────────────────────────────────── */
.article-template .hero-lead {
  font-family: var(--font-body, 'Helvetica Neue Roman', serif);
  font-size: clamp(19px, 2.5vw, 22px);
  line-height: 1.6;
  color: #cdc3b6;
  margin: 0 0 32px;
  font-style: italic;
  border-left: 2px solid rgba(216, 181, 107, 0.4);
  padding-left: 20px;
}

.article-template .hero-cover {
  margin: 0 0 44px;
  border-radius: 8px;
  overflow: hidden;
  border: 1px solid rgba(216, 181, 107, 0.2);
  background: #110d1a;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
}

.article-template .hero-cover img {
  width: 100%;
  height: auto;
  display: block;
}

.article-template .hero-cover figcaption {
  font-family: var(--font-body, 'Helvetica Neue Roman', serif);
  font-size: 13px;
  color: #8f857a;
  text-align: center;
  padding: 10px 16px;
  background: rgba(16, 13, 22, 0.8);
  border-top: 1px solid rgba(216, 181, 107, 0.1);
  font-style: italic;
}

/* ── Editorial Two-Column Layout (Content + Sticky Sidebar) ───── */
.article-template .editorial-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 280px;
  gap: 48px;
  align-items: start;
  position: relative;
}

.article-template .main-content {
  min-width: 0;
}

.article-template .article-sidebar {
  position: sticky;
  top: calc(var(--article-sticky-height, 75px) + 24px);
  align-self: start;
  display: flex;
  flex-direction: column;
  max-height: calc(100vh - var(--article-sticky-height, 75px) - 48px);
}

/* ── Sidebar: Table of Contents ──────────────────────────────── */
.article-template .toc-panel {
  background: #151121;
  border: 1px solid rgba(216, 181, 107, 0.18);
  border-radius: 8px;
  padding: 18px 16px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
  display: flex;
  flex-direction: column;
  height: auto;
  max-height: inherit;
  box-sizing: border-box;
  overflow: hidden;
}

.article-template .toc-header {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
  padding-bottom: 10px;
  border-bottom: 1px solid rgba(216, 181, 107, 0.14);
}

.article-template .toc-title {
  font-family: var(--font-display, 'Metamorphous', serif);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 2px;
  color: #e8cf95;
  text-transform: uppercase;
  display: flex;
  align-items: center;
  gap: 8px;
}

.article-template .toc-progress-indicator {
  font-family: var(--font-mono, Consolas, monospace);
  font-size: 11px;
  color: #b98fd8;
}

.article-template .toc-progress-bar-wrap {
  flex-shrink: 0;
  height: 3px;
  background: rgba(216, 181, 107, 0.12);
  border-radius: 2px;
  margin-bottom: 12px;
  overflow: hidden;
}

.article-template .toc-progress-bar-fill {
  height: 100%;
  width: 0%;
  background: linear-gradient(90deg, #c49a4e, #e3c47e);
  transition: width 0.15s ease-out;
}

.article-template .toc-scroll-area {
  overflow-y: auto;
  min-height: 0;
  max-height: calc(100vh - var(--article-sticky-height, 75px) - 48px - 85px);
  padding-right: 4px;
  scrollbar-width: thin;
  scrollbar-color: rgba(216, 181, 107, 0.3) rgba(21, 17, 33, 0.5);
}

.article-template .toc-scroll-area::-webkit-scrollbar {
  width: 4px;
}
.article-template .toc-scroll-area::-webkit-scrollbar-track {
  background: rgba(21, 17, 33, 0.5);
  border-radius: 2px;
}
.article-template .toc-scroll-area::-webkit-scrollbar-thumb {
  background: rgba(216, 181, 107, 0.35);
  border-radius: 2px;
}
.article-template .toc-scroll-area::-webkit-scrollbar-thumb:hover {
  background: rgba(216, 181, 107, 0.6);
}

.article-template .toc-nav-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.article-template .toc-link {
  display: flex;
  align-items: baseline;
  gap: 10px;
  padding: 6px 10px;
  border-radius: 4px;
  font-family: var(--font-body, 'Helvetica Neue Roman', serif);
  font-size: 15px;
  color: #9b9189;
  text-decoration: none;
  border-left: 2px solid transparent;
  transition: all 0.2s ease;
}

.article-template .toc-num {
  font-family: var(--font-mono, Consolas, monospace);
  font-size: 11px;
  color: #7b6f63;
  flex-shrink: 0;
}

.article-template .toc-link:hover {
  color: #f3ecdf;
  background: rgba(216, 181, 107, 0.05);
  border-left-color: rgba(216, 181, 107, 0.4);
}

.article-template .toc-link.active {
  color: #e8cf95;
  background: rgba(216, 181, 107, 0.08);
  border-left-color: #d8b56b;
  font-weight: 600;
}

.article-template .toc-link.active .toc-num {
  color: #b98fd8;
}

/* ── Mobile TOC (Dropdown Accordion) ─────────────────────────── */
.article-template .mobile-toc {
  display: none;
  margin-bottom: 32px;
  border: 1px solid rgba(216, 181, 107, 0.22);
  border-radius: 6px;
  background: #151121;
}

.article-template .mobile-toc-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 18px;
  cursor: pointer;
  font-family: var(--font-display, 'Metamorphous', serif);
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 1.5px;
  color: #e8cf95;
  user-select: none;
}

.article-template .mobile-toc-summary::-webkit-details-marker {
  display: none;
}

.article-template .mobile-toc-content {
  padding: 8px 16px 18px;
  border-top: 1px solid rgba(216, 181, 107, 0.12);
}

/* ── Standard Section ────────────────────────────────────────── */
.article-template .article-section {
  scroll-margin-top: calc(var(--article-sticky-height, 75px) + 24px);
  margin-bottom: 56px;
}

.article-template .section-kicker {
  font-family: var(--font-mono, Consolas, monospace);
  font-size: 11px;
  letter-spacing: 2px;
  color: #b98fd8;
  text-transform: uppercase;
