            listContainer.innerHTML = '';
            drafts.forEach(function(d) {
              var card = document.createElement('div');
              card.style.cssText = 'background:rgba(21,18,28,0.8);border:1px solid var(--studio-border);border-radius:6px;padding:12px 14px;display:flex;justify-content:space-between;align-items:center;gap:12px';

              var dateStr = new Date(d.updatedAt).toLocaleString();
              card.innerHTML =
                '<div>' +
                  '<div style="font-family:var(--font-display);font-size:13px;color:var(--studio-gold-bright);margin-bottom:3px">' + escapeHtml(d.title || 'Untitled Scroll') + '</div>' +
                  '<div style="font-family:var(--font-mono);font-size:10px;color:var(--studio-purple)">' + escapeHtml(d.category) + ' · ' + escapeHtml(d.status).toUpperCase() + ' · ' + dateStr + '</div>' +
                '</div>' +
                '<div style="display:flex;gap:6px">' +
                  '<button type="button" class="studio-btn studio-btn--sm btn-open-draft" data-id="' + d.studioId + '">Open</button>' +
                  '<button type="button" class="studio-btn studio-btn--sm studio-btn--danger btn-del-draft" data-id="' + d.studioId + '">✕</button>' +
                '</div>';

              card.querySelector('.btn-open-draft').addEventListener('click', function() {
