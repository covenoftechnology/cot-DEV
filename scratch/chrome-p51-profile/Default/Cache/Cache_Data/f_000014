          } else if (isCalloutChild) {
            handleBlockDrop(e, { type: 'callout', secId: sec.id, calloutBlockId: context.calloutBlockId, insertIdx: insertIdx });
          } else {
            handleBlockDrop(e, { type: 'section', secId: sec.id, insertIdx: insertIdx });
          }
        });

        // Block Fields Body
        var bBody = document.createElement('div');
        bBody.className = 'block-editor-body';
        bBody.innerHTML = renderBlockFields(sec, b);

        // Attach Structured Field Event Handlers
        attachBlockListeners(bBody, sec, b);

        // Special Container Handling for Flexible Layout V2
        if (b.type === 'flex-layout') {
          var canvasWrap = bBody.querySelector('.studio-flex-canvas-wrap');
          if (canvasWrap) {
            canvasWrap.addEventListener('dragover', function(e) {
              e.stopPropagation(); // Isolate canvas from bubbling to flex-layout bCard
              var rect = canvasWrap.getBoundingClientRect();
              var edgeZone = 80;
              var x = e.clientX;
              if (x - rect.left < edgeZone && x - rect.left >= 0) {
                var ratio = 1 - ((x - rect.left) / edgeZone);
                canvasWrap.scrollLeft -= Math.ceil(18 * ratio);
              } else if (rect.right - x < edgeZone && rect.right - x >= 0) {
                var ratio = 1 - ((rect.right - x) / edgeZone);
                canvasWrap.scrollLeft += Math.ceil(18 * ratio);
              }
            });
            canvasWrap.addEventListener('drop', function(e) {
              e.stopPropagation();
            });
          }

          var curColCount = b.data.columnCount === 3 ? 3 : 2;
          var cols = (b.data.columns || []).slice(0, curColCount);

          cols.forEach(function(col, cIdx) {
            col.id = col.id || ('col_' + (cIdx + 1));
            var colPanel = bBody.querySelector('.studio-flex-col-panel[data-col-idx="' + cIdx + '"]');
            var colBlocksContainer = bBody.querySelector('.studio-flex-col-blocks[data-col-idx="' + cIdx + '"]');
            if (!colPanel || !colBlocksContainer) return;
            colBlocksContainer.innerHTML = '';

            var childBlocks = Array.isArray(col.blocks) ? col.blocks : [];

            if (childBlocks.length === 0) {
              var emptyDropzone = document.createElement('div');
              emptyDropzone.className = 'studio-flex-empty-dropzone';
              emptyDropzone.innerHTML =
                '<div class="flex-empty-icon">✧</div>' +
                '<div class="flex-empty-title">Drop Coven blocks here</div>' +
                '<div class="flex-empty-sub">Drag from the Block Library or move an existing block</div>';
              colBlocksContainer.appendChild(emptyDropzone);
            } else {
              childBlocks.forEach(function(cb, cbIndex) {
                var childCard = createBlockCardElement(sec, cb, cbIndex, childBlocks.length, {
                  isFlexChild: true,
                  flexBlockId: b.id,
                  colId: col.id,
                  colIdx: cIdx
                });
                colBlocksContainer.appendChild(childCard);
              });
            }

            // UNIFIED COLUMN-LEVEL DRAG & DROP HANDLERS
            colPanel.addEventListener('dragover', function(e) {
              e.preventDefault();
              e.stopPropagation();
              bCard.classList.remove('drag-target-above', 'drag-target-below', 'drag-target-forbidden');

              if (isDraggingFlexLayout()) {
                colPanel.classList.add('drag-target-forbidden');
                e.dataTransfer.dropEffect = 'none';
                return;
              }

              colPanel.classList.add('drag-over');

              var currentChildCards = Array.from(colBlocksContainer.querySelectorAll(':scope > .block-editor-card'));
              if (currentChildCards.length === 0) {
                var emptyDz = colBlocksContainer.querySelector('.studio-flex-empty-dropzone');
                if (emptyDz) emptyDz.classList.add('drag-over');
                return;
              }

              var mouseY = e.clientY;
              var targetCard = null;
              var insertAbove = true;

              for (var i = 0; i < currentChildCards.length; i++) {
                var r = currentChildCards[i].getBoundingClientRect();
                var mid = r.top + r.height / 2;
                if (mouseY < mid) {
                  targetCard = currentChildCards[i];
                  insertAbove = true;
                  break;
                }
                if (i === currentChildCards.length - 1) {
                  targetCard = currentChildCards[i];
                  insertAbove = false;
                }
              }

              currentChildCards.forEach(function(c) {
                c.classList.remove('drag-target-above', 'drag-target-below');
              });

              if (targetCard) {
                targetCard.classList.add(insertAbove ? 'drag-target-above' : 'drag-target-below');
              }
            });

            colPanel.addEventListener('dragleave', function(e) {
              if (e.relatedTarget && colPanel.contains(e.relatedTarget)) {
                return;
              }
              colPanel.classList.remove('drag-over', 'drag-target-forbidden');
              var emptyDz = colBlocksContainer.querySelector('.studio-flex-empty-dropzone');
              if (emptyDz) emptyDz.classList.remove('drag-over', 'drag-target-forbidden');
              colBlocksContainer.querySelectorAll(':scope > .block-editor-card').forEach(function(c) {
                c.classList.remove('drag-target-above', 'drag-target-below', 'drag-target-forbidden');
              });
            });

            colPanel.addEventListener('drop', function(e) {
              e.preventDefault();
              e.stopPropagation();

              colPanel.classList.remove('drag-over', 'drag-target-forbidden');
              var emptyDz = colBlocksContainer.querySelector('.studio-flex-empty-dropzone');
              if (emptyDz) emptyDz.classList.remove('drag-over', 'drag-target-forbidden');

              if (isDraggingFlexLayout()) return;

              var currentChildCards = Array.from(colBlocksContainer.querySelectorAll(':scope > .block-editor-card'));
              var insertIdx = 0;

              if (currentChildCards.length > 0) {
                var mouseY = e.clientY;
                insertIdx = currentChildCards.length;

                for (var i = 0; i < currentChildCards.length; i++) {
                  var r = currentChildCards[i].getBoundingClientRect();
                  var mid = r.top + r.height / 2;
                  if (mouseY < mid) {
                    insertIdx = i;
                    break;
                  }
                }

                currentChildCards.forEach(function(c) {
                  c.classList.remove('drag-target-above', 'drag-target-below', 'drag-target-forbidden');
                });
              }

              handleBlockDrop(e, {
                type: 'flex-col',
                secId: sec.id,
                flexBlockId: b.id,
                colId: col.id,
                colIdx: cIdx,
                insertIdx: insertIdx
              });
            });
          });
        }

        // Special Container Handling for Composable Callout Advisory V2
