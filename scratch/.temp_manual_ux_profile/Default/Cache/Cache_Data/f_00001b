        }

        // 3. Case: Explicit width requested (e.g. author explicitly locked a width pill or button)
        if (explicitWidth) {
          if (contiguousFree >= reqSpan) {
            return {
              valid: true,
              columnStart: col,
              columnSpan: reqSpan,
              rowStart: row,
              rowSpan: 1,
              contiguousFree: contiguousFree,
              autoFitApplied: false
