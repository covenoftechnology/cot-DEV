              (q.answers || []).forEach(function(ans, aIdx) {
                var letters = ['A', 'B', 'C', 'D', 'E', 'F'];
                var ansRemove = '<button type="button" class="studio-btn studio-btn--icon studio-btn--danger" data-act="del-trial-ans" data-q-id="' + q.id + '" data-ans-id="' + ans.id + '" ' + (q.answers.length <= 2 ? 'disabled' : '') + ' title="Remove option">✕</button>';
                var ansLetter = letters[aIdx] || String(aIdx + 1);
                html +=
                  '<div class="trial-ans-row' + (ans.correct ? ' is-correct' : '') + '" style="align-items:flex-start;padding-top:4px">' +
                    '<input type="radio" name="trial_correct_' + q.id + '" class="trial-radio" data-act="mark-correct" data-q-id="' + q.id + '" data-ans-id="' + ans.id + '" ' + (ans.correct ? 'checked' : '') + ' title="Mark as correct answer" style="margin-top:8px" />' +
                    '<span style="font-family:var(--font-mono);font-size:11px;color:var(--studio-gold);margin-top:8px">' + ansLetter + '</span>' +
                    '<div style="flex:1">' +
                      renderRichTextFieldHtml('', 'data-rich-trial-q-id="' + q.id + '" data-rich-trial-ans-id="' + ans.id + '"', ans.text, 'Answer option text...', ansRemove) +
                    '</div>' +
                  '</div>';
              });
              html +=
                    '<div><button type="button" class="studio-btn studio-btn--sm" data-act="add-trial-ans" data-q-id="' + q.id + '">+ Add Answer Option</button></div>' +
                  '</div>' +
                  renderRichTextFieldHtml('Explanation / Guidance (Optional)', 'data-rich-trial-q-id="' + q.id + '" data-rich-trial-q-prop="explanation"', q.explanation, 'Explained once answered...') +
                '</div>';
            });
            html += '</div><div style="margin-top:8px"><button type="button" class="studio-btn studio-btn--sm" data-act="add-trial-q">+ Add Question</button></div></div>';
            break;

          // ── 10. CLOSING CONTENT ──
          case 'key-takeaways':
            html +=
              (d.title !== undefined ?
                renderRichTextFieldHtml('<span>Title</span>', 'data-rich-field="title"', d.title, 'Key Takeaways for the Initiate', '<span class="field-label-remove" data-act="remove-field" data-opt-field="title">✕ Remove</span>') :
                '<div style="margin-bottom:8px"><button type="button" class="studio-btn--add-field" data-act="add-field" data-opt-field="title">+ Add Title</button></div>'
              ) +
              '<div class="studio-form-group"><label class="studio-label">Takeaway Doctrines</label><div style="display:flex;flex-direction:column;gap:10px">';
            (d.items || []).forEach(function(item, tIdx) {
              html +=
                '<div class="nested-parent-card">' +
                  '<div style="display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(216,181,107,0.12);padding-bottom:6px">' +
                    '<span style="font-family:var(--font-mono);font-size:11px;color:var(--studio-gold)">DOCTRINE ' + String(tIdx + 1).padStart(2, '0') + '</span>' +
                    '<div style="display:flex;gap:4px">' +
                      '<button type="button" class="studio-btn studio-btn--icon" data-act="dup-takeaway" data-item-id="' + item.id + '" title="Duplicate">⧉</button>' +
                      '<button type="button" class="studio-btn studio-btn--icon studio-btn--danger" data-act="del-takeaway" data-item-id="' + item.id + '" ' + (d.items.length <= 1 ? 'disabled' : '') + ' title="Delete">✕</button>' +
                    '</div>' +
                  '</div>' +
                  renderRichTextFieldHtml('Term / Concept', 'data-rich-array-obj="items" data-rich-item-id="' + item.id + '" data-rich-prop="term"', item.term, 'e.g. Core Rule 1') +
                  renderRichTextFieldHtml('Description', 'data-rich-array-obj="items" data-rich-item-id="' + item.id + '" data-rich-prop="desc"', item.desc, 'Principle summary...') +
                '</div>';
            });
            html += '</div><div style="margin-top:8px"><button type="button" class="studio-btn studio-btn--sm" data-act="add-takeaway">+ Add Takeaway</button></div></div>';
            break;

          case 'related-docs':
            var pubArticles = window.STUDIO_PUBLISHED_ARTICLES || [];
            html += '<div class="studio-form-group"><label class="studio-label">Related Scrolls & External Docs</label><div style="display:flex;flex-direction:column;gap:12px">';
            (d.items || []).forEach(function(rd, rIdx) {
              var isInternal = rd.type !== 'external';
              html +=
                '<div class="nested-parent-card">' +
                  '<div style="display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(216,181,107,0.12);padding-bottom:6px">' +
                    '<span style="font-family:var(--font-mono);font-size:11px;color:var(--studio-gold)">DOC ' + String(rIdx + 1).padStart(2, '0') + '</span>' +
                    '<div style="display:flex;gap:4px">' +
                      '<button type="button" class="studio-btn studio-btn--icon" data-act="dup-doc" data-item-id="' + rd.id + '" title="Duplicate">⧉</button>' +
                      '<button type="button" class="studio-btn studio-btn--icon studio-btn--danger" data-act="del-doc" data-item-id="' + rd.id + '" ' + (d.items.length <= 1 ? 'disabled' : '') + ' title="Delete">✕</button>' +
                    '</div>' +
                  '</div>' +
                  '<div class="studio-form-group">' +
                    '<label class="studio-label">Resource Type</label>' +
                    '<div style="display:flex;gap:14px;align-items:center">' +
                      '<label style="display:flex;align-items:center;gap:6px;font-family:var(--font-body);font-size:14px;cursor:pointer">' +
                        '<input type="radio" name="rd_type_' + rd.id + '" data-act="toggle-doc-type" data-doc-id="' + rd.id + '" data-val="internal" ' + (isInternal ? 'checked' : '') + ' />' +
                        '<span>Internal Coven Scroll</span>' +
                      '</label>' +
                      '<label style="display:flex;align-items:center;gap:6px;font-family:var(--font-body);font-size:14px;cursor:pointer">' +
                        '<input type="radio" name="rd_type_' + rd.id + '" data-act="toggle-doc-type" data-doc-id="' + rd.id + '" data-val="external" ' + (!isInternal ? 'checked' : '') + ' />' +
                        '<span>External Documentation</span>' +
                      '</label>' +
                    '</div>' +
                  '</div>';

              if (isInternal) {
                html +=
                  '<div class="studio-form-group"><label class="studio-label">Select Published Scroll</label>' +
                    '<select class="studio-select" data-doc-select-slug="' + rd.id + '">' +
                      '<option value="">-- Choose scroll or keep custom --</option>';
                pubArticles.forEach(function(pa) {
                  var sel = (rd.slug === pa.slug || rd.url === '/article/' + pa.slug) ? ' selected' : '';
                  html += '<option value="' + pa.slug + '"' + sel + '>' + escapeHtml(pa.title) + ' (' + escapeHtml(pa.category) + ')</option>';
                });
                html +=
                    '</select>' +
                  '</div>' +
                  renderRichTextFieldHtml('Title', 'data-rich-array-obj="items" data-rich-item-id="' + rd.id + '" data-rich-prop="title"', rd.title, 'Scroll title...') +
                  '<div class="studio-form-group"><label class="studio-label">CTA Text</label><input type="text" class="studio-input" data-array-obj="items" data-item-id="' + rd.id + '" data-prop="ctaText" value="' + escapeHtml(rd.ctaText || 'Study scroll') + '" /></div>';
              } else {
                html +=
                  renderRichTextFieldHtml('Title', 'data-rich-array-obj="items" data-rich-item-id="' + rd.id + '" data-rich-prop="title"', rd.title, 'e.g. Official Salesforce Documentation') +
                  '<div class="studio-form-group"><label class="studio-label">External URL</label><input type="text" class="studio-input" data-array-obj="items" data-item-id="' + rd.id + '" data-prop="url" value="' + escapeHtml(rd.url || '') + '" placeholder="https://..." /></div>' +
                  '<div class="studio-form-group"><label class="studio-label">CTA Text</label><input type="text" class="studio-input" data-array-obj="items" data-item-id="' + rd.id + '" data-prop="ctaText" value="' + escapeHtml(rd.ctaText || 'Official documentation') + '" /></div>';
              }

              html += '</div>';
            });
            html += '</div><div style="margin-top:8px"><button type="button" class="studio-btn studio-btn--sm" data-act="add-doc">+ Add Documentation</button></div></div>';
            break;

          default:
            html += '<div style="color:var(--studio-text-muted);font-size:12px">Block fields for ' + escapeHtml(block.type) + '</div>';
            break;
        }

        return html;
      }

      // ── Attach Event Listeners to Block Fields ──────────
      function attachBlockListeners(bBody, sec, block) {
        var d = block.data;

        // Rich text listeners for any block with rich-text-field-wrap
        if (bBody.querySelector('.rich-text-field-wrap')) {
          attachRichTextListeners(bBody, sec, block);
        }

        // Table rich text listeners for technical-table
        if (block.type === 'technical-table') {
          attachTableRichTextListeners(bBody, sec, block);
        }

        // 1. Direct field inputs
        bBody.querySelectorAll('[data-field]').forEach(function(input) {
          var field = input.getAttribute('data-field');
          input.addEventListener('input', function(e) {
            d[field] = e.target.value;
            calculateReadingTime();
            triggerAutosave();
          });
        });

        // 2. Array primitive fields (e.g. paragraphs)
        bBody.querySelectorAll('[data-array-field]').forEach(function(input) {
          var field = input.getAttribute('data-array-field');
          var idx = parseInt(input.getAttribute('data-array-idx'), 10);
          input.addEventListener('input', function(e) {
            if (Array.isArray(d[field])) {
              d[field][idx] = e.target.value;
              calculateReadingTime();
              triggerAutosave();
            }
          });
        });

        // 3. Array of objects fields (e.g. steps, items, columns)
        bBody.querySelectorAll('[data-array-obj]').forEach(function(input) {
          var arrayName = input.getAttribute('data-array-obj');
          var itemId = input.getAttribute('data-item-id');
          var prop = input.getAttribute('data-prop');
          input.addEventListener('input', function(e) {
            var arr = d[arrayName];
            if (Array.isArray(arr)) {
              var target = arr.find(function(it) { return it.id === itemId; });
              if (target) {
                target[prop] = e.target.value;
                calculateReadingTime();
                triggerAutosave();
              }
            }
          });
        });

        // 4. Nested sub-items
        bBody.querySelectorAll('[data-nested-sub="true"]').forEach(function(input) {
          var subId = input.getAttribute('data-sub-id');
          input.addEventListener('input', function(e) {
            var foundSub = findNestedBulletNodeById(d.items || [], subId);
            if (foundSub && foundSub.node) {
              foundSub.node.text = e.target.value;
              calculateReadingTime();
              triggerAutosave();
            }
          });
        });

        // 5. Image sub-fields (alt, caption)
        bBody.querySelectorAll('[data-img-subfield]').forEach(function(input) {
          var sub = input.getAttribute('data-img-subfield');
          var propPrefix = input.getAttribute('data-img-prop');
          input.addEventListener('input', function(e) {
            if (propPrefix === 'imageSrc' || propPrefix === 'src') {
              d[sub] = e.target.value;
            } else if (propPrefix.startsWith('img') && propPrefix.length === 4) {
              // e.g. img1, img2, img3
              d[propPrefix + (sub === 'alt' ? 'Alt' : 'Caption')] = e.target.value;
            } else if (propPrefix.startsWith('gcard_')) {
              var cardId = propPrefix.replace('gcard_', '');
              var card = (d.cards || []).find(function(c) { return c.id === cardId; });
              if (card) card[sub] = e.target.value;
            }
            calculateReadingTime();
            triggerAutosave();
          });
        });

        // 6. External URL input for images
        bBody.querySelectorAll('[data-ext-url-input]').forEach(function(input) {
          var propPrefix = input.getAttribute('data-img-prop');
          input.addEventListener('change', function(e) {
            var url = (e.target.value || '').trim();
            if (!url) return;
            applyImageUrl(d, propPrefix, url);
            renderSections();
            triggerAutosave();
          });
        });

        // 7. Table Builder cell inputs
        bBody.querySelectorAll('[data-table-header]').forEach(function(input) {
          var colId = input.getAttribute('data-table-header');
          input.addEventListener('input', function(e) {
            var col = (d.columns || []).find(function(c) { return c.id === colId; });
            if (col) {
              col.label = e.target.value;
              triggerAutosave();
            }
          });
        });

        bBody.querySelectorAll('[data-table-row]').forEach(function(input) {
          var rowId = input.getAttribute('data-table-row');
          var colId = input.getAttribute('data-table-col');
          input.addEventListener('input', function(e) {
            var row = (d.rows || []).find(function(r) { return r.id === rowId; });
            if (row) {
              row.cells = row.cells || {};
              row.cells[colId] = e.target.value;
              calculateReadingTime();
              triggerAutosave();
            }
          });
        });

        // 8. Trial Builder inputs
        bBody.querySelectorAll('[data-trial-q]').forEach(function(input) {
          var qId = input.getAttribute('data-q-id');
          var prop = input.getAttribute('data-trial-q');
          input.addEventListener('input', function(e) {
            var q = (d.questions || []).find(function(it) { return it.id === qId; });
            if (q) {
              q[prop === 'text' ? 'question' : prop] = e.target.value;
              calculateReadingTime();
              triggerAutosave();
            }
          });
        });

        bBody.querySelectorAll('[data-trial-ans]').forEach(function(input) {
          var qId = input.getAttribute('data-q-id');
          var ansId = input.getAttribute('data-ans-id');
          input.addEventListener('input', function(e) {
            var q = (d.questions || []).find(function(it) { return it.id === qId; });
            if (q && Array.isArray(q.answers)) {
              var ans = q.answers.find(function(a) { return a.id === ansId; });
              if (ans) {
                ans.text = e.target.value;
                calculateReadingTime();
                triggerAutosave();
              }
            }
          });
        });

        // 9. Related Docs Select dropdown
        bBody.querySelectorAll('[data-doc-select-slug]').forEach(function(select) {
          var docId = select.getAttribute('data-doc-select-slug');
          select.addEventListener('change', function(e) {
            var slug = e.target.value;
            var docItem = (d.items || []).find(function(it) { return it.id === docId; });
            if (docItem) {
              var found = (window.STUDIO_PUBLISHED_ARTICLES || []).find(function(a) { return a.slug === slug; });
              if (found) {
                docItem.title = found.title;
                docItem.slug = found.slug;
                docItem.url = '/article/' + found.slug;
                docItem.ctaText = 'Study scroll';
              }
              renderSections();
              triggerAutosave();
            }
          });
        });

        // 10. Drag & Drop support for image dropzones inside block
        bBody.querySelectorAll('.studio-img-dropzone').forEach(function(dz) {
          var propPrefix = dz.getAttribute('data-img-prop');
          dz.addEventListener('dragover', function(e) {
            e.preventDefault();
            e.stopPropagation();
            dz.style.borderColor = 'var(--studio-gold)';
          });
          dz.addEventListener('dragleave', function(e) {
            e.stopPropagation();
            dz.style.borderColor = '';
          });
          dz.addEventListener('drop', function(e) {
            e.preventDefault();
            e.stopPropagation();
            dz.style.borderColor = '';
            var file = e.dataTransfer.files && e.dataTransfer.files[0];
            if (file && file.type.startsWith('image/')) {
              showToast('Uploading image...', 'saving');
              uploadImageFile(file, function(err, url) {
                if (err) {
                  showToast('Upload failed: ' + err.message, 'error');
                } else {
                  showToast('Image uploaded: ' + file.name, 'success');
                  applyImageUrl(d, propPrefix, url);
                  renderSections();
                  triggerAutosave();
                }
              });
            }
          });
        });

        // Callout Show Heading Toggle
        bBody.querySelectorAll('.callout-toggle-heading').forEach(function(cb) {
          cb.addEventListener('change', function(e) {
            d.showTitle = e.target.checked;
            renderSections();
            triggerAutosave();
          });
        });

        // 11. Unified Action Delegator for buttons
        bBody.addEventListener('click', function(e) {
          if (e.target.closest('.block-editor-body') !== bBody) return;
          if (activeSectionId !== sec.id) {
            setActiveSection(sec.id);
          }
          var actBtn = e.target.closest('[data-act]');
          if (!actBtn) return;
          var act = actBtn.getAttribute('data-act');

          switch (act) {
            // Optional Fields
            case 'add-field':
              var optField = actBtn.getAttribute('data-opt-field');
              d[optField] = '';
              renderSections();
              triggerAutosave();
              var blockEl = document.querySelector('[data-block-id="' + block.id + '"]');
              if (blockEl) {
                var newInput = blockEl.querySelector('[data-field="' + optField + '"]');
                if (newInput) newInput.focus();
              }
              break;

            case 'remove-field':
              var remField = actBtn.getAttribute('data-opt-field');
              delete d[remField];
              renderSections();
              triggerAutosave();
              break;

            // Toggle Show Text
            case 'toggle-show-text':
              d.showText = d.showText === false ? true : false;
              renderSections();
              triggerAutosave();
              calculateReadingTime();
              showToast(d.showText ? 'Paragraphs visible' : 'Paragraphs hidden');
              break;

            // Paragraphs
            case 'add-paragraph':
              d.paragraphs = d.paragraphs || [];
              d.paragraphs.push({ text: '', align: 'left' });
              renderSections();
              triggerAutosave();
              break;

            case 'del-paragraph':
              var pIdx = parseInt(actBtn.getAttribute('data-idx'), 10);
              if (d.paragraphs && d.paragraphs.length > 1) {
                d.paragraphs.splice(pIdx, 1);
                renderSections();
                triggerAutosave();
              }
              break;

            // Bullets
            case 'add-bullet':
              d.items = d.items || [];
              d.items.push({ id: uid('item'), text: '' });
              renderSections();
              triggerAutosave();
              break;

            case 'del-bullet':
              var bId = actBtn.getAttribute('data-item-id');
              if (d.items && d.items.length > 1) {
                d.items = d.items.filter(function(it) { return it.id !== bId; });
                renderSections();
                triggerAutosave();
              }
              break;

            // Nested Bullets
            case 'toggle-marker-dropdown':
              e.stopPropagation();
              var markerWrap = actBtn.closest('.nested-marker-dropdown-wrap');
              if (markerWrap) {
                var dd = markerWrap.querySelector('.nested-marker-dropdown');
                if (dd) {
                  var isDdOpen = dd.style.display === 'flex';
                  closeAllPopovers(dd);
                  if (isDdOpen) {
                    dd.style.display = 'none';
                  } else {
                    openAnchoredPopover(dd, actBtn);
                  }
                }
              }
              break;

            case 'select-marker':
              e.stopPropagation();
              var markerVal = actBtn.getAttribute('data-val') || 'coven';
              var blkCard = actBtn.closest('.block-card, .block-editor-card');
              var blkId = blkCard ? blkCard.getAttribute('data-block-id') : block.id;
              var loc = resolveBlockLocation(blkId);
              var targetBlock = loc ? loc.block : block;
              if (targetBlock && targetBlock.data) {
                targetBlock.data.markerStyle = markerVal;
              } else {
                d.markerStyle = markerVal;
              }
              closeAllPopovers();
              renderSections();
              triggerAutosave();
              break;

            case 'set-nested-layout':
              e.stopPropagation();
              var layoutVal = actBtn.getAttribute('data-layout') || 'vertical';
              var blkCard = actBtn.closest('.block-card, .block-editor-card');
              var blkId = blkCard ? blkCard.getAttribute('data-block-id') : block.id;
              var loc = resolveBlockLocation(blkId);
              var targetBlock = loc ? loc.block : block;
              if (targetBlock && targetBlock.data) {
                targetBlock.data.layout = layoutVal;
              } else {
                d.layout = layoutVal;
              }
              renderSections();
              triggerAutosave();
              break;

            case 'add-nested-main':
              d.items = d.items || [];
              d.items.push({ id: uid('main'), text: { text: '', align: 'left' }, children: [] });
              renderSections();
              triggerAutosave();
              break;

            case 'del-nested-main':
              var mId = actBtn.getAttribute('data-item-id');
              if (d.items && d.items.length > 1) {
                d.items = d.items.filter(function(m) { return m.id !== mId; });
                renderSections();
                triggerAutosave();
              }
              break;

            case 'add-nested-sub':
              var pId = actBtn.getAttribute('data-parent-id');
              var foundParent = findNestedBulletNodeById(d.items || [], pId);
              if (foundParent && foundParent.node && canAddNestedListChild(foundParent.depth)) {
                var nextDepth = foundParent.depth + 1;
                foundParent.node.children = Array.isArray(foundParent.node.children) ? foundParent.node.children : [];
                foundParent.node.children.push({
                  id: uid('sub_l' + nextDepth),
                  text: { text: '', align: 'left' },
                  children: []
                });
                renderSections();
                triggerAutosave();
              }
              break;

            case 'del-nested-sub':
              var subId = actBtn.getAttribute('data-sub-id');
              var foundTarget = findNestedBulletNodeById(d.items || [], subId);
              if (foundTarget && foundTarget.parentArray && foundTarget.index !== -1) {
                foundTarget.parentArray.splice(foundTarget.index, 1);
                renderSections();
                triggerAutosave();
              }
              break;

            // Numbered Steps
            case 'add-step':
              d.steps = d.steps || [];
              d.steps.push({ id: uid('step'), badge: String(d.steps.length + 1).padStart(2, '0'), title: { text: '', align: 'left' }, text: { text: '', align: 'left' } });
              renderSections();
              triggerAutosave();
              break;

            case 'del-step':
              var sId = actBtn.getAttribute('data-step-id');
              if (d.steps && d.steps.length > 1) {
                d.steps = d.steps.filter(function(s) { return s.id !== sId; });
                renderSections();
                triggerAutosave();
              }
              break;

            case 'dup-step':
              var stId = actBtn.getAttribute('data-step-id');
              var sIdx = (d.steps || []).findIndex(function(s) { return s.id === stId; });
              if (sIdx !== -1) {
                var copyS = JSON.parse(JSON.stringify(d.steps[sIdx]));
                copyS.id = uid('step');
                d.steps.splice(sIdx + 1, 0, copyS);
                renderSections();
                triggerAutosave();
              }
              break;

            case 'move-step':
              var mvId = actBtn.getAttribute('data-step-id');
              var dir = parseInt(actBtn.getAttribute('data-dir'), 10);
              var curIdx = (d.steps || []).findIndex(function(s) { return s.id === mvId; });
              if (curIdx !== -1) {
                var tgtIdx = curIdx + dir;
                if (tgtIdx >= 0 && tgtIdx < d.steps.length) {
                  var tmp = d.steps[curIdx];
                  d.steps[curIdx] = d.steps[tgtIdx];
                  d.steps[tgtIdx] = tmp;
                  renderSections();
                  triggerAutosave();
                }
              }
              break;

            // ── FLEXIBLE LAYOUT COMPOSER ACTIONS ──
            case 'set-flex-col-count':
              var targetCount = parseInt(actBtn.getAttribute('data-count'), 10);
              d.columnCount = targetCount;
              if (targetCount === 3 && d.columns.length < 3) {
                d.columns.push({ id: uid('fcol'), blocks: [] });
              }
              renderSections();
              triggerAutosave();
              break;

            case 'set-flex-ratio':
              var rVal = actBtn.getAttribute('data-ratio');
              d.ratio = rVal;
              renderSections();
              triggerAutosave();
              break;

            // Image Upload & Removal
