      window.addSlotToSec = addSlotToSec;
      window.duplicateGridItem = duplicateGridItem;
      window.deleteGridItem = deleteGridItem;
      window.duplicateSlotInSec = duplicateSlotInSec;
      window.deleteSlotFromSec = deleteSlotFromSec;
      window.findFirstAvailablePlacement = findFirstAvailablePlacement;
      window.migrateSectionToGridComposerV2 = migrateSectionToGridComposerV2;
      window.getSpanPercentageLabel = getSpanPercentageLabel;
      window.resolvePlacementTarget = resolvePlacementTarget;
      window.insertBlockIntoSlot = insertBlockIntoSlot;
      window.confirmReplaceBlockInSlot = confirmReplaceBlockInSlot;
      window.undoSectionVisualGrid = undoSectionVisualGrid;
      window.redoSectionVisualGrid = redoSectionVisualGrid;
      window.renderSections = renderSections;
      window.uid = uid;
      window.showConflictModal = showConflictModal;
      window.showRecoveryBanner = showRecoveryBanner;
      window.triggerAutosave = triggerAutosave;
      window.createNewArticle = createNewArticle;


      // ── Render Sections & Blocks (Center Column) ────────
      function renderSections() {
        var container = document.getElementById('sections-container');
        var trailingZone = document.getElementById('trailing-add-section-zone');
        var counterBadge = document.getElementById('section-counter-badge');

        if (!container) return;
        container.innerHTML = '';

        var totalSections = currentDoc.sections.length;
        if (counterBadge) counterBadge.textContent = totalSections + (totalSections === 1 ? ' Section' : ' Sections');

        // ZERO SECTIONS: render ONLY empty state, no trailing button
        if (totalSections === 0) {
          if (trailingZone) trailingZone.style.display = 'none';

          var emptyState = document.createElement('div');
          emptyState.className = 'empty-scroll-state';
          emptyState.innerHTML =
            '<div class="empty-scroll-icon">✦</div>' +
            '<h3 class="empty-scroll-title">BEGIN YOUR SCROLL</h3>' +
            '<p class="empty-scroll-desc">Add your first section to start building the article structure.</p>' +
            '<button type="button" class="studio-btn studio-btn--primary" id="btn-add-first-section">✦ Add First Section</button>';

          emptyState.querySelector('#btn-add-first-section').addEventListener('click', function() {
            addSection('Primary Section');
          });

          container.appendChild(emptyState);
          return;
        }

        // 1+ SECTIONS: show single trailing button, hide empty state
        if (trailingZone) trailingZone.style.display = 'flex';

        currentDoc.sections.forEach(function(sec, sIndex) {
          var isFirst = sIndex === 0;
          var isLast = sIndex === totalSections - 1;
          var isActive = sec.id === activeSectionId;
          var formattedNum = String(sIndex + 1).padStart(2, '0');

          var card = document.createElement('div');
          card.className = 'section-card' + (isActive ? ' active-section' : '');
          card.id = 'section-card-' + sec.id;
          card.setAttribute('data-sec-id', sec.id);

          // Section Card Header
          var header = document.createElement('div');
          header.className = 'section-card-header';

          header.innerHTML =
            '<div class="section-card-topbar">' +
              '<div class="section-header-left">' +
                '<span class="section-drag-handle" title="Drag to reorder section" draggable="true">⋮⋮</span>' +
                '<span class="section-number">SECTION ' + formattedNum + '</span>' +
                (isActive ? '<span class="section-toc-badge">TOC ACTIVE</span>' : '') +
              '</div>' +
              '<div class="section-header-actions">' +
                '<button type="button" class="studio-btn studio-btn--sm" data-action="dup" title="Duplicate section">Duplicate</button>' +
                '<button type="button" class="studio-btn studio-btn--sm" data-action="up" title="Move section up" ' + (isFirst ? 'disabled' : '') + '>↑ Move</button>' +
                '<button type="button" class="studio-btn studio-btn--sm" data-action="down" title="Move section down" ' + (isLast ? 'disabled' : '') + '>↓ Move</button>' +
                '<button type="button" class="studio-btn studio-btn--sm studio-btn--danger" data-action="del" title="Delete section">Delete</button>' +
              '</div>' +
            '</div>' +
            '<div class="section-card-body-header">' +
              '<div class="studio-form-group" style="margin-bottom:0">' +
                '<label class="studio-label" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">' +
                  '<span>SECTION TITLE</span>' +
                  '<span class="section-anchor-chip">#' + (slugify(sec.title) || 'section') + '</span>' +
                '</label>' +
                '<input type="text" class="studio-input section-title-input" value="' + escapeHtml(sec.title) + '" placeholder="Section title..." />' +
              '</div>' +
            '</div>';

          // Active Section Selection (Safe Activation - No DOM destruction)
          card.addEventListener('click', function() {
            if (activeSectionId !== sec.id) {
              setActiveSection(sec.id);
            }
          });

          card.addEventListener('focusin', function() {
            if (activeSectionId !== sec.id) {
              setActiveSection(sec.id);
            }
          });

          // Title input
          var titleInput = header.querySelector('.section-title-input');
          titleInput.addEventListener('input', function(e) {
            sec.title = e.target.value;
            var anchorChip = header.querySelector('.section-anchor-chip');
            if (anchorChip) anchorChip.textContent = '#' + (slugify(sec.title) || 'section');
            triggerAutosave();
          });

          // Header action buttons
          header.querySelector('[data-action="dup"]').addEventListener('click', function(e) {
            e.stopPropagation();
            duplicateSection(sec.id);
          });
          header.querySelector('[data-action="up"]').addEventListener('click', function(e) {
            e.stopPropagation();
            moveSection(sec.id, -1);
          });
          header.querySelector('[data-action="down"]').addEventListener('click', function(e) {
            e.stopPropagation();
            moveSection(sec.id, 1);
          });
          header.querySelector('[data-action="del"]').addEventListener('click', function(e) {
            e.stopPropagation();
            deleteSection(sec.id, e.currentTarget);
          });

          // Section Drag and Drop Reordering
          var secHandle = header.querySelector('.section-drag-handle');
          secHandle.addEventListener('dragstart', function(e) {
            card.classList.add('dragging');
            e.dataTransfer.setData('text/plain', JSON.stringify({ source: 'section', secId: sec.id }));
            e.dataTransfer.effectAllowed = 'move';
            startDragAutoScroll();
          });
          secHandle.addEventListener('dragend', function() {
            card.classList.remove('dragging');
            stopDragAutoScroll();
          });

          card.addEventListener('dragover', function(e) {
            e.preventDefault();
            card.classList.add('drag-over');
          });

          card.addEventListener('dragleave', function() {
            card.classList.remove('drag-over');
          });

          card.addEventListener('drop', function(e) {
            e.preventDefault();
            card.classList.remove('drag-over');
            try {
              var payload = JSON.parse(e.dataTransfer.getData('text/plain'));
              if (payload.source === 'section' && payload.secId !== sec.id) {
                var srcIdx = currentDoc.sections.findIndex(function(s) { return s.id === payload.secId; });
                var dstIdx = currentDoc.sections.findIndex(function(s) { return s.id === sec.id; });
                if (srcIdx !== -1 && dstIdx !== -1) {
                  var [moved] = currentDoc.sections.splice(srcIdx, 1);
                  currentDoc.sections.splice(dstIdx, 0, moved);
                  renderSections();
                  triggerAutosave();
                  showToast('Sections reordered');
                }
              }
            } catch (err) {}
          });

          card.appendChild(header);

          // ── Section Body: Section Visual Grid Canvas ────────
          var gridEl = renderSectionVisualGridElement(sec);
          card.appendChild(gridEl);


          container.appendChild(card);
        });
        updateAllSavedSwatchesUI();
      }

      function createBlockCardElement(sec, b, bIndex, totalCount, context) {
        var isFlexChild = context && context.isFlexChild;
        var isCalloutChild = context && context.isCalloutChild;
        var isSlotChild = context && context.isSlotChild;
        var isFirstBlock = bIndex === 0;
        var isLastBlock = bIndex === totalCount - 1;
        var blkDef = window.STUDIO_REGISTRY[b.type] || { label: b.type };
        var glyph = BLOCK_GLYPHS[b.type] || '✦';

        var bCard = document.createElement('div');
        bCard.className = 'block-editor-card' + (isFlexChild ? ' is-flex-child' : '') + (isCalloutChild ? ' is-callout-child' : '') + (isSlotChild ? ' is-slot-child' : '');
        bCard.setAttribute('draggable', isSlotChild ? 'false' : 'true');
        bCard.setAttribute('data-sec-id', sec.id);
        bCard.setAttribute('data-block-id', b.id);
        bCard.setAttribute('data-block-type', b.type);
        if (isFlexChild) {
          bCard.setAttribute('data-flex-id', context.flexBlockId);
          bCard.setAttribute('data-col-id', context.colId);
        }
        if (isCalloutChild) {
          bCard.setAttribute('data-callout-id', context.calloutBlockId);
        }

        var bHeader = document.createElement('div');
        bHeader.className = 'block-editor-header';
        bHeader.innerHTML =
          '<div class="block-header-title">' +
            '<span class="block-drag-handle" title="Drag to reorder or move across sections">⋮⋮</span>' +
            '<span style="font-family:var(--font-mono);font-size:12px;color:var(--studio-gold);opacity:0.9">' + glyph + '</span>' +
            '<span class="block-type-badge">' + escapeHtml(blkDef.label) + '</span>' +
          '</div>' +
          '<div class="block-header-actions">' +
            '<button type="button" class="studio-btn studio-btn--icon" data-action="dup" title="Duplicate block">⧉</button>' +
            '<button type="button" class="studio-btn studio-btn--icon" data-action="up" title="Move up" ' + (isFirstBlock ? 'disabled' : '') + '>▲</button>' +
            '<button type="button" class="studio-btn studio-btn--icon" data-action="down" title="Move down" ' + (isLastBlock ? 'disabled' : '') + '>▼</button>' +
            '<button type="button" class="studio-btn studio-btn--icon studio-btn--danger" data-action="del" title="Delete block">×</button>' +
          '</div>';

        bHeader.querySelector('[data-action="dup"]').addEventListener('click', function(e) {
          e.stopPropagation();
          if (isFlexChild) {
            duplicateFlexChild(sec.id, context.flexBlockId, context.colId, b.id);
          } else if (isCalloutChild) {
            duplicateCalloutChild(sec.id, context.calloutBlockId, b.id);
          } else {
            duplicateBlock(sec.id, b.id);
          }
        });
        bHeader.querySelector('[data-action="up"]').addEventListener('click', function(e) {
          e.stopPropagation();
          if (isFlexChild) {
            moveFlexChild(sec.id, context.flexBlockId, context.colId, b.id, -1);
          } else if (isCalloutChild) {
            moveCalloutChild(sec.id, context.calloutBlockId, b.id, -1);
          } else {
            moveBlock(sec.id, b.id, -1);
          }
        });
        bHeader.querySelector('[data-action="down"]').addEventListener('click', function(e) {
          e.stopPropagation();
          if (isFlexChild) {
            moveFlexChild(sec.id, context.flexBlockId, context.colId, b.id, 1);
          } else if (isCalloutChild) {
            moveCalloutChild(sec.id, context.calloutBlockId, b.id, 1);
          } else {
            moveBlock(sec.id, b.id, 1);
          }
        });
        bHeader.querySelector('[data-action="del"]').addEventListener('click', function(e) {
          e.stopPropagation();
          if (isFlexChild) {
            deleteFlexChild(sec.id, context.flexBlockId, context.colId, b.id, e.currentTarget);
          } else if (isCalloutChild) {
            deleteCalloutChild(sec.id, context.calloutBlockId, b.id, e.currentTarget);
          } else {
            deleteBlock(sec.id, b.id, e.currentTarget);
          }
        });

        // Block Drag & Drop
        bCard.addEventListener('dragstart', function(e) {
          if (isSlotChild) {
            e.preventDefault();
            return false;
          }
          if (e.target && e.target.closest('input, textarea, select, [contenteditable="true"]')) {
            return;
          }
          e.stopPropagation();
          bCard.classList.add('dragging');
          if (isFlexChild) {
            draggedBlockData = { source: 'block', type: b.type, blockType: b.type, secId: sec.id, flexBlockId: context.flexBlockId, colId: context.colId, colIdx: context.colIdx, blockId: b.id };
          } else if (isCalloutChild) {
            draggedBlockData = { source: 'block', type: b.type, blockType: b.type, secId: sec.id, calloutBlockId: context.calloutBlockId, blockId: b.id };
          } else {
            draggedBlockData = { source: 'block', type: b.type, blockType: b.type, secId: sec.id, blockId: b.id };
          }
          e.dataTransfer.setData('text/plain', JSON.stringify(draggedBlockData));
          e.dataTransfer.effectAllowed = 'move';
          startDragAutoScroll();
        });

        bCard.addEventListener('dragend', function(e) {
          if (e && e.stopPropagation) e.stopPropagation();
          bCard.classList.remove('dragging');
          draggedBlockData = null;
          stopDragAutoScroll();
        });

        bCard.addEventListener('dragover', function(e) {
          e.preventDefault();
          e.stopPropagation();
          if (isFlexChild || isCalloutChild) {
            var parentContainerCard = bCard.parentElement ? bCard.parentElement.closest('.block-editor-card') : null;
            if (parentContainerCard) {
              parentContainerCard.classList.remove('drag-target-above', 'drag-target-below', 'drag-target-forbidden');
            }
          }
          if (isFlexChild && isDraggingFlexLayout()) {
            bCard.classList.add('drag-target-forbidden');
            bCard.classList.remove('drag-target-above', 'drag-target-below');
            e.dataTransfer.dropEffect = 'none';
            return;
          }
          if (isCalloutChild && isDraggingForbiddenInCallout()) {
            bCard.classList.add('drag-target-forbidden');
            bCard.classList.remove('drag-target-above', 'drag-target-below');
            e.dataTransfer.dropEffect = 'none';
            return;
          }
          if (isFlexChild) {
            var parentCol = bCard.closest('.studio-flex-col-panel');
            if (parentCol) parentCol.classList.add('drag-over');
          }
          if (isCalloutChild) {
            var parentCallout = bCard.closest('.studio-callout-blocks-panel');
            if (parentCallout) parentCallout.classList.add('drag-over');
          }
          var rect = bCard.getBoundingClientRect();
          var relY = e.clientY - rect.top;
          if (relY < rect.height / 2) {
            bCard.classList.add('drag-target-above');
            bCard.classList.remove('drag-target-below');
          } else {
            bCard.classList.add('drag-target-below');
            bCard.classList.remove('drag-target-above');
          }
        });

        bCard.addEventListener('dragleave', function(e) {
          if (e.relatedTarget && bCard.contains(e.relatedTarget)) return;
          bCard.classList.remove('drag-target-above', 'drag-target-below', 'drag-target-forbidden');
        });

        bCard.addEventListener('drop', function(e) {
          e.preventDefault();
          e.stopPropagation();
          if (bCard.classList.contains('drag-target-forbidden')) {
            bCard.classList.remove('drag-target-forbidden');
            return;
          }
          if (isFlexChild) {
            var parentCol = bCard.closest('.studio-flex-col-panel');
            if (parentCol) parentCol.classList.remove('drag-over', 'drag-target-forbidden');
          }
          if (isCalloutChild) {
            var parentCallout = bCard.closest('.studio-callout-blocks-panel');
            if (parentCallout) parentCallout.classList.remove('drag-over', 'drag-target-forbidden');
          }
          var insertIdx = bIndex;
          if (bCard.classList.contains('drag-target-below')) insertIdx = bIndex + 1;
          bCard.classList.remove('drag-target-above', 'drag-target-below');

          if (isFlexChild) {
            handleBlockDrop(e, { type: 'flex-col', secId: sec.id, flexBlockId: context.flexBlockId, colId: context.colId, colIdx: context.colIdx, insertIdx: insertIdx });
          } else if (isCalloutChild) {
            handleBlockDrop(e, { type: 'callout', secId: sec.id, calloutBlockId: context.calloutBlockId, insertIdx: insertIdx });
          } else {
            handleBlockDrop(e, { type: 'section', secId: sec.id, insertIdx: insertIdx });
          }
        });

        // Block Fields Body
        var bBody = document.createElement('div');
        bBody.className = 'block-editor-body';
        bBody.innerHTML = renderBlockFields(sec, b);

        // Attach Structured Field Event Handlers
        attachBlockListeners(bBody, sec, b);

        // Special Container Handling for Flexible Layout V2
        if (b.type === 'flex-layout') {
          var canvasWrap = bBody.querySelector('.studio-flex-canvas-wrap');
          if (canvasWrap) {
            canvasWrap.addEventListener('dragover', function(e) {
              e.stopPropagation(); // Isolate canvas from bubbling to flex-layout bCard
              var rect = canvasWrap.getBoundingClientRect();
              var edgeZone = 80;
              var x = e.clientX;
              if (x - rect.left < edgeZone && x - rect.left >= 0) {
                var ratio = 1 - ((x - rect.left) / edgeZone);
                canvasWrap.scrollLeft -= Math.ceil(18 * ratio);
              } else if (rect.right - x < edgeZone && rect.right - x >= 0) {
                var ratio = 1 - ((rect.right - x) / edgeZone);
                canvasWrap.scrollLeft += Math.ceil(18 * ratio);
              }
            });
            canvasWrap.addEventListener('drop', function(e) {
              e.stopPropagation();
            });
          }

          var curColCount = b.data.columnCount === 3 ? 3 : 2;
          var cols = (b.data.columns || []).slice(0, curColCount);

          cols.forEach(function(col, cIdx) {
            col.id = col.id || ('col_' + (cIdx + 1));
            var colPanel = bBody.querySelector('.studio-flex-col-panel[data-col-idx="' + cIdx + '"]');
            var colBlocksContainer = bBody.querySelector('.studio-flex-col-blocks[data-col-idx="' + cIdx + '"]');
            if (!colPanel || !colBlocksContainer) return;
            colBlocksContainer.innerHTML = '';

            var childBlocks = Array.isArray(col.blocks) ? col.blocks : [];

            if (childBlocks.length === 0) {
              var emptyDropzone = document.createElement('div');
              emptyDropzone.className = 'studio-flex-empty-dropzone';
              emptyDropzone.innerHTML =
                '<div class="flex-empty-icon">✧</div>' +
                '<div class="flex-empty-title">Drop Coven blocks here</div>' +
                '<div class="flex-empty-sub">Drag from the Block Library or move an existing block</div>';
              colBlocksContainer.appendChild(emptyDropzone);
            } else {
              childBlocks.forEach(function(cb, cbIndex) {
                var childCard = createBlockCardElement(sec, cb, cbIndex, childBlocks.length, {
                  isFlexChild: true,
                  flexBlockId: b.id,
                  colId: col.id,
                  colIdx: cIdx
                });
                colBlocksContainer.appendChild(childCard);
              });
            }

            // UNIFIED COLUMN-LEVEL DRAG & DROP HANDLERS
            colPanel.addEventListener('dragover', function(e) {
              e.preventDefault();
              e.stopPropagation();
              bCard.classList.remove('drag-target-above', 'drag-target-below', 'drag-target-forbidden');

              if (isDraggingFlexLayout()) {
                colPanel.classList.add('drag-target-forbidden');
                e.dataTransfer.dropEffect = 'none';
                return;
              }

              colPanel.classList.add('drag-over');

              var currentChildCards = Array.from(colBlocksContainer.querySelectorAll(':scope > .block-editor-card'));
              if (currentChildCards.length === 0) {
                var emptyDz = colBlocksContainer.querySelector('.studio-flex-empty-dropzone');
                if (emptyDz) emptyDz.classList.add('drag-over');
                return;
              }

              var mouseY = e.clientY;
              var targetCard = null;
              var insertAbove = true;

              for (var i = 0; i < currentChildCards.length; i++) {
                var r = currentChildCards[i].getBoundingClientRect();
                var mid = r.top + r.height / 2;
                if (mouseY < mid) {
                  targetCard = currentChildCards[i];
                  insertAbove = true;
                  break;
                }
                if (i === currentChildCards.length - 1) {
                  targetCard = currentChildCards[i];
                  insertAbove = false;
                }
              }

              currentChildCards.forEach(function(c) {
                c.classList.remove('drag-target-above', 'drag-target-below');
              });

              if (targetCard) {
                targetCard.classList.add(insertAbove ? 'drag-target-above' : 'drag-target-below');
              }
            });

            colPanel.addEventListener('dragleave', function(e) {
              if (e.relatedTarget && colPanel.contains(e.relatedTarget)) {
                return;
              }
              colPanel.classList.remove('drag-over', 'drag-target-forbidden');
              var emptyDz = colBlocksContainer.querySelector('.studio-flex-empty-dropzone');
              if (emptyDz) emptyDz.classList.remove('drag-over', 'drag-target-forbidden');
              colBlocksContainer.querySelectorAll(':scope > .block-editor-card').forEach(function(c) {
                c.classList.remove('drag-target-above', 'drag-target-below', 'drag-target-forbidden');
              });
            });

            colPanel.addEventListener('drop', function(e) {
              e.preventDefault();
              e.stopPropagation();

              colPanel.classList.remove('drag-over', 'drag-target-forbidden');
              var emptyDz = colBlocksContainer.querySelector('.studio-flex-empty-dropzone');
              if (emptyDz) emptyDz.classList.remove('drag-over', 'drag-target-forbidden');

              if (isDraggingFlexLayout()) return;

              var currentChildCards = Array.from(colBlocksContainer.querySelectorAll(':scope > .block-editor-card'));
              var insertIdx = 0;

              if (currentChildCards.length > 0) {
                var mouseY = e.clientY;
                insertIdx = currentChildCards.length;

                for (var i = 0; i < currentChildCards.length; i++) {
                  var r = currentChildCards[i].getBoundingClientRect();
                  var mid = r.top + r.height / 2;
                  if (mouseY < mid) {
                    insertIdx = i;
                    break;
                  }
                }

                currentChildCards.forEach(function(c) {
                  c.classList.remove('drag-target-above', 'drag-target-below', 'drag-target-forbidden');
                });
              }

              handleBlockDrop(e, {
                type: 'flex-col',
                secId: sec.id,
                flexBlockId: b.id,
                colId: col.id,
                colIdx: cIdx,
                insertIdx: insertIdx
              });
            });
          });
        }

        // Special Container Handling for Composable Callout Advisory V2
        if (b.type === 'callout') {
          var calloutPanel = bBody.querySelector('.studio-callout-blocks-panel[data-callout-id="' + b.id + '"]');
          var calloutBlocksContainer = bBody.querySelector('.studio-callout-blocks[data-callout-id="' + b.id + '"]');
          var upgradeBtn = bBody.querySelector('[data-act="callout-upgrade-composable"]');
          var addTextBtn = bBody.querySelector('[data-act="callout-add-text"]');

          if (upgradeBtn) {
            upgradeBtn.addEventListener('click', function(e) {
              e.stopPropagation();
              var richPara = getRichData(b.data.text !== undefined ? b.data.text : b.data.body);
              b.data.blocks = [
                {
                  id: uid('blk'),
                  type: 'solo-text',
                  data: {
                    paragraphs: [richPara]
                  }
                }
              ];
              b.data.text = { text: '', align: 'left' };
              delete b.data.body;
              renderSections();
              triggerAutosave();
              showToast('Upgraded Callout to composable blocks');
            });
          }

          if (addTextBtn) {
            addTextBtn.addEventListener('click', function(e) {
              e.stopPropagation();
              if (!Array.isArray(b.data.blocks)) b.data.blocks = [];
              b.data.blocks.push({
                id: uid('blk'),
                type: 'solo-text',
                data: { paragraphs: [{ text: '', align: 'left' }] }
              });
              renderSections();
              triggerAutosave();
              showToast('Added Solo Text to Callout');
            });
          }

          if (calloutBlocksContainer && calloutPanel) {
            calloutBlocksContainer.innerHTML = '';
            var calloutChildBlocks = Array.isArray(b.data.blocks) ? b.data.blocks : [];

            if (calloutChildBlocks.length === 0) {
              var emptyDropzone = document.createElement('div');
              emptyDropzone.className = 'studio-callout-empty-dropzone';
              emptyDropzone.innerHTML =
                '<div class="callout-empty-icon">✧</div>' +
                '<div class="callout-empty-title">Drop Coven blocks here</div>' +
                '<div class="callout-empty-sub">Solo Text, Nested Bullets, Image, Table... Drag from Block Library or existing blocks</div>';
              calloutBlocksContainer.appendChild(emptyDropzone);
            } else {
              calloutChildBlocks.forEach(function(cb, cbIndex) {
                var childCard = createBlockCardElement(sec, cb, cbIndex, calloutChildBlocks.length, {
                  isCalloutChild: true,
                  calloutBlockId: b.id
                });
                calloutBlocksContainer.appendChild(childCard);
              });
            }

            // UNIFIED CALLOUT DRAG & DROP HANDLERS
            calloutPanel.addEventListener('dragover', function(e) {
              e.preventDefault();
              e.stopPropagation();
              bCard.classList.remove('drag-target-above', 'drag-target-below', 'drag-target-forbidden');

              if (isDraggingForbiddenInCallout()) {
                calloutPanel.classList.add('drag-target-forbidden');
                e.dataTransfer.dropEffect = 'none';
                return;
              }

              calloutPanel.classList.add('drag-over');

              var currentChildCards = Array.from(calloutBlocksContainer.querySelectorAll(':scope > .block-editor-card'));
              if (currentChildCards.length === 0) {
                var emptyDz = calloutBlocksContainer.querySelector('.studio-callout-empty-dropzone');
                if (emptyDz) emptyDz.classList.add('drag-over');
                return;
              }

              var mouseY = e.clientY;
              var targetCard = null;
              var insertAbove = true;

              for (var i = 0; i < currentChildCards.length; i++) {
                var r = currentChildCards[i].getBoundingClientRect();
                var mid = r.top + r.height / 2;
                if (mouseY < mid) {
                  targetCard = currentChildCards[i];
                  insertAbove = true;
                  break;
                }
                if (i === currentChildCards.length - 1) {
                  targetCard = currentChildCards[i];
                  insertAbove = false;
                }
              }

              currentChildCards.forEach(function(c) {
                c.classList.remove('drag-target-above', 'drag-target-below');
              });

              if (targetCard) {
                targetCard.classList.add(insertAbove ? 'drag-target-above' : 'drag-target-below');
              }
            });

            calloutPanel.addEventListener('dragleave', function(e) {
              if (e.relatedTarget && calloutPanel.contains(e.relatedTarget)) {
                return;
              }
              calloutPanel.classList.remove('drag-over', 'drag-target-forbidden');
              var emptyDz = calloutBlocksContainer.querySelector('.studio-callout-empty-dropzone');
              if (emptyDz) emptyDz.classList.remove('drag-over', 'drag-target-forbidden');
              calloutBlocksContainer.querySelectorAll(':scope > .block-editor-card').forEach(function(c) {
                c.classList.remove('drag-target-above', 'drag-target-below', 'drag-target-forbidden');
              });
            });

            calloutPanel.addEventListener('drop', function(e) {
              e.preventDefault();
              e.stopPropagation();

              calloutPanel.classList.remove('drag-over', 'drag-target-forbidden');
              var emptyDz = calloutBlocksContainer.querySelector('.studio-callout-empty-dropzone');
              if (emptyDz) emptyDz.classList.remove('drag-over', 'drag-target-forbidden');

              if (isDraggingForbiddenInCallout()) {
                showToast('This block type cannot be nested inside Callout Advisory.', 'error');
                return;
              }

              var currentChildCards = Array.from(calloutBlocksContainer.querySelectorAll(':scope > .block-editor-card'));
              var insertIdx = 0;

              if (currentChildCards.length > 0) {
                var mouseY = e.clientY;
                insertIdx = currentChildCards.length;

                for (var i = 0; i < currentChildCards.length; i++) {
                  var r = currentChildCards[i].getBoundingClientRect();
                  var mid = r.top + r.height / 2;
                  if (mouseY < mid) {
                    insertIdx = i;
                    break;
                  }
                }

                currentChildCards.forEach(function(c) {
                  c.classList.remove('drag-target-above', 'drag-target-below', 'drag-target-forbidden');
                });
              }

              handleBlockDrop(e, {
                type: 'callout',
                secId: sec.id,
                calloutBlockId: b.id,
                insertIdx: insertIdx
              });
            });
          }
        }

        bCard.appendChild(bHeader);
        bCard.appendChild(bBody);
        return bCard;
      }

      function handleBlockDrop(e, target) {
        try {
          var payloadStr = (e.dataTransfer && e.dataTransfer.getData('text/plain')) || '{}';
          var payload = null;
          try { payload = JSON.parse(payloadStr); } catch (pErr) {}
          if (!payload || !payload.source) payload = draggedBlockData;
          if (!payload || !payload.source) return;

          var targetSecId, targetFlexBlockId, targetColId, targetColIdx, targetCalloutBlockId, insertIdx, isFlexTarget, isCalloutTarget;
          if (typeof target === 'object' && target !== null) {
            isFlexTarget = target.type === 'flex-col';
            isCalloutTarget = target.type === 'callout';
            targetSecId = target.secId;
            targetFlexBlockId = target.flexBlockId;
            targetColId = target.colId;
            targetColIdx = target.colIdx;
            targetCalloutBlockId = target.calloutBlockId;
            insertIdx = target.insertIdx;
          } else {
            targetSecId = arguments[1];
            insertIdx = arguments[2];
            isFlexTarget = false;
            isCalloutTarget = false;
          }

          var draggedType = payload.type || payload.blockType || '';
          if (payload.source === 'block' && !draggedType && payload.blockId) {
            var srcB = findBlockById(payload.blockId);
            if (srcB) draggedType = srcB.type;
          }

          // STRICT CHECK: Forbid flex-layout inside flex-col
          if (isFlexTarget) {
            if (!canNestInFlexLayout(draggedType)) {
              showToast('Flexible Layout cannot be nested inside another Flexible Layout.', 'error');
              return;
            }
          }

          // STRICT CHECK: Centralized Callout nesting eligibility
          if (isCalloutTarget) {
            if (!canNestInCallout(draggedType)) {
              showToast('This block type cannot be nested inside Callout Advisory.', 'error');
              return;
            }
          }

          var targetSec = currentDoc.sections.find(function(s) { return s.id === targetSecId; });
          if (!targetSec) return;

          var targetArray;
          if (isFlexTarget) {
            var flexBlock = targetSec.blocks.find(function(b) { return b.id === targetFlexBlockId; });
            if (!flexBlock || flexBlock.type !== 'flex-layout') return;
            var col = (flexBlock.data.columns || []).find(function(c) { return c.id === targetColId; });
            if (!col && typeof targetColIdx === 'number' && flexBlock.data.columns && flexBlock.data.columns[targetColIdx]) {
              col = flexBlock.data.columns[targetColIdx];
            }
            if (!col) return;
            if (!Array.isArray(col.blocks)) col.blocks = [];
            targetArray = col.blocks;
          } else if (isCalloutTarget) {
            var calloutLoc = resolveBlockLocation(targetCalloutBlockId);
            var calloutBlock = calloutLoc ? calloutLoc.block : targetSec.blocks.find(function(b) { return b.id === targetCalloutBlockId; });
            if (!calloutBlock || calloutBlock.type !== 'callout') return;
            if (!Array.isArray(calloutBlock.data.blocks)) calloutBlock.data.blocks = [];
            targetArray = calloutBlock.data.blocks;
          } else {
            targetArray = targetSec.blocks;
          }

          if (payload.source === 'library') {
            var def = window.STUDIO_REGISTRY[payload.type];
            if (!def) return;

            var newBlock = {
              id: uid('blk'),
              type: payload.type,
              data: JSON.parse(JSON.stringify(def.defaultData))
            };
            if ((payload.type === 'text-image' || payload.type === 'image-text') && !newBlock.data.paragraphs) {
              newBlock.data.paragraphs = [{ text: '', align: 'left' }];
            }
            if (payload.type === 'flex-layout') {
              newBlock.data.columns = [
                { id: uid('fcol'), blocks: [] },
                { id: uid('fcol'), blocks: [] }
              ];
            }
            if (payload.type === 'callout') {
              newBlock.data.blocks = [
                {
                  id: uid('blk'),
                  type: 'solo-text',
                  data: { paragraphs: [{ text: '', align: 'left' }] }
                }
              ];
            }
            if (insertIdx !== undefined && insertIdx >= 0 && insertIdx <= targetArray.length) {
              targetArray.splice(insertIdx, 0, newBlock);
            } else {
              targetArray.push(newBlock);
            }
            normalizeDocument(currentDoc);
            activeSectionId = targetSec.id;
            renderSections();
            triggerAutosave();
            showToast('Inserted block: ' + def.label);
          } else if (payload.source === 'block') {
            var srcSec = currentDoc.sections.find(function(s) { return s.id === payload.secId; });
            if (!srcSec) return;

            var movedBlock = null;
            if (payload.calloutBlockId) {
              var srcCalloutLoc = resolveBlockLocation(payload.calloutBlockId);
              var srcCallout = srcCalloutLoc ? srcCalloutLoc.block : srcSec.blocks.find(function(b) { return b.id === payload.calloutBlockId; });
              if (srcCallout && srcCallout.type === 'callout' && srcCallout.data && Array.isArray(srcCallout.data.blocks)) {
                var cbIdx = srcCallout.data.blocks.findIndex(function(b) { return b.id === payload.blockId; });
                if (cbIdx !== -1) {
                  movedBlock = srcCallout.data.blocks.splice(cbIdx, 1)[0];
                  if (targetArray === srcCallout.data.blocks && cbIdx < insertIdx) {
                    insertIdx--;
                  }
                }
              }
            } else if (payload.flexBlockId) {
              var srcFlex = srcSec.blocks.find(function(b) { return b.id === payload.flexBlockId; });
              if (srcFlex && srcFlex.type === 'flex-layout') {
                var srcCol = (srcFlex.data.columns || []).find(function(c) { return c.id === payload.colId; });
                if (!srcCol && typeof payload.colIdx === 'number' && srcFlex.data.columns && srcFlex.data.columns[payload.colIdx]) {
                  srcCol = srcFlex.data.columns[payload.colIdx];
                }
                if (srcCol && Array.isArray(srcCol.blocks)) {
                  var bIdx = srcCol.blocks.findIndex(function(b) { return b.id === payload.blockId; });
                  if (bIdx !== -1) {
                    movedBlock = srcCol.blocks.splice(bIdx, 1)[0];
                    if (targetArray === srcCol.blocks && bIdx < insertIdx) {
                      insertIdx--;
                    }
                  }
                }
              }
            } else {
              var bIdx = srcSec.blocks.findIndex(function(b) { return b.id === payload.blockId; });
              if (bIdx !== -1) {
                movedBlock = srcSec.blocks.splice(bIdx, 1)[0];
                if (targetArray === srcSec.blocks && bIdx < insertIdx) {
                  insertIdx--;
                }
              }
            }

            // Resilient fallback using resolveBlockLocation if not found in primary path
            if (!movedBlock) {
              var loc = resolveBlockLocation(payload.blockId);
              if (loc) {
                if (loc.parentType === 'callout') {
                  var pCalloutLoc = resolveBlockLocation(loc.parentBlockId);
                  var pCallout = pCalloutLoc ? pCalloutLoc.block : null;
                  if (pCallout && pCallout.data && Array.isArray(pCallout.data.blocks)) {
                    var idx = pCallout.data.blocks.findIndex(function(b) { return b.id === payload.blockId; });
                    if (idx !== -1) {
                      movedBlock = pCallout.data.blocks.splice(idx, 1)[0];
                      if (targetArray === pCallout.data.blocks && idx < insertIdx) insertIdx--;
                    }
                  }
                } else if (loc.parentType === 'flex-col') {
                  var sFlex = loc.section.blocks.find(function(b) { return b.id === loc.parentBlockId; });
                  if (sFlex && sFlex.data && Array.isArray(sFlex.data.columns)) {
                    var sCol = sFlex.data.columns.find(function(c) { return c.id === loc.columnId; });
                    if (sCol && Array.isArray(sCol.blocks)) {
                      var idx = sCol.blocks.findIndex(function(b) { return b.id === payload.blockId; });
                      if (idx !== -1) {
                        movedBlock = sCol.blocks.splice(idx, 1)[0];
                        if (targetArray === sCol.blocks && idx < insertIdx) insertIdx--;
                      }
                    }
                  }
                } else if (loc.parentType === 'section') {
                  var idx = loc.section.blocks.findIndex(function(b) { return b.id === payload.blockId; });
                  if (idx !== -1) {
                    movedBlock = loc.section.blocks.splice(idx, 1)[0];
                    if (targetArray === loc.section.blocks && idx < insertIdx) insertIdx--;
                  }
                }
              }
            }

            if (!movedBlock) return;

            if (insertIdx !== undefined && insertIdx >= 0 && insertIdx <= targetArray.length) {
              targetArray.splice(insertIdx, 0, movedBlock);
            } else {
              targetArray.push(movedBlock);
            }

            activeSectionId = targetSec.id;
            renderSections();
            triggerAutosave();
            showToast('Block moved');
          }
        } catch (err) {
          console.error('handleBlockDrop error:', err);
        } finally {
          draggedBlockData = null;
          stopDragAutoScroll();
        }
      }

