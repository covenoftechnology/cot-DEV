        var reqSpan = clampVal(requestedSpan || 4, 1, 4);

        // 1. Calculate contiguous free columns starting at `col` on `row`
        var contiguousFree = 0;
        for (var c = col; c <= 4; c++) {
          var singleCell = {
            columnStart: c,
            columnSpan: 1,
            columnEnd: c + 1,
            rowStart: row,
            rowSpan: 1,
            rowEnd: row + 1
          };
          if (checkSlotCollisionState(items, excludeItemId, singleCell)) {
            break;
          }
          contiguousFree++;
        }

        // 2. Case: Target cell itself is occupied
        if (contiguousFree === 0) {
          return {
            valid: false,
            columnStart: col,
            columnSpan: reqSpan,
            rowStart: row,
            rowSpan: 1,
            contiguousFree: 0,
            autoFitApplied: false,
            reason: 'Space Occupied'
