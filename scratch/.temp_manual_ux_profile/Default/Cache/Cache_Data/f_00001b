      function checkSlotCollisionState(items, excludeId, rect) {
        if (!Array.isArray(items)) return false;
        for (var i = 0; i < items.length; i++) {
          var it = items[i];
          if (it.id === excludeId) continue;
          if (rectsOverlapCoords(it, rect)) return true;
