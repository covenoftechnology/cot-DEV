  font-size: clamp(18px, 4.5vw, 22px);
  line-height: 1.3;
  color: #ece6dd;
  margin: 30px 0 14px;
}

.article-template h4 {
  font-family: var(--font-display, 'Metamorphous', serif);
  font-weight: 600;
  font-size: 16px;
  line-height: 1.35;
  color: #ece6dd;
  margin: 24px 0 10px;
}

.article-template p {
  font-family: var(--font-body, 'Helvetica Neue Roman', serif);
  font-size: 18px;
  font-weight: 400;
