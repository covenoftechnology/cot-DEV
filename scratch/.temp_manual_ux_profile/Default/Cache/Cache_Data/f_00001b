        }

        function migrateV1UnitToBlock(u) {
          if (!u || !u.type) return null;
          if (u.type === 'text') {
            var hasHeading = u.heading && ((typeof u.heading === 'string' && u.heading.trim().length > 0) || (u.heading.text && u.heading.text.trim().length > 0));
            if (hasHeading) {
              return {
                id: uid('blk'),
                type: 'title-text',
                data: {
                  heading: getRichData(u.heading),
                  paragraphs: Array.isArray(u.paragraphs) ? u.paragraphs.map(function(p) { return getRichData(p); }) : [{ text: '', align: 'left' }]
                }
              };
            } else {
              return {
                id: uid('blk'),
                type: 'solo-text',
                data: {
                  paragraphs: Array.isArray(u.paragraphs) ? u.paragraphs.map(function(p) { return getRichData(p); }) : [{ text: '', align: 'left' }]
                }
              };
            }
          } else if (u.type === 'list') {
            return {
              id: uid('blk'),
              type: 'nested-bullets',
              data: {
                title: getRichData(u.title || ''),
                markers: u.markers || { level1: 'coven', level2: 'upper-alpha', level3: 'hyphen' },
                items: Array.isArray(u.items) ? u.items : [{ id: uid('main'), text: getRichData(''), children: [] }]
              }
            };
          } else if (u.type === 'image') {
            return {
              id: uid('blk'),
              type: 'single-image',
              data: {
                src: u.imageSrc || '',
                alt: u.alt || '',
                caption: getRichData(u.caption || '')
              }
            };
          }
          return null;
        }

        function normalizeBlock(blk) {
          if (!blk.id) blk.id = uid('blk');
          var d = blk.data = blk.data || {};

          switch (blk.type) {
              case 'title-text':
                if (!Array.isArray(d.paragraphs)) {
                  d.paragraphs = d.paragraph || d.text ? [d.paragraph || d.text] : [''];
                }
                d.paragraphs = d.paragraphs.map(function(p) { return getRichData(p); });
                d.heading = getRichData(d.heading);
                if (d.showText !== undefined) {
                  d.showText = d.showText !== false;
                }
                break;

              case 'text-title':
                d.intro = getRichData(d.intro);
                d.heading = getRichData(d.heading);
                d.paragraph = getRichData(d.paragraph || d.text);
                break;

              case 'solo-text':
                if (!Array.isArray(d.paragraphs)) {
                  d.paragraphs = d.paragraph || d.text ? [d.paragraph || d.text] : [''];
                }
                d.paragraphs = d.paragraphs.map(function(p) { return getRichData(p); });
                break;

              case 'bullet-list':
                if (Array.isArray(d.items)) {
                  d.items = d.items.map(function(it) {
                    if (typeof it === 'string') return { id: uid('item'), text: it };
                    if (!it.id) it.id = uid('item');
                    return it;
                  });
                } else {
                  d.items = [{ id: uid('item'), text: '' }];
                }
                break;

              case 'nested-bullets':
                if (d.title !== undefined) {
                  d.title = getRichData(d.title);
                }
                function normalizeNestedNodes(nodes, depth) {
                  var curDepth = depth || 1;
                  if (!Array.isArray(nodes)) return [];
                  return nodes.map(function(node) {
                    if (typeof node === 'string') node = { text: node };
                    if (!node || typeof node !== 'object') node = { text: '' };
                    if (!node.id) node.id = uid(curDepth === 1 ? 'main' : ('sub_l' + curDepth));
                    node.text = getRichData(node.text);
                    var rawChildren = Array.isArray(node.children) ? node.children : (Array.isArray(node.subItems) ? node.subItems : []);
                    delete node.subItems;
                    if (canAddNestedListChild(curDepth)) {
                      node.children = normalizeNestedNodes(rawChildren, curDepth + 1);
                    } else {
                      node.children = [];
                    }
                    return node;
                  });
                }
                if (Array.isArray(d.items) && d.items.length > 0) {
                  d.items = normalizeNestedNodes(d.items, 1);
                } else {
                  d.items = [{ id: uid('main'), text: getRichData(''), children: [] }];
                }
                break;

              case 'numbered-steps':
                if (d.title !== undefined) {
                  d.title = getRichData(d.title);
                }
                if (Array.isArray(d.steps)) {
                  d.steps = d.steps.map(function(s, idx) {
                    if (!s.id) s.id = uid('step');
                    s.badge = String(idx + 1).padStart(2, '0');
                    s.title = getRichData(s.title);
                    s.text = getRichData(s.text);
                    return s;
                  });
                } else {
                  d.steps = [{ id: uid('step'), badge: '01', title: getRichData(''), text: getRichData('') }];
                }
                break;

              case 'text-image':
              case 'image-text':
                if (d.heading !== undefined) d.heading = getRichData(d.heading);
                d.text = getRichData(d.text);
                if (d.caption !== undefined) d.caption = getRichData(d.caption);
                break;

              case 'two-columns':
                if (d.col1Title !== undefined) d.col1Title = getRichData(d.col1Title);
                d.col1Text = getRichData(d.col1Text);
                if (d.col2Title !== undefined) d.col2Title = getRichData(d.col2Title);
                d.col2Text = getRichData(d.col2Text);
                break;

              case 'three-columns':
                if (!Array.isArray(d.columns) || d.columns.length === 0) {
                  d.columns = [
                    { id: 'col_1', kicker: 'PILLAR I', title: getRichData(''), text: getRichData('') },
                    { id: 'col_2', kicker: 'PILLAR II', title: getRichData(''), text: getRichData('') },
                    { id: 'col_3', kicker: 'PILLAR III', title: getRichData(''), text: getRichData('') }
                  ];
                } else {
                  d.columns.forEach(function(c, i) {
                    if (!c.id) c.id = 'col_' + (i + 1);
                    c.title = getRichData(c.title);
                    c.text = getRichData(c.text);
                  });
                }
                break;

              case 'single-image':
              case 'full-image':
                if (d.caption !== undefined) d.caption = getRichData(d.caption);
                break;

              case 'two-images':
                if (d.img1Caption !== undefined) d.img1Caption = getRichData(d.img1Caption);
                if (d.img2Caption !== undefined) d.img2Caption = getRichData(d.img2Caption);
                break;

              case 'flex-layout':
                d.columnCount = (d.columnCount === 3) ? 3 : 2;
                d.ratio = (d.ratio === '40-60' || d.ratio === '60-40') ? d.ratio : '50-50';
                if (!Array.isArray(d.columns) || d.columns.length === 0) {
                  d.columns = [
                    { id: uid('fcol'), blocks: [] },
                    { id: uid('fcol'), blocks: [] }
                  ];
                }
                while (d.columns.length < d.columnCount) {
                  d.columns.push({ id: uid('fcol'), blocks: [] });
                }
                d.columns.forEach(function(col, cIdx) {
                  col.id = col.id || ('col_' + (cIdx + 1));
                  if (!Array.isArray(col.blocks)) {
                    if (Array.isArray(col.units) && col.units.length > 0) {
                      col.blocks = col.units.map(function(u) {
                        return migrateV1UnitToBlock(u);
                      }).filter(Boolean);
                      delete col.units;
                    } else {
                      col.blocks = [];
                    }
                  }
                  col.blocks = col.blocks.filter(function(b) {
                    return b && b.type && b.type !== 'flex-layout';
                  });
                  col.blocks.forEach(function(childBlock) {
                    normalizeBlock(childBlock);
                  });
                });
                break;

              case 'three-images':
                if (d.img1Caption !== undefined) d.img1Caption = getRichData(d.img1Caption);
                if (d.img2Caption !== undefined) d.img2Caption = getRichData(d.img2Caption);
                if (d.img3Caption !== undefined) d.img3Caption = getRichData(d.img3Caption);
                break;

              case 'gallery-scroll':
                if (!Array.isArray(d.cards)) {
                  d.cards = [];
                } else {
                  d.cards.forEach(function(c) {
                    if (!c.id) c.id = uid('gcard');
                    c.caption = getRichData(c.caption);
                  });
                }
                break;

              case 'card-grid-2':
                d.card1Title = getRichData(d.card1Title);
                d.card1Desc = getRichData(d.card1Desc);
                d.card2Title = getRichData(d.card2Title);
                d.card2Desc = getRichData(d.card2Desc);
                break;

              case 'card-grid-3':
                d.card1Title = getRichData(d.card1Title);
                d.card1Desc = getRichData(d.card1Desc);
                d.card2Title = getRichData(d.card2Title);
                d.card2Desc = getRichData(d.card2Desc);
                d.card3Title = getRichData(d.card3Title);
                d.card3Desc = getRichData(d.card3Desc);
                break;

              case 'comparison':
                d.col1Header = getRichData(d.col1Header);
                d.col2Header = getRichData(d.col2Header);
                if (Array.isArray(d.col1Items)) {
                  d.col1Items = d.col1Items.map(function(it) {
                    if (typeof it === 'string') return { id: uid('c1'), text: getRichData(it) };
                    if (!it.id) it.id = uid('c1');
                    it.text = getRichData(it.text);
                    return it;
                  });
                } else {
                  d.col1Items = [];
                }
                if (Array.isArray(d.col2Items)) {
                  d.col2Items = d.col2Items.map(function(it) {
                    if (typeof it === 'string') return { id: uid('c2'), text: getRichData(it) };
                    if (!it.id) it.id = uid('c2');
                    it.text = getRichData(it.text);
                    return it;
                  });
                } else {
                  d.col2Items = [];
                }
                break;

              case 'stats-metrics':
                d.stat1Label = getRichData(d.stat1Label);
                d.stat1Sub = getRichData(d.stat1Sub);
                d.stat2Label = getRichData(d.stat2Label);
                d.stat2Sub = getRichData(d.stat2Sub);
                d.stat3Label = getRichData(d.stat3Label);
                d.stat3Sub = getRichData(d.stat3Sub);
                break;

              case 'technical-table':
                if (!Array.isArray(d.columns) || d.columns.length === 0) {
                  if (Array.isArray(d.headers) && d.headers.length > 0) {
                    d.columns = d.headers.map(function(h, idx) {
                      return { id: 'col_' + idx, label: getRichData(h) };
                    });
                    if (Array.isArray(d.rows)) {
                      d.rows = d.rows.map(function(r) {
                        var cells = {};
                        d.columns.forEach(function(c, cIdx) {
                          cells[c.id] = getRichData(r.cells ? (r.cells[c.id] || '') : (r['col' + (cIdx + 1)] || (Array.isArray(r) ? r[cIdx] : '')));
                        });
                        return { id: r.id || uid('row'), cells: cells };
                      });
                    }
                  } else {
                    d.columns = [
                      { id: 'col_1', label: getRichData('Feature') },
                      { id: 'col_2', label: getRichData('Status') }
                    ];
                    d.rows = [
                      { id: uid('row'), cells: { col_1: getRichData(''), col_2: getRichData('') } }
                    ];
                  }
                } else {
                  d.columns.forEach(function(c) {
                    c.label = getRichData(c.label);
                  });
                  (d.rows || []).forEach(function(r) {
                    r.cells = r.cells || {};
                    d.columns.forEach(function(c) {
                      r.cells[c.id] = getRichData(r.cells[c.id]);
                    });
                  });
                }
                break;

              case 'callout':
                if (d.showTitle === undefined) {
                  d.showTitle = true;
                }
                if (d.titleMode === undefined) {
                  if (d.title !== undefined && d.title !== null && (typeof d.title === 'string' ? d.title.trim() : (d.title.text && d.title.text.trim()))) {
                    d.titleMode = 'custom';
                    d.title = getRichData(d.title);
                  } else {
                    d.titleMode = 'default';
                    delete d.title;
                  }
                } else if (d.titleMode === 'custom' && d.title !== undefined) {
                  d.title = getRichData(d.title);
                }
                if (d.text === undefined && d.body !== undefined) {
                  d.text = getRichData(d.body);
                } else {
                  d.text = getRichData(d.text);
                }
                if (Array.isArray(d.blocks)) {
                  d.blocks = d.blocks.filter(function(b) {
                    return b && b.type && canNestInCallout(b);
                  });
                  d.blocks.forEach(function(childBlock) {
                    normalizeBlock(childBlock);
                  });
                }
                break;

              case 'pullquote':
                d.quote = getRichData(d.quote);
                d.author = getRichData(d.author);
                break;

              case 'code-block':
                if (d.title !== undefined) d.title = getRichData(d.title);
                break;

              case 'faq':
                if (Array.isArray(d.items)) {
                  d.items = d.items.map(function(it) {
                    if (!it.id) it.id = uid('faq');
                    it.question = getRichData(it.question);
                    it.answer = getRichData(it.answer);
                    return it;
                  });
                } else {
                  d.items = [{ id: uid('faq'), question: getRichData(''), answer: getRichData('') }];
                }
                break;

              case 'exercise':
                d.scenario = getRichData(d.scenario);
                d.solutionTitle = getRichData(d.solutionTitle);
                d.solutionText = getRichData(d.solutionText);
                break;

              case 'article-trial':
                d.title = getRichData(d.title || "You've reached the trial");
                d.intro = getRichData(d.intro || d.description || '');
                if (!Array.isArray(d.questions) || d.questions.length === 0) {
                  d.questions = [
                    {
                      id: uid('q'),
                      question: getRichData(''),
                      answers: [
                        { id: uid('ans'), text: getRichData(''), correct: true },
                        { id: uid('ans'), text: getRichData(''), correct: false }
                      ],
                      explanation: getRichData('')
                    }
                  ];
                } else {
                  d.questions.forEach(function(q) {
                    if (!q.id) q.id = uid('q');
                    q.question = getRichData(q.question);
                    q.explanation = getRichData(q.explanation);
                    if (!Array.isArray(q.answers)) q.answers = [];
                    q.answers.forEach(function(a) {
                      if (!a.id) a.id = uid('ans');
                      a.text = getRichData(a.text);
                    });
                  });
                }
                break;

              case 'key-takeaways':
                if (d.title !== undefined) d.title = getRichData(d.title);
                if (Array.isArray(d.items)) {
                  d.items = d.items.map(function(it) {
                    if (!it.id) it.id = uid('t');
                    it.term = getRichData(it.term);
                    it.desc = getRichData(it.desc);
                    return it;
                  });
                } else {
                  d.items = [{ id: uid('t'), term: getRichData(''), desc: getRichData('') }];
                }
                break;

              case 'related-docs':
                if (Array.isArray(d.items)) {
                  d.items = d.items.map(function(it) {
                    if (!it.id) it.id = uid('rd');
                    it.type = it.type || (it.url && it.url.startsWith('http') ? 'external' : 'internal');
                    it.title = getRichData(it.title);
                    return it;
                  });
                } else {
                  d.items = [{ id: uid('rd'), type: 'internal', title: getRichData(''), slug: '', url: '', ctaText: 'Study scroll' }];
                }
                break;
            }
        }

        doc.sections.forEach(function(sec) {
          if (!sec.id) sec.id = uid('sec');
          if (!sec.blocks) sec.blocks = [];
          sec.blocks.forEach(normalizeBlock);
        });
        return doc;
      }

      // ── Reading Time Auto Calculator ────────────────────
      function calculateReadingTime() {
        var totalWords = 0;

        function addWords(val) {
          if (!val) return;
          var str = (typeof val === 'object' && val !== null) ? (val.text || val.content || '') : val;
          if (!str || typeof str !== 'string') return;
          var clean = str.replace(/<[^>]*>/g, ' ').trim();
          if (clean) {
            totalWords += clean.split(/\s+/).length;
          }
        }

        addWords(currentDoc.meta.title);
        addWords(currentDoc.meta.description);

        (currentDoc.sections || []).forEach(function(sec) {
          addWords(sec.title);
          addWords(sec.kicker);
          addWords(sec.heading);

          (sec.blocks || []).forEach(function(blk) {
            var d = blk.data || {};
            addWords(d.title);
            addWords(d.heading);
            addWords(d.intro);
            if (blk.type !== 'title-text' || d.showText !== false) {
              addWords(d.text);
              addWords(d.paragraph);
            }
            addWords(d.quote);
            addWords(d.author);
            addWords(d.caption);
            addWords(d.solutionTitle);
            addWords(d.solutionText);
            addWords(d.scenario);
            addWords(d.alt);
            addWords(d.col1Title);
            addWords(d.col1Text);
            addWords(d.col2Title);
            addWords(d.col2Text);
            addWords(d.card1Title);
            addWords(d.card1Desc);
            addWords(d.card2Title);
            addWords(d.card2Desc);
            addWords(d.card3Title);
            addWords(d.card3Desc);
            addWords(d.col1Header);
            addWords(d.col2Header);
            addWords(d.stat1Label);
            addWords(d.stat1Sub);
            addWords(d.stat2Label);
            addWords(d.stat2Sub);
            addWords(d.stat3Label);
            addWords(d.stat3Sub);
            addWords(d.img1Caption);
            addWords(d.img2Caption);
            addWords(d.img3Caption);

            if (Array.isArray(d.col1Items)) {
              d.col1Items.forEach(function(it) { addWords(it.text); });
            }
            if (Array.isArray(d.col2Items)) {
              d.col2Items.forEach(function(it) { addWords(it.text); });
            }

            if (Array.isArray(d.paragraphs)) {
              if (blk.type !== 'title-text' || d.showText !== false) {
                d.paragraphs.forEach(function(p) { addWords(typeof p === 'object' ? p.text : p); });
              }
            }

            if (Array.isArray(d.items)) {
              d.items.forEach(function(it) {
                if (typeof it === 'string') addWords(it);
                else {
                  addWords(it.term);
                  addWords(it.desc);
                  addWords(it.text);
                  addWords(it.question);
                  addWords(it.answer);
                  addWords(it.title);
                  function addNestedChildrenWords(childrenArr) {
                    if (!Array.isArray(childrenArr)) return;
                    childrenArr.forEach(function(c) {
                      if (typeof c === 'string') addWords(c);
                      else if (c && typeof c === "object") {
                        addWords(c.text);
                        if (Array.isArray(c.children)) addNestedChildrenWords(c.children);
                      }
                    });
                  }
                  if (Array.isArray(it.children)) {
                    addNestedChildrenWords(it.children);
                  }
                }
              });
            }

            if (Array.isArray(d.steps)) {
              d.steps.forEach(function(s) {
                addWords(s.title);
                addWords(s.text);
              });
            }

            if (Array.isArray(d.columns)) {
              d.columns.forEach(function(c) {
                addWords(c.title);
                addWords(c.text);
                addWords(c.label);
              });
            }

            if (Array.isArray(d.rows)) {
              d.rows.forEach(function(r) {
                if (r.cells) {
                  Object.values(r.cells).forEach(addWords);
                }
              });
            }

            if (Array.isArray(d.questions)) {
              d.questions.forEach(function(q) {
                addWords(q.question);
                addWords(q.explanation);
                if (Array.isArray(q.answers)) {
                  q.answers.forEach(function(a) { addWords(a.text); });
                }
              });
            }

            if (Array.isArray(d.cards)) {
              d.cards.forEach(function(c) {
                addWords(c.caption);
                addWords(c.alt);
              });
            }

            if (Array.isArray(d.blocks)) {
              d.blocks.forEach(function(cb) {
                var cd = cb.data || {};
                addWords(cd.text);
                addWords(cd.heading);
                if (Array.isArray(cd.paragraphs)) {
                  cd.paragraphs.forEach(function(p) { addWords(typeof p === 'object' ? p.text : p); });
                }
                if (Array.isArray(cd.items)) {
                  cd.items.forEach(function(it) {
                    addWords(typeof it === 'object' ? it.text : it);
                    if (it && Array.isArray(it.children)) {
                      it.children.forEach(function(c) { addWords(typeof c === 'object' ? c.text : c); });
                    }
                  });
                }
                if (Array.isArray(cd.rows)) {
                  cd.rows.forEach(function(r) {
                    if (r.cells) Object.values(r.cells).forEach(addWords);
                  });
                }
              });
            }
          });
        });

        var minutes = Math.max(1, Math.round(totalWords / 200));
        var str = minutes + ' min';
        currentDoc.meta.readingTime = str;

        var el = document.getElementById('reading-time-text');
        if (el) el.textContent = '≈ ' + str;

        return str;
      }

      // ── Image Upload & Reusable Image Picker ────────────
      function uploadImageFile(file, callback) {
        var reader = new FileReader();
        reader.onload = function(evt) {
          fetch('/__uat-article-forge/upload', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ studioId: currentDoc.studioId, filename: file.name, data: evt.target.result })
          })
          .then(function(res) { return res.json(); })
          .then(function(data) {
            if (data.ok && data.url) {
              callback(null, data.url);
              showToast('Image uploaded to UAT: ' + (data.filename || file.name), 'success');
              triggerAutosave();
            } else {
              callback(new Error(data.error || 'Upload failed'));
              showToast(data.error || 'Upload failed', 'error');
            }
          })
          .catch(function(err) {
            callback(err);
            showToast('Upload error: ' + err.message, 'error');
          });
        };
        reader.readAsDataURL(file);
      }

      function openImageUploader(onUploaded) {
        var fileInput = document.createElement('input');
        fileInput.type = 'file';
        fileInput.accept = 'image/*';
        fileInput.style.display = 'none';
        document.body.appendChild(fileInput);

        fileInput.addEventListener('change', function(e) {
          var file = e.target.files[0];
          if (!file) {
            fileInput.remove();
            return;
          }
          showToast('Uploading image...', 'saving');
          uploadImageFile(file, function(err, url) {
            fileInput.remove();
            if (err) {
              showToast('Upload failed: ' + err.message, 'error');
            } else {
              showToast('Image uploaded successfully', 'success');
              onUploaded(url, file.name);
            }
          });
        });

        fileInput.click();
      }

