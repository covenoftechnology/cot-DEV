      window.checkSlotCollisionState = checkSlotCollisionState;

      function getSpanPercentageLabel(colSpan) {
        var s = clampVal(colSpan, 1, 4);
        switch (s) {
          case 1: return '25%';
          case 2: return '50%';
          case 3: return '75%';
          case 4: return '100%';
          default: return (s * 25) + '%';
        }
