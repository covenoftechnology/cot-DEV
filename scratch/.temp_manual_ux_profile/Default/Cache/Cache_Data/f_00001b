          if (coverAltInput) coverAltInput.value = '';
          updateCoverUiState('');
          triggerAutosave();
          showToast('Cover image removed', 'info');
        });
      }

      if (coverAltInput) {
        coverAltInput.addEventListener('input', function(e) {
          var val = (e.target.value || '').trim();
          currentDoc.meta.coverImageAlt = val;
          delete currentDoc.meta.coverCaption;
          triggerAutosave();
        });
      }

      if (coverShowToggle) {
        coverShowToggle.addEventListener('change', function(e) {
          currentDoc.meta.showCoverImageOnArticle = e.target.checked;
          triggerAutosave();
        });
      }

      // Settings generic listeners
      ['meta-desc', 'meta-author', 'meta-rank', 'meta-aether', 'meta-featured', 'meta-wide'].forEach(function(id) {
        var el = document.getElementById(id);
        if (el) {
          el.addEventListener('change', function() {
            syncMetaStateFromInputs();
            triggerAutosave();
          });
        }
      });

      // ── Autosave & Persistence ──────────────────────────
      var isSaving = false;
      var pendingSaveQueue = null;
      var pendingSaveResolver = null;

      function saveDraft(quiet) {
        if (isSaving) {
          // If a save is already in-flight, queue next save with latest doc state
          if (!pendingSaveQueue) {
            pendingSaveQueue = new Promise(function(resolve, reject) {
              pendingSaveResolver = { resolve: resolve, reject: reject, quiet: quiet };
            });
          } else {
            if (!quiet && pendingSaveResolver) pendingSaveResolver.quiet = false;
          }
          return pendingSaveQueue;
        }

        isSaving = true;
        syncMetaStateFromInputs();
        setStatus('Saving…', 'saving');

        // Ensure authoritative single layout serialization: layoutItems only, slots & layout non-enumerable
        if (Array.isArray(currentDoc.sections)) {
          for (var s = 0; s < currentDoc.sections.length; s++) {
            var secClean = currentDoc.sections[s];
            if (secClean.visualGrid) {
              if (!Array.isArray(secClean.visualGrid.layoutItems) && Array.isArray(secClean.visualGrid.slots)) {
                secClean.visualGrid.layoutItems = secClean.visualGrid.slots;
              }
              delete secClean.visualGrid.slots;
              Object.defineProperty(secClean.visualGrid, 'slots', {
                get: function() { return this.layoutItems; },
                set: function(v) { this.layoutItems = v; },
                enumerable: false,
                configurable: true
              });
            }
            delete secClean.layout;
            Object.defineProperty(secClean, 'layout', {
              get: function() { return this.visualGrid; },
              set: function(v) { this.visualGrid = v; },
              enumerable: false,
              configurable: true
            });
          }
        }

        return fetch('/__uat-article-forge/draft', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            doc: currentDoc,
            expectedRevision: currentDoc.revision
          })
        })
        .then(function(res) {
          if (res.status === 409) {
            return res.json().then(function(conflictData) {
              setStatus('Conflict', 'error');
              showConflictModal(conflictData);
              throw new Error('Conflict: Revision mismatch (' + conflictData.currentRevision + ' vs ' + conflictData.incomingRevision + ')');
            });
          }
          if (!res.ok) {
            return res.json().then(function(errData) {
              throw new Error(errData.error || 'Server error: ' + res.status);
            });
          }
          return res.json();
        })
        .then(function(data) {
          if (data.ok) {
            currentDoc.revision = data.revision;
            if (data.draft) {
              currentDoc.createdAt = data.draft.createdAt;
              currentDoc.updatedAt = data.draft.updatedAt;
            }
            setStatus('Saved in UAT', 'saved');
            isDirty = false;
            try {
              sessionStorage.setItem('covenUatArticleForge:draft', JSON.stringify(currentDoc));
              sessionStorage.removeItem('covenUatArticleForge:recovery');
              localStorage.setItem('covenUatArticleForge:lastDraftId', currentDoc.studioId);
            } catch (e) {}
            if (!quiet) showToast('Draft saved in UAT (Rev ' + currentDoc.revision + ')', 'success');
            return data;
          } else {
            setStatus('Save Failed', 'error');
            showToast(data.error || 'Failed to save draft', 'error');
            return data;
          }
        })
        .catch(function(err) {
          if (!err.message.includes('Conflict:')) {
            setStatus('Save Failed', 'error');
            showToast('Save error: ' + err.message, 'error');
          }
          return { ok: false, error: err.message };
        })
        .finally(function() {
          isSaving = false;
          if (pendingSaveQueue) {
            var resolver = pendingSaveResolver;
            pendingSaveQueue = null;
            pendingSaveResolver = null;
            saveDraft(resolver.quiet).then(resolver.resolve, resolver.reject);
          }
        });
      }

      var saveDebounceTimer = null;
      function triggerAutosave() {
        isDirty = true;
        setStatus('Unsaved', 'dirty');
        try {
          sessionStorage.setItem('covenUatArticleForge:recovery', JSON.stringify(currentDoc));
        } catch (e) {}
        if (saveDebounceTimer) clearTimeout(saveDebounceTimer);
        saveDebounceTimer = setTimeout(function() {
          saveDraft(true);
        }, 1000);
      }

      function setStatus(text, type) {
        var indicator = document.getElementById('status-indicator');
        var dot = document.getElementById('status-dot');
        if (indicator) indicator.textContent = text;
        if (dot) {
          dot.className = 'status-dot' + (type ? ' ' + type : '');
        }
      }

      function showToast(msg, type) {
        window._lastToast = { msg: msg, type: type, timestamp: Date.now() };
        var container = document.getElementById('toast-container');
        if (!container) return;

        var toast = document.createElement('div');
        toast.className = 'studio-toast' + (type ? ' ' + type : '');
        toast.innerHTML = '<span>✦</span><span>' + escapeHtml(msg) + '</span>';
        container.appendChild(toast);

        setTimeout(function() {
          toast.style.opacity = '0';
          toast.style.transform = 'translateY(10px)';
          setTimeout(function() { toast.remove(); }, 300);
        }, 3000);
      }

      // ── Delete Confirmation Modal ───────────────────────
      function confirmDelete(title, message, onConfirm) {
        var modal = document.getElementById('delete-confirm-modal');
        var titleEl = document.getElementById('delete-modal-title');
        var msgEl = document.getElementById('delete-modal-message');
        if (!modal) {
          if (confirm(message)) onConfirm();
          return;
        }

        if (titleEl) titleEl.textContent = title;
        if (msgEl) msgEl.textContent = message;
        pendingDeleteCallback = onConfirm;
        modal.style.display = 'flex';
      }

      document.getElementById('btn-cancel-delete').addEventListener('click', function() {
        document.getElementById('delete-confirm-modal').style.display = 'none';
        pendingDeleteCallback = null;
      });

      document.getElementById('btn-confirm-delete').addEventListener('click', function() {
        document.getElementById('delete-confirm-modal').style.display = 'none';
        if (typeof pendingDeleteCallback === 'function') {
          pendingDeleteCallback();
        }
        pendingDeleteCallback = null;
      });

      // ── New Article Draft ───────────────────────────────
      document.getElementById('btn-new').addEventListener('click', function() {
        checkUnsavedThen(function() {
          createNewArticle();
        });
      });

      function createNewArticle() {
        isExistingPublished = false;
        originalPublishedSlug = '';
        var warningEl = document.getElementById('slug-published-warning');
        if (warningEl) warningEl.style.display = 'none';

        var initialSecId = uid('sec');
        var initialSec = {
          id: initialSecId,
          title: 'Section 1',
          kicker: '',
          heading: '',
          visualGrid: {
            columns: 4,
            rows: 3,
            columnGap: 16,
            rowGap: 16,
            minRowHeight: 80,
            showCoordinates: false,
            layoutItems: []
          },
          blocks: []
        };
        Object.defineProperty(initialSec.visualGrid, 'slots', {
          get: function() { return this.layoutItems; },
          set: function(v) { this.layoutItems = v; },
          enumerable: false,
          configurable: true
        });
        Object.defineProperty(initialSec, 'layout', {
          get: function() { return this.visualGrid; },
          set: function(v) { this.visualGrid = v; },
          enumerable: false,
          configurable: true
        });

        currentDoc = {
          version: 1,
          studioId: uid('draft'),
          revision: 1,
          slug: '',
          meta: {
            title: '',
            description: '',
            author: 'Oracle of Orgs',
            category: 'Salesforce',
            difficulty: 'Lv. 1 - Incantation',
            tags: [],
            rank: 'Mechanic',
            readingTime: '1 min',
            aetherReward: 120,
            status: 'draft',
            featured: false,
            wide: true,
            coverImageSrc: '',
            coverImageAlt: '',
            showCoverImageOnArticle: true
          },
          sections: [initialSec]
        };
        activeSectionId = initialSecId;
        isDirty = false;
        renderSections();
        syncMetaInputsFromState();
        setStatus('Ready', 'ready');
        showToast('New UAT article created (0 slots)', 'success');
      }

      // ── Drafts Modal ────────────────────────────────────
      var btnDraftsEl = document.getElementById('btn-drafts');
      if (btnDraftsEl) {
        btnDraftsEl.addEventListener('click', function() {
          loadDraftsList();
          document.getElementById('drafts-modal').style.display = 'flex';
        });
      }

      document.getElementById('btn-close-drafts').addEventListener('click', function() {
        closeInlineDelete();
        document.getElementById('drafts-modal').style.display = 'none';
      });

      function deleteDraft(studioId, title, triggerBtn) {
        showInlineDelete(
          triggerBtn,
          'Delete "' + (title || studioId) + '" permanently from UAT?',
          null,
          function() {
            if (triggerBtn) triggerBtn.disabled = true;
            fetch('/__uat-article-forge/drafts/' + encodeURIComponent(studioId), { method: 'DELETE' })
              .then(function(res) {
                if (!res.ok) throw new Error('Delete failed');
                showToast('Draft deleted from UAT', 'info');
                if (currentDoc && currentDoc.studioId === studioId) {
                  createNewArticle();
                }
                loadDraftsList();
              })
              .catch(function(err) {
                if (triggerBtn) triggerBtn.disabled = false;
                showToast('Failed to delete draft: ' + err.message, 'error');
              });
          }
        );
      }

      function loadDraftsList() {
        var listContainer = document.getElementById('drafts-list');
        listContainer.innerHTML = '<div style="color:var(--studio-text-muted);font-size:12px">Loading drafts…</div>';

        fetch('/__uat-article-forge/drafts')
          .then(function(res) { return res.json(); })
          .then(function(data) {
            var drafts = data.drafts || [];
            if (drafts.length === 0) {
              listContainer.innerHTML = '<div style="color:var(--studio-text-muted);font-size:13px;padding:12px 0">No UAT drafts found.</div>';
              return;
            }

            listContainer.innerHTML = '';
            drafts.forEach(function(d) {
              var card = document.createElement('div');
              card.style.cssText = 'background:rgba(21,18,28,0.85);border:1px solid var(--studio-border);border-radius:8px;padding:12px 14px;display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:8px';

              var dateStr = new Date(d.updatedAt).toLocaleString();
              card.innerHTML =
                '<div style="min-width:0;flex:1">' +
                  '<div style="font-family:var(--font-display);font-size:13px;color:var(--studio-gold-bright);margin-bottom:3px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + escapeHtml(d.title || 'Untitled Scroll') + '</div>' +
                  '<div style="font-family:var(--font-mono);font-size:10px;color:var(--studio-purple)">' +
                    escapeHtml(d.category || 'General') + ' · ' + escapeHtml(d.difficulty || 'Lv. 1') + ' · ' + (d.sectionCount || 0) + ' sec · ' + (d.slotCount || 0) + ' slots · ' + dateStr +
                  '</div>' +
                  '<div style="font-family:var(--font-mono);font-size:9px;color:var(--studio-text-muted);margin-top:2px">' +
                    'ID: ' + escapeHtml(d.studioId) + ' (Rev ' + (d.revision || 1) + ')' +
                  '</div>' +
                '</div>' +
                '<div style="display:flex;gap:6px;flex-shrink:0">' +
                  '<button type="button" class="studio-btn studio-btn--sm btn-open-draft" data-id="' + d.studioId + '">Open</button>' +
                  '<button type="button" class="studio-btn studio-btn--sm btn-dup-draft" data-id="' + d.studioId + '" title="Duplicate">Copy</button>' +
                  '<button type="button" class="studio-btn studio-btn--sm studio-btn--danger btn-del-draft" data-id="' + d.studioId + '" title="Delete">✕</button>' +
                '</div>';

              card.querySelector('.btn-open-draft').addEventListener('click', function() {
                checkUnsavedThen(function() {
                  openDraft(d.studioId);
                  document.getElementById('drafts-modal').style.display = 'none';
                });
              });

              card.querySelector('.btn-dup-draft').addEventListener('click', function() {
                duplicateDraft(d.studioId);
              });

              card.querySelector('.btn-del-draft').addEventListener('click', function(e) {
                e.stopPropagation();
                deleteDraft(d.studioId, d.title, e.currentTarget);
              });

              listContainer.appendChild(card);
            });
          })
          .catch(function(err) {
            listContainer.innerHTML = '<div style="color:#f85149;font-size:13px;padding:12px 0">Error loading drafts: ' + escapeHtml(err.message) + '</div>';
          });
      }

      function openDraft(studioId) {
        closeInlineDelete();
        try {
          localStorage.setItem('covenUatArticleForge:lastDraftId', studioId);
        } catch (e) {}

        return fetch('/__uat-article-forge/drafts/' + encodeURIComponent(studioId))
          .then(function(res) {
            if (!res.ok) throw new Error('Draft not found');
            return res.json();
          })
          .then(function(data) {
            if (!data.ok || !data.draft) throw new Error('Invalid draft data');
            var doc = data.draft;
            normalizeDocument(doc);
            currentDoc = doc;
            activeSectionId = doc.sections.length > 0 ? doc.sections[0].id : null;
            isDirty = false;
            renderSections();
            syncMetaInputsFromState();
            setStatus('Saved in UAT', 'saved');
            try {
              sessionStorage.setItem('covenUatArticleForge:draft', JSON.stringify(currentDoc));
              sessionStorage.removeItem('covenUatArticleForge:recovery');
              localStorage.setItem('covenUatArticleForge:lastDraftId', currentDoc.studioId);
            } catch (e) {}
            showToast('Draft opened: ' + (doc.meta?.title || 'Untitled'));
            return doc;
          })
          .catch(function(err) {
            showToast('Error opening draft: ' + err.message, 'error');
            throw err;
          });
      }

      function duplicateDraft(studioId) {
        showToast('Duplicating draft…', 'info');
        return fetch('/__uat-article-forge/duplicate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ studioId: studioId })
        })
        .then(function(res) {
          if (!res.ok) throw new Error('Duplicate failed');
          return res.json();
        })
        .then(function(data) {
          showToast('Draft duplicated: ' + (data.doc?.meta?.title || 'Copy'), 'success');
          loadDraftsList();
          return data;
        })
        .catch(function(err) {
          showToast('Duplicate error: ' + err.message, 'error');
          throw err;
        });
      }

      // ── Duplicate Article ───────────────────────────────
      document.getElementById('btn-duplicate-article').addEventListener('click', function() {
        var copyDoc = JSON.parse(JSON.stringify(currentDoc));
        copyDoc.studioId = uid('draft');
        var rawBase = (copyDoc.slug || 'untitled').replace(/-copy(-\d+)?$/i, '');
        copyDoc.slug = normalizeSlugClient(rawBase + '-copy', false);
        copyDoc.meta.title = (copyDoc.meta.title || 'Untitled Scroll') + ' (Copy)';
        copyDoc.meta.status = 'draft';

        normalizeDocument(copyDoc);
        currentDoc = copyDoc;
        isExistingPublished = false;
        originalPublishedSlug = '';
        activeSectionId = currentDoc.sections.length > 0 ? currentDoc.sections[0].id : null;
        renderSections();
        syncMetaInputsFromState();
        saveDraft(false);
        showToast('Article duplicated as new draft', 'success');
      });

      // ── Focus Canvas Toggle ──────────────────────────────
      var btnFocus = document.getElementById('btn-focus-canvas');
      if (btnFocus) {
        btnFocus.addEventListener('click', function() {
          var isFocused = document.body.classList.toggle('is-canvas-focused');
          btnFocus.textContent = isFocused ? '⛶ Normal View' : '⛶ Focus Canvas';
          btnFocus.setAttribute('title', isFocused ? 'Restore normal 3-column workspace' : 'Toggle full-width canvas workspace');
          showToast(isFocused ? 'Focus Canvas mode enabled' : 'Normal workspace view restored', 'info');
        });
      }

      // ── Save Draft Button ───────────────────────────────
      document.getElementById('btn-save-draft').addEventListener('click', function() {
        saveDraft(false);
      });

      // ── Single-Tab Reusable Live Preview ────────────────
      document.getElementById('btn-preview').addEventListener('click', function() {
        syncMetaStateFromInputs();
        showToast('Preparing preview…', 'saving');

        fetch('/__uat-article-forge/preview', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(currentDoc)
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.ok) {
            window.open('/lab/layout-forge/preview?draft=' + encodeURIComponent(currentDoc.studioId), 'coven-uat-preview');
            showToast('UAT Preview opened in tab', 'success');
          } else {
            showToast(data.error || 'Preview failed', 'error');
          }
        })
        .catch(function(err) {
          showToast('Preview error: ' + err.message, 'error');
        });
      });

      // ── Publish Action (Disabled in UAT Article Forge Sandbox) ──
      document.getElementById('btn-publish').addEventListener('click', function() {
        showToast('Publishing is disabled in UAT Article Forge sandbox (Safe Mode)', 'warning');
      });

      // ── Initial Boot ────────────────────────────────────
      initLibrary();
      initCategoryCombobox();
      initDifficultyDropdown();
      initTagsCombobox();
      initCustomColorPicker();

      // Phase 5 Boot Sequence
      var urlParams = new URLSearchParams(window.location.search);
      var draftParam = urlParams.get('draft');

      if (draftParam) {
        openDraft(draftParam);
      } else {
        checkRecoveryAndSessionOnBoot();
      }

      function checkRecoveryAndSessionOnBoot() {
        var recoveryRaw = null;
        try {
          recoveryRaw = sessionStorage.getItem('covenUatArticleForge:recovery');
        } catch (e) {}

        if (recoveryRaw) {
          try {
            var recDoc = JSON.parse(recoveryRaw);
            if (recDoc && recDoc.sections) {
              showRecoveryBanner(recDoc);
              return;
            }
          } catch (e) {}
        }

        var lastDraftId = null;
        try {
          lastDraftId = localStorage.getItem('covenUatArticleForge:lastDraftId');
        } catch (e) {}

        if (lastDraftId) {
          fetch('/__uat-article-forge/drafts/' + encodeURIComponent(lastDraftId))
            .then(function(r) {
              if (r.ok) return r.json();
              throw new Error('Not found');
            })
            .then(function(data) {
              if (data.ok && data.draft) {
                normalizeDocument(data.draft);
                currentDoc = data.draft;
                activeSectionId = currentDoc.sections.length > 0 ? currentDoc.sections[0].id : null;
                renderSections();
                syncMetaInputsFromState();
                setStatus('Saved in UAT', 'saved');
                isDirty = false;
              } else {
                createNewArticle();
              }
            })
            .catch(function() {
              createNewArticle();
            });
        } else {
          createNewArticle();
        }
      }

      // Expose state globally for browser QA automation
      try {
        Object.defineProperty(window, 'currentDoc', {
          configurable: true,
          enumerable: true,
          get: function() { return currentDoc; },
          set: function(v) { currentDoc = v; }
        });
      } catch(e) {
        window.currentDoc = currentDoc;
      }
      window.resolveBlockLocation = resolveBlockLocation;
      window.renderSections = renderSections;
      window.renderMetadata = syncMetaInputsFromState;
      window.calculateReadingTime = calculateReadingTime;
      window.saveDraft = saveDraft;
      window.sanitizeRichText = sanitizeRichText;
      window.applyColorClass = applyColorClass;
      window.applyBgClass = applyBgClass;
      window.getSavedColors = getSavedColors;
      window.saveColorToPalette = saveColorToPalette;
      window.removeColorFromPalette = removeColorFromPalette;
      window.closeAllPopovers = closeAllPopovers;
      window.openCustomColorPicker = openCustomColorPicker;
      window.normalizeHex = normalizeHex;
      window.addBlockToActiveSection = addBlockToActiveSection;
      window.addSection = addSection;

    })();
  })();</script></body></html>