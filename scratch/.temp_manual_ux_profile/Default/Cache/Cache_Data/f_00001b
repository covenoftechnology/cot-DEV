  max-height: 190px;
}

.coven-studio .combobox-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 9px 14px;
  font-family: var(--font-body);
  font-size: 14px;
  color: var(--studio-text);
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease;
  user-select: none;
}

.coven-studio .combobox-option:hover,
.coven-studio .combobox-option.is-highlighted {
  background: rgba(216, 181, 107, 0.14);
  color: var(--studio-gold-bright);
}

.coven-studio .combobox-option.is-selected {
  background: rgba(185, 143, 216, 0.15);
  color: var(--studio-gold-bright);
  font-weight: 600;
}

.coven-studio .combobox-option.is-selected::after {
  content: '✓';
  color: var(--studio-purple);
  font-family: var(--font-mono);
  font-size: 12px;
  margin-left: 8px;
}

.coven-studio .combobox-option-icon {
  margin-right: 8px;
  color: var(--studio-gold-dim);
  font-family: var(--font-mono);
  font-size: 12px;
}

.coven-studio .combobox-create-option {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 10px 14px;
  font-family: var(--font-mono);
  font-size: 12px;
  color: var(--studio-gold-bright);
  background: rgba(216, 181, 107, 0.08);
  border-top: 1px solid var(--studio-border);
  cursor: pointer;
  transition: background 0.15s ease;
  user-select: none;
}

.coven-studio .combobox-create-option:hover,
.coven-studio .combobox-create-option.is-highlighted {
  background: rgba(216, 181, 107, 0.22);
  color: #ffffff;
}

.coven-studio .tag-suggestions-menu {
  position: absolute;
  top: calc(100% + 4px);
  left: 0;
  right: 0;
  background: #130f1c;
  border: 1px solid var(--studio-border-active);
  border-radius: 6px;
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.85);
  z-index: 100;
  max-height: 250px;
  display: flex;
  flex-direction: column;
}

/* Status Segmented Control */
.coven-studio .segmented-control {
  display: flex;
  background: rgba(8, 6, 14, 0.9);
  border: 1px solid var(--studio-border);
  border-radius: 4px;
  padding: 3px;
  gap: 3px;
}

.coven-studio .segment-btn {
  flex: 1;
  font-family: var(--font-display);
  font-size: 11px;
  letter-spacing: 1.2px;
  padding: 8px 12px;
  border-radius: 3px;
  border: none;
  background: transparent;
  color: var(--studio-text-muted);
  cursor: pointer;
  text-transform: uppercase;
  transition: all 0.2s ease;
}

.coven-studio .segment-btn.active {
  background: rgba(216, 181, 107, 0.18);
  color: var(--studio-gold-bright);
  border: 1px solid var(--studio-border-active);
  box-shadow: 0 0 12px rgba(216, 181, 107, 0.18);
}

/* Advanced Settings Accordion */
.coven-studio .advanced-settings-box {
  border: 1px solid var(--studio-border);
  border-radius: 5px;
  background: rgba(14, 11, 20, 0.65);
  overflow: hidden;
  margin-top: 6px;
}

.coven-studio .advanced-settings-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  cursor: pointer;
  user-select: none;
  background: rgba(20, 16, 28, 0.85);
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--studio-gold);
  text-transform: uppercase;
  letter-spacing: 0.8px;
  border: none;
  width: 100%;
}

.coven-studio .advanced-settings-toggle:hover {
  background: rgba(28, 22, 40, 0.95);
}

.coven-studio .advanced-settings-body {
  display: none;
  padding: 16px;
  flex-direction: column;
  gap: 14px;
  border-top: 1px solid var(--studio-border);
}

.coven-studio .advanced-settings-box.open .advanced-settings-body {
  display: flex;
}

.coven-studio .advanced-settings-box.open .adv-arrow {
  transform: rotate(180deg);
}

.coven-studio .adv-arrow {
  transition: transform 0.2s ease;
  font-size: 10px;
}

.coven-studio .checkbox-row {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-body);
  font-size: 14px;
  color: var(--studio-text-dim);
  cursor: pointer;
}

.coven-studio .checkbox-row input[type="checkbox"] {
  accent-color: var(--studio-gold-dim);
  cursor: pointer;
  width: 16px;
  height: 16px;
}

.coven-studio .image-picker-row {
  display: flex;
  gap: 8px;
  align-items: center;
}

/* ── Toast Notifications ──────────────────────────────────── */
.coven-studio .studio-toast-container {
  position: fixed;
  bottom: 24px;
  right: 24px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  z-index: 1000;
  pointer-events: none;
}

.coven-studio .studio-toast {
  background: #14101e;
  border: 1px solid var(--studio-border-active);
  box-shadow: 0 10px 32px rgba(0, 0, 0, 0.75);
  padding: 12px 20px;
  border-radius: 5px;
  font-family: var(--font-mono);
  font-size: 12px;
  color: var(--studio-gold-bright);
  display: flex;
  align-items: center;
  gap: 10px;
  pointer-events: auto;
  animation: studioToastIn 0.25s ease-out;
  transition: opacity 0.3s ease, transform 0.3s ease;
}

.coven-studio .studio-toast.success {
  border-color: var(--studio-success);
  color: #c8e6c9;
}

.coven-studio .studio-toast.warning {
  border-color: #ffb74d;
  color: #ffe0b2;
}

.coven-studio .studio-toast.error {
  border-color: var(--studio-danger);
  color: #ffcdd2;
}

@keyframes studioToastIn {
  from { opacity: 0; transform: translateY(12px); }
  to { opacity: 1; transform: translateY(0); }
}

/* ── Coven Modals ─────────────────────────────────────────── */
.coven-studio .studio-modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(4, 3, 7, 0.85);
  backdrop-filter: blur(8px);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 200;
  padding: 20px;
}

.coven-studio .studio-modal {
  background: var(--studio-surface);
  border: 1px solid var(--studio-border-active);
  border-radius: 8px;
  padding: 28px;
  width: 580px;
  max-width: 100%;
  box-shadow: 0 18px 48px rgba(0, 0, 0, 0.85);
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.coven-studio .studio-modal-title {
  font-family: var(--font-display);
  font-size: 18px;
  color: var(--studio-gold);
}

.coven-studio .studio-modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 8px;
}

/* ── Inline Delete Confirmation Popover ───────────────────────── */
.coven-studio .delete-confirm-inline {
  position: fixed;
  z-index: 10001;
  background: #110d1a;
  border: 1px solid rgba(220, 80, 80, 0.45);
  border-radius: 6px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.75), 0 0 16px rgba(220, 80, 80, 0.15);
  padding: 10px 14px;
  min-width: 190px;
  max-width: 270px;
  box-sizing: border-box;
  animation: deleteConfirmFadeIn 0.12s ease-out;
}

@keyframes deleteConfirmFadeIn {
  from {
    opacity: 0;
    transform: translateY(-4px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.coven-studio .delete-confirm-inline__content {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.coven-studio .delete-confirm-inline__title {
  font-family: var(--font-display, 'Metamorphous', serif);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.5px;
  color: #f5d6d6;
  line-height: 1.3;
}

.coven-studio .delete-confirm-inline__subtitle {
  font-family: var(--font-body, 'Helvetica Neue', sans-serif);
  font-size: 11px;
  color: var(--studio-text-muted, #8f857a);
  line-height: 1.3;
}

.coven-studio .delete-confirm-inline__actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
  margin-top: 4px;
}

.coven-studio .delete-confirm-inline__actions .studio-btn {
  font-size: 11px;
  padding: 4px 10px;
  height: 26px;
  line-height: 1;
}

/* ── Structured Block Editors V3 Styles ───────────────────── */
.coven-studio .studio-brand {
  text-decoration: none;
  color: inherit;
  display: flex;
  align-items: center;
  gap: 12px;
}

.coven-studio .studio-btn--add-field {
  background: transparent;
  border: 1px dashed rgba(216, 181, 107, 0.3);
  color: var(--studio-gold-dim);
  font-family: var(--font-mono);
  font-size: 11px;
  height: 30px;
  padding: 0 12px;
  border-radius: 4px;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  transition: all 0.2s ease;
}

.coven-studio .studio-btn--add-field:hover {
  border-color: var(--studio-gold);
  color: var(--studio-gold-bright);
  background: rgba(216, 181, 107, 0.08);
}

.coven-studio .field-label-remove {
  cursor: pointer;
  color: var(--studio-gold-dim);
  font-size: 11px;
  transition: color 0.15s ease;
  padding: 0 4px;
}

.coven-studio .field-label-remove:hover {
  color: var(--studio-danger);
}

/* Repeatable List Editor */
.coven-studio .studio-repeatable-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.coven-studio .studio-repeatable-row {
  display: flex;
  align-items: center;
  gap: 8px;
  background: rgba(18, 14, 26, 0.85);
  border: 1px solid var(--studio-border);
  border-radius: 4px;
  padding: 6px 10px;
  transition: border-color 0.2s ease;
}

.coven-studio .studio-repeatable-row:hover {
  border-color: var(--studio-border-hover);
}

.coven-studio .studio-repeatable-handle {
  cursor: grab;
  color: var(--studio-purple-dim);
  font-size: 13px;
  user-select: none;
  padding: 0 2px;
}

.coven-studio .studio-repeatable-handle:active {
  cursor: grabbing;
}

.coven-studio .studio-repeatable-content {
  flex: 1;
  min-width: 0;
}

.coven-studio .studio-repeatable-actions {
  display: flex;
  align-items: center;
  gap: 4px;
}

/* Hierarchical Nested Items */
.coven-studio .nested-parent-card {
  background: rgba(18, 14, 26, 0.85);
  border: 1px solid var(--studio-border);
  border-radius: 5px;
  padding: 10px 12px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.coven-studio .nested-sub-items-wrap {
  margin-left: 18px;
  border-left: 2px solid rgba(185, 143, 216, 0.25);
  padding-left: 12px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.coven-studio .nested-sub-items-wrap[data-depth="3"] {
  margin-left: 14px;
  border-left-color: rgba(216, 181, 107, 0.26);
  padding-left: 10px;
  margin-top: 6px;
}

.coven-studio .nested-sub-items-wrap[data-depth="4"] {
  margin-left: 12px;
  border-left-color: rgba(185, 143, 216, 0.22);
  padding-left: 10px;
  margin-top: 6px;
}

.coven-studio .nested-sub-item-card {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.coven-studio .nested-sub-item-actions {
  margin-top: 2px;
}

.coven-studio .nested-max-depth-pill {
  font-family: var(--font-mono);
  font-size: 9px;
  color: var(--studio-text-muted);
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(216, 181, 107, 0.16);
  border-radius: 3px;
  padding: 1px 5px;
  margin-left: 6px;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

/* Numbered Steps Card */
.coven-studio .studio-step-card {
  background: rgba(18, 14, 26, 0.9);
  border: 1px solid var(--studio-border);
  border-radius: 6px;
  padding: 12px 14px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  position: relative;
}

.coven-studio .studio-step-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.coven-studio .studio-step-badge {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 1px solid var(--studio-border-active);
  background: rgba(216, 181, 107, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 600;
  color: var(--studio-gold-bright);
}

/* Reusable Image Picker Tile */
.coven-studio .studio-img-picker {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.coven-studio .studio-img-dropzone {
  border: 1px dashed rgba(216, 181, 107, 0.3);
  border-radius: 6px;
  background: rgba(16, 13, 22, 0.6);
  padding: 22px 16px;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.coven-studio .studio-img-dropzone:hover {
  border-color: var(--studio-gold);
  background: rgba(216, 181, 107, 0.05);
}

.coven-studio .studio-img-preview-box {
  background: rgba(14, 11, 20, 0.9);
  border: 1px solid var(--studio-border);
  border-radius: 6px;
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.coven-studio .studio-img-thumbnail-wrap {
  position: relative;
  max-height: 140px;
  overflow: hidden;
  border-radius: 4px;
  border: 1px solid rgba(216, 181, 107, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  background: #050408;
}

.coven-studio .studio-img-thumbnail {
  max-width: 100%;
  max-height: 140px;
  object-fit: contain;
}

/* Two and Three Columns Layout */
.coven-studio .studio-cols-grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}

.coven-studio .studio-cols-grid-3 {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12px;
}

/* Multi-Image Studio Editor Local Horizontal Scroll */
.coven-studio .studio-multi-image-scroll {
  width: 100%;
  max-width: 100%;
  overflow-x: auto;
  overflow-y: hidden;
  padding-bottom: 10px;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: thin;
  scrollbar-color: rgba(216, 181, 107, 0.4) rgba(8, 6, 14, 0.7);
  box-sizing: border-box;
}

.coven-studio .studio-multi-image-scroll::-webkit-scrollbar {
  height: 8px;
}
.coven-studio .studio-multi-image-scroll::-webkit-scrollbar-track {
  background: rgba(8, 6, 14, 0.7);
  border-radius: 4px;
}
.coven-studio .studio-multi-image-scroll::-webkit-scrollbar-thumb {
  background: rgba(216, 181, 107, 0.35);
  border-radius: 4px;
}
.coven-studio .studio-multi-image-scroll::-webkit-scrollbar-thumb:hover {
  background: rgba(216, 181, 107, 0.65);
}

.coven-studio .studio-multi-image-scroll .studio-multi-image-grid {
  display: flex !important;
  gap: 14px;
  min-width: min-content;
}

.coven-studio .studio-multi-image-scroll .studio-col-panel {
  flex: 0 0 420px;
  min-width: 420px;
  max-width: 440px;
  box-sizing: border-box;
}

.coven-studio .studio-col-panel {
  background: rgba(18, 14, 26, 0.85);
  border: 1px solid var(--studio-border);
  border-radius: 5px;
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.coven-studio .studio-col-panel-title {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--studio-gold);
  letter-spacing: 0.8px;
  text-transform: uppercase;
}

/* Callout Palette Swatches */
.coven-studio .callout-swatches-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
}

.coven-studio .callout-swatch-item {
  padding: 8px 10px;
  border-radius: 4px;
  cursor: pointer;
  font-family: var(--font-mono);
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  border: 1px solid transparent;
  transition: all 0.2s ease;
  user-select: none;
}

.coven-studio .callout-swatch-item.swatch-note {
  background: rgba(139, 92, 246, 0.12);
  color: #c4b5fd;
  border-color: rgba(139, 92, 246, 0.35);
}

.coven-studio .callout-swatch-item.swatch-info {
  background: rgba(185, 143, 216, 0.12);
  color: #e9d5ff;
  border-color: rgba(185, 143, 216, 0.35);
}

.coven-studio .callout-swatch-item.swatch-tip {
  background: rgba(216, 181, 107, 0.12);
  color: #fef08a;
  border-color: rgba(216, 181, 107, 0.35);
}

.coven-studio .callout-swatch-item.swatch-warning {
  background: rgba(245, 158, 11, 0.12);
  color: #fde68a;
  border-color: rgba(245, 158, 11, 0.35);
}

.coven-studio .callout-swatch-item.active {
  border-width: 2px;
  box-shadow: 0 0 14px currentColor;
  font-weight: 600;
}

/* Excel-like Table Builder */
.coven-studio .studio-table-builder {
  overflow-x: auto;
  border: 1px solid var(--studio-border);
  border-radius: 5px;
  background: #09070f;
}

.coven-studio .studio-table-grid {
  width: 100%;
  border-collapse: collapse;
}

.coven-studio .studio-table-grid th {
  background: #14101e;
  border: 1px solid rgba(216, 181, 107, 0.18);
  padding: 6px 8px;
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--studio-gold);
}

.coven-studio .studio-table-grid td {
  border: 1px solid rgba(216, 181, 107, 0.1);
  padding: 4px 6px;
  background: #0d0b14;
}

.coven-studio .studio-table-cell-input {
  width: 100%;
  background: transparent;
  border: none;
  color: #ece6dd;
  font-family: var(--font-body);
  font-size: 13px;
  outline: none;
  padding: 4px;
}

.coven-studio .studio-table-cell-input:focus {
  background: rgba(216, 181, 107, 0.1);
}

.coven-studio .table-contextual-bar {
  margin-bottom: 8px;
}

.coven-studio .table-contextual-bar .rich-text-toolbar {
  border-radius: 4px;
  border-bottom: 1px solid rgba(216, 181, 107, 0.22);
  opacity: 1;
}

.coven-studio .studio-table-cell-input.rich-text-surface {
  min-height: 24px;
  cursor: text;
  white-space: pre-wrap;
  word-break: break-word;
}

.coven-studio .studio-table-cell-input.rich-text-surface:empty::before {
  content: '...';
  color: var(--studio-text-muted);
  opacity: 0.5;
}

/* Article Trial Builder */
.coven-studio .trial-q-card {
  background: rgba(18, 14, 26, 0.9);
  border: 1px solid rgba(185, 143, 216, 0.25);
  border-radius: 6px;
  padding: 14px 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 12px;
}

.coven-studio .trial-q-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid rgba(185, 143, 216, 0.15);
  padding-bottom: 8px;
}

.coven-studio .trial-q-title {
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 1px;
  color: #b98fd8;
  font-weight: 600;
}

.coven-studio .trial-ans-row {
  display: flex;
  align-items: center;
  gap: 10px;
  background: rgba(12, 10, 18, 0.7);
  border: 1px solid rgba(216, 181, 107, 0.12);
  border-radius: 4px;
  padding: 6px 10px;
}

.coven-studio .trial-ans-row.is-correct {
  border-color: rgba(76, 175, 80, 0.45);
  background: rgba(76, 175, 80, 0.08);
}

.coven-studio .trial-radio {
  accent-color: var(--studio-gold);
  cursor: pointer;
  width: 16px;
  height: 16px;
}

/* ── Responsive ───────────────────────────────────────────── */
@media (max-width: 1100px) {
  .coven-studio .studio-workspace {
    grid-template-columns: 270px minmax(0, 1fr) 320px;
  }
}

@media (max-width: 900px) {
  .coven-studio .studio-workspace {
    grid-template-columns: 1fr;
    height: auto;
    overflow-y: auto;
  }
  .coven-studio .studio-library-pane,
  .coven-studio .studio-settings-pane {
    border: none;
    border-bottom: 1px solid var(--studio-border);
  }
  .coven-studio .studio-cols-grid-2,
  .coven-studio .studio-cols-grid-3 {
    grid-template-columns: 1fr;
  }
}

/* ── Rich Text Editor (Basic Typography: Title+Text, Text+Title, Solo Text) ── */
.coven-studio .rich-text-field-wrap {
  position: relative;
