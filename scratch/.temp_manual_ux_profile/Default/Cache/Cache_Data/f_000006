const __vite__css = "/* ============================================================\r\n   COVEN ARTICLE STUDIO — STYLESHEET (V2 VISUAL PASS)\r\n   Strictly scoped under `.coven-studio` to style both static and\r\n   dynamically created DOM elements without leaking to public pages.\r\n   ============================================================ */\r\n\r\n/* ── Custom Properties / Tokens ──────────────────────────── */\r\n.coven-studio {\r\n  --studio-bg: #08060e;\r\n  --studio-surface: #100d16;\r\n  --studio-surface-raised: #15121c;\r\n  --studio-surface-elevated: #1b1724;\r\n  --studio-surface-header: #1e192a;\r\n  --studio-surface-input: #0c0a12;\r\n  \r\n  --studio-border: rgba(216, 181, 107, 0.16);\r\n  --studio-border-hover: rgba(216, 181, 107, 0.38);\r\n  --studio-border-active: rgba(216, 181, 107, 0.7);\r\n  --studio-border-purple: rgba(185, 143, 216, 0.32);\r\n  --studio-border-danger: rgba(229, 115, 115, 0.4);\r\n  \r\n  --studio-gold: #e8cf95;\r\n  --studio-gold-bright: #f3ecdf;\r\n  --studio-gold-dim: #c49a4e;\r\n  --studio-gold-deep: #8f857a;\r\n  \r\n  --studio-purple: #b98fd8;\r\n  --studio-purple-dim: #8b5cc4;\r\n  \r\n  --studio-text: #ece6dd;\r\n  --studio-text-dim: #cdc3b6;\r\n  --studio-text-muted: #8f857a;\r\n  \r\n  --studio-danger: #e57373;\r\n  --studio-danger-bg: rgba(229, 115, 115, 0.12);\r\n  --studio-success: #81c784;\r\n  \r\n  --font-display: 'Metamorphous', serif;\r\n  --font-body: 'EB Garamond', serif;\r\n  --font-mono: 'Consolas', 'IBM Plex Mono', monospace;\r\n\r\n  background: var(--studio-bg);\r\n  color: var(--studio-text);\r\n  font-family: var(--font-body);\r\n  font-size: 16px;\r\n  line-height: 1.5;\r\n  height: 100vh;\r\n  width: 100vw;\r\n  overflow: hidden;\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n/* ── Form Controls & Native Resets ────────────────────────── */\r\n.coven-studio input,\r\n.coven-studio textarea,\r\n.coven-studio select,\r\n.coven-studio button {\r\n  appearance: none;\r\n  -webkit-appearance: none;\r\n  box-sizing: border-box;\r\n  font-family: inherit;\r\n  color: inherit;\r\n}\r\n\r\n.coven-studio button {\r\n  background: none;\r\n  border: none;\r\n  padding: 0;\r\n  cursor: pointer;\r\n}\r\n\r\n/* ── Custom Scrollbars ────────────────────────────────────── */\r\n.coven-studio *::-webkit-scrollbar {\r\n  width: 6px;\r\n  height: 6px;\r\n}\r\n.coven-studio *::-webkit-scrollbar-track {\r\n  background: rgba(8, 6, 14, 0.6);\r\n}\r\n.coven-studio *::-webkit-scrollbar-thumb {\r\n  background: rgba(216, 181, 107, 0.2);\r\n  border-radius: 3px;\r\n}\r\n.coven-studio *::-webkit-scrollbar-thumb:hover {\r\n  background: rgba(216, 181, 107, 0.4);\r\n}\r\n\r\n/* ── Top Bar ──────────────────────────────────────────────── */\r\n.coven-studio .studio-topbar {\r\n  height: 64px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  padding: 0 24px;\r\n  background: rgba(16, 13, 22, 0.98);\r\n  border-bottom: 1px solid var(--studio-border);\r\n  flex-shrink: 0;\r\n  z-index: 100;\r\n  backdrop-filter: blur(12px);\r\n  gap: 16px;\r\n}\r\n\r\n.coven-studio .studio-brand {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n}\r\n\r\n.coven-studio .brand-icon {\r\n  width: 34px;\r\n  height: 34px;\r\n  border-radius: 50%;\r\n  border: 1px solid var(--studio-gold-dim);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  color: var(--studio-gold);\r\n  font-size: 15px;\r\n  background: #0b0a0e;\r\n  box-shadow: inset 0 0 10px rgba(216, 181, 107, 0.2);\r\n}\r\n\r\n.coven-studio .brand-title {\r\n  font-family: var(--font-display);\r\n  font-size: 13px;\r\n  letter-spacing: 1.8px;\r\n  color: var(--studio-gold-bright);\r\n  text-transform: uppercase;\r\n  font-weight: 600;\r\n}\r\n\r\n.coven-studio .brand-badge {\r\n  font-family: var(--font-mono);\r\n  font-size: 10px;\r\n  padding: 3px 8px;\r\n  border-radius: 3px;\r\n  background: rgba(185, 143, 216, 0.12);\r\n  border: 1px solid var(--studio-border-purple);\r\n  color: var(--studio-purple);\r\n  letter-spacing: 1px;\r\n}\r\n\r\n.coven-studio .status-indicator {\r\n  font-family: var(--font-mono);\r\n  font-size: 11px;\r\n  color: var(--studio-gold-deep);\r\n  padding: 5px 12px;\r\n  border-radius: 4px;\r\n  background: rgba(0, 0, 0, 0.4);\r\n  border: 1px solid var(--studio-border);\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n\r\n.coven-studio .status-dot {\r\n  width: 6px;\r\n  height: 6px;\r\n  border-radius: 50%;\r\n  background: var(--studio-gold-dim);\r\n  box-shadow: 0 0 6px var(--studio-gold-dim);\r\n}\r\n\r\n.coven-studio .status-dot.saving {\r\n  background: var(--studio-purple);\r\n  box-shadow: 0 0 8px var(--studio-purple);\r\n  animation: studioPulse 1s infinite alternate;\r\n}\r\n\r\n.coven-studio .status-dot.saved {\r\n  background: var(--studio-success);\r\n  box-shadow: 0 0 6px var(--studio-success);\r\n}\r\n\r\n.coven-studio .status-dot.error {\r\n  background: var(--studio-danger);\r\n  box-shadow: 0 0 6px var(--studio-danger);\r\n}\r\n\r\n@keyframes studioPulse {\r\n  from { opacity: 0.35; }\r\n  to { opacity: 1; }\r\n}\r\n\r\n.coven-studio .studio-actions {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n\r\n/* ── Coven Buttons (`studio-btn`) ─────────────────────────── */\r\n.coven-studio .studio-btn {\r\n  font-family: var(--font-display);\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n  letter-spacing: 1px;\r\n  height: 36px;\r\n  padding: 0 16px;\r\n  border-radius: 4px;\r\n  border: 1px solid var(--studio-border);\r\n  background: var(--studio-surface-raised);\r\n  color: var(--studio-text);\r\n  cursor: pointer;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 6px;\r\n  transition: all 0.2s ease;\r\n  white-space: nowrap;\r\n  text-decoration: none;\r\n  user-select: none;\r\n}\r\n\r\n.coven-studio .studio-btn:hover:not(:disabled) {\r\n  border-color: var(--studio-gold);\r\n  background: var(--studio-surface-elevated);\r\n  color: var(--studio-gold-bright);\r\n  box-shadow: 0 0 14px rgba(216, 181, 107, 0.22);\r\n}\r\n\r\n.coven-studio .studio-btn:disabled {\r\n  opacity: 0.42;\r\n  cursor: not-allowed;\r\n  border-color: rgba(255, 255, 255, 0.08);\r\n}\r\n\r\n.coven-studio .studio-btn--primary {\r\n  background: linear-gradient(180deg, #e3c47e, #c49a4e);\r\n  color: #1a1205;\r\n  border: 1px solid transparent;\r\n  box-shadow: 0 0 18px rgba(216, 181, 107, 0.32);\r\n}\r\n\r\n.coven-studio .studio-btn--primary:hover:not(:disabled) {\r\n  background: linear-gradient(180deg, #ebd498, #d0a65c);\r\n  color: #1a1205;\r\n  box-shadow: 0 0 26px rgba(216, 181, 107, 0.55);\r\n}\r\n\r\n.coven-studio .studio-btn--secondary {\r\n  background: var(--studio-surface-raised);\r\n  border-color: var(--studio-border);\r\n  color: var(--studio-gold);\r\n}\r\n\r\n.coven-studio .studio-btn--secondary:hover:not(:disabled) {\r\n  border-color: var(--studio-gold);\r\n  background: var(--studio-surface-elevated);\r\n  color: var(--studio-gold-bright);\r\n}\r\n\r\n.coven-studio .studio-btn--ghost {\r\n  background: rgba(16, 13, 22, 0.5);\r\n  border-color: var(--studio-border);\r\n  color: var(--studio-text-dim);\r\n}\r\n\r\n.coven-studio .studio-btn--ghost:hover:not(:disabled) {\r\n  border-color: var(--studio-border-hover);\r\n  color: var(--studio-gold-bright);\r\n  background: rgba(24, 20, 34, 0.75);\r\n}\r\n\r\n.coven-studio .studio-btn--sm {\r\n  font-family: var(--font-mono);\r\n  font-size: 11px;\r\n  letter-spacing: 0.5px;\r\n  height: 28px;\r\n  padding: 0 10px;\r\n  border-radius: 3px;\r\n  border: 1px solid var(--studio-border);\r\n  background: rgba(18, 14, 26, 0.85);\r\n  color: var(--studio-text-dim);\r\n}\r\n\r\n.coven-studio .studio-btn--sm:hover:not(:disabled) {\r\n  border-color: var(--studio-gold-dim);\r\n  color: var(--studio-gold-bright);\r\n  background: rgba(28, 22, 40, 0.95);\r\n  box-shadow: 0 0 10px rgba(216, 181, 107, 0.15);\r\n}\r\n\r\n.coven-studio .studio-btn--icon {\r\n  font-family: var(--font-mono);\r\n  font-size: 12px;\r\n  width: 26px;\r\n  height: 26px;\r\n  padding: 0;\r\n  border-radius: 3px;\r\n  border: 1px solid var(--studio-border);\r\n  background: rgba(18, 14, 26, 0.7);\r\n  color: var(--studio-text-dim);\r\n}\r\n\r\n.coven-studio .studio-btn--icon:hover:not(:disabled) {\r\n  border-color: var(--studio-gold);\r\n  color: var(--studio-gold-bright);\r\n  background: rgba(28, 22, 40, 0.9);\r\n}\r\n\r\n.coven-studio .studio-btn--danger {\r\n  color: var(--studio-danger);\r\n  border-color: rgba(229, 115, 115, 0.28);\r\n}\r\n\r\n.coven-studio .studio-btn--danger:hover:not(:disabled) {\r\n  background: var(--studio-danger-bg);\r\n  border-color: var(--studio-danger);\r\n  color: #ff9e9e;\r\n  box-shadow: 0 0 12px rgba(229, 115, 115, 0.3);\r\n}\r\n\r\n.coven-studio .studio-btn--insert {\r\n  font-family: var(--font-mono);\r\n  font-size: 10px;\r\n  height: 24px;\r\n  padding: 0 8px;\r\n  border-radius: 3px;\r\n  background: rgba(216, 181, 107, 0.08);\r\n  border: 1px solid rgba(216, 181, 107, 0.25);\r\n  color: var(--studio-gold);\r\n}\r\n\r\n.coven-studio .studio-btn--insert:hover:not(:disabled) {\r\n  background: var(--studio-gold);\r\n  color: #120e1a;\r\n  border-color: var(--studio-gold);\r\n  box-shadow: 0 0 10px rgba(216, 181, 107, 0.4);\r\n}\r\n\r\n/* ── Workspace 3-Column Layout ────────────────────────────── */\r\n.coven-studio .studio-workspace {\r\n  display: grid;\r\n  grid-template-columns: 310px minmax(0, 1fr) 370px;\r\n  flex: 1;\r\n  height: calc(100vh - 64px);\r\n  overflow: hidden;\r\n}\r\n\r\n/* ── Focus Canvas Workspace Mode ─────────────────────────────────── */\r\nbody.coven-studio.is-canvas-focused .studio-library-pane,\r\nbody.coven-studio.is-canvas-focused .studio-settings-pane {\r\n  display: none !important;\r\n}\r\n\r\nbody.coven-studio.is-canvas-focused .studio-workspace {\r\n  grid-template-columns: 1fr !important;\r\n}\r\n\r\nbody.coven-studio.is-canvas-focused #btn-focus-canvas {\r\n  background: rgba(201, 168, 76, 0.22) !important;\r\n  border-color: var(--studio-gold, #c9a84c) !important;\r\n  color: var(--studio-gold, #c9a84c) !important;\r\n  box-shadow: 0 0 12px rgba(201, 168, 76, 0.25) !important;\r\n}\r\n\r\n/* ── Left Pane: Block Library ─────────────────────────────── */\r\n.coven-studio .studio-library-pane {\r\n  background: var(--studio-surface);\r\n  border-right: 1px solid var(--studio-border);\r\n  overflow-y: auto;\r\n  padding: 18px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 16px;\r\n}\r\n\r\n.coven-studio .library-header {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  border-bottom: 1px solid var(--studio-border);\r\n  padding-bottom: 10px;\r\n}\r\n\r\n.coven-studio .library-title {\r\n  font-family: var(--font-display);\r\n  font-size: 13px;\r\n  letter-spacing: 1.5px;\r\n  color: var(--studio-gold);\r\n  text-transform: uppercase;\r\n}\r\n\r\n.coven-studio .library-count-badge {\r\n  font-family: var(--font-mono);\r\n  font-size: 10px;\r\n  letter-spacing: 1px;\r\n  color: var(--studio-purple);\r\n  background: rgba(185, 143, 216, 0.1);\r\n  border: 1px solid var(--studio-border-purple);\r\n  padding: 2px 8px;\r\n  border-radius: 3px;\r\n  text-transform: uppercase;\r\n}\r\n\r\n/* Library Search */\r\n.coven-studio .library-search-wrap {\r\n  position: relative;\r\n  display: flex;\r\n  align-items: center;\r\n  width: 100%;\r\n}\r\n\r\n.coven-studio .library-search-wrap .studio-input {\r\n  padding-right: 36px;\r\n}\r\n\r\n.coven-studio .library-search-clear-btn {\r\n  position: absolute;\r\n  right: 8px;\r\n  top: 50%;\r\n  transform: translateY(-50%);\r\n  display: none;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 22px;\r\n  height: 22px;\r\n  padding: 0;\r\n  border: 1px solid transparent;\r\n  border-radius: 4px;\r\n  background: transparent;\r\n  color: var(--studio-text-muted);\r\n  font-family: var(--font-body);\r\n  font-size: 18px;\r\n  line-height: 1;\r\n  cursor: pointer;\r\n  transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;\r\n  user-select: none;\r\n}\r\n\r\n.coven-studio .library-search-clear-btn:hover {\r\n  color: var(--studio-gold-bright);\r\n  background: rgba(216, 181, 107, 0.1);\r\n  border-color: rgba(216, 181, 107, 0.25);\r\n}\r\n\r\n.coven-studio .library-search-clear-btn:focus-visible {\r\n  outline: 2px solid var(--studio-gold);\r\n  outline-offset: 1px;\r\n  color: var(--studio-gold-bright);\r\n}\r\n\r\n/* Categories & Accordions */\r\n.coven-studio .library-categories-list {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 10px;\r\n}\r\n\r\n.coven-studio .category-accordion {\r\n  border: 1px solid rgba(216, 181, 107, 0.12);\r\n  border-radius: 5px;\r\n  background: rgba(21, 18, 28, 0.5);\r\n  overflow: hidden;\r\n  transition: border-color 0.2s ease;\r\n}\r\n\r\n.coven-studio .category-accordion:hover {\r\n  border-color: var(--studio-border-hover);\r\n}\r\n\r\n.coven-studio .category-accordion-header {\r\n  width: 100%;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  padding: 10px 12px;\r\n  cursor: pointer;\r\n  user-select: none;\r\n  background: rgba(22, 18, 30, 0.85);\r\n  border: none;\r\n  text-align: left;\r\n  transition: background 0.15s ease;\r\n}\r\n\r\n.coven-studio .category-accordion-header:hover {\r\n  background: rgba(32, 26, 44, 0.95);\r\n}\r\n\r\n.coven-studio .category-accordion-title {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  font-family: var(--font-mono);\r\n  font-size: 11px;\r\n  color: var(--studio-purple);\r\n  letter-spacing: 0.5px;\r\n  text-transform: uppercase;\r\n  font-weight: 600;\r\n}\r\n\r\n.coven-studio .category-arrow {\r\n  font-size: 10px;\r\n  color: var(--studio-gold-dim);\r\n  transition: transform 0.2s ease;\r\n  display: inline-block;\r\n  width: 12px;\r\n}\r\n\r\n.coven-studio .category-accordion.open