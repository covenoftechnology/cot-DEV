ox-shadow: 0 0 20px rgba(216, 181, 107, 0.45) !important;\n}\n\n.section-grid-slot.slot-drag-replace-warning {\n  border: 2px dashed #f39c12 !important;\n  background: rgba(243, 156, 18, 0.18) !important;\n  box-shadow: 0 0 20px rgba(243, 156, 18, 0.4) !important;\n}\n\n.section-grid-slot.drag-target-forbidden {\n  border: 2px dashed #e74c3c !important;\n  background: rgba(231, 76, 60, 0.15) !important;\n  cursor: not-allowed !important;\n}\n\n/* Slot Header */\n.slot-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  margin-bottom: 6px;\n  padding-bottom: 5px;\n  border-bottom: 1px solid rgba(216, 181, 107, 0.15);\n  user-select: none;\n}\n\n.slot-header-left {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n\n/* Dedicated Slot Drag Handle: ⠿ */\n.slot-drag-handle {\n  font-family: var(--font-mono);\n  font-size: 14px;\n  line-height: 1;\n  color: var(--studio-gold);\n  cursor: grab;\n  padding: 3px 6px;\n  border-radius: 3px;\n  background: rgba(216, 181, 107, 0.1);\n  border: 1px solid rgba(216, 181, 107, 0.2);\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  transition: all 0.12s;\n  touch-action: none;\n}\n\n.slot-drag-handle:hover {\n  background: rgba(216, 181, 107, 0.25);\n  color: var(--studio-gold-bright);\n  box-shadow: 0 0 8px rgba(216, 181, 107, 0.3);\n}\n\n.slot-drag-handle:active {\n  cursor: grabbing;\n}\n\n.slot-title {\n  font-family: var(--font-display);\n  font-size: 12px;\n  font-weight: 600;\n  color: var(--studio-gold-bright);\n  letter-spacing: 0.03em;\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.slot-glyph {\n  font-family: var(--font-mono);\n  font-size: 11px;\n  color: var(--studio-gold);\n}\n\n.slot-id-badge {\n  font-family: var(--font-mono);\n  font-size: 9px;\n  background: rgba(185, 143, 216, 0.15);\n  border: 1px solid rgba(185, 143, 216, 0.25);\n  color: var(--studio-purple);\n  padding: 1px 5px;\n  border-radius: 3px;\n}\n\n.slot-actions {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  position: relative;\n}\n\n.slot-action-btn {\n  background: rgba(25, 20, 35, 0.8);\n  border: 1px solid var(--studio-border);\n  color: var(--studio-text-muted);\n  font-family: var(--font-mono);\n  font-size: 11px;\n  cursor: pointer;\n  padding: 2px 6px;\n  border-radius: 3px;\n  transition: all 0.12s;\n  display: inline-flex;\n  align-items: center;\n  gap: 3px;\n}\n\n.slot-action-btn:hover {\n  color: var(--studio-gold-bright);\n  background: rgba(216, 181, 107, 0.2);\n  border-color: var(--studio-gold);\n}\n\n.slot-action-btn--gold {\n  color: var(--studio-gold);\n  border-color: rgba(216, 181, 107, 0.3);\n}\n\n.slot-action-btn--gold:hover {\n  background: rgba(216, 181, 107, 0.25);\n  color: var(--studio-gold-bright);\n}\n\n.slot-action-btn--warning:hover {\n  color: #f39c12;\n  border-color: #f39c12;\n  background: rgba(243, 156, 18, 0.15);\n}\n\n.slot-action-btn--danger:hover {\n  color: #ff6b6b;\n  border-color: #ff6b6b;\n  background: rgba(255, 107, 107, 0.15);\n}\n\n/* Slot Body */\n.slot-body {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n  width: 100%;\n}\n\n/* Empty Slot State */\n.slot-empty-state {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  min-height: 90px;\n  padding: 14px 10px;\n  gap: 8px;\n  text-align: center;\n}\n\n.slot-add-block-btn {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 7px 14px;\n  background: rgba(216, 181, 107, 0.12);\n  border: 1px dashed rgba(216, 181, 107, 0.45);\n  border-radius: 5px;\n  color: var(--studio-gold-bright);\n  font-family: var(--font-mono);\n  font-size: 11px;\n  font-weight: 600;\n  cursor: pointer;\n  transition: all 0.15s ease;\n}\n\n.slot-add-block-btn:hover {\n  background: rgba(216, 181, 107, 0.25);\n  border-color: var(--studio-gold);\n  transform: translateY(-1px);\n  box-shadow: 0 0 12px rgba(216, 181, 107, 0.3);\n}\n\n.slot-empty-hint {\n  font-family: var(--font-mono);\n  font-size: 10px;\n  color: rgba(216, 181, 107, 0.45);\n  font-style: italic;\n}\n\n/* Occupied Slot State & Embedded Block Editor */\n.section-grid-slot.is-occupied {\n  background: rgba(18, 14, 25, 0.95);\n}\n\n.section-grid-slot .block-editor-card {\n  background: transparent !important;\n  border: none !important;\n  border-radius: 4px !important;\n  box-shadow: none !important;\n  margin: 0 !important;\n  padding: 0 !important;\n  width: 100% !important;\n  min-width: 0 !important;\n  overflow: visible !important;\n}\n\n.section-grid-slot .block-editor-card .block-editor-header {\n  display: none !important; /* Unified into slot header */\n}\n\n.section-grid-slot .block-editor-body {\n  padding: 4px 0 6px 0;\n  min-width: 0;\n  box-sizing: border-box;\n}\n\n/* Ensure inputs reflow naturally without scaling */\n.section-grid-slot input,\n.section-grid-slot textarea,\n.section-grid-slot select {\n  max-width: 100%;\n  box-sizing: border-box;\n}\n\n/* Move Block Popover */\n.slot-move-popover {\n  position: absolute;\n  top: calc(100% + 4px);\n  right: 0;\n  z-index: 50;\n  background: rgba(22, 17, 30, 0.98);\n  border: 1px solid var(--studio-gold);\n  border-radius: 6px;\n  padding: 10px;\n  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.75);\n  min-width: 220px;\n  animation: fadeInProps 0.15s ease-out;\n}\n\n.slot-move-popover-title {\n  font-family: var(--font-mono);\n  font-size: 10px;\n  color: var(--studio-gold);\n  text-transform: uppercase;\n  margin-bottom: 8px;\n  letter-spacing: 0.05em;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n\n.slot-move-item-btn {\n  width: 100%;\n  text-align: left;\n  padding: 6px 10px;\n  margin-bottom: 4px;\n  background: rgba(30, 24, 42, 0.85);\n  border: 1px solid var(--studio-border);\n  border-radius: 4px;\n  color: var(--studio-text);\n  font-family: var(--font-mono);\n  font-size: 11px;\n  cursor: pointer;\n  transition: all 0.12s;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n\n.slot-move-item-btn:hover {\n  background: rgba(216, 181, 107, 0.2);\n  border-color: var(--studio-gold);\n  color: var(--studio-gold-bright);\n}\n\n/* Pulse Library Highlight Animation */\n.pulse-library-highlight {\n  animation: pulseLibGlow 1.2s ease-in-out;\n}\n\n@keyframes pulseLibGlow {\n  0% { box-shadow: 0 0 0 rgba(216, 181, 107, 0); }\n  50% { box-shadow: 0 0 28px rgba(216, 181, 107, 0.55), inset 0 0 15px rgba(216, 181, 107, 0.2); }\n  100% { box-shadow: 0 0 0 rgba(216, 181, 107, 0); }\n}\n\n/* Legacy Migration Button */\n.btn-legacy-migrate-slot {\n  background: rgba(216, 181, 107, 0.15);\n  border: 1px solid var(--studio-gold);\n  color: var(--studio-gold-bright);\n  font-family: var(--font-mono);\n  font-size: 10px;\n  padding: 3px 8px;\n  border-radius: 4px;\n  cursor: pointer;\n  transition: all 0.12s;\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n}\n\n.btn-legacy-migrate-slot:hover {\n  background: rgba(216, 181, 107, 0.3);\n  box-shadow: 0 0 10px rgba(216, 181, 107, 0.35);\n}\n\n/* Slot Footer */\n.slot-footer {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-top: 4px;\n  pointer-events: none;\n}\n\n.slot-span-badge {\n  font-family: var(--font-mono);\n  font-size: 10px;\n  color: var(--studio-text-muted);\n}\n\n/* Resize Grip (Southeast) */\n.slot-resize-grip {\n  position: absolute;\n  right: 2px;\n  bottom: 2px;\n  width: 16px;\n  height: 16px;\n  cursor: se-resize;\n  color: var(--studio-gold);\n  opacity: 0.6;\n  font-size: 13px;\n  line-height: 16px;\n  text-align: right;\n  display: flex;\n  align-items: flex-end;\n  justify-content: flex-end;\n  z-index: 12;\n  transition: opacity 0.15s;\n}\n\n.slot-resize-grip:hover,\n.section-grid-slot.is-selected .slot-resize-grip {\n  opacity: 1;\n  color: var(--studio-gold-bright);\n}\n\n/* Boundary Handles */\n.slot-handle {\n  position: absolute;\n  z-index: 15;\n  box-sizing: border-box;\n}\n\n.slot-handle-e {\n  top: 15%;\n  bottom: 15%;\n  right: -5px;\n  width: 10px;\n  cursor: e-resize;\n}\n\n.slot-handle-s {\n  left: 15%;\n  right: 15%;\n  bottom: -5px;\n  height: 10px;\n  cursor: s-resize;\n}\n\n.slot-handle-w {\n  top: 15%;\n  bottom: 15%;\n  left: -5px;\n  width: 10px;\n  cursor: w-resize;\n}\n\n.slot-handle-n {\n  left: 15%;\n  right: 15%;\n  top: -5px;\n  height: 10px;\n  cursor: n-resize;\n}\n\n/* ── Ghost Preview & Collision Indicator ─────────────── */\n.section-grid-preview {\n  position: relative;\n  border-radius: 6px;\n  pointer-events: none;\n  z-index: 8;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-family: var(--font-mono);\n  font-size: 11px;\n  font-weight: 500;\n  transition: background 0.08s ease, border-color 0.08s ease;\n}\n\n.section-grid-preview.is-valid {\n  background: rgba(216, 181, 107, 0.12);\n  border: 2px dashed var(--studio-gold);\n  color: var(--studio-gold-bright);\n  box-shadow: 0 0 16px rgba(216, 181, 107, 0.25);\n}\n\n.section-grid-preview.is-collision {\n  background: rgba(224, 108, 117, 0.22);\n  border: 2px solid #e06c75;\n  color: #ff858d;\n  box-shadow: 0 0 20px rgba(224, 108, 117, 0.4);\n}\n\n/* ── Slot Precision Property Panel ────────────────────── */\n.slot-properties-bar {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 8px 12px;\n  background: rgba(28, 22, 38, 0.95);\n  border: 1px solid rgba(216, 181, 107, 0.35);\n  border-radius: 6px;\n  flex-wrap: wrap;\n  animation: fadeInProps 0.15s ease-out;\n}\n\n@keyframes fadeInProps {\n  from { opacity: 0; transform: translateY(-3px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n.slot-prop-field {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.slot-prop-label {\n  font-family: var(--font-mono);\n  font-size: 10px;\n  color: var(--studio-gold);\n  text-transform: uppercase;\n}\n\n.slot-prop-input {\n  background: rgba(12, 10, 18, 0.85);\n  bord