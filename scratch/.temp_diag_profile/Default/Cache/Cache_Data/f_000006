sor: not-allowed;\n}\n\n.grid-stepper-val {\n  font-family: var(--font-mono);\n  font-size: 11px;\n  padding: 0 8px;\n  min-width: 50px;\n  text-align: center;\n  color: var(--studio-text);\n  border-left: 1px solid rgba(216, 181, 107, 0.1);\n  border-right: 1px solid rgba(216, 181, 107, 0.1);\n}\n\n.grid-btn {\n  background: rgba(25, 20, 35, 0.8);\n  border: 1px solid var(--studio-border);\n  border-radius: 4px;\n  color: var(--studio-text);\n  font-family: var(--font-mono);\n  font-size: 11px;\n  padding: 4px 10px;\n  cursor: pointer;\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  transition: background 0.15s, border-color 0.15s, color 0.15s;\n}\n\n.grid-btn:hover {\n  background: rgba(45, 35, 60, 0.9);\n  border-color: var(--studio-gold);\n  color: var(--studio-gold-bright);\n}\n\n.grid-btn.is-active {\n  background: rgba(216, 181, 107, 0.2);\n  border-color: var(--studio-gold);\n  color: var(--studio-gold-bright);\n}\n\n.grid-btn--gold {\n  background: rgba(216, 181, 107, 0.15);\n  border-color: var(--studio-gold);\n  color: var(--studio-gold-bright);\n  font-weight: 500;\n}\n\n.grid-btn--gold:hover {\n  background: rgba(216, 181, 107, 0.3);\n  box-shadow: 0 0 10px rgba(216, 181, 107, 0.3);\n}\n\n/* ── Section Grid Canvas ──────────────────────────────── */\n.section-grid-canvas-wrap {\n  position: relative;\n  width: 100%;\n  border: 1.5px dashed rgba(216, 181, 107, 0.25);\n  border-radius: 6px;\n  background: #09070e;\n  background-image: \n    radial-gradient(circle at 50% 50%, rgba(185, 143, 216, 0.04) 0%, transparent 80%),\n    linear-gradient(to right, rgba(216, 181, 107, 0.03) 1px, transparent 1px),\n    linear-gradient(to bottom, rgba(216, 181, 107, 0.03) 1px, transparent 1px);\n  background-size: 100% 100%, 32px 32px, 32px 32px;\n  padding: 16px;\n  box-sizing: border-box;\n  user-select: none;\n}\n\n.section-grid-canvas {\n  display: grid;\n  width: 100%;\n  position: relative;\n  box-sizing: border-box;\n}\n\n/* ── Empty Grid Cells ─